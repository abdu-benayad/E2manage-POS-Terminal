    // Helper function to select operator and navigate to PIN entry
    function select-operator(id: string, name: string, role: string, initials: string, op-color: color) {
        selected-operator-id = id;
        selected-operator-name = name;
        selected-operator-role = role;
        selected-operator-initials = initials;
        selected-operator-color = op-color;
        pin-error = false;
        pin-error-message = "";
        pin-attempts-remaining = 3;
        pin-text = "";
        current-screen = "pin-entry";
    }

    // Login screen (Phase 7)
    if current-screen == "login": LoginSelectScreen {
        // Operators populated from database via Rust
        operators: operators;
        employee-id-error: root.employee-id-error;
        employee-id-text <=> root.employee-id-text;

        operator-selected(id) => {
            // Call Rust to look up operator from DB and set properties
            root.on-operator-selected(id);
        }

        face-login => {
            debug("Face login requested");
        }

        employee-id-submitted(id) => {
            root.employee-id-submitted(id);
        }

        employee-id-backspace => {
            root.employee-id-backspace();
        }

        search-operators(query) => {
            root.search-operators(query);
        }
    }

    // PIN entry screen (Phase 8)
    if current-screen == "pin-entry": PinEntryScreen {
        operator-id: selected-operator-id;
        operator-name: selected-operator-name;
        operator-role: selected-operator-role;
        operator-initials: selected-operator-initials;
        operator-color: selected-operator-color;
        error: pin-error;
        error-message: pin-error-message;
        attempts-remaining: pin-attempts-remaining;
        pin-value <=> root.pin-text;

        back-clicked => {
            // Return to login screen
            pin-text = "";
            current-screen = "login";
        }

        pin-backspace => { root.pin-backspace(); }

        pin-submitted(pin) => {
            debug("PIN submitted for operator " + selected-operator-id);
            // Delegate to Rust for real bcrypt PIN verification
            root.verify-pin(selected-operator-id, pin);
        }

        forgot-pin-clicked => {
            debug("Forgot PIN clicked for operator: " + selected-operator-id);
        }

        face-login-clicked => {
            debug("Face login clicked for operator: " + selected-operator-id);
        }
    }

    // Start Shift screen (Phase 9)
    if current-screen == "start-shift": StartShiftScreen {
        operator-name: selected-operator-name;
        terminal-id: AppState.terminal-code;

        start-shift(amount) => {
            debug("Start shift with opening float: " + amount);
            AppState.shift-active = true;
            AppState.current-shift = "1"; // In production, get from API
            // Trigger sync on shift start to get latest catalog
            root.request-sync();
            current-screen = "checkout";
        }

        skip-float => {
            debug("Shift started with zero float (skipped)");
            AppState.shift-active = true;
            AppState.current-shift = "1";
            // Trigger sync on shift start to get latest catalog
            root.request-sync();
            current-screen = "checkout";
        }

        cancel => {
            // Return to login screen
            debug("Start shift cancelled");
            AppState.current-user = "";
            current-screen = "login";
        }
    }

    // Main Checkout screen (Phase 14)
    if current-screen == "checkout": MainCheckoutScreen {
        width: root.width;
        height: root.height;
        // Cart items data (managed by CartService via Rust)
        cart-items: root.cart-items;
        cart-item-count: root.cart-items.length;
        cart-subtotal: root.cart-subtotal;
        cart-tax: root.cart-tax;
        cart-tax-rate: AppState.tax-rate-label;
        cart-discount: root.cart-discount;
        cart-total: root.cart-total;
        cart-has-discount: root.cart-has-discount;
        cart-discount-name: root.cart-discount-name;

        // Customer data (managed via Rust)
        customer-name: root.customer-name;
        has-customer: root.has-customer;

        // Categories data (Phase 15)
        categories: root.categories;
        selected-category-id: selected-category;
        total-product-count: root.total-product-count;

        // Products data (Phase 16)
        products: root.products;
        products-loading: root.products-loading;

        // Last scanned item display (Phase 2)
        last-scanned-name: root.last-scanned-name;
        last-scanned-price: root.last-scanned-price;
        show-last-scanned: root.show-last-scanned;

        // Void last item feedback (Phase 3)
        void-item-name: root.void-item-name;
        void-item-price: root.void-item-price;
        show-void-feedback: root.show-void-feedback;

        // PLU Pad data (Phase 3)
        plu-result-name: root.plu-result-name;
        plu-result-price: root.plu-result-price;
        plu-result-product-id: root.plu-result-product-id;
        plu-result-count: root.plu-result-count;
        plu-searching: root.plu-searching;
        plu-error-message: root.plu-error-message;

        plu-lookup(code) => {
            debug("PLU lookup: " + code);
            root.plu-lookup(code);
        }

        plu-add-product(id) => {
            debug("PLU add product: " + id);
            root.plu-add-product(id);
        }

        // Quantity Pad data (Phase 3 — Quick Quantity Entry)
        qty-pad-open <=> root.qty-pad-open;
        qty-pad-value <=> root.qty-pad-value;
        qty-pad-item-id <=> root.qty-pad-item-id;
        qty-pad-item-name: root.qty-pad-item-name;
        qty-pad-item-price: root.qty-pad-item-price;
        qty-pad-current-qty: root.qty-pad-current-qty;
        qty-pad-error: root.qty-pad-error;

        quantity-confirmed(id, qty) => {
            debug("Quantity confirmed: item=" + id + " qty=" + qty);
            root.quantity-confirmed(id, qty);
        }

        // Price Check Mode data (Phase 3 — Price Check)
        price-check-mode <=> root.price-check-mode;
        price-check-open <=> root.price-check-open;
        price-check-name: root.price-check-name;
        price-check-price: root.price-check-price;
        price-check-barcode: root.price-check-barcode;
        price-check-sku: root.price-check-sku;
        price-check-category: root.price-check-category;
        price-check-stock: root.price-check-stock;
        price-check-unit: root.price-check-unit;
        price-check-in-stock: root.price-check-in-stock;
        price-check-low-stock: root.price-check-low-stock;
        price-check-tax-info: root.price-check-tax-info;
        price-check-searching: root.price-check-searching;
        price-check-error: root.price-check-error;

        price-check-toggle => {
            root.price-check-mode = !root.price-check-mode;
            if !root.price-check-mode {
                // Clear overlay when toggling off
                root.price-check-open = false;
            }
        }

        price-check-lookup(id) => {
            debug("Price check lookup: " + id);
            root.price-check-lookup(id);
        }

        price-check-dismiss => {
            root.price-check-open = false;
        }

        // Weight Pad data (Phase 3 — Scale/Weight Display)
        weight-pad-open <=> root.weight-pad-open;
        weight-pad-product-name: root.weight-pad-product-name;
        weight-pad-price-per-unit: root.weight-pad-price-per-unit;
        weight-pad-product-unit: root.weight-pad-product-unit;
        weight-pad-weight-display: root.weight-pad-weight-display;
        weight-pad-weight-stable: root.weight-pad-weight-stable;
        weight-pad-computed-total: root.weight-pad-computed-total;
        weight-pad-scale-connected: root.weight-pad-scale-connected;
        weight-pad-manual-value <=> root.weight-pad-manual-value;
        weight-pad-manual-mode: root.weight-pad-manual-mode;
        weight-pad-error: root.weight-pad-error;

        weight-confirmed(weight) => {
            debug("Weight confirmed: " + weight);
            root.weight-confirmed(weight);
        }

        weight-tare-requested => {
            debug("Weight tare requested");
            root.weight-tare-requested();
        }

        // Product/search callbacks
        search-product(query) => {
            debug("Search product: " + query);
            if root.price-check-mode && query != "" {
                // In price check mode, look up product instead of navigating
                root.price-check-lookup(query);
            } else if (query != "") {
                search-query = query;
                current-screen = "product-search";
            }
        }

        category-selected(id) => {
            debug("Category selected: " + id);
            selected-category = id;
            // Call Rust to filter products by category
            root.select-category(id);
        }

        product-selected(id) => {
            debug("Product selected: " + id);
            // Add product to cart via Rust/CartService
            root.add-to-cart(id);
        }

        // Cart item callbacks (Phase 17 + Phase 2 wiring)
        cart-item-increment(id) => {
            debug("Cart item increment: " + id);
            root.cart-item-increment(id);
        }

        cart-item-decrement(id) => {
            debug("Cart item decrement: " + id);
            root.cart-item-decrement(id);
        }

        cart-item-remove(id) => {
            debug("Cart item remove: " + id);
            root.cart-item-remove(id);
        }

        cart-item-edit(id) => {
            debug("Cart item edit (quantity): " + id);
            root.cart-item-edit(id);
        }

        cart-item-clicked(id) => {
            debug("Cart item clicked: " + id);
        }

        // Cart action callbacks
        clear-cart => {
            debug("Clear cart clicked");
            root.clear-cart();
        }

        apply-discount => {
            debug("Apply discount clicked");
        }

        remove-discount => {
            debug("Remove discount clicked");
        }

        select-customer => {
            debug("Select customer clicked");
            // TODO: Navigate to customer search screen
            // For now, customer selection handled via Rust callback
        }

        remove-customer => {
            debug("Remove customer clicked");
            root.has-customer = false;
            root.customer-name = "";
        }

        pay-clicked => {
            debug("Pay clicked - navigate to payment methods");
            current-screen = "payment-methods";
        }

        hold-clicked => {
            debug("Hold (save draft) clicked");
            // Reset save draft state and show dialog
            draft-name = "";
            draft-is-saving = false;
            show-save-draft-dialog = true;
        }

        recall-clicked => {
            debug("Recall draft clicked");
            recall-draft-search-query = "";
            current-screen = "recall-draft";
        }

        void-clicked => {
            debug("Void cart clicked");
            root.clear-cart();
        }

        // Phase 2 quick action callbacks
        void-last-item => {
            debug("Void last item clicked");
            root.void-last-item();
        }

        quantity-multiply => {
            debug("Quantity multiply clicked");
            root.quantity-multiply();
        }

        // Navigation callbacks
        menu-clicked => {
            debug("Menu clicked");
        }

        settings-clicked => {
            debug("Settings clicked");
            current-screen = "settings";
        }

        drafts-clicked => {
            debug("Drafts clicked");
            recall-draft-search-query = "";
            current-screen = "recall-draft";
        }

        transfer-clicked => {
            debug("Transfer clicked");
        }

        returns-clicked => {
            debug("Returns clicked - navigating to return entry");
            // Reset return state
            return-receipt-number = "";
            return-searching = false;
            return-receipt-found = false;
            return-error-message = "";
            current-screen = "return-entry";
        }

        end-shift-clicked => {
            debug("End shift clicked - navigating to end shift screen");
            // Load current shift data (would be done from Rust in production)
            // Reset end shift state
            end-shift-counted-cash = "0.000";
            end-shift-variance = "0.000";
            end-shift-variance-status = "balanced";
            end-shift-variance-note = "";
            end-shift-active-denom-index = -1;
            end-shift-keypad-value = "0";
            current-screen = "end-shift";
        }
    }

    // Product Search screen (Phase 19)
    if current-screen == "product-search": ProductSearchScreen {
        search-query: root.search-query;
        results: search-results;
        loading: search-loading;
        recent-searches: root.recent-searches;

        back-clicked => {
            debug("Back from search screen");
            search-query = "";
            search-results = [];
            current-screen = "checkout";
        }

        search-changed(query) => {
            debug("Search query changed: " + query);
            search-query = query;

            // Demo: Perform search if query is not empty
            // In production: This would call ProductService.search() with debounce
            if (query != "") {
                search-loading = true;

                // Demo: Return demo results matching query
                // In production: This would call ProductService.search()
                search-results = [
                    { id: "P001", name: "Coca-Cola 500ml", name_ar: "كوكا كولا 500مل", sku: "SKU-001", barcode: "5449000000996", price: "1.500", stock: 45, unit: "pc", category: "Beverages", category_ar: "مشروبات", has_image: false, image_url: "", low_stock: false, out_of_stock: false },
                    { id: "P002", name: "Pepsi 500ml", name_ar: "بيبسي 500مل", sku: "SKU-002", barcode: "5449000000997", price: "1.500", stock: 38, unit: "pc", category: "Beverages", category_ar: "مشروبات", has_image: false, image_url: "", low_stock: false, out_of_stock: false },
                    { id: "P003", name: "Fresh Milk 1L", name_ar: "حليب طازج 1 لتر", sku: "SKU-003", barcode: "5449000000998", price: "2.500", stock: 5, unit: "pc", category: "Dairy", category_ar: "ألبان", has_image: false, image_url: "", low_stock: true, out_of_stock: false },
                    { id: "P005", name: "Lays Chips Classic", name_ar: "شيبس ليز كلاسيك", sku: "SKU-005", barcode: "5449000001000", price: "2.000", stock: 0, unit: "pc", category: "Snacks", category_ar: "وجبات خفيفة", has_image: false, image_url: "", low_stock: false, out_of_stock: true },
                ];
                search-loading = false;
            } else {
                search-results = [];
            }
        }

        product-selected(id) => {
            debug("Product selected from search: " + id);
            // Navigate back to checkout and add to cart
            // In production: Call CartService.add_item(id)
            current-screen = "checkout";
        }

        product-add-to-cart(id) => {
            debug("Add to cart from search: " + id);
            // In production: Call CartService.add_item(id) and stay on search
        }

        recent-search-clicked(query) => {
            debug("Recent search clicked: " + query);
            search-query = query;
            // Trigger search
        }

        clear-recent-searches => {
            debug("Clear recent searches");
            recent-searches = [];
        }

        barcode-scanned(barcode) => {
            debug("Barcode scanned: " + barcode);
