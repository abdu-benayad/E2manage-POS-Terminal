            // In production: Update the item's reason via Rust
            // This would trigger recalculation of can-proceed
            return-show-reason-picker = false;
            return-selected-item-index = -1;

            // For demo: Check if we can proceed (all items with qty > 0 have reasons)
            // In production this is calculated in Rust after updating the item
        }

        close-reason-picker => {
            debug("Close reason picker");
            return-show-reason-picker = false;
            return-selected-item-index = -1;
        }

        proceed-to-refund => {
            debug("Proceed to refund - total: " + return-items-total);

            // Set up refund state from return items
            refund-amount = return-items-total;
            refund-original-payment-method = "cash";  // In production: get from original transaction
            refund-selected-method = "cash";          // Default to cash, or match original
            refund-status = "selecting";
            refund-error-message = "";
            refund-receipt-number = "";

            // Navigate to refund screen
            current-screen = "refund";
        }

        back-clicked => {
            debug("Back from return items");
            // Clear items selection but keep receipt info
            return-items = [];
            return-subtotal = "0.000";
            return-tax = "0.000";
            return-items-total = "0.000";
            return-can-proceed = false;
            current-screen = "return-entry";
        }
    }

    // Refund Screen (Phase 32)
    if current-screen == "refund": RefundScreen {
        refund-amount: root.refund-amount;
        currency: CartState.currency;
        original-payment-method: root.refund-original-payment-method;
        selected-refund-method: root.refund-selected-method;
        status: root.refund-status;
        error-message: root.refund-error-message;
        return-receipt-number: root.refund-receipt-number;
        wallet-type: root.refund-wallet-type;
        is-online: AppState.is-online;

        method-selected(method) => {
            debug("Refund method selected: " + method);
            refund-selected-method = method;
        }

        process-refund => {
            debug("Processing refund: " + refund-amount + " via " + refund-selected-method);
            refund-status = "processing";

            // In production: Call RefundService to process the refund
            // For demo: Simulate a successful refund after a brief delay
            // The Rust backend would handle the actual processing and update status

            // Demo: Immediate success (in production, this would be async)
            refund-status = "completed";
            refund-receipt-number = "RTN-T001-" + "2024121201";  // Generated receipt number
        }

        print-receipt => {
            debug("Print refund receipt: " + refund-receipt-number);
            // In production: Call PrintService.print_return_receipt()
        }

        done => {
            debug("Refund complete, returning to checkout");

            // Reset all return and refund state
            return-items = [];
            return-subtotal = "0.000";
            return-tax = "0.000";
            return-items-total = "0.000";
            return-can-proceed = false;
            return-receipt-number = "";
            return-receipt-found = false;
            return-error-message = "";

            refund-amount = "0.000";
            refund-status = "selecting";
            refund-error-message = "";
            refund-receipt-number = "";

            current-screen = "checkout";
        }

        back-clicked => {
            debug("Back from refund to return items");
            // Reset refund state but keep return items selected
            refund-status = "selecting";
            refund-error-message = "";
            current-screen = "return-items";
        }
    }

    // End Shift Screen (Phase 33)
    if current-screen == "end-shift": EndShiftScreen {
        shift-number: end-shift-number;
        operator-name: selected-operator-name != "" ? selected-operator-name : (Layout.rtl ? "أحمد محمد" : "Ahmed Mohamed");
        expected-cash: end-shift-expected-cash;
        opening-float: end-shift-opening-float;
        cash-sales: end-shift-cash-sales;
        counted-cash: end-shift-counted-cash;
        variance: end-shift-variance;
        variance-status: end-shift-variance-status;
        variance-note <=> end-shift-variance-note;
        transaction-count: end-shift-transaction-count;
        loading <=> end-shift-loading;
        active-denomination-index <=> end-shift-active-denom-index;
        keypad-value <=> end-shift-keypad-value;
        denominations: end-shift-denominations;
        currency: CartState.currency;

        denomination-changed(index, count) => {
            debug("Denomination " + index + " changed to count: " + count);
            // In production: Update denomination count and recalculate totals
            // Demo: Simulate count update
            // The actual calculation would be done in Rust via ShiftService
        }

        close-shift(counted, variance, note) => {
            debug("Close shift requested - counted: " + counted + ", variance: " + variance + ", note: " + note);
            // In production:
            // 1. Call ShiftService.close_shift() from Rust
            // 2. On success: show X-Report or Z-Report, navigate to login
            // 3. On error: show error message

            // Demo: Simulate successful close
            debug("Shift closed successfully!");
            end-shift-loading = false;

            // Reset shift state
            end-shift-counted-cash = "0.000";
            end-shift-variance = "0.000";
            end-shift-variance-status = "balanced";
            end-shift-variance-note = "";
            end-shift-active-denom-index = -1;

            // Return to login (operator logged out)
            AppState.current-user = "";
            AppState.shift-active = false;
            current-screen = "login";
        }

        save-draft => {
            debug("Save cash count draft requested");
            // In production: Save current cash count state to local storage
            // For resuming later if operator needs to step away
        }

        back-clicked => {
            debug("Back from end shift to checkout");
            // Reset any in-progress cash count
            end-shift-active-denom-index = -1;
            end-shift-keypad-value = "0";
            current-screen = "checkout";
        }

        print-x-report => {
            debug("Print X-Report requested");
            // Populate X-Report data from current shift data
            x-report-shift-number = end-shift-number;
            x-report-operator-name = selected-operator-name != "" ? selected-operator-name : (Layout.rtl ? "أحمد محمد" : "Ahmed Mohamed");
            x-report-terminal-id = AppState.terminal-code;
            x-report-current-time = AppState.current-time;
            x-report-transaction-count = end-shift-transaction-count;
            x-report-opening-float = end-shift-opening-float;
            x-report-expected-cash = end-shift-expected-cash;
            x-report-cash-received = end-shift-cash-sales;
            // Navigate to X-Report screen
            current-screen = "x-report";
        }
    }

    // X-Report Screen (Phase 34)
    if current-screen == "x-report": XReportScreen {
        shift-number: x-report-shift-number;
        operator-name: x-report-operator-name;
        terminal-id: x-report-terminal-id;
        shift-start: x-report-shift-start;
        current-time: x-report-current-time;
        currency: CartState.currency;
        transaction-count: x-report-transaction-count;
        gross-sales: x-report-gross-sales;
        discounts: x-report-discounts;
        returns: x-report-returns;
        net-sales: x-report-net-sales;
        tax-collected: x-report-tax-collected;
        tax-rate: x-report-tax-rate;
        cash-total: x-report-cash-total;
        card-total: x-report-card-total;
        wallet-total: x-report-wallet-total;
        credit-total: x-report-credit-total;
        cash-count: x-report-cash-count;
        card-count: x-report-card-count;
        wallet-count: x-report-wallet-count;
        credit-count: x-report-credit-count;
        opening-float: x-report-opening-float;
        cash-received: x-report-cash-received;
        cash-refunded: x-report-cash-refunded;
        expected-cash: x-report-expected-cash;
        return-count: x-report-return-count;
        return-total: x-report-return-total;
        void-count: x-report-void-count;
        void-total: x-report-void-total;
        is-printing: x-report-is-printing;

        print-report => {
            debug("Print X-Report requested from X-Report screen");
            x-report-is-printing = true;
            // In production:
            // 1. Call PrintService.print_x_report() from Rust
            // 2. On success: show success toast, reset is-printing
            // 3. On error: show error message, reset is-printing

            // Demo: Simulate print completion after short delay
            // In Rust integration, this would be triggered by callback
            debug("X-Report printed successfully!");
            x-report-is-printing = false;
        }

        back-clicked => {
            debug("Back from X-Report to End Shift");
            current-screen = "end-shift";
        }
    }

    // Z-Report Screen (Phase 35) - End of Day
    if current-screen == "z-report": ZReportScreen {
        report-date: z-report-date;
        report-number: z-report-number;
        terminal-id: z-report-terminal-id;
        currency: CartState.currency;
        total-shifts: z-report-total-shifts;
        total-transactions: z-report-total-transactions;
        gross-sales: z-report-gross-sales;
        discounts: z-report-discounts;
        returns: z-report-returns;
        net-sales: z-report-net-sales;
        tax-collected: z-report-tax-collected;
        tax-rate: z-report-tax-rate;
        cash-total: z-report-cash-total;
        card-total: z-report-card-total;
        wallet-total: z-report-wallet-total;
        credit-total: z-report-credit-total;
        cash-count: z-report-cash-count;
        card-count: z-report-card-count;
        wallet-count: z-report-wallet-count;
        credit-count: z-report-credit-count;
        opening-float: z-report-opening-float;
        total-cash-in: z-report-total-cash-in;
        total-cash-out: z-report-total-cash-out;
        expected-cash: z-report-expected-cash;
        actual-cash: z-report-actual-cash;
        variance: z-report-variance;
        variance-status: z-report-variance-status;
        return-count: z-report-return-count;
        return-total: z-report-return-total;
        void-count: z-report-void-count;
        void-total: z-report-void-total;
        can-close: z-report-can-close;
        status: z-report-status;
        is-printing: z-report-is-printing;

        print-report => {
            debug("Print Z-Report requested");
            z-report-is-printing = true;
            // In production:
            // 1. Call PrintService.print_z_report() from Rust
            // 2. On success: show success toast, reset is-printing
            // 3. On error: show error message, reset is-printing
            debug("Z-Report printed successfully!");
            z-report-is-printing = false;
        }

        close-day => {
            debug("Close Day requested - generating Z-Report");
            z-report-status = "closing";
            // In production:
            // 1. Call ZReportService.close_day() from Rust
            // 2. On success: transition to "closed" status
            // 3. On error: show error message, revert to "preview"
            // Demo: Simulate close completion
            z-report-status = "closed";
        }

        back-clicked => {
            debug("Back from Z-Report to Checkout");
            current-screen = "checkout";
        }
    }

    // Settings Router (Phase 36-42) - All settings screens consolidated
    if current-screen == "settings": SettingsRouter {
        available-printers: printer-available-printers;

        exit-settings => {
            debug("Exit settings");
            SettingsState.current-screen = "home"; // Reset to home for next time
            current-screen = "checkout";
        }

        sync-now-requested => {
            debug("Sync now requested from settings");
            // Show dialog and trigger sync
            show-sync-dialog = true;
            sync-dialog-in-progress = true;
            sync-dialog-status = "جاري المزامنة...";
            sync-dialog-progress = 0.0;
            root.sync-now();
        }

        full-sync-requested => {
            debug("Full sync requested from settings");
            // Show dialog and trigger full sync
            show-sync-dialog = true;
            sync-dialog-in-progress = true;
            sync-dialog-status = "جاري المزامنة الكاملة...";
            sync-dialog-progress = 0.0;
            root.full-sync();
        }
    }

    // Save Draft Dialog Overlay (Phase 28)
    // Shown as modal overlay on checkout screen
    if show-save-draft-dialog: SaveDraftScreen {
        draft-name <=> root.draft-name;
        customer-name: root.customer-name;
        item-count: root.cart-items.length;
        total-amount: root.cart-total;
        currency: CartState.currency;
        draft-count: root.draft-count;
        is-saving: draft-is-saving;

        name-changed(name) => {
            debug("Draft name changed: " + name);
            draft-name = name;
        }

        save-draft => {
            debug("Save draft requested with name: " + draft-name);
            draft-is-saving = true;
            // Call Rust DraftService to save the cart
            // Rust will update UI state (draft-count, show-save-draft-dialog, etc.) on completion
            root.save-draft(draft-name, selected-operator-id, AppState.current-shift);
        }

        cancel => {
            debug("Save draft cancelled");
            show-save-draft-dialog = false;
            draft-name = "";
            draft-is-saving = false;
        }
    }

    // Shutdown Dialog Overlay
    ShutdownDialog {
        open: show-shutdown-dialog;
        close-app => { root.request-close-app(); }
        restart-app => { root.request-restart-app(); }
        restart-machine => { root.request-restart-machine(); }
        shutdown-machine => { root.request-shutdown-machine(); }
        cancelled => { show-shutdown-dialog = false; }
    }

    // Sync Summary Dialog Overlay
    SyncSummaryDialog {
        open: show-sync-dialog;
        sync-in-progress: sync-dialog-in-progress;
        sync-progress: sync-dialog-progress;
        sync-status: sync-dialog-status;
        sync-success: sync-dialog-success;
        error-message: sync-dialog-error;
        products-synced: sync-products-count;
        categories-synced: sync-categories-count;
        operators-synced: sync-operators-count;
        offline-synced: sync-offline-synced;
        offline-failed: sync-offline-failed;
        catalog-not-modified: sync-catalog-not-modified;
        operators-not-modified: sync-operators-not-modified;
        dismissed => {
            show-sync-dialog = false;
            // Reset state
            sync-dialog-in-progress = false;
            sync-dialog-progress = 0.0;
            sync-dialog-status = "";
        }
    }
}
