            if (cash-amount-tendered == "0" && key != ".") {
                cash-amount-tendered = key;
            } else {
                cash-amount-tendered = cash-amount-tendered + key;
            }

            // Demo change calculation (simplified)
            // In production: This would be handled by Rust with proper decimal math
            // For demo: compare as simple numbers
            // Assume total is 7.675 - if tendered >= 8, show change
            if (cash-amount-tendered == "8" || cash-amount-tendered == "10" || cash-amount-tendered == "20" ||
                cash-amount-tendered == "50" || cash-amount-tendered == "100" || cash-amount-tendered == "200") {
                cash-is-sufficient = true;
                // Demo change values
                if (cash-amount-tendered == "8") { cash-change-due = "0.325"; }
                if (cash-amount-tendered == "10") { cash-change-due = "2.325"; }
                if (cash-amount-tendered == "20") { cash-change-due = "12.325"; }
                if (cash-amount-tendered == "50") { cash-change-due = "42.325"; }
                if (cash-amount-tendered == "100") { cash-change-due = "92.325"; }
                if (cash-amount-tendered == "200") { cash-change-due = "192.325"; }
            } else {
                // Simple check for numeric comparison
                // This is a demo approximation
                cash-is-sufficient = false;
                cash-change-due = "0.000";
            }
        }

        keypad-backspace => {
            debug("Cash keypad backspace");
            // Remove last character
            // In Slint, we need Rust help for this. For demo, just reset
            if (cash-amount-tendered.character-count <= 1) {
                cash-amount-tendered = "0";
            }
            // Note: Proper backspace requires Rust string manipulation
            cash-is-sufficient = false;
            cash-change-due = "0.000";
        }

        keypad-clear => {
            debug("Cash keypad clear");
            cash-amount-tendered = "0";
            cash-is-sufficient = false;
            cash-change-due = "0.000";
        }

