// ============================================================================
// E2Manage POS Terminal - Main Window
// ============================================================================
// Entry point for the Slint UI
// Imports theme and renders the current screen
// ============================================================================

import { Button as StdButton, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";
// Bundled fonts — the .ttf imports inside fonts.slint cause the compiler
// to embed and register them at runtime. Must be imported before anything
// that references the font families.
import { Fonts } from "tokens/fonts.slint";
import { Colors, Typography, Spacing, Sizes, Radius, Animation, Layout, Locale, AppState, CartState, SettingsState, Responsive } from "theme.slint";
import { Button, SmallButton, IconButton, LargeButton, QuickAmountButton } from "components/mod.slint";
import { TextInput, SearchInput, AmountInput, PinInput, SelectInput } from "components/mod.slint";
import { Card, CardHeader, CardContent, CardFooter } from "components/mod.slint";
import { ListItem, ListSectionHeader, SelectableListItem } from "components/mod.slint";
import { Dialog, AlertDialog, LoadingDialog, ShutdownDialog, SyncSummaryDialog } from "components/mod.slint";
import { Badge, Chip, StatusDot, Tag, CountBadge, PriceTag } from "components/mod.slint";
// Phase 4 components
import { StatusBar, CompactStatusBar } from "components/mod.slint";
import { Header, PageHeader, SimpleHeader } from "components/mod.slint";
import { ProgressBar, CircularProgress, LabeledProgress, StepProgress } from "components/mod.slint";
// Phase 5 components
import { NumericKeypad, CompactKeypad } from "components/mod.slint";
import { PinDisplay, AmountDisplay, ChangeDisplay, TotalDisplay } from "components/mod.slint";
// Phase 6-9 screens + Setup screen
import { SplashScreen, SetupScreen, LoginSelectScreen, Operator, PinEntryScreen, StartShiftScreen } from "screens/mod.slint";
// Phase 14 - Checkout screen
import { MainCheckoutScreen } from "screens/mod.slint";
// Phase 19 - Product Search screen
import { ProductSearchScreen, ProductSearchResult, RecentSearchItem } from "screens/mod.slint";
// Phase 20 - Payment Methods screen
import { PaymentMethodsScreen } from "screens/mod.slint";
// Phase 21 - Cash Payment screen
import { CashPaymentScreen } from "screens/mod.slint";
// Phase 22 - Card Payment screen
import { CardPaymentScreen } from "screens/mod.slint";
// Phase 23 - Split Payment screen
import { SplitPaymentScreen, SplitPaymentEntry } from "screens/mod.slint";
// Phase 24 - QR/Wallet Payment screen
import { QrPaymentScreen, WalletProvider } from "screens/mod.slint";
// Phase 26 - Receipt screen
import { ReceiptScreen, ReceiptItem, ReceiptPayment } from "screens/mod.slint";
// Phase 28 - Save Draft screen
import { SaveDraftScreen, DraftData } from "screens/mod.slint";
// Phase 29 - Recall Draft screen
import { RecallDraftScreen, DraftItem } from "screens/mod.slint";
// Phase 30 - Return Entry screen
import { ReturnEntryScreen, ReturnEntryData } from "screens/mod.slint";
// Phase 31 - Return Items screen
import { ReturnItemsScreen, ReturnableItem, ReturnReason } from "screens/mod.slint";
// Phase 32 - Refund Process screen
import { RefundScreen } from "screens/mod.slint";
// Phase 33 - End Shift screen
import { EndShiftScreen, Denomination } from "screens/mod.slint";
// Phase 34 - X-Report screen
import { XReportScreen } from "screens/mod.slint";
// Phase 35 - Z-Report screen
import { ZReportScreen } from "screens/mod.slint";
// Settings Router (Phase 36-42) - consolidates all settings screens
import { SettingsRouter } from "screens/mod.slint";
import { PrinterDevice } from "screens/mod.slint"; // For type reference if needed
// Dev-only theme harness — wired into the binary behind `--theme-harness` (Task 9).
// ThemeHarnessWindow is the runnable Window wrapper; ThemeHarness itself is a
// Rectangle and would not produce Rust bindings on its own.
export { ThemeHarnessWindow } from "screens/dev/mod.slint";
// Phase 15 - Category components
import { CategoryData } from "components/mod.slint";
// Phase 16 - Product components
import { ProductData } from "components/mod.slint";
// Phase 17 - Cart components
import { CartItemData } from "components/mod.slint";

// ============================================================================
// Note: MainCheckout placeholder removed - now using MainCheckoutScreen from Phase 14
// ============================================================================

// ============================================================================
// COMPONENT TEST SCREEN
// ============================================================================

component ComponentTestScreen inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in-out property <bool> show-alert: false;
    in-out property <bool> show-loading: false;
    in-out property <int> selected-list-item: -1;
    in-out property <bool> chip-selected: false;

    background: Colors.background;

    ScrollView {
        VerticalLayout {
            alignment: start;
            spacing: Spacing.xl;
            padding: Spacing.xxl;

            // Title
            Text {
                text: "Component Test - Phase 5 (NumericKeypad & PIN Display)";
                font-size: Typography.title;
                font-weight: Typography.bold;
                color: Colors.text-primary;
                horizontal-alignment: center;
            }

            // Section: Button Variants
            Rectangle {
                background: Colors.surface;
                border-radius: Radius.card;
                border-width: 1px;
                border-color: Colors.border;

                VerticalLayout {
                    padding: Spacing.lg;
                    spacing: Spacing.lg;

                    Text {
                        text: "Button Variants";
                        font-size: Typography.heading;
                        font-weight: Typography.semi-bold;
                        color: Colors.text-primary;
                    }

                    HorizontalLayout {
                        spacing: Spacing.md;
                        alignment: start;

                        Button { text: "Primary"; variant: "primary"; clicked => { debug("Primary clicked"); } }
                        Button { text: "Secondary"; variant: "secondary"; clicked => { debug("Secondary clicked"); } }
                        Button { text: "Danger"; variant: "danger"; clicked => { debug("Danger clicked"); } }
                        Button { text: "Warning"; variant: "warning"; clicked => { debug("Warning clicked"); } }
                        Button { text: "Ghost"; variant: "ghost"; clicked => { debug("Ghost clicked"); } }
                    }

                    HorizontalLayout {
                        spacing: Spacing.md;
                        alignment: start;

                        Button { text: "Disabled"; variant: "primary"; disabled: true; }
                        Button { text: "Loading..."; variant: "primary"; loading: true; }
                    }
                }
            }

            // Section: Small Buttons
            Rectangle {
                background: Colors.surface;
                border-radius: Radius.card;
                border-width: 1px;
                border-color: Colors.border;

                VerticalLayout {
                    padding: Spacing.lg;
                    spacing: Spacing.lg;

                    Text {
                        text: "Small Buttons";
                        font-size: Typography.heading;
                        font-weight: Typography.semi-bold;
                        color: Colors.text-primary;
                    }

                    HorizontalLayout {
                        spacing: Spacing.md;
                        alignment: start;

                        SmallButton { text: "Primary"; variant: "primary"; }
                        SmallButton { text: "Secondary"; variant: "secondary"; }
                        SmallButton { text: "Danger"; variant: "danger"; }
                        SmallButton { text: "Disabled"; disabled: true; }
                    }
                }
            }

            // Section: Icon Buttons
            Rectangle {
                background: Colors.surface;
                border-radius: Radius.card;
                border-width: 1px;
                border-color: Colors.border;

                VerticalLayout {
                    padding: Spacing.lg;
                    spacing: Spacing.lg;

                    Text {
                        text: "Icon Buttons";
                        font-size: Typography.heading;
                        font-weight: Typography.semi-bold;
                        color: Colors.text-primary;
                    }

                    HorizontalLayout {
                        spacing: Spacing.md;
                        alignment: start;

                        IconButton { icon-text: "\u{2630}"; variant: "ghost"; } // Menu
                        IconButton { icon-text: "\u{2715}"; variant: "ghost"; } // Close
                        IconButton { icon-text: "\u{2713}"; variant: "primary"; } // Check
                        IconButton { icon-text: "\u{1F5D1}"; variant: "danger"; } // Trash
                        IconButton { icon-text: "\u{2699}"; variant: "ghost"; disabled: true; } // Settings (disabled)
                    }
                }
            }

            // Section: Large Buttons
            Rectangle {
                background: Colors.surface;
                border-radius: Radius.card;
                border-width: 1px;
                border-color: Colors.border;

                VerticalLayout {
                    padding: Spacing.lg;
                    spacing: Spacing.lg;

                    Text {
                        text: "Large Buttons";
                        font-size: Typography.heading;
                        font-weight: Typography.semi-bold;
                        color: Colors.text-primary;
                    }

                    HorizontalLayout {
                        spacing: Spacing.md;
                        alignment: start;

                        LargeButton { text: "Pay Now"; variant: "primary"; }
                        LargeButton { text: "Complete"; variant: "success"; }
                        LargeButton { text: "Cancel"; variant: "danger"; }
                    }
                }
            }

            // Section: Quick Amount Buttons
            Rectangle {
                background: Colors.surface;
                border-radius: Radius.card;
                border-width: 1px;
                border-color: Colors.border;

                VerticalLayout {
                    padding: Spacing.lg;
                    spacing: Spacing.lg;

                    Text {
                        text: "Quick Amount Buttons";
                        font-size: Typography.heading;
                        font-weight: Typography.semi-bold;
                        color: Colors.text-primary;
                    }

                    HorizontalLayout {
                        spacing: Spacing.md;
                        alignment: start;

                        QuickAmountButton { amount: "50"; currency: CartState.currency; }
                        QuickAmountButton { amount: "100"; currency: CartState.currency; selected: true; }
                        QuickAmountButton { amount: "200"; currency: CartState.currency; }
                        QuickAmountButton { amount: "500"; currency: CartState.currency; }
                    }
                }
            }

            // Section: Input Components
            Rectangle {
                background: Colors.surface;
                border-radius: Radius.card;
                border-width: 1px;
                border-color: Colors.border;

                VerticalLayout {
                    padding: Spacing.lg;
                    spacing: Spacing.lg;

                    Text {
                        text: "Input Components";
                        font-size: Typography.heading;
                        font-weight: Typography.semi-bold;
                        color: Colors.text-primary;
                    }

                    HorizontalLayout {
                        spacing: Spacing.lg;
                        alignment: start;

                        VerticalLayout {
                            spacing: Spacing.md;
                            max-width: 300px;

                            SearchInput { placeholder: "Search products..."; }

                            TextInput {
                                label: "Customer Name";
                                placeholder: "Enter name";
                            }

                            TextInput {
                                label: "Email (with error)";
                                placeholder: "Enter email";
                                error: true;
                                error-message: "Invalid email format";
                            }

                            TextInput {
                                label: "Disabled Input";
                                placeholder: "Cannot edit";
                                disabled: true;
                            }
                        }

                        VerticalLayout {
                            spacing: Spacing.md;
                            max-width: 300px;

                            SelectInput {
                                label: "Category";
                                placeholder: "Select category";
                            }

                            SelectInput {
                                label: "Payment Method";
                                value: "Cash";
                            }
                        }
                    }
                }
            }

            // Section: Amount & PIN Inputs
            Rectangle {
                background: Colors.surface;
                border-radius: Radius.card;
                border-width: 1px;
                border-color: Colors.border;

                VerticalLayout {
                    padding: Spacing.lg;
                    spacing: Spacing.lg;

                    Text {
                        text: "Amount & PIN Inputs";
                        font-size: Typography.heading;
                        font-weight: Typography.semi-bold;
                        color: Colors.text-primary;
                    }

                    HorizontalLayout {
                        spacing: Spacing.xl;
                        alignment: start;

                        VerticalLayout {
                            spacing: Spacing.md;

                            Text {
                                text: "Amount Display";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                            }

                            AmountInput {
                                value: "125.500";
                                currency: CartState.currency;
                            }

                            AmountInput {
                                value: "0.000";
                                currency: CartState.currency;
                                large: true;
                            }
                        }

                        VerticalLayout {
                            spacing: Spacing.md;

                            Text {
                                text: "PIN Entry (0 filled)";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                            }
                            PinInput { length: 4; filled: 0; }

                            Text {
                                text: "PIN Entry (2 filled)";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                            }
                            PinInput { length: 4; filled: 2; }

                            Text {
                                text: "PIN Entry (error)";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                            }
                            PinInput { length: 4; filled: 4; error: true; }
                        }
                    }
                }
            }

            // Section: RTL Support
            Rectangle {
                background: Colors.surface;
                border-radius: Radius.card;
                border-width: 1px;
                border-color: Colors.border;

                VerticalLayout {
                    padding: Spacing.lg;
                    spacing: Spacing.lg;

                    Text {
                        text: Layout.rtl ? "دعم اللغة العربية (RTL)" : "RTL Support";
                        font-size: Typography.heading;
                        font-weight: Typography.semi-bold;
                        color: Colors.text-primary;
                        horizontal-alignment: Layout.rtl ? right : left;
                    }

                    HorizontalLayout {
                        spacing: Spacing.md;
                        alignment: Layout.rtl ? end : start;

                        Button {
                            text: Layout.rtl ? "تأكيد" : "Confirm";
                            variant: "primary";
                        }

                        Button {
                            text: Layout.rtl ? "إلغاء" : "Cancel";
                            variant: "secondary";
                        }
                    }

                    Text {
                        text: Layout.rtl ? "النص باللغة العربية يظهر بشكل صحيح من اليمين إلى اليسار" :
                                          "Arabic text displays correctly from right to left";
                        font-size: Typography.body;
                        color: Colors.text-secondary;
                        horizontal-alignment: Layout.rtl ? right : left;
                    }
                }
            }

            // ================================================================
            // PHASE 4 - STATUSBAR, HEADER & PROGRESS COMPONENTS
            // ================================================================

            // Spacer before Phase 4 section
            Rectangle {
                height: Spacing.xl;
            }

            Text {
                text: "Phase 4 - StatusBar, Header & Progress";
                font-size: Typography.heading;
                font-weight: Typography.bold;
                color: Colors.primary;
                horizontal-alignment: center;
            }

            // Section: StatusBar Components
            Card {
                title: "StatusBar Components";

                VerticalLayout {
                    spacing: Spacing.lg;
                    padding: Spacing.lg;

                    Text {
                        text: "Default StatusBar";
                        font-size: Typography.caption;
                        color: Colors.text-secondary;
                    }

                    StatusBar {
                        terminal-code: "POS-001";
                        version: "v1.0.0";
                        is-online: true;
                        pending-sync-count: 0;
                    }

                    Text {
                        text: "StatusBar (Offline with pending)";
                        font-size: Typography.caption;
                        color: Colors.text-secondary;
                    }

                    StatusBar {
                        terminal-code: "POS-002";
                        version: "v1.0.0";
                        is-online: false;
                        pending-sync-count: 5;
                    }

                    Text {
                        text: "Compact StatusBar";
                        font-size: Typography.caption;
                        color: Colors.text-secondary;
                    }

                    CompactStatusBar {
                        is-online: true;
                        pending-sync-count: 0;
                    }
                }
            }

            // Section: Header Components
            Card {
                title: "Header Components";

                VerticalLayout {
                    spacing: Spacing.lg;
                    padding: Spacing.lg;

                    Text {
                        text: "Main Header (with operator)";
                        font-size: Typography.caption;
                        color: Colors.text-secondary;
                    }

                    Header {
                        terminal-code: "POS-001";
                        operator-name: Layout.rtl ? "أحمد محمد" : "Ahmed Mohamed";
                        shift-number: "1";
                        is-online: true;
                        current-time: "10:30";
                        menu-clicked => { debug("Menu clicked"); }
                        settings-clicked => { debug("Settings clicked"); }
                    }

                    Text {
                        text: "Header (no operator)";
                        font-size: Typography.caption;
                        color: Colors.text-secondary;
                    }

                    Header {
                        terminal-code: "POS-001";
                        is-online: false;
                        current-time: "14:45";
                        menu-clicked => { debug("Menu clicked"); }
                        settings-clicked => { debug("Settings clicked"); }
                    }

                    Text {
                        text: "Page Header (with back button)";
                        font-size: Typography.caption;
                        color: Colors.text-secondary;
                    }

                    PageHeader {
                        title: Layout.rtl ? "الإعدادات" : "Settings";
                        subtitle: Layout.rtl ? "إعدادات الجهاز" : "Terminal Configuration";
                        action-text: Layout.rtl ? "حفظ" : "Save";
                        back-clicked => { debug("Back clicked"); }
                        action-clicked => { debug("Save clicked"); }
                    }

                    Text {
                        text: "Simple Header (for dialogs)";
                        font-size: Typography.caption;
                        color: Colors.text-secondary;
                    }

                    SimpleHeader {
                        title: Layout.rtl ? "تفاصيل المنتج" : "Product Details";
                        close-clicked => { debug("Close clicked"); }
                    }
                }
            }

            // Section: Progress Indicators
            Card {
                title: "Progress Indicators";

                CardContent {
                    VerticalLayout {
                        spacing: Spacing.xl;

                        // Progress Bars
                        VerticalLayout {
                            spacing: Spacing.md;

                            Text {
                                text: "Progress Bars";
                                font-size: Typography.subheading;
                                font-weight: 600;
                                color: Colors.text-primary;
                            }

                            HorizontalLayout {
                                spacing: Spacing.lg;

                                VerticalLayout {
                                    spacing: Spacing.sm;

                                    Text { text: "Default (50%)"; font-size: Typography.small; color: Colors.text-secondary; }
                                    ProgressBar { progress: 0.5; }

                                    Text { text: "Success (75%)"; font-size: Typography.small; color: Colors.text-secondary; }
                                    ProgressBar { progress: 0.75; variant: "success"; }

                                    Text { text: "Warning (30%)"; font-size: Typography.small; color: Colors.text-secondary; }
                                    ProgressBar { progress: 0.3; variant: "warning"; }

                                    Text { text: "Danger (90%)"; font-size: Typography.small; color: Colors.text-secondary; }
                                    ProgressBar { progress: 0.9; variant: "danger"; }
                                }

                                VerticalLayout {
                                    spacing: Spacing.sm;

                                    Text { text: "Small size"; font-size: Typography.small; color: Colors.text-secondary; }
                                    ProgressBar { progress: 0.6; size: "small"; }

                                    Text { text: "Medium size (default)"; font-size: Typography.small; color: Colors.text-secondary; }
                                    ProgressBar { progress: 0.6; size: "medium"; }

                                    Text { text: "Large size"; font-size: Typography.small; color: Colors.text-secondary; }
                                    ProgressBar { progress: 0.6; size: "large"; }
                                }
                            }
                        }

                        // Labeled Progress
                        VerticalLayout {
                            spacing: Spacing.md;

                            Text {
                                text: "Labeled Progress";
                                font-size: Typography.subheading;
                                font-weight: 600;
                                color: Colors.text-primary;
                            }

                            LabeledProgress {
                                label: Layout.rtl ? "جارٍ المزامنة..." : "Syncing products...";
                                progress: 0.65;
                                width: 300px;
                            }

                            LabeledProgress {
                                label: Layout.rtl ? "تحميل البيانات" : "Loading data";
                                progress: 0.9;
                                variant: "success";
                                width: 300px;
                            }
                        }

                        // Circular Progress
                        HorizontalLayout {
                            spacing: Spacing.xl;
                            alignment: start;

                            VerticalLayout {
                                spacing: Spacing.sm;
                                alignment: center;

                                Text {
                                    text: "Circular Progress";
                                    font-size: Typography.subheading;
                                    font-weight: 600;
                                    color: Colors.text-primary;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.lg;

                                    CircularProgress { progress: 0.25; circle-size: 60px; }
                                    CircularProgress { progress: 0.5; circle-size: 60px; variant: "success"; }
                                    CircularProgress { progress: 0.75; circle-size: 60px; variant: "warning"; }
                                    CircularProgress { indeterminate: true; circle-size: 60px; }
                                }
                            }
                        }

                        // Step Progress
                        VerticalLayout {
                            spacing: Spacing.md;

                            Text {
                                text: "Step Progress";
                                font-size: Typography.subheading;
                                font-weight: 600;
                                color: Colors.text-primary;
                            }

                            StepProgress {
                                current-step: 2;
                                total-steps: 4;
                            }

                            StepProgress {
                                current-step: 3;
                                total-steps: 5;
                                show-numbers: false;
                            }
                        }
                    }
                }
            }

            // ================================================================
            // PHASE 5 - NUMERIC KEYPAD & PIN DISPLAY
            // ================================================================

            // Spacer before Phase 5 section
            Rectangle {
                height: Spacing.xl;
            }

            Text {
                text: "Phase 5 - NumericKeypad & PIN Display";
                font-size: Typography.heading;
                font-weight: Typography.bold;
                color: Colors.primary;
                horizontal-alignment: center;
            }

            // Section: NumericKeypad Components
            Card {
                title: "NumericKeypad Components";

                CardContent {
                    HorizontalLayout {
                        spacing: Spacing.xxl;
                        alignment: start;

                        // PIN Mode Keypad
                        VerticalLayout {
                            spacing: Spacing.md;
                            alignment: center;

                            Text {
                                text: "PIN Mode (4 digits)";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                                horizontal-alignment: center;
                            }

                            NumericKeypad {
                                mode: "pin";
                                max-length: 4;
                                confirm-label: Layout.rtl ? "تأكيد" : "OK";
                                key-pressed(key) => { debug("PIN key: " + key); }
                                confirmed(val) => { debug("PIN confirmed: " + val); }
                                backspace => { debug("PIN backspace"); }
                            }
                        }

                        // Amount Mode Keypad
                        VerticalLayout {
                            spacing: Spacing.md;
                            alignment: center;

                            Text {
                                text: "Amount Mode (with confirm)";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                                horizontal-alignment: center;
                            }

                            NumericKeypad {
                                mode: "amount";
                                max-length: 10;
                                show-decimal: false;
                                confirm-label: Layout.rtl ? "ادفع" : "Pay";
                                key-pressed(key) => { debug("Amount key: " + key); }
                                confirmed(val) => { debug("Amount confirmed: " + val); }
                                backspace => { debug("Amount backspace"); }
                            }
                        }

                        // Compact Keypad
                        VerticalLayout {
                            spacing: Spacing.md;
                            alignment: center;

                            Text {
                                text: "Compact Keypad (with Clear)";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                                horizontal-alignment: center;
                            }

                            CompactKeypad {
                                key-pressed(key) => { debug("Compact key: " + key); }
                                backspace => { debug("Compact backspace"); }
                                clear => { debug("Compact clear"); }
                            }
                        }
                    }
                }
            }

            // Section: PinDisplay Components
            Card {
                title: "PinDisplay Components";

                CardContent {
                    VerticalLayout {
                        spacing: Spacing.lg;

                        HorizontalLayout {
                            spacing: Spacing.xl;
                            alignment: start;

                            VerticalLayout {
                                spacing: Spacing.md;

                                Text {
                                    text: "Empty (0 filled)";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                                PinDisplay { length: 4; filled: 0; }
                            }

                            VerticalLayout {
                                spacing: Spacing.md;

                                Text {
                                    text: "Partial (2 filled)";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                                PinDisplay { length: 4; filled: 2; }
                            }

                            VerticalLayout {
                                spacing: Spacing.md;

                                Text {
                                    text: "Full (4 filled)";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                                PinDisplay { length: 4; filled: 4; }
                            }
                        }

                        HorizontalLayout {
                            spacing: Spacing.xl;
                            alignment: start;

                            VerticalLayout {
                                spacing: Spacing.md;

                                Text {
                                    text: "Error State";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                                PinDisplay {
                                    length: 4;
                                    filled: 4;
                                    error: true;
                                    error-message: Layout.rtl ? "رمز PIN خاطئ" : "Wrong PIN";
                                }
                            }

                            VerticalLayout {
                                spacing: Spacing.md;

                                Text {
                                    text: "Success State";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                                PinDisplay {
                                    length: 4;
                                    filled: 4;
                                    success: true;
                                }
                            }

                            VerticalLayout {
                                spacing: Spacing.md;

                                Text {
                                    text: "6-Digit PIN";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                                PinDisplay { length: 6; filled: 3; }
                            }
                        }

                        // With Label
                        HorizontalLayout {
                            alignment: center;

                            PinDisplay {
                                length: 4;
                                filled: 2;
                                label: Layout.rtl ? "أدخل رمز PIN" : "Enter PIN Code";
                            }
                        }
                    }
                }
            }

            // Section: AmountDisplay Components
            Card {
                title: "AmountDisplay & TotalDisplay";

                CardContent {
                    VerticalLayout {
                        spacing: Spacing.lg;

                        HorizontalLayout {
                            spacing: Spacing.lg;
                            alignment: start;

                            VerticalLayout {
                                spacing: Spacing.md;
                                width: 250px;

                                Text {
                                    text: "Default Amount";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                                AmountDisplay { value: "125.500"; currency: CartState.currency; }
                            }

                            VerticalLayout {
                                spacing: Spacing.md;
                                width: 250px;

                                Text {
                                    text: "Large Amount";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                                AmountDisplay { value: "1,250.000"; currency: CartState.currency; large: true; }
                            }

                            VerticalLayout {
                                spacing: Spacing.md;
                                width: 250px;

                                Text {
                                    text: "With Label";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                                AmountDisplay {
                                    label: Layout.rtl ? "المبلغ المدفوع" : "Amount Paid";
                                    value: "500.000";
                                    currency: CartState.currency;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: Spacing.lg;
                            alignment: start;

                            VerticalLayout {
                                spacing: Spacing.md;
                                width: 250px;

                                Text {
                                    text: "Error State";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                                AmountDisplay { value: "0.000"; currency: CartState.currency; error: true; }
                            }

                            VerticalLayout {
                                spacing: Spacing.md;
                                width: 250px;

                                Text {
                                    text: "Highlighted";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                                AmountDisplay { value: "350.750"; currency: CartState.currency; highlight: true; }
                            }
                        }

                        // ChangeDisplay
                        Text {
                            text: "Change Display";
                            font-size: Typography.subheading;
                            font-weight: 600;
                            color: Colors.text-primary;
                        }

                        HorizontalLayout {
                            spacing: Spacing.lg;
                            alignment: start;

                            ChangeDisplay {
                                width: 250px;
                                paid: "500.000";
                                total: "425.500";
                                change: "74.500";
                                currency: CartState.currency;
                                is-sufficient: true;
                            }

                            ChangeDisplay {
                                width: 250px;
                                paid: "300.000";
                                total: "425.500";
                                change: "125.500";
                                currency: CartState.currency;
                                is-sufficient: false;
                            }
                        }

                        // TotalDisplay
                        Text {
                            text: "Total Display";
                            font-size: Typography.subheading;
                            font-weight: 600;
                            color: Colors.text-primary;
                        }

                        HorizontalLayout {
                            spacing: Spacing.lg;
                            alignment: start;

                            TotalDisplay {
                                width: 300px;
                                subtotal: "380.000";
                                tax: "19.000";
                                discount: "0.000";
                                total: "399.000";
                                currency: CartState.currency;
                                show-breakdown: true;
                            }

                            TotalDisplay {
                                width: 300px;
                                subtotal: "250.000";
                                tax: "12.500";
                                discount: "25.000";
                                total: "237.500";
                                currency: CartState.currency;
                                show-breakdown: true;
                            }

                            TotalDisplay {
                                width: 200px;
                                total: "425.500";
                                currency: CartState.currency;
                                show-breakdown: false;
                            }
                        }
                    }
                }
            }

            // ================================================================
            // PHASE 3 - LAYOUT COMPONENTS
            // ================================================================

            // Spacer before Phase 3 section
            Rectangle {
                height: Spacing.xl;
            }

            Text {
                text: "Phase 3 - Layout Components";
                font-size: Typography.heading;
                font-weight: Typography.bold;
                color: Colors.primary;
                horizontal-alignment: center;
            }

            // Section: Card Components
            Card {
                title: "Card Component";
                subtitle: "With title and subtitle";

                CardContent {
                    VerticalLayout {
                        spacing: Spacing.md;

                        Text {
                            text: "This is a Card component with optional title header.";
                            font-size: Typography.body;
                            color: Colors.text-secondary;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: Spacing.md;

                            Card {
                                width: 200px;
                                height: 100px;
                                has-shadow: false;

                                CardContent {
                                    Text {
                                        text: "Nested card (no shadow)";
                                        font-size: Typography.caption;
                                        color: Colors.text-secondary;
                                    }
                                }
                            }

                            Card {
                                width: 200px;
                                height: 100px;
                                clickable: true;
                                clicked => { debug("Card clicked!"); }

                                CardContent {
                                    Text {
                                        text: "Clickable card";
                                        font-size: Typography.caption;
                                        color: Colors.text-secondary;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Section: List Item Components
            Card {
                title: "List Item Components";

                VerticalLayout {
                    ListSectionHeader {
                        title: "Section Header";
                        action-text: "See All";
                        action-clicked => { debug("See all clicked"); }
                    }

                    ListItem {
                        text: "Simple List Item";
                        clicked => { root.selected-list-item = 0; }
                        selected: root.selected-list-item == 0;
                    }

                    ListItem {
                        text: "Item with Subtitle";
                        subtitle: "This is a subtitle";
                        clicked => { root.selected-list-item = 1; }
                        selected: root.selected-list-item == 1;
                    }

                    ListItem {
                        text: "Item with Trailing Text";
                        trailing-text: CartState.currency + " 125.00";
                        clicked => { root.selected-list-item = 2; }
                        selected: root.selected-list-item == 2;
                    }

                    ListItem {
                        text: "Item with Chevron";
                        subtitle: "Navigate to details";
                        has-chevron: true;
                        clicked => { root.selected-list-item = 3; }
                        selected: root.selected-list-item == 3;
                    }

                    ListItem {
                        text: "Item with Leading Icon";
                        leading-icon: "\u{1F4E6}"; // Package emoji
                        leading-bg: Colors.primary-light;
                        subtitle: "Product category";
                        has-chevron: true;
                        clicked => { debug("Item clicked"); }
                    }

                    ListItem {
                        text: "Disabled Item";
                        subtitle: "This item is disabled";
                        disabled: true;
                        show-divider: false;
                    }
                }
            }

            // Section: Selectable List Items
            Card {
                title: "Selectable List Items";

                VerticalLayout {
                    SelectableListItem {
                        text: "Radio Option 1";
                        subtitle: "Single select mode";
                        selected: root.selected-list-item == 10;
                        multi-select: false;
                        clicked => { root.selected-list-item = 10; }
                    }

                    SelectableListItem {
                        text: "Radio Option 2";
                        selected: root.selected-list-item == 11;
                        multi-select: false;
                        clicked => { root.selected-list-item = 11; }
                    }

                    SelectableListItem {
                        text: "Checkbox Option";
                        subtitle: "Multi-select mode";
                        selected: root.chip-selected;
                        multi-select: true;
                        clicked => { root.chip-selected = !root.chip-selected; }
                        show-divider: false;
                    }
                }
            }

            // Section: Badge & Chip Components
            Card {
                title: "Badge & Chip Components";

                CardContent {
                    VerticalLayout {
                        spacing: Spacing.lg;

                        // Badges
                        HorizontalLayout {
                            spacing: Spacing.md;
                            alignment: start;

                            Text {
                                text: "Badges:";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                                vertical-alignment: center;
                            }

                            Badge { count: 5; variant: "primary"; }
                            Badge { count: 12; variant: "success"; }
                            Badge { count: 99; variant: "warning"; }
                            Badge { count: 150; variant: "danger"; }
                            Badge { text: "New"; variant: "primary"; }
                            Badge { dot-only: true; variant: "danger"; }
                        }

                        // Status Dots
                        HorizontalLayout {
                            spacing: Spacing.lg;
                            alignment: start;

                            Text {
                                text: "Status:";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                                vertical-alignment: center;
                            }

                            HorizontalLayout {
                                spacing: Spacing.xs;
                                StatusDot { status: "online"; }
                                Text { text: "Online"; font-size: Typography.small; color: Colors.text-secondary; vertical-alignment: center; }
                            }

                            HorizontalLayout {
                                spacing: Spacing.xs;
                                StatusDot { status: "offline"; }
                                Text { text: "Offline"; font-size: Typography.small; color: Colors.text-secondary; vertical-alignment: center; }
                            }

                            HorizontalLayout {
                                spacing: Spacing.xs;
                                StatusDot { status: "busy"; }
                                Text { text: "Busy"; font-size: Typography.small; color: Colors.text-secondary; vertical-alignment: center; }
                            }

                            HorizontalLayout {
                                spacing: Spacing.xs;
                                StatusDot { status: "away"; }
                                Text { text: "Away"; font-size: Typography.small; color: Colors.text-secondary; vertical-alignment: center; }
                            }
                        }

                        // Chips
                        HorizontalLayout {
                            spacing: Spacing.md;
                            alignment: start;

                            Text {
                                text: "Chips:";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                                vertical-alignment: center;
                            }

                            Chip {
                                text: "Selectable";
                                selected: root.chip-selected;
                                clicked => { root.chip-selected = !root.chip-selected; }
                            }

                            Chip { text: "Success"; variant: "success"; }
                            Chip { text: "Warning"; variant: "warning"; }
                            Chip { text: "Danger"; variant: "danger"; }

                            Chip {
                                text: "Closable";
                                closable: true;
                                closed => { debug("Chip closed"); }
                            }
                        }

                        // Tags
                        HorizontalLayout {
                            spacing: Spacing.md;
                            alignment: start;

                            Text {
                                text: "Tags:";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                                vertical-alignment: center;
                            }

                            Tag { text: "Neutral"; variant: "neutral"; }
                            Tag { text: "Primary"; variant: "primary"; }
                            Tag { text: "Success"; variant: "success"; icon: "\u{2713}"; }
                            Tag { text: "Warning"; variant: "warning"; }
                            Tag { text: "Danger"; variant: "danger"; }
                            Tag { text: "Outlined"; variant: "primary"; outlined: true; }
                        }

                        // Price Tags
                        HorizontalLayout {
                            spacing: Spacing.md;
                            alignment: start;

                            Text {
                                text: "Prices:";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                                vertical-alignment: center;
                            }

                            PriceTag { price: "125.500"; currency: CartState.currency; }
                            PriceTag { price: "99.990"; currency: CartState.currency; variant: "sale"; }
                            PriceTag { price: "49.990"; currency: CartState.currency; variant: "discount"; }
                            PriceTag { price: "250.000"; currency: CartState.currency; large: true; }
                        }
                    }
                }
            }

            // Section: Dialog Components
            Card {
                title: "Dialog Components";

                CardContent {
                    HorizontalLayout {
                        spacing: Spacing.md;

                        Button {
                            text: "Show Confirm Dialog";
                            variant: "primary";
                            clicked => { root.show-dialog = true; }
                        }

                        Button {
                            text: "Show Alert";
                            variant: "secondary";
                            clicked => { root.show-alert = true; }
                        }

                        Button {
                            text: "Show Loading";
                            variant: "secondary";
                            clicked => { root.show-loading = true; }
                        }
                    }
                }
            }

            // Bottom padding
            Rectangle {
                height: Spacing.xxl;
            }
        }
    }

    // Dialog overlays (must be outside ScrollView to cover full screen)
    Dialog {
        open <=> root.show-dialog;
        title: "Confirm Action";
        message: "Are you sure you want to perform this action?";
        variant: "default";
        confirmed => { debug("Dialog confirmed"); }
        cancelled => { debug("Dialog cancelled"); }
    }

    AlertDialog {
        open <=> root.show-alert;
        title: "Success!";
        message: "Operation completed successfully.";
        variant: "success";
        dismissed => { debug("Alert dismissed"); }
    }

    LoadingDialog {
        open <=> root.show-loading;
        message: "Processing...";
        can-cancel: true;
        cancelled => { root.show-loading = false; debug("Loading cancelled"); }
    }
}

// ============================================================================
// MAIN WINDOW
// ============================================================================

export component MainWindow inherits Window {
    title: "E2Manage POS Terminal";
    min-width: 768px;
    min-height: 600px;
    preferred-width: 1024px;
    preferred-height: 768px;
    background: Colors.background;

    // Track viewport dimensions for responsive layout
    property <length> viewport-w: self.width;
    property <length> viewport-h: self.height;

    // Update Responsive global when window size changes
    changed viewport-w => { Responsive.viewport-width = self.width; }
    changed viewport-h => { Responsive.viewport-height = self.height; }

    // Locale + RTL forwarding (Plan 2 Task 1) — Rust sets these once at
    // startup based on LC_ALL / LANG so the whole component tree picks up
    // the correct direction and locale before first paint.
    in-out property <bool> rtl <=> Layout.rtl;
    in-out property <string> locale <=> Locale.current;

    // AppState bindings (for setting from Rust)
    in-out property <string> app-company-name <=> AppState.company-name;
    in-out property <string> app-terminal-code <=> AppState.terminal-code;
    in-out property <string> app-current-time <=> AppState.current-time;
    in-out property <string> app-current-user <=> AppState.current-user;
    in-out property <bool> app-is-online <=> AppState.is-online;
    in-out property <int> app-pending-sync-count <=> AppState.pending-sync-count;

    // Currency & tax config (set from Rust on startup)
    in-out property <string> app-currency <=> AppState.currency;
    in-out property <int> app-currency-decimals <=> AppState.currency-decimals;
    in-out property <string> app-zero-amount <=> AppState.zero-amount;
    in-out property <float> app-tax-rate-value <=> AppState.tax-rate-value;
    in-out property <string> app-tax-rate-label <=> AppState.tax-rate-label;
    in-out property <bool> app-tax-inclusive <=> AppState.tax-inclusive;

    // Screen state
    in-out property <string> current-screen: "splash"; // Start with splash screen
    in-out property <float> splash-progress: 0.0;
    in-out property <string> splash-status: Locale.splash-starting;

    // Selected operator state (for PIN entry screen)
    in-out property <string> selected-operator-id: "";
    in-out property <string> selected-operator-name: "";
    in-out property <string> selected-operator-role: "";
    in-out property <string> selected-operator-initials: "";
    in-out property <color> selected-operator-color: Colors.primary;

    // PIN entry state
    in-out property <bool> pin-error: false;
    in-out property <string> pin-error-message: "";
    in-out property <int> pin-attempts-remaining: 3;
    in-out property <string> pin-text: ""; // two-way bound to PinEntryScreen.pin-value for Rust backspace

    // Setup/Pairing state
    in-out property <string> setup-pairing-code: "---";
    in-out property <string> setup-hardware-id: "";
    in-out property <string> setup-status: "pending"; // pending, completed, expired, error
    in-out property <string> setup-error-message: "";
    in-out property <int> setup-expires-in-seconds: 900;
    in-out property <string> setup-server-url: "http://178.156.135.235:3000"; // configurable backend URL

    // Callbacks for setup screen
    callback setup-refresh-requested;
    callback setup-pairing-completed(string, string); // terminal-id, secret
    callback setup-server-url-changed(string);        // called when server URL changes

    // Shutdown dialog state and callbacks
    in-out property <bool> show-shutdown-dialog: false;
    callback request-close-app;
    callback request-restart-app;
    callback request-restart-machine;
    callback request-shutdown-machine;

    // Callback for navigation
    callback navigate-to(string);
    navigate-to(screen) => { current-screen = screen; }

    // Callback for PIN verification (to be connected from Rust)
    callback verify-pin(string, string); // operator-id, pin

    // Callback for operator selection - looks up operator from DB and navigates to PIN entry
    callback on-operator-selected(string); // operator-id

    // Callback for searching operators (filters grid by name)
    callback search-operators(string); // search query

    // Callback for employee ID login (looks up operator by employee number)
    callback employee-id-submitted(string); // employee number

    // Callback for employee ID backspace (Rust removes last character since Slint can't slice strings)
    callback employee-id-backspace();

    // Callback for PIN backspace (Rust removes last character since Slint can't slice strings)
    callback pin-backspace();

    // Employee ID error (set from Rust when not found)
    in-out property <string> employee-id-error: "";

    // Employee ID text (bound two-way for keypad input + Rust backspace)
    in-out property <string> employee-id-text: "";

    // Callback to trigger manual sync (called on shift start)
    callback request-sync();

    // Sync dialog callbacks (triggered from settings sync screen)
    callback sync-now();      // Quick sync - catalogs + operators
    callback full-sync();     // Full sync - includes clearing cache

    // Product catalog callbacks (connected to Rust services)
    callback select-category(string);    // Filter products by category ID (empty = all)
    callback add-to-cart(string);        // Add product to cart by product ID

    // Draft management callbacks (connected to Rust DraftService)
    callback save-draft(string, string, string);  // Save draft: (name, operator_id, shift_id)

    // Cart item operation callbacks (Phase 2 — connected to Rust CartService)
    callback cart-item-increment(string);   // Increment item quantity by ID
    callback cart-item-decrement(string);   // Decrement item quantity by ID
    callback cart-item-remove(string);      // Remove item from cart by ID
    callback cart-item-edit(string);        // Edit item quantity (opens quantity pad)
    callback clear-cart();                  // Clear all items from cart
    callback void-last-item();             // Remove the last added item
    callback quantity-multiply();          // Prompt for quantity entry on last item

    // Sync summary dialog state
    in-out property <bool> show-sync-dialog: false;
    in-out property <bool> sync-dialog-in-progress: false;
    in-out property <float> sync-dialog-progress: 0.0;
    in-out property <string> sync-dialog-status: "";
    in-out property <bool> sync-dialog-success: true;
    in-out property <string> sync-dialog-error: "";
    in-out property <int> sync-products-count: 0;
    in-out property <int> sync-categories-count: 0;
    in-out property <int> sync-operators-count: 0;
    in-out property <int> sync-offline-synced: 0;
    in-out property <int> sync-offline-failed: 0;
    in-out property <bool> sync-catalog-not-modified: false;
    in-out property <bool> sync-operators-not-modified: false;

    // Feature-based navigation callbacks (connected from Rust in Phase 9)
    // Check if a feature is enabled (returns bool)
    pure callback is-feature-enabled(string) -> bool;

    // Check if navigation to a screen is allowed (returns bool)
    pure callback can-navigate-to(string) -> bool;

    // Navigate to a screen with feature validation (returns success/failure)
    callback navigate-to-screen(string) -> bool;

    // Navigate to a feature's entry point (returns success/failure)
    callback navigate-to-feature(string) -> bool;

    // Screen routing
    if current-screen == "splash": SplashScreen {
        progress: splash-progress;
        status-text: splash-status;
        loading-complete => { current-screen = "login"; }
    }

    // Setup/Pairing screen (shown when terminal is not registered)
    if current-screen == "setup": SetupScreen {
        pairing-code: setup-pairing-code;
        hardware-id: setup-hardware-id;
        status: setup-status;
        error-message: setup-error-message;
        expires-in-seconds: setup-expires-in-seconds;
        server-url <=> setup-server-url;
        refresh-requested => { root.setup-refresh-requested(); }
        pairing-completed(terminal-id, secret) => { root.setup-pairing-completed(terminal-id, secret); }
        server-url-changed(url) => { root.setup-server-url-changed(url); }
    }

    // Operators list (populated from database via Rust)
    in-out property <[Operator]> operators: [];

    // Categories list (populated from database via Rust)
    in-out property <[CategoryData]> categories: [];
    property <string> selected-category: "";
    in-out property <int> total-product-count: 0;

    // Products list (populated from database via Rust)
    in-out property <[ProductData]> products: [];
    in-out property <bool> products-loading: false;

    // Search state
    property <string> search-query: "";
    property <[ProductSearchResult]> search-results: [];
    property <bool> search-loading: false;
    property <[RecentSearchItem]> recent-searches: [];

    // Cash payment state (Phase 21)
    property <string> cash-amount-tendered: "0";
    property <string> cash-change-due: "0.000";
    property <bool> cash-is-sufficient: false;
    property <[string]> cash-quick-amounts: ["20", "50", "100", "200"];

    // Card payment state (Phase 22)
    // Status: waiting, card_inserted, processing, pin_required, approved, declined, error, cancelled
    property <string> card-payment-status: "waiting";
    property <string> card-type: "";
    property <string> card-last-four: "";
    property <string> card-auth-code: "";
    property <string> card-transaction-id: "";
    property <string> card-error-message: "";

    // Split payment state (Phase 23)
    property <string> split-current-amount: "0";
    property <string> split-selected-method: "cash";
    property <string> split-paid-amount: "0.000";
    property <string> split-remaining-amount: "7.675";  // Initially equals total
    property <[SplitPaymentEntry]> split-payments: [];
    property <bool> split-can-complete: false;

    // QR/Wallet payment state (Phase 24)
    // status: waiting, scanning, verifying, approved, expired, error
    property <string> qr-payment-status: "waiting";
    property <int> qr-expires-in: 300;          // Seconds remaining
    property <int> qr-initial-timeout: 300;     // For progress calculation
    property <string> qr-wallet-type: "";       // Sadad, MobiCash, etc.
    property <string> qr-transaction-id: "";
    property <string> qr-error-message: "";
    property <string> qr-payment-reference: ""; // Invoice/order reference
    property <[WalletProvider]> supported-wallets: [
        { id: "sadad", name: "Sadad", name-ar: "سداد", icon: "\u{1F4F1}", color: #22C55E },
        { id: "mobicash", name: "MobiCash", name-ar: "موبي كاش", icon: "\u{1F4B0}", color: #3B82F6 },
    ];

    // Receipt state (Phase 26)
    property <string> receipt-transaction-number: "";
    property <string> receipt-number: "";
    property <string> receipt-date-time: "";
    property <[ReceiptItem]> receipt-items: [];
    property <string> receipt-subtotal: "0.000";
    property <string> receipt-tax: "0.000";
    property <string> receipt-discount: "0.000";
    property <string> receipt-total: "0.000";
    property <int> receipt-item-count: 0;
    property <[ReceiptPayment]> receipt-payments: [];
    property <string> receipt-change-due: "0.000";
    property <bool> receipt-is-printing: false;
    property <bool> receipt-is-emailing: false;

    // Save Draft state (Phase 28)
    in-out property <bool> show-save-draft-dialog: false;
    in-out property <string> draft-name: "";
    in-out property <int> draft-count: 0;
    in-out property <bool> draft-is-saving: false;

    // Recall Draft state (Phase 29)
    property <string> recall-draft-search-query: "";
    property <bool> recall-drafts-loading: false;
    in-out property <[DraftItem]> drafts: [];

    // Return Entry state (Phase 30)
    property <string> return-receipt-number: "";
    property <bool> return-searching: false;
    property <bool> return-receipt-found: false;
    property <string> return-error-message: "";
    property <ReturnEntryData> return-found-transaction: {
        receipt-number: "",
        original-transaction-id: "",
        original-date: "",
        original-total: "",
        item-count: 0,
        customer-name: "",
        can-return: false,
        requires-approval: false,
        error-message: "",
    };

    // Return Items state (Phase 31)
    property <[ReturnableItem]> return-items: [];
    property <string> return-subtotal: "0.000";
    property <string> return-tax: "0.000";
    property <string> return-items-total: "0.000";
    property <bool> return-can-proceed: false;
    property <int> return-selected-item-index: -1;
    property <bool> return-show-reason-picker: false;

    // Refund state (Phase 32)
