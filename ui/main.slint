import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

// Color scheme
global Theme {
    out property <color> primary: #C62828;
    out property <color> primary-dark: #B71C1C;
    out property <color> surface: #FFFFFF;
    out property <color> background: #F5F5F5;
    out property <color> text-primary: #212121;
    out property <color> text-secondary: #757575;
    out property <color> border: #E0E0E0;
    out property <color> success: #4CAF50;
    out property <color> cart-bg: #FAFAFA;
}

// Main Window
export component MainWindow inherits Window {
    title: "E2Manage POS Terminal";
    width: 1024px;
    height: 768px;
    background: Theme.background;

    VerticalLayout {
        spacing: 0px;

        // ===== HEADER =====
        Rectangle {
            height: 56px;
            background: Theme.primary;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                // Left section
                HorizontalLayout {
                    spacing: 24px;
                    alignment: start;

                    Text {
                        text: "POS-001";
                        font-size: 16px;
                        font-weight: 700;
                        color: white;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Main Checkout";
                        font-size: 14px;
                        color: #FFCDD2;
                        vertical-alignment: center;
                    }
                }

                // Center section
                Text {
                    text: "Ahmed • Shift #12";
                    font-size: 14px;
                    color: white;
                    vertical-alignment: center;
                }

                // Right section
                HorizontalLayout {
                    spacing: 16px;
                    alignment: end;

                    HorizontalLayout {
                        spacing: 6px;

                        Text {
                            text: "10:30";
                            font-size: 14px;
                            color: white;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.success;
                        }
                        Text {
                            text: "Online";
                            font-size: 12px;
                            color: #A5D6A7;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: transparent;

                        TouchArea {}

                        Text {
                            text: "⚙";
                            font-size: 22px;
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ===== MAIN CONTENT =====
        Rectangle {
            background: Theme.background;
            vertical-stretch: 1;

            HorizontalLayout {
                padding: 16px;
                spacing: 16px;

                // ===== LEFT PANEL =====
                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.surface;
                    border-radius: 12px;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 16px;

                        // Search Bar
                        Rectangle {
                            height: 48px;
                            background: Theme.background;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                spacing: 8px;

                                Text {
                                    text: "🔍";
                                    font-size: 18px;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "Scan or Search product...";
                                    font-size: 14px;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border-radius: 8px;
                                    background: transparent;
                                    TouchArea {}
                                    Text {
                                        text: "🎤";
                                        font-size: 20px;
                                        color: Theme.primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border-radius: 8px;
                                    background: transparent;
                                    TouchArea {}
                                    Text {
                                        text: "📷";
                                        font-size: 20px;
                                        color: Theme.primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Customer Bar
                        Rectangle {
                            height: 40px;
                            background: #FFF3E0;
                            border-radius: 8px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 8px;

                                    Text {
                                        text: "👤";
                                        font-size: 16px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Guest Customer";
                                        font-size: 13px;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    width: 70px;
                                    height: 28px;
                                    border-radius: 4px;
                                    background: transparent;

                                    TouchArea {}

                                    Text {
                                        text: "Change";
                                        font-size: 12px;
                                        color: #E65100;
                                        font-weight: 500;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Quick Categories
                        VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: "Quick Categories";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text-secondary;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                // Category tiles
                                for item in [
                                    { icon: "🥬", name: "Produce" },
                                    { icon: "🥛", name: "Dairy" },
                                    { icon: "🍞", name: "Bakery" },
                                    { icon: "🥤", name: "Drinks" },
                                    { icon: "🍖", name: "Meat" },
                                    { icon: "🍫", name: "Snacks" }
                                ]: Rectangle {
                                    width: 85px;
                                    height: 85px;
                                    border-radius: 12px;
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.border;

                                    TouchArea {}

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        padding: 8px;

                                        Text {
                                            text: item.icon;
                                            font-size: 28px;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: item.name;
                                            font-size: 11px;
                                            color: Theme.text-primary;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Recent Items
                        VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 8px;

                            Text {
                                text: "Recent Items";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text-secondary;
                            }

                            Rectangle {
                                vertical-stretch: 1;
                                background: Theme.background;
                                border-radius: 8px;
                                clip: true;

                                VerticalLayout {
                                    padding-top: 4px;
                                    padding-bottom: 4px;

                                    for item in [
                                        { name: "Milk 1L", price: "2.50" },
                                        { name: "Eggs (30)", price: "8.00" },
                                        { name: "Rice 5kg", price: "15.00" },
                                        { name: "Sugar 1kg", price: "3.50" },
                                        { name: "Olive Oil", price: "12.00" },
                                        { name: "Tomatoes 1kg", price: "3.00" },
                                        { name: "Chicken 1kg", price: "18.00" },
                                        { name: "Water 6pk", price: "4.50" }
                                    ]: Rectangle {
                                        height: 44px;
                                        background: transparent;

                                        TouchArea {}

                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            alignment: space-between;

                                            Text {
                                                text: item.name;
                                                font-size: 14px;
                                                color: Theme.text-primary;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: item.price;
                                                font-size: 14px;
                                                color: Theme.text-secondary;
                                                vertical-alignment: center;
                                            }
                                        }

                                        // Bottom border
                                        Rectangle {
                                            y: parent.height - 1px;
                                            height: 1px;
                                            background: Theme.border;
                                        }
                                    }
                                }
                            }
                        }

                        // Bottom Actions
                        HorizontalLayout {
                            spacing: 8px;
                            height: 44px;

                            Rectangle {
                                horizontal-stretch: 1;
                                background: Theme.background;
                                border-radius: 8px;

                                TouchArea {}

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;

                                    Text {
                                        text: "📋";
                                        font-size: 16px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Drafts";
                                        font-size: 13px;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: Theme.background;
                                border-radius: 8px;

                                TouchArea {}

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;

                                    Text {
                                        text: "🔄";
                                        font-size: 16px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Transfer";
                                        font-size: 13px;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: Theme.background;
                                border-radius: 8px;

                                TouchArea {}

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;

                                    Text {
                                        text: "↩️";
                                        font-size: 16px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Returns";
                                        font-size: 13px;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // ===== RIGHT PANEL (CART) =====
                Rectangle {
                    width: 340px;
                    background: Theme.surface;
                    border-radius: 12px;

                    VerticalLayout {
                        spacing: 0px;

                        // Cart Header
                        Rectangle {
                            height: 52px;
                            background: Theme.cart-bg;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;

                                Text {
                                    text: "Cart";
                                    font-size: 18px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "(5 items)";
                                    font-size: 14px;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Cart Items
                        Rectangle {
                            vertical-stretch: 1;
                            background: Theme.surface;

                            VerticalLayout {
                                padding-top: 8px;

                                for item in [
                                    { name: "Apple 1kg", qty: "×1", price: "4.00" },
                                    { name: "Milk 1L", qty: "×1", price: "2.50" },
                                    { name: "Bread", qty: "×1", price: "1.50" },
                                    { name: "Cheese 500g", qty: "×1", price: "6.00" },
                                    { name: "Eggs (12)", qty: "×1", price: "4.00" }
                                ]: Rectangle {
                                    height: 48px;
                                    background: transparent;

                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 8px;
                                        spacing: 8px;

                                        // Name
                                        Text {
                                            text: item.name;
                                            font-size: 14px;
                                            color: Theme.text-primary;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }

                                        // Quantity
                                        Text {
                                            text: item.qty;
                                            font-size: 12px;
                                            color: Theme.text-secondary;
                                            vertical-alignment: center;
                                        }

                                        // Price
                                        Text {
                                            text: item.price;
                                            font-size: 14px;
                                            font-weight: 500;
                                            color: Theme.text-primary;
                                            vertical-alignment: center;
                                        }

                                        // Remove button
                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 16px;
                                            background: transparent;

                                            TouchArea {}

                                            Text {
                                                text: "−";
                                                font-size: 18px;
                                                color: Theme.text-secondary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Bottom border
                                    Rectangle {
                                        y: parent.height - 1px;
                                        height: 1px;
                                        background: Theme.border;
                                    }
                                }
                            }
                        }

                        // Cart Totals
                        Rectangle {
                            height: 120px;
                            background: Theme.cart-bg;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Subtotal:";
                                        font-size: 14px;
                                        color: Theme.text-secondary;
                                    }
                                    Text {
                                        text: "18.00";
                                        font-size: 14px;
                                        color: Theme.text-secondary;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Tax 5%:";
                                        font-size: 14px;
                                        color: Theme.text-secondary;
                                    }
                                    Text {
                                        text: "0.90";
                                        font-size: 14px;
                                        color: Theme.text-secondary;
                                    }
                                }

                                Rectangle {
                                    height: 1px;
                                    background: Theme.border;
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "TOTAL:";
                                        font-size: 18px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                    }
                                    Text {
                                        text: "18.90";
                                        font-size: 18px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                    }
                                }
                            }
                        }

                        // Payment Buttons
                        Rectangle {
                            height: 70px;
                            background: Theme.surface;

                            HorizontalLayout {
                                padding: 12px;
                                spacing: 8px;

                                // Cash button
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 48px;
                                    border-radius: 8px;
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.border;

                                    TouchArea {}

                                    Text {
                                        text: "Cash";
                                        font-size: 15px;
                                        font-weight: 600;
                                        color: Theme.text-primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Card button
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 48px;
                                    border-radius: 8px;
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.border;

                                    TouchArea {}

                                    Text {
                                        text: "Card";
                                        font-size: 15px;
                                        font-weight: 600;
                                        color: Theme.text-primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Split button
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 48px;
                                    border-radius: 8px;
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.border;

                                    TouchArea {}

                                    Text {
                                        text: "Split";
                                        font-size: 15px;
                                        font-weight: 600;
                                        color: Theme.text-primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // PAY button
                                Rectangle {
                                    horizontal-stretch: 2;
                                    height: 48px;
                                    border-radius: 8px;
                                    background: Theme.primary;

                                    TouchArea {}

                                    Text {
                                        text: "PAY 18.90";
                                        font-size: 15px;
                                        font-weight: 600;
                                        color: white;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Bottom Actions
                        Rectangle {
                            height: 48px;
                            background: Theme.cart-bg;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;

                                // Hold
                                Rectangle {
                                    width: 90px;
                                    height: 36px;
                                    background: transparent;

                                    TouchArea {}

                                    Text {
                                        text: "Hold (F3)";
                                        font-size: 12px;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Recall
                                Rectangle {
                                    width: 90px;
                                    height: 36px;
                                    background: transparent;

                                    TouchArea {}

                                    Text {
                                        text: "Recall (F4)";
                                        font-size: 12px;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Void
                                Rectangle {
                                    width: 70px;
                                    height: 36px;
                                    background: transparent;

                                    TouchArea {}

                                    Text {
                                        text: "Void";
                                        font-size: 12px;
                                        color: #F44336;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
