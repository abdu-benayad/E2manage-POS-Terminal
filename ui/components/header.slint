// ============================================================================
// E2Manage POS Terminal - Header Component
// ============================================================================
// Top header bar showing navigation, operator info, and status
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Animation, Locale, AppState, Layout } from "../theme.slint";

// Private StatusDot component for connection indicator
component StatusDot inherits Rectangle {
    in property <bool> online: true;

    width: Sizes.status-dot;
    height: Sizes.status-dot;
    border-radius: Sizes.status-dot / 2;
    background: online ? Colors.success : Colors.warning;

    animate background { duration: Animation.normal; }
}

// ============================================================================
// HEADER COMPONENT
// ============================================================================
// Usage:
//   Header {
//       terminal-code: "POS-001";
//       operator-name: "Ahmed";
//       shift-number: "1";
//       menu-clicked => { handle_menu(); }
//       settings-clicked => { handle_settings(); }
//   }
// ============================================================================

export component Header inherits Rectangle {
    // Terminal identification
    in property <string> terminal-code: AppState.terminal-code;

    // Company/Shop name
    in property <string> company-name: AppState.company-name;

    // Operator information (optional - hides center section if empty)
    in property <string> operator-name: "";

    // Shift number (optional)
    in property <string> shift-number: "";

    // Connection status
    in property <bool> is-online: AppState.is-online;

    // Current time display
    in property <string> current-time: AppState.current-time;

    // Whether to show menu button
    in property <bool> show-menu: true;

    // Whether to show settings button
    in property <bool> show-settings: true;

    // Subdued mode - reduces visual weight for checkout screen
    // Pay button should be the dominant element, not header
    in property <bool> subdued: false;

    // Compact mode for responsive layout (smaller screens)
    in property <bool> compact: false;

    // Callbacks
    callback menu-clicked;
    callback settings-clicked;

    // Reduced height and muted color in subdued/compact mode
    height: compact ? 48px : (subdued ? 56px : Sizes.header-height);
    background: subdued ? #374151 : Colors.primary;  // Dark gray vs bright blue

    HorizontalLayout {
        padding-left: Spacing.lg;
        padding-right: Spacing.lg;
        spacing: Spacing.lg;
        alignment: space-between;

        // Left section - Menu & Terminal
        HorizontalLayout {
            spacing: Spacing.lg;
            alignment: Layout.rtl ? end : start;

            // Menu button
            if show-menu: Rectangle {
                width: Sizes.touch-target;
                height: Sizes.touch-target;
                border-radius: Sizes.touch-target / 2;
                background: menu-touch.has-hover ? rgba(255, 255, 255, 0.1) : transparent;

                menu-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.menu-clicked(); }
                }

                Text {
                    // Hamburger menu icon (☰)
                    text: "\u{2630}";
                    font-size: 24px;
                    color: Colors.text-on-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                animate background { duration: Animation.fast; }
            }

            // Terminal code
            Text {
                text: terminal-code;
                font-size: Typography.body;
                font-weight: 700;
                color: Colors.text-on-primary;
                vertical-alignment: center;
                horizontal-alignment: Layout.rtl ? right : left;
            }
        }

        // Center section - Operator name
        if operator-name != "": Text {
            text: operator-name;
            font-size: Typography.body;
            color: Colors.text-on-primary;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        // Right section - Time, Status, Settings
        HorizontalLayout {
            spacing: Spacing.lg;
            alignment: Layout.rtl ? start : end;

            // Time
            Text {
                text: current-time;
                font-size: Typography.body;
                color: Colors.text-on-primary;
                vertical-alignment: center;
            }

            // Connection status
            HorizontalLayout {
                spacing: Spacing.xs;

                StatusDot { online: is-online; }

                Text {
                    text: is-online ? Locale.online : Locale.offline;
                    font-size: Typography.small;
                    color: is-online ? #A5D6A7 : Colors.warning;
                    vertical-alignment: center;
                }
            }

            // Settings button
            if show-settings: Rectangle {
                width: Sizes.touch-target;
                height: Sizes.touch-target;
                border-radius: Sizes.touch-target / 2;
                background: settings-touch.has-hover ? rgba(255, 255, 255, 0.1) : transparent;

                settings-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.settings-clicked(); }
                }

                Text {
                    // Gear icon (⚙)
                    text: "\u{2699}";
                    font-size: 20px;
                    color: Colors.text-on-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                animate background { duration: Animation.fast; }
            }
        }
    }
}

// ============================================================================
// PAGE HEADER (for secondary screens with back button)
// ============================================================================
// Usage:
//   PageHeader {
//       title: "Settings";
//       subtitle: "Configure terminal";
//       back-clicked => { go_back(); }
//   }
// ============================================================================

export component PageHeader inherits Rectangle {
    // Page title
    in property <string> title: "";

    // Optional subtitle
    in property <string> subtitle: "";

    // Whether to show back button
    in property <bool> show-back: true;

    // Optional right action text
    in property <string> action-text: "";

    // Callbacks
    callback back-clicked;
    callback action-clicked;

    height: Sizes.header-height;
    background: Colors.primary;

    HorizontalLayout {
        padding-left: Spacing.lg;
        padding-right: Spacing.lg;
        spacing: Spacing.lg;
        alignment: space-between;

        // Left section - Back button & Title
        HorizontalLayout {
            spacing: Spacing.md;
            alignment: Layout.rtl ? end : start;

            // Back button (RTL-aware arrow direction)
            if show-back: Rectangle {
                width: Sizes.touch-target;
                height: Sizes.touch-target;
                border-radius: Sizes.touch-target / 2;
                background: back-touch.has-hover ? rgba(255, 255, 255, 0.1) : transparent;

                back-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.back-clicked(); }
                }

                Text {
                    // Arrow direction based on RTL (← for LTR, → for RTL)
                    text: Layout.rtl ? "\u{2192}" : "\u{2190}";
                    font-size: 24px;
                    color: Colors.text-on-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                animate background { duration: Animation.fast; }
            }

            // Title & Subtitle
            VerticalLayout {
                alignment: center;
                spacing: 0px;

                Text {
                    text: title;
                    font-size: Typography.subheading;
                    font-weight: 600;
                    color: Colors.text-on-primary;
                    horizontal-alignment: Layout.rtl ? right : left;
                }

                if subtitle != "": Text {
                    text: subtitle;
                    font-size: Typography.small;
                    color: rgba(255, 255, 255, 0.7);
                    horizontal-alignment: Layout.rtl ? right : left;
                }
            }
        }

        // Right section - Action button (if provided)
        if action-text != "": Rectangle {
            width: action-label.preferred-width + Spacing.lg * 2;
            height: Sizes.button-small;
            border-radius: Radius.button;
            background: action-touch.has-hover ? rgba(255, 255, 255, 0.2) : rgba(255, 255, 255, 0.1);

            action-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.action-clicked(); }
            }

            action-label := Text {
                text: action-text;
                font-size: Typography.caption;
                font-weight: 600;
                color: Colors.text-on-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            animate background { duration: Animation.fast; }
        }
    }
}

// ============================================================================
// SIMPLE HEADER (minimal header for dialogs/modals)
// ============================================================================

export component SimpleHeader inherits Rectangle {
    in property <string> title: "";

    // Whether to show close button
    in property <bool> show-close: true;

    callback close-clicked;

    height: 56px;
    background: Colors.surface;

    // Bottom border only
    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Colors.border;
    }

    HorizontalLayout {
        padding-left: Spacing.lg;
        padding-right: Spacing.lg;
        alignment: space-between;

        // Title
        Text {
            text: title;
            font-size: Typography.subheading;
            font-weight: 600;
            color: Colors.text-primary;
            vertical-alignment: center;
            horizontal-alignment: Layout.rtl ? right : left;
        }

        // Close button
        if show-close: Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: close-touch.has-hover ? Colors.surface-variant : transparent;

            close-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.close-clicked(); }
            }

            Text {
                // Close icon (✕)
                text: "\u{2715}";
                font-size: 20px;
                color: Colors.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            animate background { duration: Animation.fast; }
        }
    }
}
