// ============================================================================
// E2Manage POS Terminal - ProgressBar Component
// ============================================================================
// Progress indicators for loading states, sync progress, etc.
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Animation } from "../theme.slint";

// ============================================================================
// PROGRESS BAR COMPONENT
// ============================================================================
// Usage:
//   ProgressBar { progress: 0.5; }  // 50% progress
//   ProgressBar { progress: sync-progress; variant: "success"; }
// ============================================================================

export component ProgressBar inherits Rectangle {
    // Progress value from 0.0 to 1.0
    in property <float> progress: 0.0;

    // Variant: "default", "success", "warning", "danger"
    in property <string> variant: "default";

    // Whether to show indeterminate (animated) state
    in property <bool> indeterminate: false;

    // Size: "small", "medium", "large"
    in property <string> size: "medium";

    // Animation state for indeterminate mode
    in-out property <float> indeterminate-offset: 0;

    width: Sizes.progress-width;
    height: size == "small" ? 4px : size == "large" ? 12px : Sizes.progress-height;
    border-radius: self.height / 2;
    background: Colors.progress-bg;
    clip: true;

    // Determinate progress fill
    if !indeterminate: Rectangle {
        x: 0;
        y: 0;
        width: parent.width * clamp(progress, 0, 1);
        height: parent.height;
        border-radius: parent.height / 2;
        background: variant == "success" ? Colors.success :
                    variant == "warning" ? Colors.warning :
                    variant == "danger" ? Colors.danger :
                    Colors.progress-fill;

        animate width { duration: Animation.progress; }
    }

    // Indeterminate animated fill
    if indeterminate: Rectangle {
        x: (parent.width * indeterminate-offset) - self.width * 0.5;
        y: 0;
        width: parent.width * 0.3;
        height: parent.height;
        border-radius: parent.height / 2;
        background: variant == "success" ? Colors.success :
                    variant == "warning" ? Colors.warning :
                    variant == "danger" ? Colors.danger :
                    Colors.progress-fill;
    }

    // Indeterminate animation (controlled from Rust)
    // The indeterminate-offset property should be animated externally
}

// ============================================================================
// CIRCULAR PROGRESS INDICATOR
// ============================================================================
// Usage:
//   CircularProgress { progress: 0.75; }
//   CircularProgress { indeterminate: true; }
// ============================================================================

export component CircularProgress inherits Rectangle {
    // Progress value from 0.0 to 1.0 (ignored if indeterminate)
    in property <float> progress: 0.0;

    // Whether to show indeterminate (spinning) state
    in property <bool> indeterminate: false;

    // Size of the circular indicator
    in property <length> circle-size: 40px;

    // Stroke width
    in property <length> stroke-width: 4px;

    // Color variant
    in property <string> variant: "default";

    width: circle-size;
    height: circle-size;
    background: transparent;

    // For now, use a simple rotating indicator for indeterminate
    // Slint doesn't have native circular progress, so we use a visual approximation

    // Background track
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: parent.width / 2;
        border-width: stroke-width;
        border-color: Colors.progress-bg;
        background: transparent;
    }

    // Progress indicator text (percentage)
    if !indeterminate: Text {
        text: Math.round(clamp(progress, 0, 1) * 100) + "%";
        font-size: circle-size < 60px ? Typography.small : Typography.caption;
        font-weight: 600;
        color: variant == "success" ? Colors.success :
               variant == "warning" ? Colors.warning :
               variant == "danger" ? Colors.danger :
               Colors.primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Indeterminate spinner indicator
    if indeterminate: Text {
        text: "\u{21BB}"; // Rotating arrow
        font-size: circle-size * 0.5;
        color: variant == "success" ? Colors.success :
               variant == "warning" ? Colors.warning :
               variant == "danger" ? Colors.danger :
               Colors.primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ============================================================================
// LABELED PROGRESS BAR
// ============================================================================
// Progress bar with label and percentage display
// Usage:
//   LabeledProgress { label: "Syncing..."; progress: 0.6; }
// ============================================================================

export component LabeledProgress inherits Rectangle {
    // Label text
    in property <string> label: "";

    // Progress value from 0.0 to 1.0
    in property <float> progress: 0.0;

    // Whether to show percentage
    in property <bool> show-percentage: true;

    // Variant: "default", "success", "warning", "danger"
    in property <string> variant: "default";

    height: 48px;
    background: transparent;

    VerticalLayout {
        spacing: Spacing.xs;

        // Label row
        HorizontalLayout {
            alignment: space-between;

            Text {
                text: label;
                font-size: Typography.caption;
                color: Colors.text-secondary;
            }

            if show-percentage: Text {
                text: Math.round(clamp(progress, 0, 1) * 100) + "%";
                font-size: Typography.caption;
                font-weight: 600;
                color: variant == "success" ? Colors.success :
                       variant == "warning" ? Colors.warning :
                       variant == "danger" ? Colors.danger :
                       Colors.text-primary;
            }
        }

        // Progress bar
        ProgressBar {
            progress: root.progress;
            variant: root.variant;
            width: 100%;
        }
    }
}

// ============================================================================
// STEP PROGRESS INDICATOR
// ============================================================================
// Shows progress through discrete steps
// Usage:
//   StepProgress { current-step: 2; total-steps: 5; }
// ============================================================================

export component StepProgress inherits Rectangle {
    // Current step (1-based)
    in property <int> current-step: 1;

    // Total number of steps
    in property <int> total-steps: 4;

    // Labels for each step (comma-separated)
    in property <string> step-labels: "";

    // Whether to show step numbers
    in property <bool> show-numbers: true;

    height: 60px;
    background: transparent;

    HorizontalLayout {
        alignment: center;
        spacing: 0px;

        for i in total-steps: HorizontalLayout {
            spacing: 0px;
            alignment: center;

            // Step circle
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: i < current-step ? Colors.primary :
                           i == current-step - 1 ? Colors.primary-light :
                           Colors.surface-variant;
                border-width: i >= current-step ? 2px : 0px;
                border-color: Colors.border;

                Text {
                    text: show-numbers ? (i + 1) + "" : (i < current-step ? "\u{2713}" : "");
                    font-size: Typography.small;
                    font-weight: 600;
                    color: i < current-step ? Colors.text-on-primary :
                           i == current-step - 1 ? Colors.text-on-primary :
                           Colors.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Connector line (except for last step)
            if i < total-steps - 1: Rectangle {
                width: 40px;
                height: 24px;

                Rectangle {
                    y: (parent.height - 2px) / 2;
                    width: parent.width;
                    height: 2px;
                    background: i < current-step - 1 ? Colors.primary : Colors.border;
                }
            }
        }
    }
}
