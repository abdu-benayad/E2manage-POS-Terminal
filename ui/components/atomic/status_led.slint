import { Colors } from "../../theme.slint";

export component StatusLED inherits Rectangle {
    // "online" | "offline" | "syncing"
    in property <string> state: "online";

    width: 14px;
    height: 14px;

    out property <color> dot-color:
        state == "offline" ? Colors.warning :
        state == "syncing" ? Colors.info :
        Colors.accent-lime;

    // Pulse driver: a boolean that flips every 600ms while syncing.
    // The animate-opacity block on the halo smoothly interpolates each flip,
    // producing a continuous breathe with a 1200ms cycle.
    in-out property <bool> pulse-on: false;
    Timer {
        interval: 600ms;
        running: root.state == "syncing";
        triggered => { root.pulse-on = !root.pulse-on; }
    }

    // Halo
    Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.dot-color;
        // Steady-state halo at 0.45; syncing oscillates 0.45↔0.85.
        // Higher floor so the halo reads against dark surfaces.
        opacity: root.state == "syncing"
            ? (root.pulse-on ? 0.85 : 0.45)
            : 0.45;
        animate opacity { duration: 600ms; easing: ease-in-out; }
    }
    // Core dot
    Rectangle {
        x: 3px;
        y: 3px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.dot-color;
    }
}
