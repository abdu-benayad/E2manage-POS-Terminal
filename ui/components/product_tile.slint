// ============================================================================
// E2Manage POS Terminal - Product Tile Component (Phase 16)
// ============================================================================
// Individual product tile for the product grid
// Displays product image, name (EN/AR), SKU, price, and stock status
// ============================================================================

import { Colors, Typography, Spacing, Radius, Layout, Locale, Animation, CartState } from "../theme.slint";

// ============================================================================
// PRODUCT DATA STRUCT
// ============================================================================

export struct ProductData {
    id: string,
    name: string,
    name_ar: string,
    sku: string,
    barcode: string,
    price: string,
    stock: int,
    low_stock: bool,
    out_of_stock: bool,
    has_image: bool,
    image_url: string,
    category_id: string,
    unit: string,
    category_color: color,
    is_weighable: bool,
    // Product type awareness (Phase 3 Track H)
    product_type: string,   // "PHYSICAL_GOOD", "SERVICE", "FEE", etc.
    is_service: bool,       // true for SERVICE, FEE, LABOR, DIGITAL, SUBSCRIPTION
}

// ============================================================================
// PRODUCT TILE COMPONENT
// ============================================================================

export component ProductTile inherits Rectangle {
    in property <string> product-id: "";
    in property <string> name: "Product";
    in property <string> name-ar: "";
    in property <string> sku: "";
    in property <string> price: "0.000";
    in property <string> currency: CartState.currency;
    in property <int> stock: 0;
    in property <bool> low-stock: false;
    in property <bool> out-of-stock: false;
    in property <bool> has-image: false;
    in property <string> unit: "";
    in property <color> category-color: Colors.primary;
    // Product type awareness (Phase 3 Track H)
    in property <string> product-type: "PHYSICAL_GOOD";
    in property <bool> is-service: false;

    callback clicked(string);
    callback long-pressed(string);

    // Services/fees are never out-of-stock
    property <bool> effectively-out-of-stock: out-of-stock && !is-service;

    horizontal-stretch: 1;
    preferred-width: 0px;
    min-width: 120px;
    height: 160px;
    border-radius: Radius.md;
    background: effectively-out-of-stock ? Colors.surface-variant : Colors.surface;
    border-width: 1px;
    border-color: touch.pressed ? Colors.primary :
                  touch.has-hover ? Colors.primary-light :
                  is-service ? Colors.info : Colors.border;

    // Pressed state scale effect
    opacity: effectively-out-of-stock ? 0.6 : 1.0;

    states [
        pressed when touch.pressed: {
            background: Colors.background;
        }
        hover when touch.has-hover && !out-of-stock: {
            border-color: Colors.primary-light;
        }
    ]

    animate background { duration: Animation.fast; }
    animate border-color { duration: Animation.fast; }

    VerticalLayout {
        spacing: Spacing.xs;

        // Colored tile area (category-colored background instead of gray placeholder)
        Rectangle {
            height: 80px;
            background: root.category-color;
            border-radius: Radius.md;
            clip: true;

            // Product name on colored background (shows first few chars naturally)
            Text {
                text: Locale.current == "ar" && name-ar != "" ? name-ar : name;
                font-size: 28px;
                font-weight: 700;
                color: rgba(255, 255, 255, 0.9);
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            // Out of stock overlay (services are never out of stock)
            if effectively-out-of-stock: Rectangle {
                background: rgba(0, 0, 0, 0.5);
                border-radius: Radius.md;

                Text {
                    text: Locale.current == "ar" ? "نفذ" : "OUT";
                    font-size: Typography.caption;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Service/Fee type badge (top-right corner)
            if is-service: Rectangle {
                x: parent.width - 24px;
                y: 4px;
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: Colors.info;

                Text {
                    text: product-type == "FEE" ? "\u{24}" : "\u{2699}";  // $ for fee, gear for service
                    font-size: 11px;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Low stock indicator (top-right corner) — only for physical products
            if !is-service && low-stock && !out-of-stock: Rectangle {
                x: parent.width - 24px;
                y: 4px;
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: Colors.warning;

                Text {
                    text: "!";
                    font-size: 12px;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Stock count badge (bottom-left corner) — only for physical products
            if !is-service && stock > 0 && stock <= 10: Rectangle {
                x: 4px;
                y: parent.height - 20px;
                width: 28px;
                height: 16px;
                border-radius: Radius.sm;
                background: low-stock ? Colors.warning : Colors.info;

                Text {
                    text: stock + "";
                    font-size: 10px;
                    font-weight: 600;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Product info
        VerticalLayout {
            padding-left: Spacing.xs;
            padding-right: Spacing.xs;
            padding-bottom: Spacing.xs;
            spacing: 2px;

            // Product name (locale-aware)
            Text {
                text: Locale.current == "ar" && name-ar != "" ? name-ar : name;
                font-size: Typography.body;
                color: Colors.text-primary;
                overflow: elide;
                horizontal-alignment: Layout.rtl ? right : left;
            }

            // Price and unit
            HorizontalLayout {
                spacing: Spacing.xxs;

                Text {
                    text: price;
                    font-size: Typography.body;
                    font-weight: 700;
                    color: effectively-out-of-stock ? Colors.text-secondary : Colors.primary;
                }

                Text {
                    text: currency;
                    font-size: Typography.small;
                    font-weight: 500;
                    color: Colors.text-secondary;
                    vertical-alignment: center;
                }

                if unit != "": Text {
                    text: "/" + unit;
                    font-size: Typography.small;
                    color: Colors.text-secondary;
                    vertical-alignment: center;
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: effectively-out-of-stock ? default : pointer;
        clicked => {
            if !effectively-out-of-stock {
                root.clicked(root.product-id);
            }
        }
        // Note: Long press requires timer implementation in Rust
    }
}

// ============================================================================
// COMPACT PRODUCT TILE (smaller variant for dense grids)
// ============================================================================

export component CompactProductTile inherits Rectangle {
    in property <string> product-id: "";
    in property <string> name: "Product";
    in property <string> name-ar: "";
    in property <string> price: "0.000";
    in property <string> currency: CartState.currency;
    in property <bool> out-of-stock: false;
    in property <color> category-color: Colors.primary;
    in property <bool> is-service: false;

    callback clicked(string);

    property <bool> effectively-out-of-stock: out-of-stock && !is-service;

    horizontal-stretch: 1;
    min-width: 80px;
    height: 100px;
    border-radius: Radius.md;
    background: effectively-out-of-stock ? Colors.surface-variant : Colors.surface;
    border-width: 1px;
    border-color: touch.pressed ? Colors.primary :
                  touch.has-hover ? Colors.primary-light : Colors.border;
    opacity: effectively-out-of-stock ? 0.6 : 1.0;

    animate background { duration: Animation.fast; }
    animate border-color { duration: Animation.fast; }

    VerticalLayout {
        alignment: center;
        spacing: Spacing.xs;
        padding: Spacing.xs;

        // Colored icon area
        Rectangle {
            width: 36px;
            height: 36px;
            background: root.category-color;
            border-radius: Radius.sm;

            Text {
                text: Locale.current == "ar" && name-ar != "" ? name-ar : name;
                font-size: 16px;
                font-weight: 700;
                color: rgba(255, 255, 255, 0.9);
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // Name
        Text {
            text: Locale.current == "ar" && name-ar != "" ? name-ar : name;
            font-size: Typography.small;
            color: Colors.text-primary;
            overflow: elide;
            horizontal-alignment: center;
        }

        // Price
        Text {
            text: price + " " + currency;
            font-size: Typography.caption;
            font-weight: 600;
            color: effectively-out-of-stock ? Colors.text-secondary : Colors.primary;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: effectively-out-of-stock ? default : pointer;
        clicked => {
            if !effectively-out-of-stock {
                root.clicked(root.product-id);
            }
        }
    }
}

// ============================================================================
// PRODUCT LIST ITEM (for list view instead of grid)
// ============================================================================

export component ProductListItem inherits Rectangle {
    in property <string> product-id: "";
    in property <string> name: "Product";
    in property <string> name-ar: "";
    in property <string> sku: "";
    in property <string> price: "0.000";
    in property <string> currency: CartState.currency;
    in property <int> stock: 0;
    in property <bool> low-stock: false;
    in property <bool> out-of-stock: false;

    callback clicked(string);

    height: 56px;
    background: touch.has-hover ? Colors.surface-variant : Colors.surface;
    opacity: out-of-stock ? 0.6 : 1.0;

    touch := TouchArea {
        mouse-cursor: out-of-stock ? default : pointer;
        clicked => {
            if !out-of-stock {
                root.clicked(root.product-id);
            }
        }
    }

    HorizontalLayout {
        padding-left: Spacing.lg;
        padding-right: Spacing.lg;
        spacing: Spacing.md;

        // Product icon
        Rectangle {
            width: 40px;
            height: 40px;
            background: Colors.background;
            border-radius: Radius.sm;

            Text {
                text: "\u{1F4E6}";
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Product info
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: Spacing.sm;

                Text {
                    text: Locale.current == "ar" && name-ar != "" ? name-ar : name;
                    font-size: Typography.body;
                    color: Colors.text-primary;
                    horizontal-alignment: Layout.rtl ? right : left;
                }

                if low-stock && !out-of-stock: Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: Colors.warning;

                    Text {
                        text: "!";
                        font-size: 10px;
                        font-weight: 700;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

        }

        // Stock
        Text {
            text: out-of-stock ?
                  (Locale.current == "ar" ? "نفذ" : "OUT") :
                  (stock + "");
            font-size: Typography.caption;
            color: out-of-stock ? Colors.danger : Colors.text-secondary;
            vertical-alignment: center;
        }

        // Price
        VerticalLayout {
            alignment: center;

            Text {
                text: price;
                font-size: Typography.body;
                font-weight: 600;
                color: out-of-stock ? Colors.text-secondary : Colors.primary;
                horizontal-alignment: right;
            }

            Text {
                text: currency;
                font-size: Typography.small;
                color: Colors.text-secondary;
                horizontal-alignment: right;
            }
        }
    }

    // Bottom divider
    Rectangle {
        y: parent.height - 1px;
        width: parent.width - (Spacing.lg * 2);
        x: Spacing.lg;
        height: 1px;
        background: Colors.divider;
    }
}
