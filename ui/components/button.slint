// ============================================================================
// E2Manage POS Terminal - Button Components
// ============================================================================
// Reusable button components with variants and states
// Supports: primary, secondary, danger, ghost, warning
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Animation, Layout, CartState } from "../theme.slint";

// ============================================================================
// BUTTON COMPONENT
// ============================================================================

export component Button inherits Rectangle {
    in property <string> text: "Button";
    in property <string> variant: "primary"; // primary, secondary, danger, ghost, warning
    in property <bool> disabled: false;
    in property <length> icon-size: 24px;
    in property <image> icon;
    in property <bool> loading: false;
    in property <bool> full-width: false;

    callback clicked;

    height: Sizes.button-height;
    min-width: 120px;
    horizontal-stretch: full-width ? 1 : 0;
    border-radius: Radius.button;

    // Background based on variant
    background: disabled ? Colors.border :
                variant == "primary" ? Colors.primary :
                variant == "secondary" ? Colors.surface :
                variant == "danger" ? Colors.danger :
                variant == "warning" ? Colors.warning :
                transparent;

    // Border for secondary variant
    border-width: variant == "secondary" ? 1px : 0px;
    border-color: Colors.border;

    // Hover/pressed states
    states [
        pressed when touch.pressed && !disabled: {
            background: variant == "primary" ? Colors.primary-dark :
                        variant == "secondary" ? Colors.border :
                        variant == "danger" ? #DC2626 :
                        variant == "warning" ? #D97706 :
                        rgba(0, 0, 0, 0.1);
        }
        hovered when touch.has-hover && !disabled && !touch.pressed: {
            background: variant == "primary" ? Colors.primary-light :
                        variant == "secondary" ? Colors.surface-variant :
                        variant == "danger" ? #F87171 :
                        variant == "warning" ? #FBBF24 :
                        rgba(0, 0, 0, 0.05);
        }
    ]

    animate background { duration: Animation.fast; }

    HorizontalLayout {
        alignment: center;
        spacing: Spacing.sm;
        padding-left: Spacing.button-padding-h;
        padding-right: Spacing.button-padding-h;

        // Icon (if provided)
        if icon.width > 0 && !loading: Image {
            source: icon;
            width: icon-size;
            height: icon-size;
            colorize: variant == "primary" || variant == "danger" ? Colors.text-on-primary :
                      variant == "warning" ? Colors.text-primary :
                      Colors.text-primary;
        }

        // Loading indicator (simple text for now)
        if loading: Text {
            text: "...";
            font-size: Typography.body;
            font-weight: Typography.semi-bold;
            color: variant == "primary" || variant == "danger" ? Colors.text-on-primary :
                   variant == "warning" ? Colors.text-primary :
                   Colors.text-primary;
            vertical-alignment: center;
        }

        // Button text
        if !loading || text != "": Text {
            text: root.text;
            font-size: Typography.body;
            font-weight: Typography.semi-bold;
            color: disabled ? Colors.text-secondary :
                   variant == "primary" || variant == "danger" ? Colors.text-on-primary :
                   variant == "warning" ? Colors.text-primary :
                   Colors.text-primary;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: !disabled && !loading;
        mouse-cursor: disabled ? default : pointer;
        clicked => { root.clicked(); }
    }
}

// ============================================================================
// SMALL BUTTON COMPONENT
// ============================================================================

export component SmallButton inherits Rectangle {
    in property <string> text: "Button";
    in property <string> variant: "primary";
    in property <bool> disabled: false;

    callback clicked;

    height: Sizes.button-small;
    min-width: 80px;
    border-radius: Radius.button;

    background: disabled ? Colors.border :
                variant == "primary" ? Colors.primary :
                variant == "secondary" ? Colors.surface :
                variant == "danger" ? Colors.danger :
                variant == "warning" ? Colors.warning :
                transparent;

    border-width: variant == "secondary" ? 1px : 0px;
    border-color: Colors.border;

    states [
        pressed when touch.pressed && !disabled: {
            background: variant == "primary" ? Colors.primary-dark :
                        variant == "secondary" ? Colors.border :
                        variant == "danger" ? #DC2626 :
                        variant == "warning" ? #D97706 :
                        rgba(0, 0, 0, 0.1);
        }
    ]

    animate background { duration: Animation.fast; }

    HorizontalLayout {
        alignment: center;
        padding-left: Spacing.lg;
        padding-right: Spacing.lg;

        Text {
            text: root.text;
            font-size: Typography.caption;
            font-weight: Typography.semi-bold;
            color: disabled ? Colors.text-secondary :
                   variant == "primary" || variant == "danger" ? Colors.text-on-primary :
                   variant == "warning" ? Colors.text-primary :
                   Colors.text-primary;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: !disabled;
        mouse-cursor: disabled ? default : pointer;
        clicked => { root.clicked(); }
    }
}

// ============================================================================
// ICON BUTTON COMPONENT
// ============================================================================

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> icon-text: ""; // Fallback text if no icon image
    in property <bool> disabled: false;
    in property <string> variant: "ghost"; // ghost, primary, danger
    in property <length> size: Sizes.touch-target;

    callback clicked;

    width: size;
    height: size;
    border-radius: Radius.md;
    background: variant == "primary" ? Colors.primary :
                variant == "danger" ? Colors.danger :
                transparent;

    states [
        pressed when touch.pressed && !disabled: {
            background: variant == "primary" ? Colors.primary-dark :
                        variant == "danger" ? #DC2626 :
                        rgba(0, 0, 0, 0.1);
        }
        hovered when touch.has-hover && !disabled && !touch.pressed: {
            background: variant == "primary" ? Colors.primary-light :
                        variant == "danger" ? #F87171 :
                        rgba(0, 0, 0, 0.05);
        }
    ]

    animate background { duration: Animation.fast; }

    if icon.width > 0: Image {
        source: icon;
        width: Sizes.icon-md;
        height: Sizes.icon-md;
        colorize: disabled ? Colors.disabled :
                  variant == "primary" || variant == "danger" ? Colors.text-on-primary :
                  Colors.text-primary;
    }

    if icon.width == 0 && icon-text != "": Text {
        text: icon-text;
        font-size: Typography.heading;
        color: disabled ? Colors.disabled :
               variant == "primary" || variant == "danger" ? Colors.text-on-primary :
               Colors.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: !disabled;
        mouse-cursor: disabled ? default : pointer;
        clicked => { root.clicked(); }
    }
}

// ============================================================================
// LARGE BUTTON COMPONENT (for important actions)
// ============================================================================

export component LargeButton inherits Rectangle {
    in property <string> text: "Button";
    in property <string> variant: "primary";
    in property <bool> disabled: false;
    in property <image> icon;

    callback clicked;

    height: Sizes.button-large;
    min-width: 160px;
    border-radius: Radius.lg;

    background: disabled ? Colors.border :
                variant == "primary" ? Colors.primary :
                variant == "secondary" ? Colors.surface :
                variant == "danger" ? Colors.danger :
                variant == "success" ? Colors.success :
                transparent;

    border-width: variant == "secondary" ? 1px : 0px;
    border-color: Colors.border;

    states [
        pressed when touch.pressed && !disabled: {
            background: variant == "primary" ? Colors.primary-dark :
                        variant == "secondary" ? Colors.border :
                        variant == "danger" ? #DC2626 :
                        variant == "success" ? #16A34A :
                        rgba(0, 0, 0, 0.1);
        }
    ]

    animate background { duration: Animation.fast; }

    HorizontalLayout {
        alignment: center;
        spacing: Spacing.md;
        padding-left: Spacing.xxl;
        padding-right: Spacing.xxl;

        if icon.width > 0: Image {
            source: icon;
            width: Sizes.icon-lg;
            height: Sizes.icon-lg;
            colorize: variant == "primary" || variant == "danger" || variant == "success" ?
                      Colors.text-on-primary : Colors.text-primary;
        }

        Text {
            text: root.text;
            font-size: Typography.subheading;
            font-weight: Typography.semi-bold;
            color: disabled ? Colors.text-secondary :
                   variant == "primary" || variant == "danger" || variant == "success" ?
                   Colors.text-on-primary : Colors.text-primary;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: !disabled;
        mouse-cursor: disabled ? default : pointer;
        clicked => { root.clicked(); }
    }
}

// ============================================================================
// QUICK AMOUNT BUTTON (for payment screens)
// ============================================================================

export component QuickAmountButton inherits Rectangle {
    in property <string> amount: "100";
    in property <string> currency: CartState.currency;
    in property <bool> selected: false;
    in property <bool> disabled: false;

    callback clicked;

    width: Sizes.shortcut-width;
    height: Sizes.shortcut-height;
    border-radius: Radius.lg;
    background: selected ? Colors.primary : Colors.surface;
    border-width: selected ? 0px : 1px;
    border-color: Colors.border;

    states [
        pressed when touch.pressed && !disabled: {
            background: selected ? Colors.primary-dark : Colors.surface-variant;
        }
    ]

    animate background { duration: Animation.fast; }

    VerticalLayout {
        alignment: center;
        spacing: Spacing.xxs;

        Text {
            text: amount;
            font-size: Typography.heading;
            font-weight: Typography.bold;
            color: selected ? Colors.text-on-primary : Colors.text-primary;
            horizontal-alignment: center;
        }

        Text {
            text: currency;
            font-size: Typography.small;
            color: selected ? Colors.text-muted : Colors.text-secondary;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: !disabled;
        mouse-cursor: disabled ? default : pointer;
        clicked => { root.clicked(); }
    }
}
