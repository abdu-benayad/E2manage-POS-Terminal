// ============================================================================
// E2Manage POS Terminal - Card Component
// ============================================================================
// Reusable card container component for layout
// Supports optional title header and shadow effects
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Animation, Layout } from "../theme.slint";

// ============================================================================
// CARD COMPONENT
// ============================================================================

export component Card inherits Rectangle {
    in property <string> title: "";
    in property <bool> has-shadow: true;
    in property <bool> clickable: false;
    in property <string> subtitle: "";
    in property <bool> show-divider: true;

    callback clicked;

    border-radius: Radius.card;
    background: Colors.surface;
    border-width: has-shadow ? 0px : 1px;
    border-color: Colors.border;
    clip: true;

    states [
        pressed when touch.pressed && clickable: {
            background: Colors.surface-variant;
        }
        hovered when touch.has-hover && clickable && !touch.pressed: {
            background: Colors.background;
        }
    ]

    animate background { duration: Animation.fast; }

    VerticalLayout {
        // Title header (optional)
        if title != "": Rectangle {
            height: subtitle != "" ? 64px : 48px;
            background: Colors.background;

            HorizontalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.lg;
                alignment: Layout.rtl ? end : start;

                VerticalLayout {
                    alignment: center;
                    spacing: Spacing.xxs;

                    Text {
                        text: title;
                        font-size: Typography.body;
                        font-weight: 600;
                        color: Colors.text-primary;
                        horizontal-alignment: Layout.rtl ? right : left;
                    }

                    if subtitle != "": Text {
                        text: subtitle;
                        font-size: Typography.caption;
                        color: Colors.text-secondary;
                        horizontal-alignment: Layout.rtl ? right : left;
                    }
                }
            }

            // Divider line
            if show-divider: Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Colors.border;
            }
        }

        @children
    }

    touch := TouchArea {
        enabled: clickable;
        mouse-cursor: clickable ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// ============================================================================
// CARD HEADER COMPONENT (standalone header for custom layouts)
// ============================================================================

export component CardHeader inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <bool> has-action: false;
    in property <string> action-text: "";

    callback action-clicked;

    height: subtitle != "" ? 64px : 48px;
    background: Colors.background;

    HorizontalLayout {
        padding-left: Spacing.lg;
        padding-right: Spacing.lg;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: Spacing.xxs;

            Text {
                text: title;
                font-size: Typography.body;
                font-weight: 600;
                color: Colors.text-primary;
                horizontal-alignment: Layout.rtl ? right : left;
            }

            if subtitle != "": Text {
                text: subtitle;
                font-size: Typography.caption;
                color: Colors.text-secondary;
                horizontal-alignment: Layout.rtl ? right : left;
            }
        }

        if has-action: Rectangle {
            width: action-touch.width;
            height: parent.height;

            action-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.action-clicked(); }

                Text {
                    text: action-text;
                    font-size: Typography.caption;
                    font-weight: Typography.medium;
                    color: Colors.primary;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Divider
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Colors.border;
    }
}

// ============================================================================
// CARD CONTENT COMPONENT (padded content area)
// ============================================================================

export component CardContent inherits Rectangle {
    in property <length> padding-h: Spacing.lg;
    in property <length> padding-v: Spacing.lg;

    background: transparent;

    HorizontalLayout {
        padding-left: padding-h;
        padding-right: padding-h;
        padding-top: padding-v;
        padding-bottom: padding-v;

        @children
    }
}

// ============================================================================
// CARD FOOTER COMPONENT (for action buttons)
// ============================================================================

export component CardFooter inherits Rectangle {
    in property <bool> show-divider: true;

    height: 56px;
    background: Colors.background;

    // Top divider
    if show-divider: Rectangle {
        y: 0;
        height: 1px;
        background: Colors.border;
    }

    HorizontalLayout {
        padding-left: Spacing.lg;
        padding-right: Spacing.lg;
        alignment: end;
        spacing: Spacing.md;

        @children
    }
}
