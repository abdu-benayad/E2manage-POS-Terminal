}

// ============================================================================
// COMPACT PRODUCT GRID (for smaller screens or dense layouts)
// ============================================================================

export component CompactProductGrid inherits Rectangle {
    in property <[ProductData]> products: [];
    in property <string> currency: CartState.currency;
    in property <bool> loading: false;

    callback product-selected(string);

    background: Colors.background;

    VerticalLayout {
        spacing: Spacing.sm;
        padding: Spacing.sm;

        // Loading state
        if loading: Rectangle {
            vertical-stretch: 1;

            Text {
                text: Locale.current == "ar" ? "جاري التحميل..." : "Loading...";
                font-size: Typography.body;
                color: Colors.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Empty state
        if !loading && products.length == 0: Rectangle {
            vertical-stretch: 1;

            Text {
                text: Locale.current == "ar" ? "لا توجد منتجات" : "No products";
                font-size: Typography.body;
                color: Colors.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Compact grid
        if !loading && products.length > 0: Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: Spacing.xs;

                // Row 1
                if products.length > 0: HorizontalLayout {
                    spacing: Spacing.xs;

                    for i in [0, 1, 2, 3, 4]: Rectangle {
                        width: 100px;
                        height: 100px;

                        if i < products.length: CompactProductTile {
                            name: products[i].name;
                            name-ar: products[i].name_ar;
                            price: products[i].price;
                            currency: root.currency;
                            out-of-stock: products[i].out_of_stock;
                            product-id: products[i].id;
                            category-color: products[i].category_color;
                            clicked(id) => { root.product-selected(id); }
                        }
                    }
                }
            }
        }
    }
}

// ============================================================================
// PRODUCT LIST VIEW (alternative to grid)
// ============================================================================

export component ProductListView inherits Rectangle {
    in property <[ProductData]> products: [];
    in property <string> currency: CartState.currency;
    in property <bool> loading: false;

    callback product-selected(string);

    background: Colors.surface;

    VerticalLayout {
        spacing: 0px;

        // Loading state
        if loading: Rectangle {
            vertical-stretch: 1;

            Text {
                text: Locale.current == "ar" ? "جاري التحميل..." : "Loading...";
                font-size: Typography.body;
                color: Colors.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Empty state
        if !loading && products.length == 0: Rectangle {
            vertical-stretch: 1;

            Text {
                text: Locale.current == "ar" ? "لا توجد منتجات" : "No products";
                font-size: Typography.body;
                color: Colors.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Product list
        if !loading && products.length > 0: Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 0px;

                for product in products: ProductListItem {
                    name: product.name;
                    name-ar: product.name_ar;
                    sku: product.sku;
                    price: product.price;
                    currency: root.currency;
                    stock: product.stock;
                    low-stock: product.low_stock;
                    out-of-stock: product.out_of_stock;
                    product-id: product.id;
                    clicked(id) => { root.product-selected(id); }
                }
            }
        }
    }
}

// ============================================================================
// RECENT ITEMS STRIP (horizontal scrollable strip for recent products)
// ============================================================================

export component RecentItemsStrip inherits Rectangle {
    in property <[ProductData]> products: [];
    in property <string> currency: CartState.currency;
    in property <string> title: "";

    callback product-selected(string);

    background: Colors.background;

    VerticalLayout {
        spacing: Spacing.sm;

        // Title
        if title != "": HorizontalLayout {
            padding-left: Spacing.md;

            Text {
                text: title;
                font-size: Typography.caption;
                font-weight: 600;
                color: Colors.text-secondary;
                letter-spacing: 0.5px;
            }
        }

        // Horizontal scrollable strip
        Flickable {
            height: 168px;
            viewport-width: products.length * (140px + Spacing.sm) + Spacing.md;

            HorizontalLayout {
                spacing: Spacing.sm;
                padding-left: Spacing.md;
                padding-right: Spacing.md;

                for product in products: ProductTile {
                    name: product.name;
                    name-ar: product.name_ar;
                    sku: product.sku;
                    price: product.price;
                    currency: root.currency;
                    stock: product.stock;
                    low-stock: product.low_stock;
                    out-of-stock: product.out_of_stock;
                    product-id: product.id;
                    category-color: product.category_color;
                    product-type: product.product_type;
                    is-service: product.is_service;
                    clicked(id) => { root.product-selected(id); }
                }
            }
        }
    }
}
