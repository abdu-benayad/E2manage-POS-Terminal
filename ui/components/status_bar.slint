// ============================================================================
// E2Manage POS Terminal - StatusBar Component
// ============================================================================
// Bottom status bar showing terminal info, version, and connection status
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Animation, Locale, AppState, Layout } from "../theme.slint";

// Private StatusDot component — glossy LED-style indicator (no continuous animation)
component StatusDot inherits Rectangle {
    in property <bool> online: true;

    width: 40px;
    height: 40px;
    border-radius: 20px;

    // Outer ring — 2px dark border
    border-width: 2px;
    border-color: online ? #15803D : #B45309;

    // Main fill — glossy gradient (brighter top-left, deeper bottom-right)
    background: online
        ? @linear-gradient(145deg, #4ADE80 0%, #16A34A 60%, #15803D 100%)
        : @linear-gradient(145deg, #FCD34D 0%, #F59E0B 60%, #D97706 100%);

    // Only animate on online/offline state change — not continuously
    animate border-color { duration: Animation.normal; }
    animate background   { duration: Animation.normal; }

    // Static top-left gloss highlight (no Timer, no continuous redraws)
    Rectangle {
        x: 9px;
        y: 6px;
        width: 18px;
        height: 12px;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.55);
    }

    // Bottom inner shadow — gives depth
    Rectangle {
        x: 11px;
        y: parent.height - 16px;
        width: parent.width - 22px;
        height: 10px;
        border-radius: 5px;
        background: rgba(0, 0, 0, 0.25);
    }
}

// ============================================================================
// STATUSBAR COMPONENT
// ============================================================================
// Usage:
//   StatusBar {}
//   StatusBar { show-pending-count: true; }
// ============================================================================

export component StatusBar inherits Rectangle {
    // Whether to show pending sync count
    in property <bool> show-pending-count: true;

    // Allow override of terminal code (defaults to AppState)
    in property <string> terminal-code: AppState.terminal-code;

    // Allow override of version (defaults to AppState)
    in property <string> version: AppState.version;

    // Allow override of online status (defaults to AppState)
    in property <bool> is-online: AppState.is-online;

    // Allow override of pending count (defaults to AppState)
    in property <int> pending-sync-count: AppState.pending-sync-count;

    // Compact mode for responsive layout (smaller screens)
    in property <bool> compact: false;

    height: compact ? 40px : Sizes.status-bar-height;
    background: Colors.status-bar-bg;

    HorizontalLayout {
        padding-left: Spacing.xl;
        padding-right: Spacing.xl;
        spacing: Spacing.lg;
        alignment: space-between;

        // Left section - Terminal info
        HorizontalLayout {
            spacing: Spacing.lg;
            alignment: Layout.rtl ? end : start;

            Text {
                text: (Locale.current == "ar" ? "الجهاز: " : "Terminal: ") + terminal-code;
                font-size: Typography.caption;
                color: rgba(255, 255, 255, 0.9);
                vertical-alignment: center;
            }

            Rectangle {
                width: 1px;
                height: 20px;
                background: rgba(255, 255, 255, 0.2);
            }

            Text {
                text: version;
                font-size: Typography.caption;
                color: rgba(255, 255, 255, 0.6);
                vertical-alignment: center;
            }
        }

        // Right section - Connection status
        HorizontalLayout {
            spacing: Spacing.sm;
            alignment: Layout.rtl ? start : end;

            Text {
                text: is-online ? Locale.online : Locale.offline;
                font-size: Typography.caption;
                color: is-online ? #A5D6A7 : Colors.warning;
                vertical-alignment: center;
            }

            StatusDot { online: is-online; }

            // Pending sync count (only show if enabled and count > 0)
            if show-pending-count && pending-sync-count > 0: Rectangle {
                width: pending-count-text.preferred-width + Spacing.sm * 2;
                height: 20px;
                border-radius: 10px;
                background: Colors.warning;

                pending-count-text := Text {
                    text: pending-sync-count >= 100 ? "99+" : pending-sync-count + "";
                    font-size: Typography.tiny;
                    font-weight: 600;
                    color: Colors.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// ============================================================================
// COMPACT STATUSBAR (for smaller screens)
// ============================================================================

export component CompactStatusBar inherits Rectangle {
    in property <bool> is-online: AppState.is-online;
    in property <int> pending-sync-count: AppState.pending-sync-count;

    height: 32px;
    background: Colors.status-bar-bg;

    HorizontalLayout {
        padding-left: Spacing.lg;
        padding-right: Spacing.lg;
        spacing: Spacing.md;
        alignment: space-between;

        // Left - Terminal
        Text {
            text: AppState.terminal-code;
            font-size: Typography.small;
            color: rgba(255, 255, 255, 0.8);
            vertical-alignment: center;
        }

        // Right - Status
        HorizontalLayout {
            spacing: Spacing.xs;
            alignment: end;

            StatusDot { online: is-online; }

            if pending-sync-count > 0: Text {
                text: "(" + pending-sync-count + ")";
                font-size: Typography.tiny;
                color: Colors.warning;
                vertical-alignment: center;
            }
        }
    }
}
