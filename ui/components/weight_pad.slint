// ============================================================================
// E2Manage POS Terminal - Weight Pad Component (Phase 3 — Scale/Weight Display)
// ============================================================================
// Overlay for weighing items on a connected scale
// Used by cashiers for produce, bakery, and bulk items
// Supports manual entry when scale is not connected
// Follows PLUPad/QuantityPad/PriceCheckOverlay pattern
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Animation, Layout, Locale } from "../theme.slint";
import { Button, SmallButton } from "button.slint";
import { NumericKeypad } from "numeric_keypad.slint";

// ============================================================================
// WEIGHT PAD COMPONENT
// ============================================================================

export component WeightPad inherits Rectangle {
    // Visibility toggle
    in-out property <bool> open: false;

    // Product context
    in property <string> product-name: "";
    in property <string> price-per-unit: "";       // e.g., "12.500 LYD/كجم"
    in property <string> product-unit: "";          // e.g., "كجم" or "kg"

    // Live weight data (set from Rust via scale readings)
    in property <string> weight-display: "0.000";   // Large weight number
    in property <bool> weight-stable: false;         // Green when stable, yellow when moving
    in property <string> computed-total: "0.000";    // weight × unit_price
    in property <bool> scale-connected: false;       // Whether hardware scale is online

    // Manual entry mode (when no scale)
    in property <bool> manual-mode: false;
    in-out property <string> manual-weight-value: "";

    // Error display
    in property <string> error-message: "";

    // Callbacks
    callback confirmed(string);       // Fires with weight value (either from scale or manual)
    callback tare-requested;          // Tare/zero button
    callback closed;                  // Dismiss

    // Full screen overlay
    if open: Rectangle {
        width: 100%;
        height: 100%;
        background: Colors.overlay;

        // Backdrop click to close
        TouchArea {
            clicked => {
                root.manual-weight-value = "";
                root.open = false;
                root.closed();
            }
        }

        // Weight Pad dialog panel
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 420px;
            height: root.manual-mode ? 580px : 420px;
            border-radius: Radius.dialog;
            background: Colors.surface;
            drop-shadow-blur: 20px;
            drop-shadow-color: rgba(0, 0, 0, 0.3);
            drop-shadow-offset-y: 8px;

            // Block clicks from propagating to backdrop
            TouchArea {}

            VerticalLayout {
                padding: Spacing.lg;
                spacing: Spacing.md;

                // Title bar with close button
                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: Locale.current == "ar" ? "الوزن" :
                              Locale.current == "fr" ? "Peser" :
                              "Weigh Item";
                        font-size: Typography.heading;
                        font-weight: 600;
                        color: Colors.text-primary;
                        vertical-alignment: center;
                    }

                    // Close button
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: close-touch.has-hover ? Colors.surface-variant : transparent;

                        Text {
                            text: "\u{2715}";
                            font-size: Typography.body;
                            font-weight: 700;
                            color: Colors.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        close-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.manual-weight-value = "";
                                root.open = false;
                                root.closed();
                            }
                        }
                    }
                }

                // Product info row: name + price per unit
                if root.product-name != "": Rectangle {
                    height: 44px;
                    border-radius: Radius.md;
                    background: Colors.background;
                    border-width: 1px;
                    border-color: Colors.border;

                    HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        alignment: space-between;

                        Text {
                            text: root.product-name;
                            font-size: Typography.body;
                            font-weight: 600;
                            color: Colors.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: root.price-per-unit;
                            font-size: Typography.body;
                            font-weight: 700;
                            color: Colors.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Large weight display area
                Rectangle {
                    height: 80px;
                    border-radius: Radius.md;
                    border-width: 2px;
                    border-color: root.manual-mode ?
                        (root.manual-weight-value != "" ? Colors.primary : Colors.border) :
                        (root.weight-stable ? Colors.success : Colors.warning);
                    background: root.manual-mode ?
                        Colors.background :
                        (root.weight-stable ? rgba(34, 197, 94, 0.05) : rgba(245, 158, 11, 0.05));

                    HorizontalLayout {
                        padding-left: Spacing.lg;
                        padding-right: Spacing.lg;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: Spacing.sm;
                            alignment: center;

                            // Stability indicator dot
                            if !root.manual-mode: Rectangle {
                                width: 14px;
                                height: 14px;
                                border-radius: 7px;
                                background: root.scale-connected ?
                                    (root.weight-stable ? Colors.success : Colors.warning) :
                                    Colors.disabled;
                            }

                            // Weight value
                            Text {
                                text: root.manual-mode ?
                                    (root.manual-weight-value != "" ? root.manual-weight-value : "0.000") :
                                    root.weight-display;
                                font-size: 40px;
                                font-weight: 700;
                                color: root.manual-mode ?
                                    (root.manual-weight-value != "" ? Colors.text-primary : Colors.disabled) :
                                    Colors.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        // Unit label
                        Text {
                            text: root.product-unit;
                            font-size: Typography.title;
                            font-weight: 600;
                            color: Colors.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Computed total row
                Rectangle {
                    height: 48px;
                    border-radius: Radius.md;
                    background: rgba(59, 130, 246, 0.08);
                    border-width: 1px;
                    border-color: rgba(59, 130, 246, 0.2);

                    HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        alignment: space-between;

                        Text {
                            text: Locale.current == "ar" ? "الإجمالي:" :
                                  Locale.current == "fr" ? "Total :" :
                                  "Total:";
                            font-size: Typography.body;
                            font-weight: 600;
                            color: Colors.text-secondary;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.computed-total;
                            font-size: Typography.title;
                            font-weight: 700;
                            color: Colors.primary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Manual entry keypad (when scale is not connected)
                if root.manual-mode: HorizontalLayout {
                    alignment: center;

                    NumericKeypad {
                        mode: "amount";
                        value <=> root.manual-weight-value;
                        max-length: 7;
                        confirm-label: "\u{2713}";

                        confirmed(weight) => {
                            if weight != "" {
                                root.confirmed(weight);
                            }
                        }

                        backspace => {
                            // Rust handles trimming the value
                        }
                    }
                }

                // Scale not connected warning (in non-manual mode — shouldn't happen often)
                if !root.manual-mode && !root.scale-connected: Rectangle {
                    height: 44px;
                    border-radius: Radius.md;
                    background: rgba(245, 158, 11, 0.1);
                    border-width: 1px;
                    border-color: rgba(245, 158, 11, 0.3);

                    HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        alignment: center;
                        spacing: Spacing.sm;

                        Text {
                            text: "!";
                            font-size: 16px;
                            font-weight: 700;
                            color: Colors.warning;
                            vertical-alignment: center;
                        }

                        Text {
                            text: Locale.current == "ar" ? "الميزان غير متصل" :
                                  Locale.current == "fr" ? "Balance non connectée" :
                                  "Scale not connected";
                            font-size: Typography.caption;
                            color: Colors.warning;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }

                // Error message
                if root.error-message != "": Rectangle {
                    height: 44px;
                    border-radius: Radius.md;
                    background: rgba(239, 68, 68, 0.1);
                    border-width: 1px;
                    border-color: rgba(239, 68, 68, 0.3);

                    HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        alignment: center;
                        spacing: Spacing.sm;

                        Text {
                            text: "\u{2715}";
                            font-size: 16px;
                            font-weight: 700;
                            color: Colors.danger;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.error-message;
                            font-size: Typography.caption;
                            color: Colors.danger;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }

                // Bottom action buttons
                HorizontalLayout {
                    spacing: Spacing.md;

                    // Tare / Zero button (only when scale connected and not manual)
                    if !root.manual-mode && root.scale-connected: Button {
                        text: Locale.current == "ar" ? "صفر" :
                              Locale.current == "fr" ? "Tare" :
                              "Tare";
                        variant: "secondary";
                        horizontal-stretch: 1;
                        clicked => { root.tare-requested(); }
                    }

                    // Confirm button
                    Button {
                        text: Locale.current == "ar" ? "تأكيد" :
                              Locale.current == "fr" ? "Confirmer" :
                              "Confirm";
                        variant: "primary";
                        horizontal-stretch: 2;
                        // Disable when no weight or unstable reading (non-manual mode)
                        disabled: root.manual-mode ?
                            root.manual-weight-value == "" :
                            (!root.weight-stable || root.weight-display == "0.000");

                        clicked => {
                            if root.manual-mode {
                                if root.manual-weight-value != "" {
                                    root.confirmed(root.manual-weight-value);
                                }
                            } else {
                                root.confirmed(root.weight-display);
                            }
                        }
                    }
                }
            }
        }
    }
}
