// ============================================================================
// E2Manage POS Terminal - Quantity Pad Component (Phase 3 — Quick Quantity Entry)
// ============================================================================
// Overlay panel for entering exact item quantities (1-999)
// Used by cashiers when scanning multiples of the same item
// Supports RTL (Arabic) layout and both compact/desktop modes
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Animation, Layout, Locale } from "../theme.slint";
import { Button, SmallButton } from "button.slint";
import { NumericKeypad } from "numeric_keypad.slint";

// ============================================================================
// QUICK-PICK BUTTON (internal — for ×2, ×3, ×5, ×10)
// ============================================================================

component QuickPickButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> disabled: false;
    callback clicked;

    width: 72px;
    height: 40px;
    border-radius: Radius.md;
    background: disabled ? Colors.surface-variant :
                touch.pressed ? Colors.primary :
                touch.has-hover ? rgba(59, 130, 246, 0.1) :
                Colors.surface;
    border-width: 1px;
    border-color: disabled ? Colors.border : Colors.primary;

    animate background { duration: Animation.fast; }

    Text {
        text: root.label;
        font-size: Typography.body;
        font-weight: Typography.semi-bold;
        color: disabled ? Colors.disabled :
               touch.pressed ? Colors.text-on-primary :
               Colors.primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: !disabled;
        mouse-cursor: disabled ? default : pointer;
        clicked => { root.clicked(); }
    }
}

// ============================================================================
// QUANTITY PAD COMPONENT
// ============================================================================

export component QuantityPad inherits Rectangle {
    // Visibility toggle
    in-out property <bool> open: false;

    // Current quantity input
    in-out property <string> qty-value: "";

    // Item context (set from Rust when opening)
    in-out property <string> item-id: "";
    in property <string> item-name: "";
    in property <string> item-price: "";
    in property <int> current-qty: 1;
    in property <string> error-message: "";

    // Callbacks
    callback confirmed(string, string);  // Fires with (item-id, quantity) when user confirms
    callback closed;                     // Fires when pad dismissed

    // Full screen overlay
    if open: Rectangle {
        width: 100%;
        height: 100%;
        background: Colors.overlay;

        // Backdrop click to close
        TouchArea {
            clicked => {
                root.qty-value = "";
                root.open = false;
                root.closed();
            }
        }

        // Quantity Pad dialog panel
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 380px;
            height: root.error-message != "" ? 540px : 500px;
            border-radius: Radius.dialog;
            background: Colors.surface;
            drop-shadow-blur: 20px;
            drop-shadow-color: rgba(0, 0, 0, 0.3);
            drop-shadow-offset-y: 8px;

            // Block clicks from propagating to backdrop
            TouchArea {}

            VerticalLayout {
                padding: Spacing.lg;
                spacing: Spacing.md;

                // Title bar with close button
                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: Locale.current == "ar" ? "تعديل الكمية" : "Set Quantity";
                        font-size: Typography.heading;
                        font-weight: 600;
                        color: Colors.text-primary;
                        vertical-alignment: center;
                    }

                    // Close button
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: close-touch.has-hover ? Colors.surface-variant : transparent;

                        Text {
                            text: "\u{2715}";
                            font-size: Typography.body;
                            font-weight: 700;
                            color: Colors.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        close-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.qty-value = "";
                                root.open = false;
                                root.closed();
                            }
                        }
                    }
                }

                // Product context: name + unit price
                if root.item-name != "": Rectangle {
                    height: 44px;
                    border-radius: Radius.md;
                    background: Colors.background;
                    border-width: 1px;
                    border-color: Colors.border;

                    HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        alignment: space-between;

                        Text {
                            text: root.item-name;
                            font-size: Typography.body;
                            font-weight: 600;
                            color: Colors.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: root.item-price;
                            font-size: Typography.body;
                            font-weight: 700;
                            color: Colors.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Current quantity display
                Rectangle {
                    height: 32px;

                    HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.xs;

                        Text {
                            text: Locale.current == "ar" ? "الكمية الحالية:" : "Current:";
                            font-size: Typography.caption;
                            color: Colors.text-secondary;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.current-qty;
                            font-size: Typography.body;
                            font-weight: Typography.bold;
                            color: Colors.primary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Input display area
                Rectangle {
                    height: 52px;
                    border-radius: Radius.md;
                    border-width: 2px;
                    border-color: root.qty-value != "" ? Colors.primary : Colors.border;
                    background: Colors.background;

                    HorizontalLayout {
                        padding-left: Spacing.lg;
                        padding-right: Spacing.lg;
                        alignment: start;

                        Text {
                            text: "\u{00D7}";
                            font-size: Typography.title;
                            font-weight: Typography.bold;
                            color: Colors.primary;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.qty-value != "" ? root.qty-value : "_ _ _";
                            font-size: Typography.title;
                            font-weight: Typography.bold;
                            letter-spacing: root.qty-value == "" ? 4px : 2px;
                            color: root.qty-value != "" ? Colors.text-primary : Colors.disabled;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }

                // Quick-pick buttons row: ×2, ×3, ×5, ×10
                HorizontalLayout {
                    alignment: center;
                    spacing: Spacing.sm;

                    QuickPickButton {
                        label: "\u{00D7}2";
                        clicked => {
                            root.confirmed(root.item-id, "2");
                        }
                    }

                    QuickPickButton {
                        label: "\u{00D7}3";
                        clicked => {
                            root.confirmed(root.item-id, "3");
                        }
                    }

                    QuickPickButton {
                        label: "\u{00D7}5";
                        clicked => {
                            root.confirmed(root.item-id, "5");
                        }
                    }

                    QuickPickButton {
                        label: "\u{00D7}10";
                        clicked => {
                            root.confirmed(root.item-id, "10");
                        }
                    }
                }

                // Numeric keypad
                HorizontalLayout {
                    alignment: center;

                    NumericKeypad {
                        mode: "pin";
                        value <=> root.qty-value;
                        max-length: 3;
                        confirm-label: "\u{2713}";

                        confirmed(qty) => {
                            if qty != "" {
                                root.confirmed(root.item-id, qty);
                            }
                        }

                        backspace => {
                            // NumericKeypad fires backspace callback;
                            // Rust handles trimming the value since Slint can't slice strings
                        }
                    }
                }

                // Error display area
                if root.error-message != "": Rectangle {
                    height: 44px;
                    border-radius: Radius.md;
                    background: rgba(239, 68, 68, 0.1);
                    border-width: 1px;
                    border-color: rgba(239, 68, 68, 0.3);

                    HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        alignment: center;
                        spacing: Spacing.sm;

                        Text {
                            text: "\u{2715}";
                            font-size: 16px;
                            font-weight: 700;
                            color: Colors.danger;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.error-message;
                            font-size: Typography.caption;
                            color: Colors.danger;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
}
