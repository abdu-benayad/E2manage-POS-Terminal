// ============================================================================
// E2Manage POS Terminal - Side Menu Component (Phase 1 Enhancement)
// ============================================================================
// Slide-out menu for infrequent actions (Drafts, Transfer, Returns, End Shift)
// Triggered by hamburger menu button in header
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Animation, Layout, Locale, AppState } from "../theme.slint";

// ============================================================================
// MENU ITEM COMPONENT
// ============================================================================

component MenuItem inherits Rectangle {
    in property <string> icon: "";
    in property <string> label: "";
    in property <string> description: "";
    in property <bool> danger: false;

    callback clicked;

    height: 56px;
    background: touch.pressed ? Colors.surface-variant :
                touch.has-hover ? Colors.surface : transparent;

    animate background { duration: Animation.fast; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: Spacing.lg;
        padding-right: Spacing.lg;
        spacing: Spacing.md;

        // Icon
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: Radius.md;
            background: danger ? rgba(239, 68, 68, 0.1) : Colors.surface-variant;

            Text {
                text: icon;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Label and description
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;

            Text {
                text: label;
                font-size: Typography.body;
                font-weight: 500;
                color: danger ? Colors.danger : Colors.text-primary;
                horizontal-alignment: Layout.rtl ? right : left;
            }

            if description != "": Text {
                text: description;
                font-size: Typography.small;
                color: Colors.text-secondary;
                horizontal-alignment: Layout.rtl ? right : left;
            }
        }

        // Chevron
        Text {
            text: Layout.rtl ? "\u{2039}" : "\u{203A}";
            font-size: 20px;
            color: Colors.text-secondary;
            vertical-alignment: center;
        }
    }

    // Bottom divider
    Rectangle {
        y: parent.height - 1px;
        x: Spacing.lg;
        width: parent.width - (Spacing.lg * 2);
        height: 1px;
        background: Colors.border;
    }
}

// ============================================================================
// SIDE MENU PANEL
// ============================================================================

export component SideMenu inherits Rectangle {
    in property <bool> visible-menu: false;
    in property <string> operator-name: "";
    in property <string> shift-number: "";

    callback close-menu;
    callback drafts-clicked;
    callback transfer-clicked;
    callback returns-clicked;
    callback end-shift-clicked;
    callback settings-clicked;

    // Full screen overlay
    width: 100%;
    height: 100%;
    visible: visible-menu;

    // Semi-transparent backdrop
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: rgba(0, 0, 0, 0.4);

        TouchArea {
            clicked => { root.close-menu(); }
        }
    }

    // Menu panel (slides from start side — right in RTL, left in LTR)
    Rectangle {
        x: Layout.rtl ? parent.width - self.width : 0px;
        width: 300px;
        height: parent.height;
        background: Colors.background;

        // Shadow edge
        Rectangle {
            x: Layout.rtl ? -4px : parent.width;
            width: 4px;
            height: parent.height;
            background: rgba(0, 0, 0, 0.1);
        }

        VerticalLayout {
            spacing: 0px;

            // Menu header
            Rectangle {
                height: 64px;
                background: Colors.primary;

                HorizontalLayout {
                    padding-left: Spacing.lg;
                    padding-right: Spacing.lg;
                    spacing: Spacing.md;
                    alignment: space-between;

                    // Operator info
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: operator-name;
                            font-size: Typography.body;
                            font-weight: 600;
                            color: Colors.text-on-primary;
                            horizontal-alignment: Layout.rtl ? right : left;
                        }

                        if shift-number != "": Text {
                            text: (Locale.current == "ar" ? "الوردية #" : "Shift #")
                                  + shift-number;
                            font-size: Typography.small;
                            color: rgba(255, 255, 255, 0.7);
                            horizontal-alignment: Layout.rtl ? right : left;
                        }
                    }

                    // Close button
                    Rectangle {
                        width: Sizes.touch-target;
                        height: Sizes.touch-target;
                        border-radius: Sizes.touch-target / 2;
                        background: close-touch.has-hover ?
                                    rgba(255, 255, 255, 0.1) : transparent;

                        close-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close-menu(); }
                        }

                        Text {
                            text: "\u{2715}";  // ✕
                            font-size: 20px;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        animate background { duration: Animation.fast; }
                    }
                }
            }

            // Menu items
            Flickable {
                vertical-stretch: 1;

                VerticalLayout {
                    padding-top: Spacing.sm;
                    spacing: 0px;

                    // Section: Operations
                    Rectangle {
                        height: 36px;
                        HorizontalLayout {
                            padding-left: Spacing.lg;
                            Text {
                                text: Locale.current == "ar" ? "العمليات" : "Operations";
                                font-size: Typography.small;
                                font-weight: 600;
                                color: Colors.text-secondary;
                                vertical-alignment: center;
                                horizontal-alignment: Layout.rtl ? right : left;
                            }
                        }
                    }

                    MenuItem {
                        icon: "\u{1F4CB}";  // Clipboard
                        label: Locale.current == "ar" ? "المسودات" : "Drafts";
                        description: Locale.current == "ar" ?
                            "حفظ واسترجاع المعاملات المعلقة" :
                            "Save and recall pending transactions";
                        clicked => { root.drafts-clicked(); root.close-menu(); }
                    }

                    MenuItem {
                        icon: "\u{1F504}";  // Arrows circle
                        label: Locale.current == "ar" ? "تحويل" : "Transfer";
                        description: Locale.current == "ar" ?
                            "تحويل المعاملة إلى نقطة بيع أخرى" :
                            "Transfer transaction to another terminal";
                        clicked => { root.transfer-clicked(); root.close-menu(); }
                    }

                    MenuItem {
                        icon: "\u{21A9}";  // Return arrow
                        label: Locale.current == "ar" ? "المرتجعات" : "Returns";
                        description: Locale.current == "ar" ?
                            "معالجة إرجاع المنتجات" :
                            "Process product returns";
                        clicked => { root.returns-clicked(); root.close-menu(); }
                    }

                    // Spacer
                    Rectangle { height: Spacing.md; }

                    // Section: Shift
                    Rectangle {
                        height: 36px;
                        HorizontalLayout {
                            padding-left: Spacing.lg;
                            Text {
                                text: Locale.current == "ar" ? "الوردية" : "Shift";
                                font-size: Typography.small;
                                font-weight: 600;
                                color: Colors.text-secondary;
                                vertical-alignment: center;
                                horizontal-alignment: Layout.rtl ? right : left;
                            }
                        }
                    }

                    MenuItem {
                        icon: "\u{23F9}";  // Stop/End
                        label: Locale.current == "ar" ? "إنهاء الوردية" : "End Shift";
                        description: Locale.current == "ar" ?
                            "إغلاق الوردية الحالية وطباعة تقرير Z" :
                            "Close current shift and print Z report";
                        danger: true;
                        clicked => { root.end-shift-clicked(); root.close-menu(); }
                    }

                    MenuItem {
                        icon: "\u{2699}";  // Gear
                        label: Locale.current == "ar" ? "الإعدادات" : "Settings";
                        clicked => { root.settings-clicked(); root.close-menu(); }
                    }
                }
            }

            // App version footer
            Rectangle {
                height: 40px;
                background: Colors.surface;

                Text {
                    text: "v" + AppState.version;
                    font-size: Typography.small;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
