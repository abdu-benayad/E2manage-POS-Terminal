// ============================================================================
// E2Manage POS Terminal - RTL Layout Components
// ============================================================================
// Phase 40: RTL-aware wrapper components for consistent bidirectional layouts
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Layout, Locale } from "../theme.slint";

// ============================================================================
// RTL-Aware Text Component
// ============================================================================

/// Text component that automatically aligns based on RTL setting.
/// Use for text that should align to the start of the reading direction.
export component RtlText inherits Text {
    horizontal-alignment: Layout.text-start;
}

/// Text component that aligns to the end of the reading direction.
/// Use for secondary text or values that should be on the opposite side.
export component RtlTextEnd inherits Text {
    horizontal-alignment: Layout.text-end;
}

// ============================================================================
// Back Button Component
// ============================================================================

/// Back button that automatically flips direction based on RTL setting.
/// Arrow points right (→) in RTL mode, left (←) in LTR mode.
export component BackButton inherits Rectangle {
    callback clicked;

    in property <color> icon-color: Colors.text-on-primary;
    in property <length> icon-size: 24px;

    width: 48px;
    height: 48px;
    border-radius: Radius.md;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // Hover/press states
    Rectangle {
        background: touch.pressed ? rgba(255, 255, 255, 0.2) :
                   touch.has-hover ? rgba(255, 255, 255, 0.1) : transparent;
        border-radius: parent.border-radius;
    }

    Text {
        text: Layout.back-arrow();
        font-size: root.icon-size;
        color: root.icon-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ============================================================================
// Forward Button Component
// ============================================================================

/// Forward/Next button that automatically flips direction based on RTL setting.
/// Arrow points left (←) in RTL mode, right (→) in LTR mode.
export component ForwardButton inherits Rectangle {
    callback clicked;

    in property <color> icon-color: Colors.text-on-primary;
    in property <length> icon-size: 24px;

    width: 48px;
    height: 48px;
    border-radius: Radius.md;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // Hover/press states
    Rectangle {
        background: touch.pressed ? rgba(255, 255, 255, 0.2) :
                   touch.has-hover ? rgba(255, 255, 255, 0.1) : transparent;
        border-radius: parent.border-radius;
    }

    Text {
        text: Layout.forward-arrow();
        font-size: root.icon-size;
        color: root.icon-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ============================================================================
// Navigation Row Component
// ============================================================================

/// A row with back button, title, and optional action that respects RTL.
/// Layout automatically mirrors in RTL mode.
export component NavigationRow inherits Rectangle {
    callback back-clicked;
    callback action-clicked;

    in property <string> title: "";
    in property <string> action-text: "";
    in property <bool> show-back: true;
    in property <bool> show-action: false;
    in property <color> title-color: Colors.text-on-primary;

    height: Sizes.header-height;
    background: Colors.primary;

    HorizontalLayout {
        padding-left: Spacing.lg;
        padding-right: Spacing.lg;
        spacing: Spacing.lg;
        alignment: space-between;

        HorizontalLayout {
            spacing: Spacing.lg;

            // Back button (always on start side)
            if show-back: BackButton {
                icon-color: root.title-color;
                clicked => { root.back-clicked(); }
            }

            // Title
            Text {
                text: root.title;
                font-size: Typography.heading;
                font-weight: 600;
                color: root.title-color;
                vertical-alignment: center;
                horizontal-alignment: Layout.text-start;
            }
        }

        // Action button (always on end side)
        if show-action: Rectangle {
            width: action-touch.width;
            height: 48px;

            action-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.action-clicked(); }
            }

            Text {
                text: root.action-text;
                font-size: Typography.body;
                font-weight: 500;
                color: root.title-color;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// ============================================================================
// List Row with Chevron
// ============================================================================

/// A list item row with label and trailing chevron that respects RTL.
/// Chevron points in the forward direction based on RTL setting.
export component ListRowWithChevron inherits Rectangle {
    callback clicked;

    in property <string> icon: "";
    in property <string> label: "";
    in property <string> value: "";
    in property <bool> show-chevron: true;

    height: Sizes.list-item-height;
    background: Colors.surface;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Rectangle {
        background: touch.pressed ? Colors.ripple :
                   touch.has-hover ? rgba(0, 0, 0, 0.04) : transparent;
    }

    HorizontalLayout {
        padding-left: Spacing.lg;
        padding-right: Spacing.lg;
        spacing: Spacing.md;
        alignment: space-between;

        HorizontalLayout {
            spacing: Spacing.md;

            // Icon (if provided)
            if icon != "": Text {
                text: root.icon;
                font-size: 20px;
                vertical-alignment: center;
            }

            // Label
            Text {
                text: root.label;
                font-size: Typography.body;
                color: Colors.text-primary;
                vertical-alignment: center;
                horizontal-alignment: Layout.text-start;
            }
        }

        HorizontalLayout {
            spacing: Spacing.sm;

            // Value (if provided)
            if value != "": Text {
                text: root.value;
                font-size: Typography.body;
                color: Colors.text-secondary;
                vertical-alignment: center;
            }

            // Chevron
            if show-chevron: Text {
                text: Layout.chevron-end();
                font-size: 18px;
                color: Colors.text-secondary;
                vertical-alignment: center;
            }
        }
    }
}

// ============================================================================
// Direction Indicator Component
// ============================================================================

/// A simple direction indicator that shows the current text direction.
/// Useful for debugging RTL support.
export component DirectionIndicator inherits Rectangle {
    in property <bool> compact: false;

    width: compact ? 24px : 64px;
    height: 24px;
    border-radius: Radius.sm;
    background: Layout.rtl ? Colors.primary : Colors.success;

    Text {
        text: Layout.rtl ? (compact ? "RTL" : "← RTL") : (compact ? "LTR" : "LTR →");
        font-size: Typography.small;
        color: Colors.text-on-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ============================================================================
// Bidirectional Container
// ============================================================================

/// A container that provides correct padding based on RTL setting.
/// start-padding is on the right in RTL, left in LTR.
export component BidiContainer inherits Rectangle {
    in property <length> start-padding: Spacing.lg;
    in property <length> end-padding: Spacing.lg;
    in property <length> top-padding: 0px;
    in property <length> bottom-padding: 0px;

    VerticalLayout {
        padding-top: root.top-padding;
        padding-bottom: root.bottom-padding;
        padding-left: Layout.rtl ? root.end-padding : root.start-padding;
        padding-right: Layout.rtl ? root.start-padding : root.end-padding;

        @children
    }
}
