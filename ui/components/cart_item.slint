// ============================================================================
// E2Manage POS Terminal - Cart Item Component (Phase 17)
// ============================================================================
// Individual cart item row with quantity controls, price display, and actions
// Supports RTL/Arabic locale, discount badges, and swipe-to-delete
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Animation, Layout, Locale, CartState } from "../theme.slint";

// ============================================================================
// CART ITEM DATA STRUCT
// ============================================================================

export struct CartItemData {
    id: string,
    product_id: string,
    name: string,
    name_ar: string,
    sku: string,
    quantity: int,
    unit_price: string,
    line_total: string,
    has_discount: bool,
    discount_label: string,
    discount_amount: string,
    original_price: string,
    unit: string,
    notes: string,
    quantity_display: string,  // Pre-formatted display (e.g., "1.250 كجم" for weighable items)
}

// ============================================================================
// CART ITEM COMPONENT
// ============================================================================

export component CartItem inherits Rectangle {
    // Core item data
    in property <string> item-id: "";
    in property <string> name: "Product";
    in property <string> name-ar: "";
    in property <string> sku: "";  // Hidden - not displayed (English technical term)
    in property <int> quantity: 1;
    in property <string> unit-price: "0.000";  // Unit price AFTER any discount
    in property <string> line-total: "0.000";  // NET total (quantity × unit-price) - THIS IS FINAL
    in property <string> currency: CartState.currency;
    in property <bool> has-discount: false;
    in property <string> discount-label: "";   // ONLY representation of discount (e.g., "-10%")
    in property <string> discount-amount: "0.000";  // Not displayed - redundant
    in property <string> original-price: "";   // Not displayed - confusing
    in property <string> unit: "";
    in property <string> notes: "";
    in property <string> quantity-display: "";  // Pre-formatted qty (e.g., "1.250 كجم")
    in property <bool> selected: false;

    callback increment;
    callback decrement;
    callback remove;
    callback edit;
    callback clicked;

    // Display name (Arabic preferred)
    property <string> display-name: Locale.current == "ar" && name-ar != "" ? name-ar : name;

    // Generous height for touch-friendly spacing (min 96px)
    height: notes != "" ? 104px : 96px;
    background: selected ? Colors.ripple :
                touch.has-hover ? Colors.surface-variant : Colors.surface;
    border-radius: Radius.sm;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        // Generous padding for touch separation
        padding: Spacing.lg;
        padding-right: Spacing.md;
        spacing: Spacing.md;

        // Product info + Quantity controls
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Spacing.md;

            // Product info (left side)
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Spacing.xs;
                alignment: center;

                // Product name with discount badge inline
                HorizontalLayout {
                    spacing: Spacing.sm;

                    Text {
                        text: display-name;
                        font-size: Typography.body;
                        font-weight: 600;
                        color: Colors.text-primary;
                        overflow: elide;
                        horizontal-stretch: 1;
                        horizontal-alignment: Layout.rtl ? right : left;
                        vertical-alignment: center;
                    }

                    // ONE discount indicator - the badge (if discounted)
                    if has-discount && discount-label != "": Rectangle {
                        background: #F97316; // High-contrast orange
                        border-radius: Radius.sm;
                        height: 24px;
                        width: discount-badge-text.preferred-width + Spacing.md;

                        discount-badge-text := Text {
                            text: discount-label;
                            font-size: Typography.small;
                            font-weight: 700;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Unit price × quantity (simple, clear)
                Text {
                    text: unit-price + " × " + (quantity-display != "" ? quantity-display : quantity);
                    font-size: Typography.caption;
                    color: Colors.text-secondary;
                    horizontal-alignment: Layout.rtl ? right : left;
                }

                // Notes line (if any)
                if notes != "": Text {
                    text: "📝 " + notes;
                    font-size: Typography.small;
                    color: Colors.warning;
                    overflow: elide;
                    horizontal-alignment: Layout.rtl ? right : left;
                }
            }

            // Quantity controls - generous touch targets
            HorizontalLayout {
                spacing: Spacing.xs;
                alignment: center;

                // Minus button - 44px touch target
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 22px;
                    background: minus-touch.pressed ? Colors.surface-variant :
                                minus-touch.has-hover ? Colors.background : Colors.surface;
                    border-width: 1px;
                    border-color: Colors.border;

                    minus-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.decrement(); }
                    }

                    Text {
                        text: "−";
                        font-size: 22px;
                        font-weight: 700;
                        color: quantity > 1 ? Colors.text-primary : Colors.disabled;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    animate background { duration: Animation.fast; }
                }

                // Quantity display (tappable to edit)
                Rectangle {
                    width: 48px;
                    height: 44px;

                    qty-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.edit(); }
                    }

                    Text {
                        text: quantity;
                        font-size: Typography.heading;
                        font-weight: 700;
                        color: Colors.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Plus button - 44px touch target
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 22px;
                    background: plus-touch.pressed ? Colors.primary-dark :
                                plus-touch.has-hover ? Colors.primary-light : Colors.primary;

                    plus-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.increment(); }
                    }

                    Text {
                        text: "+";
                        font-size: 22px;
                        font-weight: 700;
                        color: Colors.text-on-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    animate background { duration: Animation.fast; }
                }
            }
        }

        // Line total (NET - this is the FINAL amount for this line)
        VerticalLayout {
            width: 90px;
            alignment: center;

            Text {
                text: line-total;
                font-size: Typography.heading;
                font-weight: 700;
                color: Colors.text-primary;
                horizontal-alignment: right;
            }

            Text {
                text: currency;
                font-size: Typography.caption;
                color: Colors.text-secondary;
                horizontal-alignment: right;
            }
        }

        // Remove button - 48x48px generous touch target
        Rectangle {
            width: 48px;
            height: 48px;
            border-radius: 24px;
            background: remove-touch.pressed ? Colors.danger :
                        remove-touch.has-hover ? rgba(239, 68, 68, 0.2) : rgba(239, 68, 68, 0.1);

            remove-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.remove(); }
            }

            Text {
                text: "×";
                font-size: 28px;
                font-weight: 600;
                color: remove-touch.has-hover || remove-touch.pressed ? Colors.text-on-primary : Colors.danger;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            animate background { duration: Animation.fast; }
        }
    }

    // Bottom divider
    Rectangle {
        y: parent.height - 1px;
        width: parent.width - Spacing.lg;
        x: Layout.rtl ? 0px : Spacing.lg;
        height: 1px;
        background: Colors.divider;
    }

    animate background { duration: Animation.fast; }
}

// ============================================================================
// COMPACT CART ITEM - Smaller variant for dense cart views
// ============================================================================

export component CompactCartItem inherits Rectangle {
    in property <string> item-id: "";
    in property <string> name: "Product";
    in property <string> name-ar: "";
    in property <int> quantity: 1;
    in property <string> line-total: "0.000";
    in property <string> currency: CartState.currency;

    callback increment;
    callback decrement;
    callback remove;

    property <string> display-name: Locale.current == "ar" && name-ar != "" ? name-ar : name;

    height: 48px;
    background: touch.has-hover ? Colors.surface-variant : Colors.surface;

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        spacing: Spacing.xs;

        // Name
        Text {
            horizontal-stretch: 1;
            text: display-name;
            font-size: Typography.caption;
            color: Colors.text-primary;
            overflow: elide;
            vertical-alignment: center;
            horizontal-alignment: Layout.rtl ? right : left;
        }

        // Quantity badge
        Rectangle {
            width: 28px;
            height: 24px;
            background: Colors.primary;
            border-radius: Radius.sm;

            Text {
                text: "×" + quantity;
                font-size: Typography.small;
                font-weight: 600;
                color: Colors.text-on-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Total
        Text {
            width: 70px;
            text: line-total + " " + currency;
            font-size: Typography.caption;
            font-weight: 600;
            color: Colors.text-primary;
            vertical-alignment: center;
            horizontal-alignment: right;
        }

        // Remove
        Rectangle {
            width: 24px;
            height: 24px;

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.remove(); }
            }

            Text {
                text: "×";
                font-size: 16px;
                color: Colors.danger;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// ============================================================================
// CART ITEM SKELETON - Loading placeholder
// ============================================================================

export component CartItemSkeleton inherits Rectangle {
    height: 72px;
    background: Colors.surface;

    HorizontalLayout {
        padding: Spacing.sm;
        padding-left: Spacing.md;
        spacing: Spacing.md;

        // Name placeholder
        Rectangle {
            horizontal-stretch: 1;
            height: 16px;
            background: Colors.surface-variant;
            border-radius: Radius.sm;

            animate background { duration: Animation.pulse; }
        }

        // Qty placeholder
        Rectangle {
            width: 80px;
            height: 32px;
            background: Colors.surface-variant;
            border-radius: Radius.md;
        }

        // Total placeholder
        Rectangle {
            width: 70px;
            height: 16px;
            background: Colors.surface-variant;
            border-radius: Radius.sm;
        }
    }
}
