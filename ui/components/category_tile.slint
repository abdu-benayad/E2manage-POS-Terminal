// ============================================================================
// E2Manage POS Terminal - Category Tile Component (Phase 15)
// ============================================================================
// Individual category tile for product browsing grid
// Supports: Name (EN/AR), color coding, product count, selection state
// ============================================================================

import { Colors, Typography, Spacing, Radius, Animation, Layout, Locale } from "../theme.slint";

// ============================================================================
// CATEGORY TILE DATA STRUCT
// ============================================================================

export struct CategoryData {
    id: string,
    name: string,
    name-ar: string,
    color: color,
    product-count: int,
    icon: string,
}

// ============================================================================
// CATEGORY TILE COMPONENT
// ============================================================================

export component CategoryTile inherits Rectangle {
    in property <string> category-id: "";
    in property <string> name: "Category";
    in property <string> name-ar: "";
    in property <color> tile-color: Colors.primary;
    in property <int> product-count: 0;
    in property <bool> selected: false;
    in property <string> icon: "";

    callback clicked;

    horizontal-stretch: 1;
    min-width: 90px;
    height: 80px;
    border-radius: Radius.md;
    background: selected ? tile-color : Colors.surface;
    border-width: selected ? 0px : 1px;
    border-color: touch.has-hover ? tile-color : Colors.border;

    states [
        pressed when touch.pressed: {
            background: tile-color;
            opacity: 0.85;
        }
        hover when touch.has-hover && !selected: {
            background: Colors.surface-variant;
        }
    ]

    animate background { duration: Animation.fast; }
    animate border-color { duration: Animation.fast; }
    animate opacity { duration: Animation.fast; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        spacing: Spacing.xs;
        padding: Spacing.sm;

        // Icon (if provided) — uses tile-color when not selected for category identification
        if icon != "": Text {
            text: icon;
            font-size: 24px;
            color: selected ? Colors.text-on-primary : tile-color;
            horizontal-alignment: center;
        }

        // Category name
        Text {
            text: Locale.current == "ar" && name-ar != "" ? name-ar : name;
            font-size: Typography.body;
            font-weight: 600;
            color: selected ? Colors.text-on-primary : Colors.text-primary;
            horizontal-alignment: center;
            overflow: elide;
        }

        // Product count
        Text {
            text: product-count > 0 ?
                (Locale.current == "ar" ?
                    product-count + " منتج" :
                    product-count + " items") :
                "";
            font-size: Typography.small;
            color: selected ? rgba(255, 255, 255, 0.8) : Colors.text-secondary;
            horizontal-alignment: center;
        }
    }

    // Color accent bar (top) — visible when NOT selected for visual category identification
    Rectangle {
        y: 0px;
        x: Spacing.sm;
        width: parent.width - (Spacing.sm * 2);
        height: 4px;
        border-radius: 2px;
        background: selected ? transparent : tile-color;
        opacity: selected ? 0 : 0.8;

        animate opacity { duration: Animation.fast; }
    }

    // Selection indicator (colored bar at bottom)
    Rectangle {
        y: parent.height - 3px;
        x: Spacing.sm;
        width: parent.width - (Spacing.sm * 2);
        height: 3px;
        border-radius: 2px;
        background: selected ? Colors.text-on-primary : transparent;
        opacity: selected ? 0.5 : 0;

        animate opacity { duration: Animation.fast; }
    }
}

// ============================================================================
// ALL CATEGORY TILE (Special "All" option)
// ============================================================================

export component AllCategoryTile inherits Rectangle {
    in property <bool> selected: false;
    in property <int> total-count: 0;

    callback clicked;

    horizontal-stretch: 1;
    min-width: 90px;
    height: 80px;
    border-radius: Radius.md;
    background: selected ? Colors.text-secondary : Colors.surface;
    border-width: selected ? 0px : 1px;
    border-color: touch.has-hover ? Colors.text-secondary : Colors.border;

    states [
        pressed when touch.pressed: {
            background: Colors.text-secondary;
            opacity: 0.85;
        }
        hover when touch.has-hover && !selected: {
            background: Colors.surface-variant;
        }
    ]

    animate background { duration: Animation.fast; }
    animate border-color { duration: Animation.fast; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        spacing: Spacing.xs;
        padding: Spacing.sm;

        // Grid icon
        Text {
            text: "\u{1F4E6}"; // Package emoji or grid icon
            font-size: 24px;
            color: selected ? Colors.text-on-primary : Colors.text-secondary;
            horizontal-alignment: center;
        }

        // "All" label
        Text {
            text: Locale.current == "ar" ? "الكل" : "All";
            font-size: Typography.body;
            font-weight: 600;
            color: selected ? Colors.text-on-primary : Colors.text-primary;
            horizontal-alignment: center;
        }

        // Total count
        if total-count > 0: Text {
            text: Locale.current == "ar" ?
                total-count + " منتج" :
                total-count + " items";
            font-size: Typography.small;
            color: selected ? rgba(255, 255, 255, 0.8) : Colors.text-secondary;
            horizontal-alignment: center;
        }
    }
}

// ============================================================================
// COMPACT CATEGORY CHIP (Alternative style for horizontal strip)
// ============================================================================

export component CategoryChip inherits Rectangle {
    in property <string> category-id: "";
    in property <string> name: "Category";
    in property <string> name-ar: "";
    in property <color> chip-color: Colors.primary;
    in property <bool> selected: false;

    callback clicked;

    width: self.preferred-width;
    preferred-width: chip-text.preferred-width + (Spacing.lg * 2);
    height: 40px;
    border-radius: Radius.full;
    background: selected ? chip-color : Colors.surface;
    border-width: 1px;
    border-color: selected ? chip-color : Colors.border;

    states [
        pressed when touch.pressed: {
            opacity: 0.85;
        }
        hover when touch.has-hover && !selected: {
            border-color: chip-color;
        }
    ]

    animate background { duration: Animation.fast; }
    animate border-color { duration: Animation.fast; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        padding-left: Spacing.lg;
        padding-right: Spacing.lg;

        chip-text := Text {
            text: Locale.current == "ar" && name-ar != "" ? name-ar : name;
            font-size: Typography.caption;
            font-weight: 500;
            color: selected ? Colors.text-on-primary : Colors.text-primary;
            vertical-alignment: center;
        }
    }
}
