    in-out property <bool> require-signature: false;
    in-out property <int> signature-threshold: 50;
    in-out property <string> currency: AppState.currency;
    in-out property <bool> allow-multi-currency: false;
    in-out property <bool> round-cash: true;
    in-out property <string> rounding-mode: "nearest";
    in-out property <bool> emv-enabled: true;
