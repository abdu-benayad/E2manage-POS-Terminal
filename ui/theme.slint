    in-out property <int> sync-interval: 5;
    in-out property <string> last-full-sync: "2024-01-15 10:00";
    in-out property <int> pending-uploads: 0;
    in-out property <int> pending-downloads: 0;
    in-out property <bool> sync-in-progress: false;
    in-out property <int> sync-progress: 0;
    in-out property <string> sync-status: "";
    in-out property <bool> wifi-only: false;
