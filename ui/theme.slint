// ============================================================================
// RESPONSIVE LAYOUT
// ============================================================================

export global Responsive {
    // Viewport dimensions (updated by MainWindow on resize)
    in-out property <length> viewport-width: 1024px;
    in-out property <length> viewport-height: 768px;

    // Breakpoints
    out property <length> breakpoint-compact: 800px;   // Below this = stacked layout
    out property <length> breakpoint-tablet: 768px;
    out property <length> breakpoint-desktop: 1024px;

    // Computed layout modes
    out property <bool> is-compact: viewport-width < breakpoint-compact;
    out property <bool> is-tablet: viewport-width >= breakpoint-tablet && viewport-width < breakpoint-desktop;
    out property <bool> is-desktop: viewport-width >= breakpoint-desktop;

    // Compact mode adjustments
    out property <length> compact-header-height: 56px;
    out property <length> compact-status-bar-height: 40px;
    out property <length> compact-button-height: 44px;
}

// ============================================================================
// EXPORT FOR MAIN WINDOW
// ============================================================================

export { Colors, Typography, Spacing, Sizes, Radius, Shadows, Animation, Layers, Layout, Locale, CartState, SettingsState }
