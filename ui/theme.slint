// ============================================================================
// E2Manage POS Terminal - Design System Theme
// ============================================================================
// Generated from DESIGN-SYSTEM.md specifications
// All design tokens for colors, typography, spacing, and sizing
// ============================================================================

import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme, Fonts } from "tokens/mod.slint";

// ============================================================================
// COLORS
// ============================================================================
// Old token names preserved for source compatibility — values now derive
// from Theme.mode. New tokens added at the bottom (accent-lime, pay-green,
// etc.) per redesign spec §4.2. Tokens marked "legacy alias" point at a
// new token and should be migrated to the new name during Plan 2.

global Colors {
    // ---------------------------------------------------------------------
    // Brand / accent (new tokens — redesign spec §4.2)
    // ---------------------------------------------------------------------
    out property <color> accent-lime:
        Theme.is-dark ? #A3E635 : #84CC16;
    out property <color> pay-green:
        Theme.is-dark ? #A3E635 : #15803D;
    out property <color> pay-green-bg-stop-1:
        Theme.is-dark ? #BEF264 : #22C55E;
    out property <color> pay-green-bg-stop-2:
        Theme.is-dark ? #84CC16 : #15803D;

    // ---------------------------------------------------------------------
    // Semantic
    // ---------------------------------------------------------------------
    out property <color> success: Theme.is-dark ? #22C55E : #15803D;
    out property <color> warning: Theme.is-dark ? #FCD34D : #D97706;
    out property <color> danger:  Theme.is-dark ? #F87171 : #DC2626;
    out property <color> info:    Theme.is-dark ? #60A5FA : #0EA5E9;

    // ---------------------------------------------------------------------
    // Surfaces (also re-exported from Surfaces global; here for compat)
    // ---------------------------------------------------------------------
    out property <color> background: Theme.is-dark ? #0A0C10 : #FBFCFD;
    out property <color> background-2: Theme.is-dark ? #14171C : #EEF1F5;
    out property <color> surface: Theme.is-dark ? #181C22 : #FFFFFF;
    out property <color> surface-2: Theme.is-dark ? #14171C : #F5F7FA;
    out property <color> surface-variant: Theme.is-dark ? #1F242C : #F0F2F5;
    out property <color> overlay: Theme.is-dark ? rgba(0,0,0,0.6) : rgba(11,13,16,0.30);

    // ---------------------------------------------------------------------
    // Text
    // ---------------------------------------------------------------------
    out property <color> text-primary: Theme.is-dark ? #E5E7EB : #0B0D10;
    out property <color> text-secondary: Theme.is-dark ? #9CA3AF : #6B7280;
    out property <color> text-muted: Theme.is-dark ? #6B7280 : #9CA3AF;
    out property <color> text-on-primary: #FFFFFF;
    out property <color> text-on-pay: Theme.is-dark ? #0B0D10 : #FFFFFF;

    // ---------------------------------------------------------------------
    // Borders
    // ---------------------------------------------------------------------
    out property <color> border: Theme.is-dark ? rgba(255,255,255,0.06) : rgba(11,13,16,0.06);
    out property <color> border-strong: Theme.is-dark ? rgba(255,255,255,0.10) : rgba(11,13,16,0.10);
    out property <color> border-focus: accent-lime;

    // ---------------------------------------------------------------------
    // Per-category accents (left borders on tiles) — same on both themes
    // ---------------------------------------------------------------------
    out property <color> cat-coffee: #B45309;
    out property <color> cat-bakery: #7C3AED;
    out property <color> cat-cold:   #0EA5E9;
    out property <color> cat-food:   #10B981;

    // ---------------------------------------------------------------------
    // Legacy aliases — preserved so existing screens still compile.
    // These map old (pre-redesign) names onto the closest new token.
    // Migrate call-sites to the new names during Plan 2, then remove these.
    // ---------------------------------------------------------------------

    // Brand: was a blue (#2563EB / #1E3A8A / #3B82F6); now lime/pay-green.
    out property <color> primary: accent-lime;
    out property <color> primary-dark: pay-green;
    out property <color> primary-light: accent-lime;

    // Surfaces with old names
    out property <color> cart-bg: surface-2;
    out property <color> status-bar-bg: Theme.is-dark ? rgba(11,13,16,0.9) : rgba(11,13,16,0.9);
    out property <color> customer-bar: Theme.is-dark ? #2A1D0F : #FFF3E0;

    // Text with old names
    out property <color> text-on-surface: text-primary;
    out property <color> success-text: success;
    out property <color> orange-accent: cat-coffee;

    // Borders with old names
    out property <color> divider: border;
    out property <color> status-bar-border: Theme.is-dark ? rgba(255,255,255,0.08) : rgba(255,255,255,0.08);

    // Progress
    out property <color> progress-bg: Theme.is-dark ? rgba(255,255,255,0.16) : rgba(255,255,255,0.24);
    out property <color> progress-fill: #FFFFFF;

    // Additional UI states
    out property <color> disabled: Theme.is-dark ? rgba(255,255,255,0.38) : rgba(0,0,0,0.38);
    out property <color> ripple: Theme.is-dark ? rgba(163,230,53,0.16) : rgba(132,204,22,0.12);
    out property <color> focus-ring: Theme.is-dark ? rgba(163,230,53,0.45) : rgba(132,204,22,0.40);

    // Splash gradient — kept dark-blue on light theme for brand continuity,
    // shifted to deep neutral on dark.
    out property <color> gradient-top: Theme.is-dark ? #14171C : #1E3A8A;
    out property <color> gradient-bottom: Theme.is-dark ? #0A0C10 : #2563EB;

    // Status chip backgrounds (legacy — point at semantic tokens)
    out property <color> chip-success-bg: success;
    out property <color> chip-warning-bg: warning;
    out property <color> chip-danger-bg: danger;
    out property <color> chip-neutral-bg: Theme.is-dark ? #1F242C : #E2E8F0;

    // Role colors (cashier selection badge) — same hues on both themes
    out property <color> role-cashier: #3B82F6;
    out property <color> role-supervisor: #22C55E;
    out property <color> role-admin: #F59E0B;
}

// ============================================================================
// TYPOGRAPHY
// ============================================================================

global Typography {
    // Font Sizes
    out property <length> display: 32px;
    out property <length> title: 24px;
    out property <length> heading: 20px;
    out property <length> subheading: 18px;
    out property <length> body: 16px;
    out property <length> caption: 14px;
    out property <length> small: 12px;
    out property <length> tiny: 11px;

    // Arabic-specific font sizes (slightly larger for better readability)
    out property <length> body-ar: 17px;
    out property <length> caption-ar: 15px;
    out property <length> small-ar: 13px;

    // Arabic line-height multiplier (per spec §7.6). Apply at call sites:
    //   line-height: Typography.body * Typography.arabic-line-height-multiplier;
    // when the rendered text is Arabic. Required to clear diacritics and
    // descenders that get clipped at Latin-default line-height.
    out property <float> arabic-line-height-multiplier: 1.12;

    // Font Weights (as integers for Slint)
    out property <int> regular: 400;
    out property <int> medium: 500;
    out property <int> semi-bold: 600;
    out property <int> bold: 700;

    // New stack from redesign spec §4.3. IBM Plex Sans for Latin, Plex Sans
    // Arabic for Arabic — the two cuts pair at matched x-heights so mixed-script
    // lines render without vertical jumps. JetBrains Mono for all numerics.
    // Family names sourced from the Fonts global (canonical strings backed by
    // the bundled .ttf files in assets/fonts/).
    out property <string> font-family: Fonts.sans + ", " + Fonts.sans-arabic;
    out property <string> font-family-mono: Fonts.mono;

    // Helper function for locale-aware body size
    pure public function body-size(locale: string) -> length {
        return locale == "ar" ? body-ar : body;
    }

    // Helper function for locale-aware caption size
    pure public function caption-size(locale: string) -> length {
        return locale == "ar" ? caption-ar : caption;
    }

    // Helper function for locale-aware small size
    pure public function small-size(locale: string) -> length {
        return locale == "ar" ? small-ar : small;
    }
}

// ============================================================================
// SPACING
// ============================================================================

global Spacing {
    out property <length> xxs: 2px;   // 4xs
    out property <length> xs: 4px;    // 3xs
    out property <length> sm: 8px;    // xs
    out property <length> md: 12px;   // sm
    out property <length> lg: 16px;   // md
    out property <length> xl: 24px;   // lg
    out property <length> xxl: 32px;  // xl
    out property <length> xxxl: 48px; // 2xl

    // Common patterns
    out property <length> card-padding: 16px;
    out property <length> input-padding-h: 12px;
    out property <length> button-padding-h: 24px;
    out property <length> button-padding-v: 12px;
    out property <length> screen-margin: 24px;
    out property <length> section-gap: 24px;
}

