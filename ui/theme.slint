    in-out property <bool> auto-lock-enabled: true;
    in-out property <int> auto-lock-timeout: 5;
    in-out property <bool> require-pin-refund: true;
    in-out property <bool> require-pin-discount: true;
    in-out property <bool> require-pin-void: true;
    in-out property <bool> require-pin-drawer: false;

