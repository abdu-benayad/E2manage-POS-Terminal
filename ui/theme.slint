// ============================================================================
// BORDER RADIUS
// ============================================================================

global Radius {
    out property <length> none: 0px;
    out property <length> sm: 4px;
    out property <length> md: 8px;
    out property <length> lg: 12px;
    out property <length> xl: 16px;
    out property <length> xxl: 20px;
    out property <length> full: 9999px;

    // Component-specific
    out property <length> button: 8px;
    out property <length> input: 8px;
    out property <length> card: 12px;
    out property <length> dialog: 16px;
    out property <length> avatar: 9999px; // full circle
    out property <length> chip: 9999px;
    out property <length> progress: 4px;
}

// ============================================================================
// SHADOWS (as string descriptions - apply manually in components)
// ============================================================================

global Shadows {
    // Slint doesn't have native shadow support like CSS
    // These are placeholder values for documentation
    // Use drop-shadow property or border effects as alternatives
    out property <int> none: 0;
    out property <int> sm: 1;
    out property <int> md: 2;
    out property <int> lg: 3;
}

// ============================================================================
// ANIMATION DURATIONS (in milliseconds)
// ============================================================================

global Animation {
    out property <duration> fast: 100ms;
    out property <duration> normal: 200ms;
    out property <duration> slow: 300ms;
    out property <duration> dialog: 150ms;
    out property <duration> toast: 200ms;
    out property <duration> progress: 300ms;
    out property <duration> pulse: 1000ms;
}

// ============================================================================
// Z-INDEX LAYERS
// ============================================================================

global Layers {
    out property <int> base: 0;
    out property <int> dropdown: 100;
    out property <int> sticky: 200;
    out property <int> modal: 300;
    out property <int> toast: 400;
    out property <int> tooltip: 500;
}

// ============================================================================
// RTL SUPPORT
// ============================================================================

global Layout {
    // Set to true for RTL languages (Arabic)
    in-out property <bool> rtl: true;

    // Helper properties for directional layouts
    out property <TextHorizontalAlignment> text-start: rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    out property <TextHorizontalAlignment> text-end: rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;

    // Direction-aware arrow functions
    // Back arrow points right (→) in RTL, left (←) in LTR
    pure public function back-arrow() -> string {
        return rtl ? "→" : "←";
    }

    // Forward arrow points left (←) in RTL, right (→) in LTR
    pure public function forward-arrow() -> string {
        return rtl ? "←" : "→";
    }

    // Chevron arrows for list items
    pure public function chevron-start() -> string {
        return rtl ? "›" : "‹";
    }

    pure public function chevron-end() -> string {
        return rtl ? "‹" : "›";
    }

    // === Logical direction helpers (spec §7.1, IMPL Plan 1 Task 7) ===
    // Components use these instead of border-left / border-right / padding-left
    // / padding-right when they want the value to flip with RTL.
    //
    // Use the scalar variants:
    //   border-left:  Layout.leading(3px, 0px);
    //   border-right: Layout.trailing(3px, 0px);
    // and:
    //   border-left:  Layout.leading-color(Colors.cat-coffee, transparent);
    //   border-right: Layout.trailing-color(Colors.cat-coffee, transparent);

    pure public function leading(leading-value: length, trailing-value: length) -> length {
        return rtl ? trailing-value : leading-value;
    }

    pure public function trailing(leading-value: length, trailing-value: length) -> length {
        return rtl ? leading-value : trailing-value;
    }

    pure public function leading-color(leading-value: color, trailing-value: color) -> color {
        return rtl ? trailing-value : leading-value;
    }

    pure public function trailing-color(leading-value: color, trailing-value: color) -> color {
        return rtl ? leading-value : trailing-value;
    }

    // Layout-order convenience predicates. Components can branch with
    //   if Layout.is-rtl: HorizontalLayout { /* reverse-ordered children */ }
    //   if Layout.is-ltr: HorizontalLayout { /* normal-ordered children */ }
    out property <bool> is-rtl: rtl;
    out property <bool> is-ltr: !rtl;
}

// ============================================================================
// LOCALE
// ============================================================================

global Locale {
    // Current locale: "ar", "en", "fr"
    in-out property <string> current: "ar";

    // Common labels (can be extended)
    out property <string> app-name: current == "ar" ? "E2Manage نظام نقاط البيع" : "E2Manage POS";
    out property <string> online: current == "ar" ? "متصل" : "Online";
    out property <string> offline: current == "ar" ? "غير متصل" : "Offline";
    out property <string> syncing: current == "ar" ? "جارٍ المزامنة..." : "Syncing...";
    out property <string> loading: current == "ar" ? "جارٍ التحميل..." : "Loading...";
    out property <string> error: current == "ar" ? "خطأ" : "Error";
    out property <string> success: current == "ar" ? "نجح" : "Success";
    out property <string> cancel: current == "ar" ? "إلغاء" : "Cancel";
    out property <string> confirm: current == "ar" ? "تأكيد" : "Confirm";
    out property <string> save: current == "ar" ? "حفظ" : "Save";
    out property <string> back: current == "ar" ? "رجوع" : "Back";
    out property <string> next: current == "ar" ? "التالي" : "Next";
    out property <string> done: current == "ar" ? "تم" : "Done";

    // Terminal registration
    out property <string> not-registered: current == "ar" ? "غير مسجل" : "Not Registered";

    // Login button
    out property <string> login-button: current == "ar" ? "دخول" : "Login";

    // Splash screen status messages
    out property <string> splash-starting: current == "ar" ? "جارٍ البدء..." : "Starting...";
    out property <string> splash-connecting: current == "ar" ? "جارٍ الاتصال بالخادم..." : "Connecting to server...";
    out property <string> splash-loading-config: current == "ar" ? "تحميل الإعدادات..." : "Loading configuration...";
    out property <string> splash-syncing-products: current == "ar" ? "جارٍ مزامنة المنتجات..." : "Syncing products...";
    out property <string> splash-preparing: current == "ar" ? "تجهيز الواجهة..." : "Preparing interface...";
    out property <string> splash-ready: current == "ar" ? "جاهز!" : "Ready!";
}

// ============================================================================
// APPLICATION STATE (shared across screens)
// ============================================================================

export global AppState {
    // Terminal info
    in-out property <string> terminal-code: "POS-001";
    in-out property <string> terminal-name: "Main Terminal";
    in-out property <string> company-name: "";
    in-out property <string> version: "v1.0.0";

    // Connection state
    in-out property <bool> is-online: true;
    in-out property <string> last-sync: "10:30";
    in-out property <int> pending-sync-count: 0;

    // Current user/shift
    in-out property <string> current-user: "";
    in-out property <string> current-shift: "";
    in-out property <bool> shift-active: false;

    // Current time
    in-out property <string> current-time: "10:30";

    // Currency configuration (set from backend via Rust)
    in-out property <string> currency: "LYD";
    in-out property <int> currency-decimals: 3;
    in-out property <string> zero-amount: "0.000";

    // Tax configuration (set from backend via Rust)
    in-out property <float> tax-rate-value: 0;
    in-out property <string> tax-rate-label: "0%";
    in-out property <bool> tax-inclusive: false;
}

