// ============================================================================
// E2Manage POS Terminal - Conflicts Screen
// ============================================================================
// Manager-only screen for resolving sync conflicts
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Layout, Locale } from "../../theme.slint";
import { Button } from "../../components/mod.slint";
import { ConflictItem } from "conflict-item.slint";

// ============================================================================
// Conflict Transaction Data Structure
// ============================================================================

export struct ConflictTransaction {
    offline-id: string,
    transaction-number: string,
    transaction-type: string,
    grand-total: string,  // Pre-formatted string (e.g., "123.450")
    created-at: string,
    error-message: string,
    retry-count: int,
    operator-id: string,
    receipt-number: string,
}

// ============================================================================
// Conflicts Screen
// ============================================================================

export component ConflictsScreen inherits Rectangle {
    // Input properties
    in property <[ConflictTransaction]> conflicts: [];
    in property <bool> is-loading: false;
    in property <bool> is-manager: true; // Manager permission check

    // State
    property <int> expanded-index: -1;

    // Callbacks
    callback retry-transaction(string);
    callback discard-transaction(string);
    callback retry-all-clicked();
    callback discard-all-clicked();
    callback refresh-requested();
    callback back-clicked();

    background: Colors.background;

    VerticalLayout {
        spacing: 0px;

        // Header
        Rectangle {
            height: Sizes.header-height;
            background: Colors.primary;

            HorizontalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.lg;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Spacing.lg;

                    // Back button
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: Radius.md;

                        back-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.back-clicked(); }
                        }

                        Rectangle {
                            background: back-touch.pressed ? rgba(255, 255, 255, 0.2) :
                                       back-touch.has-hover ? rgba(255, 255, 255, 0.1) : transparent;
                            border-radius: parent.border-radius;
                        }

                        Text {
                            text: Layout.rtl ? "→" : "←";
                            font-size: 24px;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Warning icon
                    Text {
                        text: "⚠️";
                        font-size: 24px;
                        vertical-alignment: center;
                    }

                    // Title
                    Text {
                        text: Locale.current == "ar" ? "تعارضات المزامنة" : "Sync Conflicts";
                        font-size: Typography.heading;
                        font-weight: 600;
                        color: Colors.text-on-primary;
                        vertical-alignment: center;
                    }
                }

                // Conflict count badge
                Rectangle {
                    width: count-text.preferred-width + 24px;
                    height: 36px;
                    border-radius: 18px;
                    background: conflicts.length > 0 ? rgba(239, 68, 68, 0.2) : rgba(76, 175, 80, 0.2);

                    count-text := Text {
                        text: conflicts.length > 0 ?
                            (Locale.current == "ar" ?
                                conflicts.length + " تعارضات" :
                                conflicts.length + " conflicts") :
                            (Locale.current == "ar" ? "لا توجد تعارضات" : "No conflicts");
                        font-size: Typography.caption;
                        font-weight: 500;
                        color: conflicts.length > 0 ? #EF4444 : #4CAF50;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Content area
        if !is-manager: Rectangle {
            // Not authorized view
            VerticalLayout {
                alignment: center;
                spacing: Spacing.lg;

                Text {
                    text: "🔒";
                    font-size: 64px;
                    horizontal-alignment: center;
                }

                Text {
                    text: Locale.current == "ar" ?
                        "يتطلب صلاحية المدير" :
                        "Manager Authorization Required";
                    font-size: Typography.title;
                    font-weight: 600;
                    color: Colors.text-primary;
                    horizontal-alignment: center;
                }

                Text {
                    text: Locale.current == "ar" ?
                        "هذه الشاشة متاحة للمديرين فقط" :
                        "This screen is only available to managers";
                    font-size: Typography.body;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                }

                Button {
                    text: Locale.current == "ar" ? "رجوع" : "Go Back";
                    variant: "primary";
                    clicked => { root.back-clicked(); }
                }
            }
        }

        if is-manager && conflicts.length == 0 && !is-loading: Rectangle {
            // Empty state
            VerticalLayout {
                alignment: center;
                spacing: Spacing.lg;

                Text {
                    text: "✅";
                    font-size: 64px;
                    horizontal-alignment: center;
                }

                Text {
                    text: Locale.current == "ar" ?
                        "لا توجد تعارضات" :
                        "No Conflicts";
                    font-size: Typography.title;
                    font-weight: 600;
                    color: Colors.text-primary;
                    horizontal-alignment: center;
                }

                Text {
                    text: Locale.current == "ar" ?
                        "جميع المعاملات تمت مزامنتها بنجاح" :
                        "All transactions have been synced successfully";
                    font-size: Typography.body;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                }

                Button {
                    text: Locale.current == "ar" ? "تحديث" : "Refresh";
                    variant: "outline";
                    clicked => { root.refresh-requested(); }
                }
            }
        }

        if is-manager && is-loading: Rectangle {
            // Loading state
            VerticalLayout {
                alignment: center;
                spacing: Spacing.lg;

                Text {
                    text: "⏳";
                    font-size: 48px;
                    horizontal-alignment: center;
                }

                Text {
                    text: Locale.current == "ar" ?
                        "جارٍ التحميل..." :
                        "Loading...";
                    font-size: Typography.body;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                }
            }
        }

        if is-manager && conflicts.length > 0 && !is-loading: VerticalLayout {
            spacing: 0px;

            // Actions bar
            Rectangle {
                height: 60px;
                background: Colors.surface;
                border-width: 0px;
                border-color: Colors.border;

                HorizontalLayout {
                    padding-left: Spacing.lg;
                    padding-right: Spacing.lg;
                    spacing: Spacing.md;
                    alignment: end;

                    Button {
                        text: Locale.current == "ar" ? "تحديث" : "Refresh";
                        variant: "ghost";
                        clicked => { root.refresh-requested(); }
                    }

                    Button {
                        text: Locale.current == "ar" ? "إعادة محاولة الكل" : "Retry All";
                        variant: "outline";
                        clicked => { root.retry-all-clicked(); }
                    }

                    Button {
                        text: Locale.current == "ar" ? "تجاهل الكل" : "Discard All";
                        variant: "danger";
                        clicked => { root.discard-all-clicked(); }
                    }
                }
            }

            // Conflict list
            Flickable {
                viewport-height: list-layout.preferred-height;

                list-layout := VerticalLayout {
                    padding: Spacing.lg;
                    spacing: Spacing.md;

                    for conflict[idx] in conflicts: ConflictItem {
                        offline-id: conflict.offline-id;
                        transaction-number: conflict.transaction-number;
                        transaction-type: conflict.transaction-type;
                        grand-total: conflict.grand-total;
                        created-at: conflict.created-at;
                        error-message: conflict.error-message;
                        retry-count: conflict.retry-count;
                        operator-id: conflict.operator-id;
                        receipt-number: conflict.receipt-number;
                        expanded: expanded-index == idx;

                        toggle-expand => {
                            if expanded-index == idx {
                                expanded-index = -1;
                            } else {
                                expanded-index = idx;
                            }
                        }

                        retry-clicked => {
                            root.retry-transaction(conflict.offline-id);
                        }

                        discard-clicked => {
                            root.discard-transaction(conflict.offline-id);
                        }
                    }

                    // Bottom spacer
                    Rectangle { height: Spacing.xxl; }
                }
            }
        }
    }
}
