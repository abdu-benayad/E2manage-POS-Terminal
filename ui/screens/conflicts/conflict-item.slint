// ============================================================================
// E2Manage POS Terminal - Conflict Item Component
// ============================================================================
// Individual conflict transaction card for the conflicts list
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Layout, Locale, CartState } from "../../theme.slint";
import { Button } from "../../components/mod.slint";

// ============================================================================
// Conflict Item Component
// ============================================================================

export component ConflictItem inherits Rectangle {
    // Input properties
    in property <string> offline-id;
    in property <string> transaction-number: "TXN-001";
    in property <string> transaction-type: "SALE";
    in property <string> grand-total: "0.000";  // Pre-formatted string
    in property <string> created-at: "";
    in property <string> error-message: "";
    in property <int> retry-count: 0;
    in property <string> operator-id: "";
    in property <string> receipt-number: "";
    in property <bool> expanded: false;

    // Callbacks
    callback retry-clicked();
    callback discard-clicked();
    callback toggle-expand();

    // Component properties
    height: expanded ? 220px : 100px;
    background: Colors.surface;
    border-radius: Radius.lg;
    drop-shadow-blur: 4px;
    drop-shadow-color: rgba(0, 0, 0, 0.08);
    drop-shadow-offset-y: 2px;

    animate height { duration: 200ms; easing: ease-out; }

    // Touch area for expand/collapse
    expand-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle-expand(); }
    }

    VerticalLayout {
        padding: Spacing.lg;
        spacing: Spacing.md;

        // Main row (always visible)
        HorizontalLayout {
            spacing: Spacing.md;

            // Transaction type indicator
            Rectangle {
                width: 4px;
                height: 56px;
                border-radius: 2px;
                background: transaction-type == "SALE" ? Colors.primary :
                           transaction-type == "RETURN" ? Colors.warning : Colors.info;
            }

            // Transaction info
            VerticalLayout {
                spacing: Spacing.xs;
                horizontal-stretch: 1;

                HorizontalLayout {
                    spacing: Spacing.sm;

                    // Transaction number
                    Text {
                        text: transaction-number;
                        font-size: Typography.body;
                        font-weight: 600;
                        color: Colors.text-primary;
                    }

                    // Type badge
                    Rectangle {
                        width: type-text.preferred-width + 12px;
                        height: 20px;
                        border-radius: 10px;
                        background: transaction-type == "SALE" ? rgba(37, 99, 235, 0.1) :
                                   transaction-type == "RETURN" ? rgba(245, 158, 11, 0.1) : rgba(14, 165, 233, 0.1);

                        type-text := Text {
                            text: transaction-type == "SALE" ?
                                (Locale.current == "ar" ? "بيع" : "Sale") :
                                transaction-type == "RETURN" ?
                                (Locale.current == "ar" ? "مرتجع" : "Return") :
                                transaction-type;
                            font-size: Typography.small;
                            color: transaction-type == "SALE" ? Colors.primary :
                                   transaction-type == "RETURN" ? Colors.warning : Colors.info;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Retry count badge
                    if retry-count > 0: Rectangle {
                        width: retry-text.preferred-width + 12px;
                        height: 20px;
                        border-radius: 10px;
                        background: rgba(239, 68, 68, 0.1);

                        retry-text := Text {
                            text: Locale.current == "ar" ?
                                retry-count + " محاولات" :
                                retry-count + " retries";
                            font-size: Typography.small;
                            color: Colors.danger;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Error message (truncated)
                Text {
                    text: error-message;
                    font-size: Typography.caption;
                    color: Colors.danger;
                    overflow: elide;
                }

                // Created date
                Text {
                    text: created-at;
                    font-size: Typography.small;
                    color: Colors.text-secondary;
                }
            }

            // Amount
            VerticalLayout {
                spacing: Spacing.xs;

                Text {
                    text: grand-total + " " + CartState.currency;
                    font-size: Typography.subheading;
                    font-weight: 600;
                    color: Colors.text-primary;
                    horizontal-alignment: right;
                }

                // Expand indicator
                Text {
                    text: expanded ? "▲" : "▼";
                    font-size: Typography.small;
                    color: Colors.text-secondary;
                    horizontal-alignment: right;
                }
            }
        }

        // Expanded section
        if expanded: VerticalLayout {
            spacing: Spacing.md;

            Rectangle { height: 1px; background: Colors.border; }

            // Additional details
            HorizontalLayout {
                spacing: Spacing.lg;

                VerticalLayout {
                    spacing: Spacing.xs;
                    horizontal-stretch: 1;

                    if receipt-number != "": HorizontalLayout {
                        spacing: Spacing.sm;

                        Text {
                            text: Locale.current == "ar" ? "رقم الإيصال:" : "Receipt:";
                            font-size: Typography.caption;
                            color: Colors.text-secondary;
                        }

                        Text {
                            text: receipt-number;
                            font-size: Typography.caption;
                            font-weight: 500;
                            color: Colors.text-primary;
                        }
                    }

                    if operator-id != "": HorizontalLayout {
                        spacing: Spacing.sm;

                        Text {
                            text: Locale.current == "ar" ? "المشغل:" : "Operator:";
                            font-size: Typography.caption;
                            color: Colors.text-secondary;
                        }

                        Text {
                            text: operator-id;
                            font-size: Typography.caption;
                            font-weight: 500;
                            color: Colors.text-primary;
                        }
                    }

                    HorizontalLayout {
                        spacing: Spacing.sm;

                        Text {
                            text: Locale.current == "ar" ? "معرف المعاملة:" : "Transaction ID:";
                            font-size: Typography.caption;
                            color: Colors.text-secondary;
                        }

                        Text {
                            text: offline-id;
                            font-size: Typography.small;
                            font-weight: 500;
                            color: Colors.text-secondary;
                            overflow: elide;
                        }
                    }
                }
            }

            // Full error message
            Rectangle {
                background: rgba(239, 68, 68, 0.05);
                border-radius: Radius.sm;
                height: error-full.preferred-height + 16px;

                error-full := Text {
                    x: Spacing.sm;
                    y: Spacing.sm;
                    width: parent.width - Spacing.lg;
                    text: error-message;
                    font-size: Typography.caption;
                    color: Colors.danger;
                    wrap: word-wrap;
                }
            }

            // Action buttons
            HorizontalLayout {
                spacing: Spacing.md;

                Button {
                    text: Locale.current == "ar" ? "إعادة المحاولة" : "Retry";
                    variant: "primary";
                    horizontal-stretch: 1;
                    clicked => { root.retry-clicked(); }
                }

                Button {
                    text: Locale.current == "ar" ? "تجاهل" : "Discard";
                    variant: "danger";
                    horizontal-stretch: 1;
                    clicked => { root.discard-clicked(); }
                }
            }
        }
    }
}
