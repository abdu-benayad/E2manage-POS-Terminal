// ============================================================================
// E2Manage POS Terminal - Login Cashier Selection Screen (Screen 1.2)
// ============================================================================
// Displays a flat grid of cashiers/operators for selection
// Includes letter filter sidebar, face login option, and employee ID entry
// RTL (Arabic) support with proper text alignment
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Animation, Locale, AppState, Layout } from "../../theme.slint";
import { StatusBar } from "../../components/status_bar.slint";
import { CashierTile, FaceLoginTile, MoreCashiersTile } from "../../components/cashier_tile.slint";
import { NumericKeypad } from "../../components/numeric_keypad.slint";
import { ScrollView } from "std-widgets.slint";

// ============================================================================
// LETTER BUTTON (internal) — single letter filter button for the sidebar
// ============================================================================

component LetterButton inherits Rectangle {
    in property <string> letter: "";
    in property <bool> active: false;

    callback clicked;

    width: 36px;
    height: 32px;
    border-radius: Radius.sm;
    background: active ? Colors.primary :
                touch.pressed ? Colors.surface-variant :
                touch.has-hover ? Colors.background :
                transparent;

    animate background { duration: Animation.fast; }

    Text {
        text: letter;
        font-size: Typography.caption;
        font-weight: active ? 700 : 500;
        color: active ? Colors.text-on-primary : Colors.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ============================================================================
// OPERATOR DATA STRUCTURE
// ============================================================================

export struct Operator {
    id: string,
    name: string,
    role: string,
    initials: string,
    color: color,
}

// ============================================================================
// LOGIN SELECT SCREEN
// ============================================================================
// Usage:
//   LoginSelectScreen {
//       operators: [...];
//       operator-selected(id) => { /* navigate to PIN entry */ }
//       face-login => { /* navigate to face login */ }
//   }
// ============================================================================

export component LoginSelectScreen inherits Rectangle {
    // Operators list (populated from database via Rust)
    // Sample data for preview - will be overwritten at runtime
    in property <[Operator]> operators: [
        { id: "1", name: "أحمد محمد", role: "كاشير", initials: "أم", color: #3B82F6 },
        { id: "2", name: "سارة علي", role: "مشرف", initials: "سع", color: #22C55E },
        { id: "3", name: "محمد خالد", role: "كاشير", initials: "مخ", color: #F59E0B },
        { id: "4", name: "فاطمة أحمد", role: "كاشير", initials: "فأ", color: #EF4444 },
        { id: "5", name: "عمر حسن", role: "مشرف", initials: "عح", color: #8B5CF6 },
        { id: "6", name: "نور الدين", role: "كاشير", initials: "ند", color: #EC4899 },
        { id: "7", name: "ياسر محمود", role: "كاشير", initials: "يم", color: #06B6D4 },
        { id: "8", name: "ليلى عبدالله", role: "مشرف", initials: "لع", color: #84CC16 },
    ];

    // Letter filter — active letter for sidebar filter
    in-out property <string> selected-letter: "";

    // Currently selected operator ID
    in-out property <string> selected-operator-id: "";

    // Employee ID entry
    in-out property <string> employee-id-text: "";

    // Employee ID error message
    in-out property <string> employee-id-error: "";

    // Show face login option (based on device capability)
    in property <bool> show-face-login: true;

    // Keypad visibility for employee ID entry
    in-out property <bool> keypad-visible: false;

    // Callbacks
    callback operator-selected(string);
    callback face-login;
    callback employee-id-submitted(string);
    callback employee-id-backspace();
    callback search-operators(string);
    callback back;

    background: Colors.background;

    VerticalLayout {
        spacing: 0px;

        // ====================================================================
        // HEADER — RTL-aware: brand and time swap sides
        // ====================================================================
        Rectangle {
            height: 120px;
            background: @linear-gradient(180deg, Colors.gradient-top 0%, Colors.gradient-bottom 100%);

            HorizontalLayout {
                padding-left: Spacing.xl;
                padding-right: Spacing.xl;
                alignment: space-between;

                // Left physical side
                HorizontalLayout {
                    alignment: start;
                    spacing: Spacing.md;

                    VerticalLayout {
                        alignment: center;

                        if Layout.rtl: Text {
                            text: AppState.current-time;
                            font-size: Typography.subheading;
                            color: rgba(255, 255, 255, 0.8);
                        }

                        if !Layout.rtl: Text {
                            text: Locale.app-name;
                            font-size: Typography.heading;
                            font-weight: 700;
                            color: Colors.text-on-primary;
                            horizontal-alignment: left;
                        }
                    }
                }

                // Center section - Screen title
                VerticalLayout {
                    alignment: center;

                    Text {
                        text: Locale.current == "ar" ? "اختر الكاشير" : "Select Cashier";
                        font-size: Typography.subheading;
                        font-weight: 500;
                        color: rgba(255, 255, 255, 0.9);
                        horizontal-alignment: center;
                    }
                }

                // Right physical side
                HorizontalLayout {
                    alignment: end;
                    spacing: Spacing.md;

                    VerticalLayout {
                        alignment: center;

                        if Layout.rtl: Text {
                            text: Locale.app-name;
                            font-size: Typography.heading;
                            font-weight: 700;
                            color: Colors.text-on-primary;
                            horizontal-alignment: right;
                        }

                        if !Layout.rtl: Text {
                            text: AppState.current-time;
                            font-size: Typography.subheading;
                            color: rgba(255, 255, 255, 0.8);
                        }
                    }
                }
            }
        }

        // ====================================================================
        // MAIN CONTENT — Grid + Letter Sidebar
        // ====================================================================
        Rectangle {
            vertical-stretch: 1;
            background: Colors.background;

            HorizontalLayout {
                spacing: 0px;

                // ============================================================
                // LEFT SIDE: Operator grid + Employee ID entry
                // ============================================================
                VerticalLayout {
                    horizontal-stretch: 1;
                    padding-top: Spacing.lg;
                    padding-bottom: Spacing.lg;
                    padding-left: Spacing.xl;
                    padding-right: Spacing.md;
                    spacing: Spacing.lg;

                    // Active filter indicator
                    if selected-letter != "": HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.sm;

                        Text {
                            text: Locale.current == "ar" ? "تصفية حسب:" : "Filtering by:";
                            font-size: Typography.caption;
                            color: Colors.text-secondary;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 32px;
                            height: 28px;
                            border-radius: Radius.sm;
                            background: Colors.primary;

                            Text {
                                text: selected-letter;
                                font-size: Typography.body;
                                font-weight: 700;
                                color: Colors.text-on-primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Clear filter button
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: clear-touch.pressed ? Colors.surface-variant : transparent;

                            Text {
                                text: "\u{2715}";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            clear-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    selected-letter = "";
                                    root.search-operators("");
                                }
                            }
                        }
                    }

                    // Cashier grid section
                    ScrollView {
                        vertical-stretch: 1;

                        Flickable {
                            VerticalLayout {
                                alignment: start;
                                spacing: Spacing.xl;
                                padding: Spacing.lg;

                                // Row 1: operators 0-3
                                if operators.length > 0: HorizontalLayout {
                                    alignment: center;
                                    spacing: Spacing.xl;

                                    if operators.length > 0: CashierTile {
                                        name: operators[0].name;
                                        role: operators[0].role;
                                        avatar-initials: operators[0].initials;
                                        avatar-color: operators[0].color;
                                        selected: operators[0].id == selected-operator-id;
                                        clicked => { selected-operator-id = operators[0].id; root.operator-selected(operators[0].id); }
                                    }
                                    if operators.length > 1: CashierTile {
                                        name: operators[1].name;
                                        role: operators[1].role;
                                        avatar-initials: operators[1].initials;
                                        avatar-color: operators[1].color;
                                        selected: operators[1].id == selected-operator-id;
                                        clicked => { selected-operator-id = operators[1].id; root.operator-selected(operators[1].id); }
                                    }
                                    if operators.length > 2: CashierTile {
                                        name: operators[2].name;
                                        role: operators[2].role;
                                        avatar-initials: operators[2].initials;
                                        avatar-color: operators[2].color;
                                        selected: operators[2].id == selected-operator-id;
                                        clicked => { selected-operator-id = operators[2].id; root.operator-selected(operators[2].id); }
                                    }
                                    if operators.length > 3: CashierTile {
                                        name: operators[3].name;
                                        role: operators[3].role;
                                        avatar-initials: operators[3].initials;
                                        avatar-color: operators[3].color;
                                        selected: operators[3].id == selected-operator-id;
                                        clicked => { selected-operator-id = operators[3].id; root.operator-selected(operators[3].id); }
                                    }
                                }

                                // Row 2: operators 4-7
                                if operators.length > 4: HorizontalLayout {
                                    alignment: center;
                                    spacing: Spacing.xl;

                                    if operators.length > 4: CashierTile { name: operators[4].name; role: operators[4].role; avatar-initials: operators[4].initials; avatar-color: operators[4].color; selected: operators[4].id == selected-operator-id; clicked => { selected-operator-id = operators[4].id; root.operator-selected(operators[4].id); } }
                                    if operators.length > 5: CashierTile { name: operators[5].name; role: operators[5].role; avatar-initials: operators[5].initials; avatar-color: operators[5].color; selected: operators[5].id == selected-operator-id; clicked => { selected-operator-id = operators[5].id; root.operator-selected(operators[5].id); } }
                                    if operators.length > 6: CashierTile { name: operators[6].name; role: operators[6].role; avatar-initials: operators[6].initials; avatar-color: operators[6].color; selected: operators[6].id == selected-operator-id; clicked => { selected-operator-id = operators[6].id; root.operator-selected(operators[6].id); } }
                                    if operators.length > 7: CashierTile { name: operators[7].name; role: operators[7].role; avatar-initials: operators[7].initials; avatar-color: operators[7].color; selected: operators[7].id == selected-operator-id; clicked => { selected-operator-id = operators[7].id; root.operator-selected(operators[7].id); } }
                                }

                                // Row 3: operators 8-11
                                if operators.length > 8: HorizontalLayout {
                                    alignment: center;
                                    spacing: Spacing.xl;

                                    if operators.length > 8: CashierTile { name: operators[8].name; role: operators[8].role; avatar-initials: operators[8].initials; avatar-color: operators[8].color; selected: operators[8].id == selected-operator-id; clicked => { selected-operator-id = operators[8].id; root.operator-selected(operators[8].id); } }
                                    if operators.length > 9: CashierTile { name: operators[9].name; role: operators[9].role; avatar-initials: operators[9].initials; avatar-color: operators[9].color; selected: operators[9].id == selected-operator-id; clicked => { selected-operator-id = operators[9].id; root.operator-selected(operators[9].id); } }
                                    if operators.length > 10: CashierTile { name: operators[10].name; role: operators[10].role; avatar-initials: operators[10].initials; avatar-color: operators[10].color; selected: operators[10].id == selected-operator-id; clicked => { selected-operator-id = operators[10].id; root.operator-selected(operators[10].id); } }
                                    if operators.length > 11: CashierTile { name: operators[11].name; role: operators[11].role; avatar-initials: operators[11].initials; avatar-color: operators[11].color; selected: operators[11].id == selected-operator-id; clicked => { selected-operator-id = operators[11].id; root.operator-selected(operators[11].id); } }
                                }

                                // Row 4: operators 12-15
                                if operators.length > 12: HorizontalLayout {
                                    alignment: center;
                                    spacing: Spacing.xl;

                                    if operators.length > 12: CashierTile { name: operators[12].name; role: operators[12].role; avatar-initials: operators[12].initials; avatar-color: operators[12].color; selected: operators[12].id == selected-operator-id; clicked => { selected-operator-id = operators[12].id; root.operator-selected(operators[12].id); } }
                                    if operators.length > 13: CashierTile { name: operators[13].name; role: operators[13].role; avatar-initials: operators[13].initials; avatar-color: operators[13].color; selected: operators[13].id == selected-operator-id; clicked => { selected-operator-id = operators[13].id; root.operator-selected(operators[13].id); } }
                                    if operators.length > 14: CashierTile { name: operators[14].name; role: operators[14].role; avatar-initials: operators[14].initials; avatar-color: operators[14].color; selected: operators[14].id == selected-operator-id; clicked => { selected-operator-id = operators[14].id; root.operator-selected(operators[14].id); } }
                                    if operators.length > 15: CashierTile { name: operators[15].name; role: operators[15].role; avatar-initials: operators[15].initials; avatar-color: operators[15].color; selected: operators[15].id == selected-operator-id; clicked => { selected-operator-id = operators[15].id; root.operator-selected(operators[15].id); } }
                                }

                                // Row 5: operators 16-19
                                if operators.length > 16: HorizontalLayout {
                                    alignment: center;
                                    spacing: Spacing.xl;

                                    if operators.length > 16: CashierTile { name: operators[16].name; role: operators[16].role; avatar-initials: operators[16].initials; avatar-color: operators[16].color; selected: operators[16].id == selected-operator-id; clicked => { selected-operator-id = operators[16].id; root.operator-selected(operators[16].id); } }
                                    if operators.length > 17: CashierTile { name: operators[17].name; role: operators[17].role; avatar-initials: operators[17].initials; avatar-color: operators[17].color; selected: operators[17].id == selected-operator-id; clicked => { selected-operator-id = operators[17].id; root.operator-selected(operators[17].id); } }
                                    if operators.length > 18: CashierTile { name: operators[18].name; role: operators[18].role; avatar-initials: operators[18].initials; avatar-color: operators[18].color; selected: operators[18].id == selected-operator-id; clicked => { selected-operator-id = operators[18].id; root.operator-selected(operators[18].id); } }
                                    if operators.length > 19: CashierTile { name: operators[19].name; role: operators[19].role; avatar-initials: operators[19].initials; avatar-color: operators[19].color; selected: operators[19].id == selected-operator-id; clicked => { selected-operator-id = operators[19].id; root.operator-selected(operators[19].id); } }
                                }
                            }
                        }
                    }

                    // Employee ID entry section
                    VerticalLayout {
                        spacing: Spacing.sm;

                        // Tappable display bar
                        Rectangle {
                            height: 56px;
                            background: Colors.surface;
                            border-radius: Radius.lg;
                            border-width: keypad-visible ? 2px : 1px;
                            border-color: keypad-visible ? Colors.primary : Colors.border;

                            HorizontalLayout {
                                padding-left: Spacing.lg;
                                padding-right: Spacing.lg;
                                spacing: Spacing.md;
                                alignment: center;

                                Text {
                                    text: Locale.current == "ar" ? "رقم الموظف:" : "Employee ID:";
                                    font-size: Typography.body;
                                    color: Colors.text-secondary;
                                    vertical-alignment: center;
                                }

                                // Display entered number
                                Text {
                                    text: employee-id-text != "" ? employee-id-text :
                                          (Locale.current == "ar" ? "اضغط لإدخال الرقم" : "Tap to enter number");
                                    font-size: employee-id-text != "" ? Typography.heading : Typography.body;
                                    font-weight: employee-id-text != "" ? 700 : 400;
                                    color: employee-id-text != "" ? Colors.text-primary : Colors.text-secondary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: center;
                                }

                                // Close keypad button
                                if keypad-visible: Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 16px;
                                    background: hide-kp-touch.pressed ? Colors.surface-variant : transparent;

                                    Text {
                                        text: "\u{2715}";
                                        font-size: Typography.caption;
                                        color: Colors.text-secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    hide-kp-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { keypad-visible = false; }
                                    }
                                }
                            }

                            // Tap to open keypad (only when keypad is hidden)
                            if !keypad-visible: TouchArea {
                                mouse-cursor: pointer;
                                clicked => { keypad-visible = true; }
                            }
                        }

                        // Error message
                        if employee-id-error != "": Text {
                            text: employee-id-error;
                            font-size: Typography.small;
                            color: Colors.danger;
                            horizontal-alignment: center;
                        }

                        // Numeric keypad (shown when active)
                        if keypad-visible: HorizontalLayout {
                            alignment: center;
                            padding-bottom: Spacing.sm;

                            NumericKeypad {
                                mode: "pin";
                                value <=> employee-id-text;
                                max-length: 10;
                                confirm-label: Locale.current == "ar" ? "دخول" : "Go";

                                key-pressed(key) => {
                                    if root.employee-id-error != "" {
                                        root.employee-id-error = "";
                                    }
                                }

                                backspace => {
                                    root.employee-id-backspace();
                                }

                                confirmed(val) => {
                                    if val != "" {
                                        employee-id-error = "";
                                        root.employee-id-submitted(val);
                                    }
                                }
                            }
                        }
                    }
                }

                // ============================================================
                // RIGHT SIDE: Letter Filter Sidebar
                // ============================================================
                Rectangle {
                    width: 48px;
                    background: Colors.surface;
                    border-width: 0px;
                    border-color: Colors.border;

                    // Left border only (visual separator)
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 1px;
                        height: parent.height;
                        background: Colors.border;
                    }

                    ScrollView {
                        VerticalLayout {
                            alignment: start;
                            spacing: 2px;
                            padding-top: Spacing.sm;
                            padding-bottom: Spacing.sm;
                            padding-left: Spacing.xs;
                            padding-right: Spacing.xs;

                            // "All" button — reset filter
                            LetterButton {
                                letter: Locale.current == "ar" ? "الكل" : "All";
                                active: selected-letter == "";
                                clicked => {
                                    selected-letter = "";
                                    root.search-operators("");
                                }
                            }

                            // Separator line
                            Rectangle { height: 1px; background: Colors.border; }

                            // Arabic letters (28)
                            LetterButton { letter: "ا"; active: selected-letter == "ا"; clicked => { selected-letter = "ا"; root.search-operators("ا"); } }
                            LetterButton { letter: "ب"; active: selected-letter == "ب"; clicked => { selected-letter = "ب"; root.search-operators("ب"); } }
                            LetterButton { letter: "ت"; active: selected-letter == "ت"; clicked => { selected-letter = "ت"; root.search-operators("ت"); } }
                            LetterButton { letter: "ث"; active: selected-letter == "ث"; clicked => { selected-letter = "ث"; root.search-operators("ث"); } }
                            LetterButton { letter: "ج"; active: selected-letter == "ج"; clicked => { selected-letter = "ج"; root.search-operators("ج"); } }
                            LetterButton { letter: "ح"; active: selected-letter == "ح"; clicked => { selected-letter = "ح"; root.search-operators("ح"); } }
                            LetterButton { letter: "خ"; active: selected-letter == "خ"; clicked => { selected-letter = "خ"; root.search-operators("خ"); } }
                            LetterButton { letter: "د"; active: selected-letter == "د"; clicked => { selected-letter = "د"; root.search-operators("د"); } }
                            LetterButton { letter: "ذ"; active: selected-letter == "ذ"; clicked => { selected-letter = "ذ"; root.search-operators("ذ"); } }
                            LetterButton { letter: "ر"; active: selected-letter == "ر"; clicked => { selected-letter = "ر"; root.search-operators("ر"); } }
                            LetterButton { letter: "ز"; active: selected-letter == "ز"; clicked => { selected-letter = "ز"; root.search-operators("ز"); } }
                            LetterButton { letter: "س"; active: selected-letter == "س"; clicked => { selected-letter = "س"; root.search-operators("س"); } }
                            LetterButton { letter: "ش"; active: selected-letter == "ش"; clicked => { selected-letter = "ش"; root.search-operators("ش"); } }
                            LetterButton { letter: "ص"; active: selected-letter == "ص"; clicked => { selected-letter = "ص"; root.search-operators("ص"); } }
                            LetterButton { letter: "ض"; active: selected-letter == "ض"; clicked => { selected-letter = "ض"; root.search-operators("ض"); } }
                            LetterButton { letter: "ط"; active: selected-letter == "ط"; clicked => { selected-letter = "ط"; root.search-operators("ط"); } }
                            LetterButton { letter: "ظ"; active: selected-letter == "ظ"; clicked => { selected-letter = "ظ"; root.search-operators("ظ"); } }
                            LetterButton { letter: "ع"; active: selected-letter == "ع"; clicked => { selected-letter = "ع"; root.search-operators("ع"); } }
                            LetterButton { letter: "غ"; active: selected-letter == "غ"; clicked => { selected-letter = "غ"; root.search-operators("غ"); } }
                            LetterButton { letter: "ف"; active: selected-letter == "ف"; clicked => { selected-letter = "ف"; root.search-operators("ف"); } }
                            LetterButton { letter: "ق"; active: selected-letter == "ق"; clicked => { selected-letter = "ق"; root.search-operators("ق"); } }
                            LetterButton { letter: "ك"; active: selected-letter == "ك"; clicked => { selected-letter = "ك"; root.search-operators("ك"); } }
                            LetterButton { letter: "ل"; active: selected-letter == "ل"; clicked => { selected-letter = "ل"; root.search-operators("ل"); } }
                            LetterButton { letter: "م"; active: selected-letter == "م"; clicked => { selected-letter = "م"; root.search-operators("م"); } }
                            LetterButton { letter: "ن"; active: selected-letter == "ن"; clicked => { selected-letter = "ن"; root.search-operators("ن"); } }
                            LetterButton { letter: "ه"; active: selected-letter == "ه"; clicked => { selected-letter = "ه"; root.search-operators("ه"); } }
                            LetterButton { letter: "و"; active: selected-letter == "و"; clicked => { selected-letter = "و"; root.search-operators("و"); } }
                            LetterButton { letter: "ي"; active: selected-letter == "ي"; clicked => { selected-letter = "ي"; root.search-operators("ي"); } }

                            // Separator line
                            Rectangle { height: 1px; background: Colors.border; }

                            // Latin letters (26)
                            LetterButton { letter: "A"; active: selected-letter == "A"; clicked => { selected-letter = "A"; root.search-operators("A"); } }
                            LetterButton { letter: "B"; active: selected-letter == "B"; clicked => { selected-letter = "B"; root.search-operators("B"); } }
                            LetterButton { letter: "C"; active: selected-letter == "C"; clicked => { selected-letter = "C"; root.search-operators("C"); } }
                            LetterButton { letter: "D"; active: selected-letter == "D"; clicked => { selected-letter = "D"; root.search-operators("D"); } }
                            LetterButton { letter: "E"; active: selected-letter == "E"; clicked => { selected-letter = "E"; root.search-operators("E"); } }
                            LetterButton { letter: "F"; active: selected-letter == "F"; clicked => { selected-letter = "F"; root.search-operators("F"); } }
                            LetterButton { letter: "G"; active: selected-letter == "G"; clicked => { selected-letter = "G"; root.search-operators("G"); } }
                            LetterButton { letter: "H"; active: selected-letter == "H"; clicked => { selected-letter = "H"; root.search-operators("H"); } }
                            LetterButton { letter: "I"; active: selected-letter == "I"; clicked => { selected-letter = "I"; root.search-operators("I"); } }
                            LetterButton { letter: "J"; active: selected-letter == "J"; clicked => { selected-letter = "J"; root.search-operators("J"); } }
                            LetterButton { letter: "K"; active: selected-letter == "K"; clicked => { selected-letter = "K"; root.search-operators("K"); } }
                            LetterButton { letter: "L"; active: selected-letter == "L"; clicked => { selected-letter = "L"; root.search-operators("L"); } }
                            LetterButton { letter: "M"; active: selected-letter == "M"; clicked => { selected-letter = "M"; root.search-operators("M"); } }
                            LetterButton { letter: "N"; active: selected-letter == "N"; clicked => { selected-letter = "N"; root.search-operators("N"); } }
                            LetterButton { letter: "O"; active: selected-letter == "O"; clicked => { selected-letter = "O"; root.search-operators("O"); } }
                            LetterButton { letter: "P"; active: selected-letter == "P"; clicked => { selected-letter = "P"; root.search-operators("P"); } }
                            LetterButton { letter: "Q"; active: selected-letter == "Q"; clicked => { selected-letter = "Q"; root.search-operators("Q"); } }
                            LetterButton { letter: "R"; active: selected-letter == "R"; clicked => { selected-letter = "R"; root.search-operators("R"); } }
                            LetterButton { letter: "S"; active: selected-letter == "S"; clicked => { selected-letter = "S"; root.search-operators("S"); } }
                            LetterButton { letter: "T"; active: selected-letter == "T"; clicked => { selected-letter = "T"; root.search-operators("T"); } }
                            LetterButton { letter: "U"; active: selected-letter == "U"; clicked => { selected-letter = "U"; root.search-operators("U"); } }
                            LetterButton { letter: "V"; active: selected-letter == "V"; clicked => { selected-letter = "V"; root.search-operators("V"); } }
                            LetterButton { letter: "W"; active: selected-letter == "W"; clicked => { selected-letter = "W"; root.search-operators("W"); } }
                            LetterButton { letter: "X"; active: selected-letter == "X"; clicked => { selected-letter = "X"; root.search-operators("X"); } }
                            LetterButton { letter: "Y"; active: selected-letter == "Y"; clicked => { selected-letter = "Y"; root.search-operators("Y"); } }
                            LetterButton { letter: "Z"; active: selected-letter == "Z"; clicked => { selected-letter = "Z"; root.search-operators("Z"); } }
                        }
                    }
                }
            }
        }

        // ====================================================================
        // STATUS BAR
        // ====================================================================
        StatusBar {
            terminal-code: AppState.terminal-code;
            version: AppState.version;
            is-online: AppState.is-online;
            pending-sync-count: AppState.pending-sync-count;
        }
    }
}
