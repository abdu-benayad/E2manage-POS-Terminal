// ============================================================================
// E2Manage POS Terminal - Setup/Pairing Screen
// ============================================================================
// Displayed when terminal is not registered. Shows pairing code for admin
// to enter in web UI to complete terminal registration.
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Animation, Locale, AppState, Layout } from "../../theme.slint";
import { StatusBar } from "../../components/status_bar.slint";

// ============================================================================
// SETUP SCREEN
// ============================================================================
// Usage:
//   SetupScreen {
//       pairing-code: "ABC-123-XYZ";
//       hardware-id: "a1b2c3d4e5f6";
//       status: "pending";  // "pending", "completed", "expired", "error"
//       error-message: "";
//       expires-in-seconds: 900;
//       refresh-requested => { /* request new pairing code */ }
//       pairing-completed(terminal-id, secret) => { /* save and proceed */ }
//   }
// ============================================================================

export component SetupScreen inherits Rectangle {
    // Pairing code displayed to user (e.g., "ABC-123-XYZ")
    in property <string> pairing-code: "---";

    // Hardware ID of this device
    in property <string> hardware-id: "";

    // Current status: "pending", "completed", "expired", "error"
    in property <string> status: "pending";

    // Error message if status is "error"
    in property <string> error-message: "";

    // Time remaining before code expires (in seconds)
    in property <int> expires-in-seconds: 900;

    // Server URL (configurable by user)
    in-out property <string> server-url: "http://178.156.135.235:3000";

    // Whether settings panel is expanded
    property <bool> settings-expanded: false;

    // Callbacks
    callback refresh-requested;
    callback pairing-completed(string, string);  // (terminal-id, secret)
    callback server-url-changed(string);         // called when server URL is changed

    // Full-screen gradient background
    background: @linear-gradient(180deg, Colors.gradient-top 0%, Colors.gradient-bottom 100%);

    // Center content container (excludes status bar height)
    Rectangle {
        y: 0;
        height: parent.height - Sizes.status-bar-height;
        width: parent.width;
        background: transparent;

        // Centered vertical layout
        VerticalLayout {
            alignment: center;
            spacing: Spacing.lg;
            padding: Spacing.xl;

            // Icon container
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 100px;
                    height: 100px;
                    border-radius: 50px;
                    background: rgba(255, 255, 255, 0.1);

                    // Link/Setup icon (simple representation)
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: status == "pending" ? "🔗" :
                                  status == "completed" ? "✓" :
                                  status == "expired" ? "⏰" : "⚠";
                            font-size: 48px;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // Title
            Text {
                text: Locale.current == "ar" ? "إعداد الجهاز" : "Terminal Setup";
                font-size: Typography.title;
                font-weight: 700;
                color: Colors.text-on-primary;
                horizontal-alignment: center;
            }

            // Description based on status
            Text {
                text: status == "pending" ?
                        (Locale.current == "ar" ?
                            "هذا الجهاز غير مسجل. أدخل رمز الإقران في لوحة الإدارة." :
                            "This terminal is not registered. Enter the pairing code in the admin panel.") :
                      status == "completed" ?
                        (Locale.current == "ar" ?
                            "تم الإقران بنجاح! جارٍ تهيئة الجهاز..." :
                            "Pairing successful! Initializing terminal...") :
                      status == "expired" ?
                        (Locale.current == "ar" ?
                            "انتهت صلاحية رمز الإقران. اضغط للحصول على رمز جديد." :
                            "Pairing code expired. Click to get a new code.") :
                        error-message;
                font-size: Typography.body;
                color: rgba(255, 255, 255, 0.85);
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            // Spacer
            Rectangle { height: Spacing.lg; }

            // Pairing code card
            if status == "pending" || status == "expired": HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 350px;
                    height: 140px;
                    border-radius: Radius.lg;
                    background: white;
                    drop-shadow-blur: 10px;
                    drop-shadow-color: rgba(0, 0, 0, 0.15);
                    drop-shadow-offset-y: 4px;

                    VerticalLayout {
                        alignment: center;
                        spacing: Spacing.sm;
                        padding: Spacing.lg;

                        Text {
                            text: Locale.current == "ar" ? "رمز الإقران" : "Pairing Code";
                            font-size: Typography.caption;
                            color: Colors.text-secondary;
                            horizontal-alignment: center;
                        }

                        // The pairing code - large and prominent
                        Text {
                            text: pairing-code;
                            font-size: 36px;
                            font-weight: 700;
                            letter-spacing: 4px;
                            color: status == "expired" ? Colors.text-secondary : Colors.primary;
                            horizontal-alignment: center;
                        }

                        // Timer or expired message
                        if status == "pending": Text {
                            property <int> timer-minutes: expires-in-seconds / 60;
                            text: Locale.current == "ar" ?
                                    "صالح لمدة " + timer-minutes + " دقيقة" :
                                    "Valid for " + timer-minutes + " min";
                            font-size: Typography.caption;
                            color: expires-in-seconds < 120 ? Colors.danger : Colors.text-secondary;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // Success animation placeholder
            if status == "completed": HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 150px;
                    height: 150px;
                    border-radius: 75px;
                    background: Colors.success;

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "✓";
                            font-size: 72px;
                            color: white;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // Spacer
            Rectangle { height: Spacing.lg; }

            // Refresh button (for expired codes)
            if status == "expired" || status == "error": HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 200px;
                    height: 48px;
                    border-radius: Radius.md;
                    background: touch-area.has-hover ? Colors.primary-light : Colors.primary;

                    touch-area := TouchArea {
                        clicked => { root.refresh-requested(); }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: Locale.current == "ar" ? "الحصول على رمز جديد" : "Get New Code";
                            font-size: Typography.body;
                            font-weight: 600;
                            color: white;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // Admin URL hint
            if status == "pending": VerticalLayout {
                spacing: Spacing.xs;

                Text {
                    text: Locale.current == "ar" ? "أدخل الرمز في:" : "Enter code at:";
                    font-size: Typography.caption;
                    color: rgba(255, 255, 255, 0.6);
                    horizontal-alignment: center;
                }

                Text {
                    text: server-url + "/pos/terminals";
                    font-size: Typography.body;
                    font-weight: 500;
                    color: rgba(255, 255, 255, 0.9);
                    horizontal-alignment: center;
                }
            }

            // Hardware ID (small, at bottom)
            Rectangle { height: Spacing.md; }

            Text {
                text: Locale.current == "ar" ?
                    "معرف الجهاز: " + hardware-id :
                    "Hardware ID: " + hardware-id;
                font-size: Typography.caption;
                color: rgba(255, 255, 255, 0.4);
                horizontal-alignment: center;
            }

            // Settings toggle
            Rectangle { height: Spacing.sm; }

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 180px;
                    height: 36px;
                    border-radius: Radius.sm;
                    background: settings-touch.has-hover ? rgba(255, 255, 255, 0.15) : rgba(255, 255, 255, 0.08);

                    settings-touch := TouchArea {
                        clicked => { settings-expanded = !settings-expanded; }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.xs;
                        padding: Spacing.sm;

                        Text {
                            text: settings-expanded ? "▼" : "▶";
                            font-size: Typography.caption;
                            color: rgba(255, 255, 255, 0.6);
                            vertical-alignment: center;
                        }

                        Text {
                            text: Locale.current == "ar" ? "إعدادات الخادم" : "Server Settings";
                            font-size: Typography.caption;
                            color: rgba(255, 255, 255, 0.6);
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Server URL input (collapsible)
            if settings-expanded: VerticalLayout {
                spacing: Spacing.sm;
                padding-top: Spacing.sm;

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: 350px;
                        height: 80px;
                        border-radius: Radius.md;
                        background: rgba(255, 255, 255, 0.1);

                        VerticalLayout {
                            padding: Spacing.md;
                            spacing: Spacing.xs;

                            Text {
                                text: Locale.current == "ar" ? "عنوان الخادم" : "Server URL";
                                font-size: Typography.caption;
                                color: rgba(255, 255, 255, 0.7);
                            }

                            Rectangle {
                                height: 36px;
                                border-radius: Radius.sm;
                                background: rgba(0, 0, 0, 0.2);
                                border-width: 1px;
                                border-color: url-input.has-focus ? Colors.primary : rgba(255, 255, 255, 0.2);

                                url-input := TextInput {
                                    text: server-url;
                                    font-size: Typography.body;
                                    color: white;
                                    horizontal-alignment: left;
                                    vertical-alignment: center;
                                    input-type: text;

                                    edited => {
                                        server-url = self.text;
                                        root.server-url-changed(self.text);
                                    }
                                }
                            }
                        }
                    }
                }

                // Hint text
                Text {
                    text: Locale.current == "ar" ?
                        "مثال: https://your-server.com أو http://192.168.1.100:3000" :
                        "Example: https://your-server.com or http://192.168.1.100:3000";
                    font-size: 11px;
                    color: rgba(255, 255, 255, 0.4);
                    horizontal-alignment: center;
                }
            }
        }
    }

    // Bottom status bar - docked at bottom
    StatusBar {
        y: parent.height - self.height;
        width: parent.width;
        show-pending-count: false;
    }
}
