// ============================================================================
// E2Manage POS Terminal - PIN Entry Screen (Screen 1.3)
// ============================================================================
// PIN entry screen for operator authentication after cashier selection
// Shows avatar, name, PIN dots, numeric keypad, and forgot PIN option
// RTL (Arabic) support with proper text alignment
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Animation, Locale, AppState, Layout } from "../../theme.slint";
import { StatusBar } from "../../components/status_bar.slint";
import { NumericKeypad } from "../../components/numeric_keypad.slint";
import { PinDisplay } from "../../components/pin_display.slint";
import { Button, IconButton } from "../../components/button.slint";

// ============================================================================
// PIN ENTRY SCREEN
// ============================================================================
// Usage:
//   PinEntryScreen {
//       operator-id: "1";
//       operator-name: "Ahmed Mohamed";
//       operator-initials: "AM";
//       operator-color: #2563EB;
//       pin-submitted(pin) => { /* verify PIN */ }
//       back-clicked => { /* navigate back to cashier selection */ }
//   }
// ============================================================================

export component PinEntryScreen inherits Rectangle {
    // Operator info (passed from login select screen)
    in property <string> operator-id: "";
    in property <string> operator-name: Layout.rtl ? "أحمد محمد" : "Ahmed Mohamed";
    in property <string> operator-role: Layout.rtl ? "كاشير" : "Cashier";
    in property <string> operator-initials: Layout.rtl ? "أم" : "AM";
    in property <color> operator-color: Colors.primary;

    // PIN state
    in-out property <string> pin-value: "";
    in-out property <bool> error: false;
    in-out property <string> error-message: "";
    in-out property <bool> loading: false;
    in-out property <int> attempts-remaining: 3;

    // Maximum PIN length
    property <int> max-pin-length: 4;

    // Callbacks
    callback pin-submitted(string);
    callback back-clicked;
    callback forgot-pin-clicked;
    callback face-login-clicked;
    callback pin-backspace;

    background: Colors.background;

    VerticalLayout {
        spacing: 0px;

        // ====================================================================
        // HEADER
        // ====================================================================
        Rectangle {
            height: 80px;
            background: @linear-gradient(180deg, Colors.gradient-top 0%, Colors.gradient-bottom 100%);

            HorizontalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.xl;
                alignment: space-between;

                // Left section - Back button
                HorizontalLayout {
                    alignment: start;
                    spacing: Spacing.md;

                    Rectangle {
                        width: Sizes.button-icon;
                        height: Sizes.button-icon;
                        border-radius: Radius.md;
                        background: back-touch.has-hover ? rgba(255, 255, 255, 0.1) : transparent;

                        animate background { duration: Animation.fast; }

                        back-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.back-clicked();
                            }
                        }

                        Text {
                            text: Layout.rtl ? "\u{2192}" : "\u{2190}"; // Arrow left/right depending on RTL
                            font-size: Typography.heading;
                            font-weight: Typography.medium;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        Text {
                            text: Layout.rtl ? "رجوع" : "Back";
                            font-size: Typography.body;
                            color: rgba(255, 255, 255, 0.8);
                            vertical-alignment: center;
                        }
                    }
                }

                // Center section - Screen title
                VerticalLayout {
                    alignment: center;

                    Text {
                        text: Layout.rtl ? "تسجيل الدخول" : "Login";
                        font-size: Typography.subheading;
                        font-weight: Typography.medium;
                        color: rgba(255, 255, 255, 0.9);
                        horizontal-alignment: center;
                    }
                }

                // Right section - Time and status
                HorizontalLayout {
                    alignment: end;
                    spacing: Spacing.md;

                    VerticalLayout {
                        alignment: center;

                        HorizontalLayout {
                            spacing: Spacing.xs;

                            Text {
                                text: AppState.current-time;
                                font-size: Typography.body;
                                color: Colors.text-on-primary;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: Sizes.status-dot;
                                height: Sizes.status-dot;
                                border-radius: Sizes.status-dot / 2;
                                background: AppState.is-online ? Colors.success : Colors.warning;
                            }

                            Text {
                                text: AppState.is-online ? Locale.online : Locale.offline;
                                font-size: Typography.small;
                                color: rgba(255, 255, 255, 0.8);
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ====================================================================
        // MAIN CONTENT
        // ====================================================================
        Rectangle {
            vertical-stretch: 1;
            background: Colors.background;

            VerticalLayout {
                alignment: center;
                spacing: Spacing.xl;
                padding-top: Spacing.xxl;
                padding-bottom: Spacing.lg;
                padding-left: Spacing.xxl;
                padding-right: Spacing.xxl;

                // Avatar
                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: Sizes.avatar-xl;
                        height: Sizes.avatar-xl;
                        border-radius: Sizes.avatar-xl / 2;
                        background: operator-color;
                        border-width: error ? 3px : 0px;
                        border-color: Colors.danger;

                        animate border-width { duration: Animation.fast; }
                        animate border-color { duration: Animation.fast; }

                        Text {
                            text: operator-initials;
                            font-size: 36px;
                            font-weight: Typography.bold;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Operator name and role
                VerticalLayout {
                    alignment: center;
                    spacing: Spacing.xs;

                    Text {
                        text: operator-name;
                        font-size: Typography.heading;
                        font-weight: Typography.semi-bold;
                        color: Colors.text-primary;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: operator-role;
                        font-size: Typography.body;
                        color: Colors.text-secondary;
                        horizontal-alignment: center;
                    }
                }

                // PIN instruction
                Text {
                    text: Layout.rtl ? "أدخل رمز PIN" : "Enter PIN code";
                    font-size: Typography.body;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                }

                // PIN display
                HorizontalLayout {
                    alignment: center;

                    PinDisplay {
                        length: max-pin-length;
                        filled: pin-value.character-count;
                        error: root.error;
                        error-message: root.error-message;
                    }
                }

                // Numeric keypad
                HorizontalLayout {
                    alignment: center;

                    NumericKeypad {
                        mode: "pin";
                        value <=> pin-value;
                        max-length: max-pin-length;
                        confirm-label: Layout.rtl ? "تأكيد" : "OK";
                        disabled: loading;

                        key-pressed(key) => {
                            // Clear error state when user starts typing
                            if root.error {
                                root.error = false;
                                root.error-message = "";
                            }
                            // Auto-submit when all digits entered
                            if pin-value.character-count == max-pin-length && !root.loading {
                                root.loading = true;
                                root.pin-submitted(pin-value);
                            }
                        }

                        backspace => {
                            // Slint cannot slice strings — delegate to Rust
                            root.pin-backspace();
                        }

                        confirmed(value) => {
                            // Fallback confirm (auto-submit handles this, guard against double submit)
                            if value.character-count == max-pin-length && !root.loading {
                                root.loading = true;
                                root.pin-submitted(value);
                            }
                        }
                    }
                }

                // Spacer
                Rectangle {
                    height: Spacing.md;
                }

                // Bottom actions
                HorizontalLayout {
                    alignment: center;
                    spacing: Spacing.xxl;

                    // Forgot PIN link
                    Rectangle {
                        height: Sizes.touch-target;

                        HorizontalLayout {
                            alignment: center;

                            forgot-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.forgot-pin-clicked(); }

                                Rectangle {
                                    background: forgot-touch.has-hover ? rgba(37, 99, 235, 0.08) : transparent;
                                    border-radius: Radius.sm;

                                    animate background { duration: Animation.fast; }

                                    HorizontalLayout {
                                        padding-left: Spacing.md;
                                        padding-right: Spacing.md;
                                        alignment: center;

                                        Text {
                                            text: Layout.rtl ? "نسيت رمز PIN؟" : "Forgot PIN?";
                                            font-size: Typography.body;
                                            color: Colors.primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Face login option (if available)
                    Rectangle {
                        height: Sizes.touch-target;

                        HorizontalLayout {
                            alignment: center;

                            face-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.face-login-clicked(); }

                                Rectangle {
                                    background: face-touch.has-hover ? rgba(37, 99, 235, 0.08) : transparent;
                                    border-radius: Radius.sm;

                                    animate background { duration: Animation.fast; }

                                    HorizontalLayout {
                                        padding-left: Spacing.md;
                                        padding-right: Spacing.md;
                                        alignment: center;
                                        spacing: Spacing.xs;

                                        Text {
                                            text: "\u{1F9D1}"; // Face emoji
                                            font-size: Typography.body;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: Layout.rtl ? "تسجيل بالوجه" : "Use Face Login";
                                            font-size: Typography.body;
                                            color: Colors.primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

            }
        }

        // ====================================================================
        // STATUS BAR
        // ====================================================================
        StatusBar {
            terminal-code: AppState.terminal-code;
            version: AppState.version;
            is-online: AppState.is-online;
            pending-sync-count: AppState.pending-sync-count;
        }
    }

    // ====================================================================
    // WRONG PIN MODAL OVERLAY
    // ====================================================================
    // Overlays the entire screen when error == true
    if error: Rectangle {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        background: rgba(0, 0, 0, 0.65);

        // Consume all touch events — prevent click-through to content below
        TouchArea { }

        // Dialog card — centered
        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: 380px;
            height: 260px;
            border-radius: Radius.lg;
            background: Colors.surface;
            border-width: 1px;
            border-color: Colors.border;

            VerticalLayout {
                alignment: center;
                spacing: Spacing.lg;
                padding-top: Spacing.xl;
                padding-bottom: Spacing.xl;
                padding-left: Spacing.xl;
                padding-right: Spacing.xl;

                // Warning icon
                Text {
                    text: "\u{26A0}";
                    font-size: 32px;
                    color: Colors.danger;
                    horizontal-alignment: center;
                }

                // Title
                Text {
                    text: Layout.rtl ? "رمز PIN خاطئ" : "Wrong PIN";
                    font-size: Typography.heading;
                    font-weight: Typography.bold;
                    color: Colors.danger;
                    horizontal-alignment: center;
                }

                // Attempts / lockout message
                Text {
                    text: attempts-remaining > 0
                        ? (Layout.rtl ? "المحاولات المتبقية: " + attempts-remaining : "Attempts remaining: " + attempts-remaining)
                        : (Layout.rtl ? "تم تجاوز الحد الأقصى. اتصل بالمشرف." : "Too many attempts. Contact supervisor.");
                    font-size: Typography.body;
                    color: attempts-remaining > 0 ? Colors.text-secondary : Colors.danger;
                    horizontal-alignment: center;
                }

                // Buttons row
                HorizontalLayout {
                    spacing: Spacing.md;
                    alignment: center;

                    // "Change Cashier" — always visible
                    Rectangle {
                        width: 155px;
                        height: 44px;
                        border-radius: Radius.md;
                        background: Colors.surface-variant;
                        border-width: 1px;
                        border-color: Colors.border;

                        back-modal-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.back-clicked(); }
                        }

                        Text {
                            text: Layout.rtl ? "اختر كاشير آخر" : "Change Cashier";
                            font-size: Typography.body;
                            color: Colors.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // "Try Again" — only when attempts remain
                    if attempts-remaining > 0: Rectangle {
                        width: 155px;
                        height: 44px;
                        border-radius: Radius.md;
                        background: Colors.primary;

                        try-again-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.pin-value = "";
                                root.error = false;
                                root.error-message = "";
                                root.loading = false;
                            }
                        }

                        Text {
                            text: Layout.rtl ? "حاول مجددًا" : "Try Again";
                            font-size: Typography.body;
                            font-weight: Typography.semi-bold;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
