// ============================================================================
// E2Manage POS Terminal - Splash Screen (Screen 1.1)
// ============================================================================
// Initial loading screen with logo, progress bar, and sync status
// Shows on application startup while connecting and syncing
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Animation, Locale, AppState, Layout } from "../../theme.slint";
import { ProgressBar } from "../../components/progress_bar.slint";
import { StatusBar } from "../../components/status_bar.slint";

// ============================================================================
// SPLASH SCREEN
// ============================================================================
// Usage:
//   SplashScreen {
//       progress: 0.6;
//       status-text: "Syncing products...";
//       loading-complete => { /* navigate to login */ }
//   }
// ============================================================================

export component SplashScreen inherits Rectangle {
    // Progress value from 0.0 to 1.0
    in property <float> progress: 0.0;

    // Current status message
    in property <string> status-text: Locale.current == "ar" ? "جارٍ البدء..." : "Starting...";

    // Callback when loading completes
    callback loading-complete;

    // Full-screen gradient background
    background: @linear-gradient(180deg, Colors.gradient-top 0%, Colors.gradient-bottom 100%);

    // Center content container (excludes status bar height)
    Rectangle {
        y: 0;
        height: parent.height - Sizes.status-bar-height;
        width: parent.width;
        background: transparent;

        // Centered vertical layout
        VerticalLayout {
            alignment: center;
            spacing: Spacing.lg;

            // Logo container - white rounded rectangle with "E2" branding
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 150px;
                    height: 150px;
                    border-radius: Radius.xl;
                    background: rgba(255, 255, 255, 0.08);

                    // Inner logo
                    Rectangle {
                        width: 120px;
                        height: 120px;
                        border-radius: Radius.lg;
                        background: white;

                        // Logo text
                        VerticalLayout {
                            alignment: center;

                            Text {
                                text: "E2";
                                font-size: 48px;
                                font-weight: 700;
                                color: Colors.primary;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            // Spacer
            Rectangle { height: Spacing.sm; }

            // App name
            Text {
                text: Locale.app-name;
                font-size: Typography.title;
                font-weight: 600;
                color: Colors.text-on-primary;
                horizontal-alignment: center;
            }

            // Tagline
            Text {
                text: Locale.current == "ar" ? "نظام نقاط البيع المتكامل" : "Complete Point of Sale System";
                font-size: Typography.body;
                color: rgba(255, 255, 255, 0.7);
                horizontal-alignment: center;
            }

            // Spacer before progress bar
            Rectangle { height: Spacing.xl; }

            // Progress bar container
            HorizontalLayout {
                alignment: center;

                ProgressBar {
                    progress: root.progress;
                    width: 300px;
                }
            }

            // Spacer
            Rectangle { height: Spacing.sm; }

            // Status text
            Text {
                text: status-text;
                font-size: Typography.body;
                color: rgba(255, 255, 255, 0.85);
                horizontal-alignment: center;
            }
        }
    }

    // Bottom status bar - docked at bottom
    StatusBar {
        y: parent.height - self.height;
        width: parent.width;
        show-pending-count: false;
    }
}
