// ============================================================================
// E2Manage POS Terminal - Refund Process Screen (Phase 32)
// ============================================================================
// Refund method selection and processing screen
// Supports Cash, Card, and Store Credit refund methods
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Layout, Locale, CartState } from "../../theme.slint";
import { Button } from "../../components/mod.slint";
import { StatusBar } from "../../components/mod.slint";

export component RefundScreen inherits Rectangle {
    // Input properties
    in property <string> refund-amount: "0.000";
    in property <string> currency: CartState.currency;
    in property <string> original-payment-method: "cash";  // cash, card, wallet
    in property <string> selected-refund-method: "cash";   // cash, card, credit
    in property <string> status: "selecting";              // selecting, processing, completed, failed
    in property <string> error-message: "";
    in property <string> return-receipt-number: "";
    in property <string> wallet-type: "";                  // For display when original was wallet
    in property <bool> is-online: true;

    // Callbacks
    callback method-selected(string);
    callback process-refund;
    callback print-receipt;
    callback done;
    callback back-clicked;

    background: Colors.background;

    VerticalLayout {
        spacing: 0px;

        // Header - changes color based on status
        Rectangle {
            height: Sizes.header-height;
            background: status == "completed" ? Colors.success :
                        status == "failed" ? Colors.danger : Colors.warning;

            HorizontalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.lg;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Spacing.lg;

                    // Back button - only show when not completed
                    if status != "completed" && status != "processing": Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: Radius.md;

                        back-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.back-clicked(); }
                        }

                        Text {
                            text: Layout.rtl ? "→" : "←";
                            font-size: 24px;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Title with icon
                    HorizontalLayout {
                        spacing: Spacing.sm;

                        Text {
                            text: status == "completed" ? "✓" :
                                  status == "failed" ? "⚠️" : "💰";
                            font-size: 24px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: status == "completed" ?
                                  (Locale.current == "ar" ? "تم الاسترداد" : "Refund Complete") :
                                  status == "failed" ?
                                  (Locale.current == "ar" ? "فشل الاسترداد" : "Refund Failed") :
                                  (Locale.current == "ar" ? "الاسترداد" : "Refund");
                            font-size: Typography.heading;
                            font-weight: 600;
                            color: Colors.text-on-primary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Amount badge (shown in selecting/processing states)
                if status == "selecting" || status == "processing": Rectangle {
                    height: 40px;
                    border-radius: Radius.chip;
                    background: rgba(255, 255, 255, 0.2);

                    HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        spacing: Spacing.xs;

                        Text {
                            text: Locale.current == "ar" ? "المبلغ:" : "Amount:";
                            font-size: Typography.caption;
                            color: rgba(255, 255, 255, 0.9);
                            vertical-alignment: center;
                        }

                        Text {
                            text: refund-amount + " " + currency;
                            font-size: Typography.body;
                            font-weight: 700;
                            color: Colors.text-on-primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Main content
        Rectangle {
            vertical-stretch: 1;
            background: Colors.surface;

            // ========================================
            // Status: SELECTING - Method selection
            // ========================================
            if status == "selecting": VerticalLayout {
                alignment: center;
                spacing: Spacing.xxl;
                padding: Spacing.xxl;

                // Refund amount display
                VerticalLayout {
                    spacing: Spacing.xs;
                    alignment: center;

                    Text {
                        text: Locale.current == "ar" ? "مبلغ الاسترداد" : "Refund Amount";
                        font-size: Typography.caption;
                        color: Colors.text-secondary;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: refund-amount + " " + currency;
                        font-size: 48px;
                        font-weight: 700;
                        color: Colors.warning;
                        horizontal-alignment: center;
                    }
                }

                // Refund method selection
                VerticalLayout {
                    spacing: Spacing.md;
                    alignment: center;

                    Text {
                        text: Locale.current == "ar" ? "اختر طريقة الاسترداد" : "Select Refund Method";
                        font-size: Typography.subheading;
                        color: Colors.text-primary;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: Spacing.lg;
                        alignment: center;

                        // Cash refund option
                        Rectangle {
                            width: 200px;
                            height: 160px;
                            background: selected-refund-method == "cash" ?
                                       Colors.warning : Colors.background;
                            border-radius: Radius.lg;
                            border-width: 2px;
                            border-color: selected-refund-method == "cash" ?
                                         Colors.warning : Colors.border;
                            drop-shadow-blur: selected-refund-method == "cash" ? 10px : 0px;
                            drop-shadow-color: selected-refund-method == "cash" ?
                                              rgba(245, 158, 11, 0.3) : transparent;

                            cash-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.method-selected("cash"); }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: Spacing.sm;

                                // Icon circle
                                Rectangle {
                                    width: 60px;
                                    height: 60px;
                                    border-radius: 30px;
                                    background: selected-refund-method == "cash" ?
                                               rgba(255, 255, 255, 0.2) : Colors.success;

                                    Text {
                                        text: "💵";
                                        font-size: 32px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: Locale.current == "ar" ? "نقداً" : "Cash";
                                    font-size: Typography.body;
                                    font-weight: 600;
                                    color: selected-refund-method == "cash" ?
                                           Colors.text-on-primary : Colors.text-primary;
                                    horizontal-alignment: center;
                                }

                                // Show "Original" badge if cash was original payment
                                if original-payment-method == "cash": Rectangle {
                                    height: 22px;
                                    border-radius: Radius.chip;
                                    background: selected-refund-method == "cash" ?
                                               rgba(255, 255, 255, 0.25) : Colors.surface-variant;

                                    HorizontalLayout {
                                        padding-left: Spacing.sm;
                                        padding-right: Spacing.sm;

                                        Text {
                                            text: Locale.current == "ar" ? "الأصلي" : "Original";
                                            font-size: Typography.small;
                                            color: selected-refund-method == "cash" ?
                                                   rgba(255, 255, 255, 0.9) : Colors.text-secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Card refund option
                        Rectangle {
                            width: 200px;
                            height: 160px;
                            background: selected-refund-method == "card" ?
                                       Colors.warning : Colors.background;
                            border-radius: Radius.lg;
                            border-width: 2px;
                            border-color: selected-refund-method == "card" ?
                                         Colors.warning : Colors.border;
                            drop-shadow-blur: selected-refund-method == "card" ? 10px : 0px;
                            drop-shadow-color: selected-refund-method == "card" ?
                                              rgba(245, 158, 11, 0.3) : transparent;

                            card-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.method-selected("card"); }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: Spacing.sm;

                                // Icon circle
                                Rectangle {
                                    width: 60px;
                                    height: 60px;
                                    border-radius: 30px;
                                    background: selected-refund-method == "card" ?
                                               rgba(255, 255, 255, 0.2) : Colors.primary;

                                    Text {
                                        text: "💳";
                                        font-size: 32px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: Locale.current == "ar" ? "بطاقة" : "Card";
                                    font-size: Typography.body;
                                    font-weight: 600;
                                    color: selected-refund-method == "card" ?
                                           Colors.text-on-primary : Colors.text-primary;
                                    horizontal-alignment: center;
                                }

                                // Show "Original" badge if card was original payment
                                if original-payment-method == "card": Rectangle {
                                    height: 22px;
                                    border-radius: Radius.chip;
                                    background: selected-refund-method == "card" ?
                                               rgba(255, 255, 255, 0.25) : Colors.surface-variant;

                                    HorizontalLayout {
                                        padding-left: Spacing.sm;
                                        padding-right: Spacing.sm;

                                        Text {
                                            text: Locale.current == "ar" ? "الأصلي" : "Original";
                                            font-size: Typography.small;
                                            color: selected-refund-method == "card" ?
                                                   rgba(255, 255, 255, 0.9) : Colors.text-secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Store credit option
                        Rectangle {
                            width: 200px;
                            height: 160px;
                            background: selected-refund-method == "credit" ?
                                       Colors.warning : Colors.background;
                            border-radius: Radius.lg;
                            border-width: 2px;
                            border-color: selected-refund-method == "credit" ?
                                         Colors.warning : Colors.border;
                            drop-shadow-blur: selected-refund-method == "credit" ? 10px : 0px;
                            drop-shadow-color: selected-refund-method == "credit" ?
                                              rgba(245, 158, 11, 0.3) : transparent;

                            credit-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.method-selected("credit"); }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: Spacing.sm;

                                // Icon circle
                                Rectangle {
                                    width: 60px;
                                    height: 60px;
                                    border-radius: 30px;
                                    background: selected-refund-method == "credit" ?
                                               rgba(255, 255, 255, 0.2) : #9333EA;

                                    Text {
                                        text: "🎁";
                                        font-size: 32px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: Locale.current == "ar" ? "رصيد المتجر" : "Store Credit";
                                    font-size: Typography.body;
                                    font-weight: 600;
                                    color: selected-refund-method == "credit" ?
                                           Colors.text-on-primary : Colors.text-primary;
                                    horizontal-alignment: center;
                                }

                                // Show "Wallet" type if original was wallet
                                if original-payment-method == "wallet" && wallet-type != "": Rectangle {
                                    height: 22px;
                                    border-radius: Radius.chip;
                                    background: selected-refund-method == "credit" ?
                                               rgba(255, 255, 255, 0.25) : Colors.surface-variant;

                                    HorizontalLayout {
                                        padding-left: Spacing.sm;
                                        padding-right: Spacing.sm;

                                        Text {
                                            text: wallet-type;
                                            font-size: Typography.small;
                                            color: selected-refund-method == "credit" ?
                                                   rgba(255, 255, 255, 0.9) : Colors.text-secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Info note
                Rectangle {
                    height: 60px;
                    max-width: 700px;
                    background: Colors.primary-light;
                    border-radius: Radius.md;

                    HorizontalLayout {
                        padding: Spacing.md;
                        spacing: Spacing.sm;

                        Text {
                            text: "ℹ️";
                            font-size: Typography.body;
                            vertical-alignment: center;
                        }

                        Text {
                            text: Locale.current == "ar" ?
                                  "نوصي باستخدام نفس طريقة الدفع الأصلية للاسترداد لتسهيل المطابقة" :
                                  "We recommend using the same payment method as the original transaction for easier reconciliation";
                            font-size: Typography.caption;
                            color: Colors.text-secondary;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                    }
                }

                // Confirm button
                Button {
                    text: Locale.current == "ar" ? "تأكيد الاسترداد" : "Confirm Refund";
                    variant: "warning";
                    width: 300px;
                    clicked => { root.process-refund(); }
                }
            }

            // ========================================
            // Status: PROCESSING - Animation
            // ========================================
            if status == "processing": VerticalLayout {
                alignment: center;
                spacing: Spacing.xl;

                // Spinning indicator animation
                Rectangle {
                    width: 120px;
                    height: 120px;
                    border-radius: 60px;
                    background: Colors.warning;

                    Text {
                        text: "⏳";
                        font-size: 64px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: Locale.current == "ar" ? "جاري معالجة الاسترداد..." : "Processing refund...";
                    font-size: Typography.subheading;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                }

                Text {
                    text: Locale.current == "ar" ? "يرجى الانتظار" : "Please wait";
                    font-size: Typography.caption;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                }
            }

            // ========================================
            // Status: COMPLETED - Success
            // ========================================
            if status == "completed": VerticalLayout {
                alignment: center;
                spacing: Spacing.xl;
                padding: Spacing.xxl;

                // Success checkmark circle
                Rectangle {
                    width: 120px;
                    height: 120px;
                    border-radius: 60px;
                    background: Colors.success;

                    Text {
                        text: "✓";
                        font-size: 64px;
                        font-weight: 700;
                        color: Colors.text-on-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: Locale.current == "ar" ? "تم الاسترداد بنجاح" : "Refund Successful";
                    font-size: Typography.title;
                    font-weight: 600;
                    color: Colors.success;
                    horizontal-alignment: center;
                }

                // Refund amount
                Text {
                    text: refund-amount + " " + currency;
                    font-size: 48px;
                    font-weight: 700;
                    color: Colors.text-primary;
                    horizontal-alignment: center;
                }

                // Method used
                Rectangle {
                    height: 36px;
                    border-radius: Radius.chip;
                    background: Colors.surface-variant;

                    HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        spacing: Spacing.xs;

                        Text {
                            text: selected-refund-method == "cash" ? "💵" :
                                  selected-refund-method == "card" ? "💳" : "🎁";
                            font-size: Typography.body;
                            vertical-alignment: center;
                        }

                        Text {
                            text: (Locale.current == "ar" ? "عبر " : "Via ") +
                                  (selected-refund-method == "cash" ?
                                   (Locale.current == "ar" ? "نقداً" : "Cash") :
                                   selected-refund-method == "card" ?
                                   (Locale.current == "ar" ? "البطاقة" : "Card") :
                                   (Locale.current == "ar" ? "رصيد المتجر" : "Store Credit"));
                            font-size: Typography.body;
                            color: Colors.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Return receipt number
                Text {
                    text: (Locale.current == "ar" ? "رقم المرتجع: " : "Return #: ") + return-receipt-number;
                    font-size: Typography.body;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                }

                // Action buttons
                HorizontalLayout {
                    spacing: Spacing.lg;
                    alignment: center;

                    Button {
                        text: Locale.current == "ar" ? "🖨️ طباعة" : "🖨️ Print";
                        variant: "secondary";
                        width: 150px;
                        clicked => { root.print-receipt(); }
                    }

                    Button {
                        text: Locale.current == "ar" ? "تم" : "Done";
                        variant: "primary";
                        width: 150px;
                        clicked => { root.done(); }
                    }
                }
            }

            // ========================================
            // Status: FAILED - Error
            // ========================================
            if status == "failed": VerticalLayout {
                alignment: center;
                spacing: Spacing.xl;
                padding: Spacing.xxl;

                // Error icon circle
                Rectangle {
                    width: 120px;
                    height: 120px;
                    border-radius: 60px;
                    background: Colors.danger;

                    Text {
                        text: "✕";
                        font-size: 64px;
                        font-weight: 700;
                        color: Colors.text-on-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: Locale.current == "ar" ? "فشل الاسترداد" : "Refund Failed";
                    font-size: Typography.title;
                    font-weight: 600;
                    color: Colors.danger;
                    horizontal-alignment: center;
                }

                // Error message
                if error-message != "": Rectangle {
                    max-width: 500px;
                    background: #FECACA;
                    border-radius: Radius.md;

                    HorizontalLayout {
                        padding: Spacing.md;
                        spacing: Spacing.sm;

                        Text {
                            text: "⚠️";
                            font-size: Typography.body;
                            vertical-alignment: center;
                        }

                        Text {
                            text: error-message;
                            font-size: Typography.body;
                            color: Colors.danger;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                    }
                }

                // Retry and cancel buttons
                HorizontalLayout {
                    spacing: Spacing.lg;
                    alignment: center;

                    Button {
                        text: Locale.current == "ar" ? "رجوع" : "Back";
                        variant: "secondary";
                        width: 150px;
                        clicked => { root.back-clicked(); }
                    }

                    Button {
                        text: Locale.current == "ar" ? "إعادة المحاولة" : "Retry";
                        variant: "primary";
                        width: 150px;
                        clicked => { root.process-refund(); }
                    }
                }
            }
        }

        // Status bar
        StatusBar {
            is-online: root.is-online;
        }
    }
}
