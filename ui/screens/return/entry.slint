// ============================================================================
// E2Manage POS Terminal - Return Entry Screen (Phase 30)
// ============================================================================
// Entry point for returns - choose between receipt-based or manual return
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Layout, Locale, CartState } from "../../theme.slint";
import { Button, TextInput, SearchInput } from "../../components/mod.slint";
import { StatusBar } from "../../components/mod.slint";

// Return entry data struct
export struct ReturnEntryData {
    receipt-number: string,
    original-transaction-id: string,
    original-date: string,
    original-total: string,
    item-count: int,
    customer-name: string,
    can-return: bool,
    requires-approval: bool,
    error-message: string,
}

export component ReturnEntryScreen inherits Rectangle {
    // Input properties
    in property <string> receipt-number: "";
    in property <bool> searching: false;
    in property <bool> receipt-found: false;
    in property <ReturnEntryData> found-transaction: {
        receipt-number: "",
        original-transaction-id: "",
        original-date: "",
        original-total: "",
        item-count: 0,
        customer-name: "",
        can-return: false,
        requires-approval: false,
        error-message: "",
    };
    in property <string> error-message: "";
    in property <bool> is-online: true;

    // Callbacks
    callback receipt-changed(string);
    callback search-receipt;
    callback scan-receipt;
    callback manual-return;
    callback continue-with-receipt;
    callback back-clicked;

    background: Colors.background;

    VerticalLayout {
        spacing: 0px;

        // Header with warning/return color
        Rectangle {
            height: Sizes.header-height;
            background: Colors.warning;

            HorizontalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.lg;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Spacing.lg;

                    // Back button (RTL-aware)
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: Radius.md;

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.back-clicked(); }
                        }

                        Text {
                            text: Layout.rtl ? "→" : "←";
                            font-size: 24px;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Return icon and title
                    HorizontalLayout {
                        spacing: Spacing.sm;

                        Text {
                            text: "↩️";
                            font-size: 24px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: Locale.current == "ar" ? "مرتجعات" : "Returns";
                            font-size: Typography.heading;
                            font-weight: 600;
                            color: Colors.text-on-primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Main content area
        Rectangle {
            vertical-stretch: 1;
            background: Colors.background;

            VerticalLayout {
                alignment: center;
                spacing: Spacing.xxl;
                padding: Spacing.xxl;

                // Title question
                Text {
                    text: Locale.current == "ar" ?
                          "كيف تريد بدء المرتجع؟" :
                          "How would you like to start the return?";
                    font-size: Typography.title;
                    font-weight: 600;
                    color: Colors.text-primary;
                    horizontal-alignment: center;
                }

                // Option cards container
                HorizontalLayout {
                    spacing: Spacing.xl;
                    alignment: center;

                    // ========================================
                    // OPTION 1: With Receipt
                    // ========================================
                    Rectangle {
                        width: 320px;
                        height: 380px;
                        background: Colors.surface;
                        border-radius: Radius.lg;
                        border-width: 2px;
                        border-color: receipt-found ? Colors.success : Colors.border;

                        VerticalLayout {
                            padding: Spacing.xl;
                            spacing: Spacing.md;
                            alignment: start;

                            // Icon circle
                            HorizontalLayout {
                                alignment: center;

                                Rectangle {
                                    width: 80px;
                                    height: 80px;
                                    border-radius: 40px;
                                    background: Colors.primary-light;

                                    Text {
                                        text: "🧾";
                                        font-size: 36px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Title
                            Text {
                                text: Locale.current == "ar" ? "بالإيصال" : "With Receipt";
                                font-size: Typography.subheading;
                                font-weight: 600;
                                color: Colors.text-primary;
                                horizontal-alignment: center;
                            }

                            // Description
                            Text {
                                text: Locale.current == "ar" ?
                                      "امسح الباركود أو أدخل رقم الإيصال" :
                                      "Scan barcode or enter receipt number";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }

                            // Receipt input area
                            VerticalLayout {
                                spacing: Spacing.sm;
                                padding-top: Spacing.md;

                                // Receipt number input
                                TextInput {
                                    placeholder: Locale.current == "ar" ?
                                                "رقم الإيصال" :
                                                "Receipt number";
                                    text: root.receipt-number;

                                    edited(value) => {
                                        root.receipt-changed(value);
                                    }
                                }

                                // Scan + Search buttons row
                                HorizontalLayout {
                                    spacing: Spacing.sm;

                                    // Scan button
                                    Rectangle {
                                        width: 48px;
                                        height: 44px;
                                        border-radius: Radius.button;
                                        background: scan-touch.pressed ? Colors.surface-variant : Colors.surface;
                                        border-width: 1px;
                                        border-color: Colors.border;

                                        scan-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.scan-receipt(); }
                                        }

                                        Text {
                                            text: "📷";
                                            font-size: 20px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Search button
                                    Button {
                                        text: searching ? (Locale.current == "ar" ? "جارٍ البحث..." : "Searching...") :
                                              (Locale.current == "ar" ? "بحث" : "Search");
                                        variant: "primary";
                                        horizontal-stretch: 1;
                                        disabled: receipt-number == "" || searching;
                                        loading: searching;
                                        clicked => { root.search-receipt(); }
                                    }
                                }
                            }

                            // Found transaction info (when receipt found)
                            if receipt-found && found-transaction.can-return: Rectangle {
                                background: Colors.surface-variant;
                                border-radius: Radius.md;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.xs;

                                    HorizontalLayout {
                                        Text {
                                            text: Locale.current == "ar" ? "التاريخ:" : "Date:";
                                            font-size: Typography.caption;
                                            color: Colors.text-secondary;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text {
                                            text: found-transaction.original-date;
                                            font-size: Typography.caption;
                                            color: Colors.text-primary;
                                            font-weight: 500;
                                        }
                                    }

                                    HorizontalLayout {
                                        Text {
                                            text: Locale.current == "ar" ? "المبلغ:" : "Amount:";
                                            font-size: Typography.caption;
                                            color: Colors.text-secondary;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text {
                                            text: found-transaction.original-total + " " + CartState.currency;
                                            font-size: Typography.caption;
                                            color: Colors.text-primary;
                                            font-weight: 500;
                                        }
                                    }

                                    HorizontalLayout {
                                        Text {
                                            text: Locale.current == "ar" ? "عدد الأصناف:" : "Items:";
                                            font-size: Typography.caption;
                                            color: Colors.text-secondary;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text {
                                            text: found-transaction.item-count;
                                            font-size: Typography.caption;
                                            color: Colors.text-primary;
                                            font-weight: 500;
                                        }
                                    }
                                }
                            }

                            // Continue button (when receipt found and eligible)
                            if receipt-found && found-transaction.can-return: Button {
                                text: Locale.current == "ar" ? "متابعة" : "Continue";
                                variant: "primary";
                                clicked => { root.continue-with-receipt(); }
                            }

                            // Requires approval warning
                            if receipt-found && found-transaction.requires-approval: Rectangle {
                                background: #FFF3E0;
                                border-radius: Radius.sm;

                                HorizontalLayout {
                                    padding: Spacing.sm;
                                    spacing: Spacing.xs;

                                    Text {
                                        text: "⚠️";
                                        font-size: Typography.caption;
                                    }

                                    Text {
                                        text: Locale.current == "ar" ?
                                              "يتطلب موافقة المشرف" :
                                              "Requires supervisor approval";
                                        font-size: Typography.caption;
                                        color: Colors.orange-accent;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }

                            // Error message
                            if error-message != "": Rectangle {
                                background: #FFEBEE;
                                border-radius: Radius.sm;

                                HorizontalLayout {
                                    padding: Spacing.sm;
                                    spacing: Spacing.xs;

                                    Text {
                                        text: "❌";
                                        font-size: Typography.caption;
                                    }

                                    Text {
                                        text: error-message;
                                        font-size: Typography.caption;
                                        color: Colors.danger;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }

                    // ========================================
                    // OPTION 2: Without Receipt
                    // ========================================
                    Rectangle {
                        width: 320px;
                        height: 380px;
                        background: manual-card-touch.has-hover ? Colors.surface-variant : Colors.surface;
                        border-radius: Radius.lg;
                        border-width: 2px;
                        border-color: Colors.border;

                        manual-card-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.manual-return(); }
                        }

                        VerticalLayout {
                            padding: Spacing.xl;
                            spacing: Spacing.md;
                            alignment: center;

                            // Icon circle
                            HorizontalLayout {
                                alignment: center;

                                Rectangle {
                                    width: 80px;
                                    height: 80px;
                                    border-radius: 40px;
                                    background: Colors.warning;

                                    Text {
                                        text: "📝";
                                        font-size: 36px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Title
                            Text {
                                text: Locale.current == "ar" ? "بدون إيصال" : "Without Receipt";
                                font-size: Typography.subheading;
                                font-weight: 600;
                                color: Colors.text-primary;
                                horizontal-alignment: center;
                            }

                            // Description
                            Text {
                                text: Locale.current == "ar" ?
                                      "إدخال المنتجات يدوياً للمرتجع" :
                                      "Manually enter products for return";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }

                            // Spacer
                            Rectangle { vertical-stretch: 1; }

                            // Supervisor approval warning
                            Rectangle {
                                background: #FFF3E0;
                                border-radius: Radius.sm;

                                HorizontalLayout {
                                    padding: Spacing.sm;
                                    spacing: Spacing.xs;

                                    Text {
                                        text: "⚠️";
                                        font-size: Typography.caption;
                                    }

                                    Text {
                                        text: Locale.current == "ar" ?
                                              "قد يتطلب موافقة المشرف" :
                                              "May require supervisor approval";
                                        font-size: Typography.caption;
                                        color: Colors.orange-accent;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }

                            // Tap to continue hint
                            Text {
                                text: Locale.current == "ar" ?
                                      "اضغط للمتابعة" :
                                      "Tap to continue";
                                font-size: Typography.caption;
                                color: Colors.primary;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                // Info note at bottom
                Text {
                    text: Locale.current == "ar" ?
                          "ملاحظة: المرتجعات بدون إيصال قد تتطلب موافقة المشرف حسب سياسة المتجر" :
                          "Note: Returns without receipt may require supervisor approval per store policy";
                    font-size: Typography.caption;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        // Status bar
        StatusBar {
            is-online: root.is-online;
        }
    }
}
