// ============================================================================
// E2Manage POS Terminal - Return Items Screen (Phase 31)
// ============================================================================
// Select items from original transaction to return, specify quantities and reasons
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Layout, Locale, CartState } from "../../theme.slint";
import { Button, TextInput, SearchInput, CompactKeypad } from "../../components/mod.slint";
import { StatusBar } from "../../components/mod.slint";

// Returnable item data from original transaction
export struct ReturnableItem {
    id: string,
    name: string,
    name_ar: string,
    sku: string,
    quantity_purchased: int,
    quantity_to_return: int,
    unit_price: string,
    return_total: string,
    reason: string,
    reason_ar: string,
}

// Return reasons for selection
export struct ReturnReason {
    id: string,
    name: string,
    name_ar: string,
}

export component ReturnItemsScreen inherits Rectangle {
    // Input properties
    in property <string> original-receipt: "";
    in property <string> original-date: "";
    in property <string> original-total: "";
    in property <string> customer-name: "";
    in property <[ReturnableItem]> items: [];
    in property <[ReturnReason]> reasons: [
        { id: "defective", name: "Defective", name_ar: "عيب في المنتج" },
        { id: "wrong_item", name: "Wrong Item", name_ar: "منتج خاطئ" },
        { id: "changed_mind", name: "Changed Mind", name_ar: "تغيير الرأي" },
        { id: "expired", name: "Expired", name_ar: "منتهي الصلاحية" },
        { id: "price_adjustment", name: "Price Adjustment", name_ar: "تعديل السعر" },
        { id: "other", name: "Other", name_ar: "أخرى" },
    ];
    in property <string> return-subtotal: "0.000";
    in property <string> return-tax: "0.000";
    in property <string> return-total: "0.000";
    in property <string> currency: CartState.currency;
    in property <bool> can-proceed: false;
    in property <bool> is-online: true;
    in property <int> selected-item-index: -1;
    in property <bool> show-reason-picker: false;

    // Callbacks
    callback item-quantity-changed(string, int);
    callback item-reason-changed(string, string);
    callback select-item-reason(int);
    callback reason-selected(string, string);
    callback close-reason-picker;
    callback proceed-to-refund;
    callback back-clicked;

    background: Colors.background;

    VerticalLayout {
        spacing: 0px;

        // Header with warning/return color
        Rectangle {
            height: Sizes.header-height;
            background: Colors.warning;

            HorizontalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.lg;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Spacing.lg;

                    // Back button (RTL-aware)
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: Radius.md;

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.back-clicked(); }
                        }

                        Text {
                            text: Layout.rtl ? "→" : "←";
                            font-size: 24px;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Title and receipt info
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        HorizontalLayout {
                            spacing: Spacing.sm;

                            Text {
                                text: "↩️";
                                font-size: 20px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: Locale.current == "ar" ? "اختر العناصر للمرتجع" : "Select Items to Return";
                                font-size: Typography.heading;
                                font-weight: 600;
                                color: Colors.text-on-primary;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: Spacing.sm;

                            Text {
                                text: "🧾 " + original-receipt;
                                font-size: Typography.caption;
                                color: rgba(255,255,255,0.85);
                            }

                            Text {
                                text: "•";
                                font-size: Typography.caption;
                                color: rgba(255,255,255,0.7);
                            }

                            Text {
                                text: original-date;
                                font-size: Typography.caption;
                                color: rgba(255,255,255,0.85);
                            }

                            if customer-name != "": Text {
                                text: "•";
                                font-size: Typography.caption;
                                color: rgba(255,255,255,0.7);
                            }

                            if customer-name != "": Text {
                                text: "👤 " + customer-name;
                                font-size: Typography.caption;
                                color: rgba(255,255,255,0.85);
                            }
                        }
                    }
                }

                // Original total badge
                Rectangle {
                    height: 36px;
                    border-radius: Radius.chip;
                    background: rgba(255,255,255,0.2);

                    HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        spacing: Spacing.xs;

                        Text {
                            text: Locale.current == "ar" ? "الفاتورة الأصلية:" : "Original:";
                            font-size: Typography.caption;
                            color: rgba(255,255,255,0.9);
                            vertical-alignment: center;
                        }

                        Text {
                            text: original-total + " " + currency;
                            font-size: Typography.body;
                            font-weight: 600;
                            color: Colors.text-on-primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Main content - two panel layout
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // Left Panel - Items List (65%)
            Rectangle {
                horizontal-stretch: 65;
                background: Colors.surface;

                VerticalLayout {
                    padding: Spacing.lg;
                    spacing: Spacing.md;

                    // Column headers
                    Rectangle {
                        height: 40px;
                        background: Colors.background;
                        border-radius: Radius.sm;

                        HorizontalLayout {
                            padding-left: Spacing.md;
                            padding-right: Spacing.md;

                            // Product
                            Text {
                                text: Locale.current == "ar" ? "المنتج" : "Product";
                                font-size: Typography.caption;
                                font-weight: 500;
                                color: Colors.text-secondary;
                                horizontal-stretch: 2;
                                vertical-alignment: center;
                            }

                            // Purchased
                            Text {
                                text: Locale.current == "ar" ? "المشتراة" : "Purchased";
                                font-size: Typography.caption;
                                font-weight: 500;
                                color: Colors.text-secondary;
                                width: 80px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            // Return Qty
                            Text {
                                text: Locale.current == "ar" ? "للمرتجع" : "Return";
                                font-size: Typography.caption;
                                font-weight: 500;
                                color: Colors.text-secondary;
                                width: 130px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            // Reason
                            Text {
                                text: Locale.current == "ar" ? "السبب" : "Reason";
                                font-size: Typography.caption;
                                font-weight: 500;
                                color: Colors.text-secondary;
                                horizontal-stretch: 1;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            // Amount
                            Text {
                                text: Locale.current == "ar" ? "المبلغ" : "Amount";
                                font-size: Typography.caption;
                                font-weight: 500;
                                color: Colors.text-secondary;
                                width: 100px;
                                horizontal-alignment: Layout.rtl ? left : right;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Divider
                    Rectangle { height: 1px; background: Colors.border; }

                    // Items list
                    Flickable {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: Spacing.sm;

                            for item[idx] in items: Rectangle {
                                height: 80px;
                                background: item.quantity_to_return > 0 ? #FEF3C7 : Colors.background;
                                border-radius: Radius.md;
                                border-width: item.quantity_to_return > 0 ? 2px : 1px;
                                border-color: item.quantity_to_return > 0 ? Colors.warning : Colors.border;

                                HorizontalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    // Product info
                                    VerticalLayout {
                                        horizontal-stretch: 2;
                                        spacing: 4px;
                                        alignment: center;

                                        Text {
                                            text: Locale.current == "ar" && item.name_ar != "" ?
                                                  item.name_ar : item.name;
                                            font-size: Typography.body;
                                            font-weight: 500;
                                            color: Colors.text-primary;
                                            overflow: elide;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.sm;

                                            // SKU badge
                                            Rectangle {
                                                height: 20px;
                                                border-radius: Radius.sm;
                                                background: Colors.surface-variant;

                                                HorizontalLayout {
                                                    padding-left: Spacing.xs;
                                                    padding-right: Spacing.xs;

                                                    Text {
                                                        text: item.sku;
                                                        font-size: Typography.small;
                                                        color: Colors.text-secondary;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            Text {
                                                text: item.unit_price + " " + currency;
                                                font-size: Typography.caption;
                                                color: Colors.text-secondary;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Quantity purchased
                                    Text {
                                        text: item.quantity_purchased;
                                        font-size: Typography.body;
                                        font-weight: 500;
                                        color: Colors.text-primary;
                                        width: 80px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    // Return quantity controls
                                    HorizontalLayout {
                                        width: 130px;
                                        alignment: center;
                                        spacing: Spacing.sm;

                                        // Minus button
                                        Rectangle {
                                            width: 36px;
                                            height: 36px;
                                            border-radius: 18px;
                                            background: minus-touch.pressed ?
                                                       Colors.surface-variant : Colors.surface;
                                            border-width: 1px;
                                            border-color: Colors.border;

                                            minus-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if item.quantity_to_return > 0 {
                                                        root.item-quantity-changed(item.id, item.quantity_to_return - 1);
                                                    }
                                                }
                                            }

                                            Text {
                                                text: "−";
                                                font-size: 20px;
                                                font-weight: 600;
                                                color: item.quantity_to_return > 0 ?
                                                       Colors.text-primary : Colors.disabled;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        // Quantity display
                                        Text {
                                            text: item.quantity_to_return;
                                            font-size: Typography.subheading;
                                            font-weight: 700;
                                            color: item.quantity_to_return > 0 ?
                                                   Colors.warning : Colors.text-primary;
                                            width: 36px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        // Plus button
                                        Rectangle {
                                            width: 36px;
                                            height: 36px;
                                            border-radius: 18px;
                                            background: item.quantity_to_return >= item.quantity_purchased ?
                                                       Colors.surface-variant :
                                                       (plus-touch.pressed ? #FCD34D : Colors.warning);

                                            plus-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if item.quantity_to_return < item.quantity_purchased {
                                                        root.item-quantity-changed(item.id, item.quantity_to_return + 1);
                                                    }
                                                }
                                            }

                                            Text {
                                                text: "+";
                                                font-size: 20px;
                                                font-weight: 600;
                                                color: item.quantity_to_return >= item.quantity_purchased ?
                                                       Colors.disabled : Colors.text-on-primary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Reason selector
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 40px;
                                        border-radius: Radius.button;
                                        background: reason-touch.pressed ?
                                                   Colors.surface-variant : Colors.surface;
                                        border-width: 1px;
                                        border-color: item.quantity_to_return > 0 && item.reason == "" ?
                                                     Colors.warning : Colors.border;

                                        reason-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                if item.quantity_to_return > 0 {
                                                    root.select-item-reason(idx);
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            padding-left: Spacing.sm;
                                            padding-right: Spacing.sm;

                                            Text {
                                                text: item.reason != "" ?
                                                      (Locale.current == "ar" && item.reason_ar != "" ?
                                                       item.reason_ar : item.reason) :
                                                      (Locale.current == "ar" ? "اختر السبب" : "Select reason");
                                                font-size: Typography.caption;
                                                color: item.reason != "" ?
                                                       Colors.text-primary : Colors.text-secondary;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                text: "▼";
                                                font-size: 10px;
                                                color: Colors.text-secondary;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Return amount
                                    Text {
                                        text: item.return_total + " " + currency;
                                        font-size: Typography.body;
                                        font-weight: 600;
                                        color: item.quantity_to_return > 0 ?
                                               Colors.warning : Colors.text-secondary;
                                        width: 100px;
                                        horizontal-alignment: Layout.rtl ? left : right;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Empty state if no items
                            if items.length == 0: Rectangle {
                                height: 200px;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: Spacing.md;

                                    Text {
                                        text: "📦";
                                        font-size: 48px;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: Locale.current == "ar" ?
                                              "لا توجد عناصر للمرتجع" :
                                              "No items to return";
                                        font-size: Typography.body;
                                        color: Colors.text-secondary;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Vertical divider
            Rectangle { width: 1px; background: Colors.border; }

            // Right Panel - Return Summary (35%)
            Rectangle {
                horizontal-stretch: 35;
                background: Colors.background;

                VerticalLayout {
                    padding: Spacing.lg;
                    spacing: Spacing.lg;

                    // Title
                    HorizontalLayout {
                        spacing: Spacing.sm;

                        Text {
                            text: "📋";
                            font-size: 20px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: Locale.current == "ar" ? "ملخص المرتجع" : "Return Summary";
                            font-size: Typography.subheading;
                            font-weight: 600;
                            color: Colors.text-primary;
                            vertical-alignment: center;
                        }
                    }

                    // Summary card
                    Rectangle {
                        background: Colors.surface;
                        border-radius: Radius.md;
                        border-width: 1px;
                        border-color: Colors.border;

                        VerticalLayout {
                            padding: Spacing.lg;
                            spacing: Spacing.md;

                            // Subtotal row
                            HorizontalLayout {
                                Text {
                                    text: Locale.current == "ar" ? "المجموع الفرعي" : "Subtotal";
                                    font-size: Typography.body;
                                    color: Colors.text-secondary;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: return-subtotal + " " + currency;
                                    font-size: Typography.body;
                                    color: Colors.text-primary;
                                    vertical-alignment: center;
                                }
                            }

                            // Tax row
                            HorizontalLayout {
                                Text {
                                    text: Locale.current == "ar" ? "الضريبة" : "Tax";
                                    font-size: Typography.body;
                                    color: Colors.text-secondary;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: return-tax + " " + currency;
                                    font-size: Typography.body;
                                    color: Colors.text-primary;
                                    vertical-alignment: center;
                                }
                            }

                            // Divider
                            Rectangle { height: 1px; background: Colors.border; }

                            // Total row
                            HorizontalLayout {
                                Text {
                                    text: Locale.current == "ar" ? "إجمالي المرتجع" : "Return Total";
                                    font-size: Typography.subheading;
                                    font-weight: 700;
                                    color: Colors.text-primary;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: return-total + " " + currency;
                                    font-size: Typography.heading;
                                    font-weight: 700;
                                    color: Colors.warning;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Return info notes
                    Rectangle {
                        background: Colors.primary-light;
                        border-radius: Radius.sm;

                        VerticalLayout {
                            padding: Spacing.md;
                            spacing: Spacing.xs;

                            HorizontalLayout {
                                spacing: Spacing.xs;

                                Text {
                                    text: "ℹ️";
                                    font-size: Typography.caption;
                                }

                                Text {
                                    text: Locale.current == "ar" ?
                                          "معلومات المرتجع" :
                                          "Return Information";
                                    font-size: Typography.caption;
                                    font-weight: 600;
                                    color: Colors.primary;
                                }
                            }

                            Text {
                                text: Locale.current == "ar" ?
                                      "• اختر الكمية المراد إرجاعها لكل منتج\n• حدد سبب الإرجاع لكل منتج\n• راجع المبلغ قبل المتابعة" :
                                      "• Select quantity to return for each item\n• Specify a reason for each return\n• Review the total before proceeding";
                                font-size: Typography.small;
                                color: Colors.text-secondary;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Spacer
                    Rectangle { vertical-stretch: 1; }

                    // Action buttons
                    VerticalLayout {
                        spacing: Spacing.md;

                        // Warning if reasons missing
                        if !can-proceed && return-total != "0.000": Rectangle {
                            background: #FFF3E0;
                            border-radius: Radius.sm;

                            HorizontalLayout {
                                padding: Spacing.sm;
                                spacing: Spacing.xs;

                                Text {
                                    text: "⚠️";
                                    font-size: Typography.caption;
                                }

                                Text {
                                    text: Locale.current == "ar" ?
                                          "يرجى تحديد سبب لكل منتج مراد إرجاعه" :
                                          "Please select a reason for each item";
                                    font-size: Typography.caption;
                                    color: Colors.orange-accent;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Proceed button
                        Button {
                            text: Locale.current == "ar" ? "متابعة للاسترداد" : "Proceed to Refund";
                            variant: "warning";
                            disabled: !can-proceed;

                            clicked => { root.proceed-to-refund(); }
                        }
                    }
                }
            }
        }

        // Status bar
        StatusBar {
            is-online: root.is-online;
        }
    }

    // Reason picker overlay
    if show-reason-picker: Rectangle {
        background: rgba(0, 0, 0, 0.5);

        TouchArea {
            clicked => { root.close-reason-picker(); }
        }

        // Centered reason picker dialog
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 360px;
            height: 380px;
            background: Colors.surface;
            border-radius: Radius.lg;
            drop-shadow-blur: 20px;
            drop-shadow-color: rgba(0, 0, 0, 0.3);
            drop-shadow-offset-y: 10px;

            TouchArea {
                // Prevent clicks from closing
            }

            VerticalLayout {
                padding: Spacing.lg;
                spacing: Spacing.md;

                // Header
                HorizontalLayout {
                    Text {
                        text: Locale.current == "ar" ? "اختر سبب المرتجع" : "Select Return Reason";
                        font-size: Typography.subheading;
                        font-weight: 600;
                        color: Colors.text-primary;
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: close-touch.pressed ? Colors.surface-variant : Colors.background;

                        close-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close-reason-picker(); }
                        }

                        Text {
                            text: "✕";
                            font-size: Typography.body;
                            color: Colors.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { height: 1px; background: Colors.border; }

                // Reason options
                Flickable {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: Spacing.xs;

                        for reason in reasons: Rectangle {
                            height: 52px;
                            border-radius: Radius.md;
                            background: reason-item-touch.has-hover ?
                                       Colors.surface-variant : Colors.background;

                            reason-item-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.reason-selected(reason.id, reason.name);
                                }
                            }

                            HorizontalLayout {
                                padding-left: Spacing.md;
                                padding-right: Spacing.md;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;

                                    Text {
                                        text: Locale.current == "ar" ?
                                              reason.name_ar : reason.name;
                                        font-size: Typography.body;
                                        color: Colors.text-primary;
                                    }

                                    if Locale.current == "ar": Text {
                                        text: reason.name;
                                        font-size: Typography.caption;
                                        color: Colors.text-secondary;
                                    }

                                    if Locale.current != "ar" && reason.name_ar != "": Text {
                                        text: reason.name_ar;
                                        font-size: Typography.caption;
                                        color: Colors.text-secondary;
                                    }
                                }

                                Text {
                                    text: "›";
                                    font-size: 20px;
                                    color: Colors.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
