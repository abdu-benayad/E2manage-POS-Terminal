// ============================================================================
// E2Manage POS Terminal - End Shift Screen (Screen 7.2)
// ============================================================================
// Cash count screen for closing a shift
// Allows cashier to count denominations and reconcile with expected cash
// RTL (Arabic) support with proper text alignment
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Animation, Locale, AppState, Layout, CartState } from "../../theme.slint";
import { StatusBar, Button, TextInput, NumericKeypad, CompactKeypad } from "../../components/mod.slint";

// ============================================================================
// DENOMINATION DATA STRUCTURE
// ============================================================================

export struct Denomination {
    label: string,
    value: float,
    count: int,
    subtotal: float,
}

// ============================================================================
// SHIFT SUMMARY DATA STRUCTURE
// ============================================================================

export struct ShiftSummary {
    shift-number: string,
    operator-name: string,
    start-time: string,
    transaction-count: int,
    gross-sales: string,
    returns-total: string,
    discounts-total: string,
    net-sales: string,
}

// ============================================================================
// END SHIFT SCREEN
// ============================================================================
// Usage:
//   EndShiftScreen {
//       shift-number: "POS-001-20241213-001";
//       expected-cash: "2,350.000";
//       currency: CartState.currency;
//       close-shift(counted, variance, note) => { /* close shift */ }
//       save-draft => { /* save cash count draft */ }
//       back-clicked => { /* navigate back */ }
//   }
// ============================================================================

export component EndShiftScreen inherits Rectangle {
    // Shift info
    in property <string> shift-number: "POS-001-20241213-001";
    in property <string> operator-name: Layout.rtl ? "أحمد محمد" : "Ahmed Mohamed";
    in property <string> start-time: "08:00";
    in property <string> currency: CartState.currency;

    // Totals (from shift)
    in property <string> expected-cash: "2,350.000";
    in property <string> opening-float: "500.000";
    in property <string> cash-sales: "1,850.000";

    // Shift summary (optional)
    in property <int> transaction-count: 47;
    in property <string> gross-sales: "4,250.500";
    in property <string> returns-total: "125.000";
    in property <string> discounts-total: "87.500";
    in property <string> net-sales: "4,038.000";

    // Denominations (bills and coins)
    in-out property <[Denomination]> denominations: [
        { label: "50", value: 50, count: 0, subtotal: 0 },
        { label: "20", value: 20, count: 0, subtotal: 0 },
        { label: "10", value: 10, count: 0, subtotal: 0 },
        { label: "5", value: 5, count: 0, subtotal: 0 },
        { label: "1", value: 1, count: 0, subtotal: 0 },
        { label: "0.500", value: 0.5, count: 0, subtotal: 0 },
        { label: "0.250", value: 0.25, count: 0, subtotal: 0 },
        { label: "0.100", value: 0.1, count: 0, subtotal: 0 },
    ];

    // Calculated values
    in-out property <string> counted-cash: "0.000";
    in-out property <string> variance: "0.000";
    in-out property <string> variance-status: "balanced"; // balanced, short, over

    // State
    in-out property <string> variance-note: "";
    in-out property <bool> loading: false;
    in-out property <int> active-denomination-index: -1; // -1 = none selected
    in-out property <string> keypad-value: "0";

    // Callbacks
    callback denomination-changed(int, int); // index, new count
    callback close-shift(string, string, string); // counted_cash, variance, note
    callback save-draft;
    callback back-clicked;
    callback print-x-report;

    background: Colors.background;

    VerticalLayout {
        spacing: 0px;

        // ====================================================================
        // HEADER
        // ====================================================================
        Rectangle {
            height: 72px;
            background: @linear-gradient(180deg, Colors.gradient-top 0%, Colors.gradient-bottom 100%);

            HorizontalLayout {
                padding-left: Spacing.xl;
                padding-right: Spacing.xl;
                alignment: space-between;

                // Left - Back button and title
                HorizontalLayout {
                    spacing: Spacing.lg;
                    alignment: start;

                    // Back button
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: Radius.md;
                        background: back-touch.has-hover ? rgba(255, 255, 255, 0.1) : transparent;

                        back-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.back-clicked(); }
                        }

                        Text {
                            text: Layout.rtl ? "→" : "←";
                            font-size: 24px;
                            font-weight: Typography.bold;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        Text {
                            text: Layout.rtl ? "إغلاق الوردية" : "Close Shift";
                            font-size: Typography.heading;
                            font-weight: Typography.semi-bold;
                            color: Colors.text-on-primary;
                        }

                        Text {
                            text: "#" + shift-number;
                            font-size: Typography.small;
                            color: rgba(255, 255, 255, 0.8);
                        }
                    }
                }

                // Right - Time and status
                HorizontalLayout {
                    alignment: end;
                    spacing: Spacing.lg;

                    // X-Report button
                    Rectangle {
                        width: 120px;
                        height: 40px;
                        border-radius: Radius.md;
                        background: xreport-touch.has-hover ? rgba(255, 255, 255, 0.2) : rgba(255, 255, 255, 0.1);

                        xreport-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.print-x-report(); }
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: Spacing.sm;

                            Text {
                                text: "X";
                                font-size: Typography.body;
                                font-weight: Typography.bold;
                                color: Colors.text-on-primary;
                                vertical-alignment: center;
                            }

                            Text {
                                text: Layout.rtl ? "تقرير" : "Report";
                                font-size: Typography.small;
                                color: Colors.text-on-primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Time
                    VerticalLayout {
                        alignment: center;

                        HorizontalLayout {
                            spacing: Spacing.xs;

                            Text {
                                text: AppState.current-time;
                                font-size: Typography.body;
                                color: Colors.text-on-primary;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: Sizes.status-dot;
                                height: Sizes.status-dot;
                                border-radius: Sizes.status-dot / 2;
                                background: AppState.is-online ? Colors.success : Colors.warning;
                            }
                        }
                    }
                }
            }
        }

        // ====================================================================
        // MAIN CONTENT (Two-panel layout)
        // ====================================================================
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // ================================================================
            // LEFT PANEL - Denomination Entry
            // ================================================================
            Rectangle {
                horizontal-stretch: 55;
                background: Colors.surface;

                VerticalLayout {
                    padding: Spacing.xl;
                    spacing: Spacing.lg;

                    // Section header
                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: Layout.rtl ? "عد النقدية" : "Cash Count";
                            font-size: Typography.heading;
                            font-weight: Typography.semi-bold;
                            color: Colors.text-primary;
                            vertical-alignment: center;
                        }

                        // Total counted badge
                        Rectangle {
                            width: 180px;
                            height: 36px;
                            border-radius: Radius.md;
                            background: Colors.primary-light;

                            HorizontalLayout {
                                padding-left: Spacing.md;
                                padding-right: Spacing.md;
                                alignment: center;
                                spacing: Spacing.xs;

                                Text {
                                    text: Layout.rtl ? "المجموع:" : "Total:";
                                    font-size: Typography.caption;
                                    color: Colors.primary-dark;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: counted-cash + " " + currency;
                                    font-size: Typography.body;
                                    font-weight: Typography.bold;
                                    color: Colors.primary-dark;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Bills header
                    Text {
                        text: Layout.rtl ? "الأوراق النقدية" : "Bills";
                        font-size: Typography.caption;
                        font-weight: Typography.medium;
                        color: Colors.text-secondary;
                    }

                    // Denominations grid
                    VerticalLayout {
                        spacing: Spacing.sm;

                        // Column headers
                        HorizontalLayout {
                            spacing: Spacing.md;
                            height: 28px;

                            Rectangle {
                                width: 80px;
                                Text {
                                    text: Layout.rtl ? "الفئة" : "Denom";
                                    font-size: Typography.small;
                                    color: Colors.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                width: 24px;
                            }

                            Rectangle {
                                width: 100px;
                                Text {
                                    text: Layout.rtl ? "العدد" : "Count";
                                    font-size: Typography.small;
                                    color: Colors.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                width: 24px;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                Text {
                                    text: Layout.rtl ? "المجموع الفرعي" : "Subtotal";
                                    font-size: Typography.small;
                                    color: Colors.text-secondary;
                                    horizontal-alignment: Layout.rtl ? right : left;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Denomination rows
                        for denom[i] in denominations: Rectangle {
                            height: 52px;
                            border-radius: Radius.md;
                            background: active-denomination-index == i ? Colors.primary-light :
                                       denom-row-touch.has-hover ? Colors.surface-variant : Colors.background;
                            border-width: active-denomination-index == i ? 2px : 1px;
                            border-color: active-denomination-index == i ? Colors.primary : Colors.border;

                            animate background { duration: Animation.fast; }
                            animate border-color { duration: Animation.fast; }

                            denom-row-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    active-denomination-index = i;
                                    keypad-value = denom.count == 0 ? "" : denom.count;
                                }
                            }

                            HorizontalLayout {
                                padding-left: Spacing.md;
                                padding-right: Spacing.md;
                                spacing: Spacing.md;

                                // Denomination label
                                Rectangle {
                                    width: 80px;
                                    height: 40px;
                                    border-radius: Radius.sm;
                                    background: denom.value >= 1 ? Colors.success : Colors.warning;

                                    Text {
                                        text: denom.label + " " + currency;
                                        font-size: Typography.caption;
                                        font-weight: Typography.medium;
                                        color: Colors.text-on-primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Multiply sign
                                Text {
                                    text: "×";
                                    font-size: Typography.body;
                                    color: Colors.text-secondary;
                                    vertical-alignment: center;
                                }

                                // Count input display
                                Rectangle {
                                    width: 100px;
                                    height: 40px;
                                    border-radius: Radius.md;
                                    background: active-denomination-index == i ? Colors.surface : Colors.surface-variant;
                                    border-width: active-denomination-index == i ? 2px : 1px;
                                    border-color: active-denomination-index == i ? Colors.primary : Colors.border;

                                    Text {
                                        text: denom.count;
                                        font-size: Typography.body;
                                        font-weight: Typography.semi-bold;
                                        color: denom.count > 0 ? Colors.text-primary : Colors.text-secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Equals sign
                                Text {
                                    text: "=";
                                    font-size: Typography.body;
                                    color: Colors.text-secondary;
                                    vertical-alignment: center;
                                }

                                // Subtotal
                                Rectangle {
                                    horizontal-stretch: 1;

                                    Text {
                                        text: denom.subtotal + " " + currency;
                                        font-size: Typography.body;
                                        font-weight: denom.subtotal > 0 ? Typography.semi-bold : Typography.regular;
                                        color: denom.subtotal > 0 ? Colors.primary : Colors.text-secondary;
                                        horizontal-alignment: Layout.rtl ? right : left;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Spacer
                    Rectangle { vertical-stretch: 1; }
                }
            }

            // Divider
            Rectangle {
                width: 1px;
                background: Colors.border;
            }

            // ================================================================
            // RIGHT PANEL - Summary & Keypad
            // ================================================================
            Rectangle {
                horizontal-stretch: 45;
                background: Colors.background;

                VerticalLayout {
                    padding: Spacing.xl;
                    spacing: Spacing.lg;

                    // Shift Summary Card
                    Rectangle {
                        height: 160px;
                        border-radius: Radius.lg;
                        background: Colors.surface;
                        border-width: 1px;
                        border-color: Colors.border;

                        VerticalLayout {
                            padding: Spacing.lg;
                            spacing: Spacing.sm;

                            Text {
                                text: Layout.rtl ? "ملخص الوردية" : "Shift Summary";
                                font-size: Typography.body;
                                font-weight: Typography.semi-bold;
                                color: Colors.text-primary;
                            }

                            Rectangle { height: 1px; background: Colors.border; }

                            // Transactions
                            HorizontalLayout {
                                Text {
                                    text: Layout.rtl ? "المعاملات:" : "Transactions:";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: transaction-count;
                                    font-size: Typography.caption;
                                    font-weight: Typography.medium;
                                    color: Colors.text-primary;
                                }
                            }

                            // Opening Float
                            HorizontalLayout {
                                Text {
                                    text: Layout.rtl ? "مبلغ الافتتاح:" : "Opening Float:";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: opening-float + " " + currency;
                                    font-size: Typography.caption;
                                    font-weight: Typography.medium;
                                    color: Colors.text-primary;
                                }
                            }

                            // Cash Sales
                            HorizontalLayout {
                                Text {
                                    text: Layout.rtl ? "مبيعات نقدية:" : "Cash Sales:";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: cash-sales + " " + currency;
                                    font-size: Typography.caption;
                                    font-weight: Typography.medium;
                                    color: Colors.text-primary;
                                }
                            }

                            Rectangle { height: 1px; background: Colors.border; }

                            // Expected Cash (highlighted)
                            HorizontalLayout {
                                Text {
                                    text: Layout.rtl ? "المتوقع:" : "Expected:";
                                    font-size: Typography.body;
                                    font-weight: Typography.medium;
                                    color: Colors.text-primary;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: expected-cash + " " + currency;
                                    font-size: Typography.body;
                                    font-weight: Typography.bold;
                                    color: Colors.primary;
                                }
                            }
                        }
                    }

                    // Variance Card
                    Rectangle {
                        height: 120px;
                        border-radius: Radius.lg;
                        background: variance-status == "balanced" ? rgba(34, 197, 94, 0.1) :
                                    variance-status == "short" ? rgba(239, 68, 68, 0.1) :
                                    rgba(245, 158, 11, 0.1);
                        border-width: 2px;
                        border-color: variance-status == "balanced" ? Colors.success :
                                      variance-status == "short" ? Colors.danger :
                                      Colors.warning;

                        VerticalLayout {
                            padding: Spacing.lg;
                            spacing: Spacing.md;
                            alignment: center;

                            // Status badge
                            Rectangle {
                                width: 100px;
                                height: 28px;
                                border-radius: Radius.full;
                                background: variance-status == "balanced" ? Colors.success :
                                            variance-status == "short" ? Colors.danger :
                                            Colors.warning;

                                Text {
                                    text: variance-status == "balanced" ?
                                          (Layout.rtl ? "متوازن" : "Balanced") :
                                          variance-status == "short" ?
                                          (Layout.rtl ? "عجز" : "Short") :
                                          (Layout.rtl ? "زيادة" : "Over");
                                    font-size: Typography.small;
                                    font-weight: Typography.semi-bold;
                                    color: Colors.text-on-primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Variance amount
                            HorizontalLayout {
                                alignment: center;
                                spacing: Spacing.sm;

                                Text {
                                    text: Layout.rtl ? "الفرق:" : "Variance:";
                                    font-size: Typography.body;
                                    color: Colors.text-secondary;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: variance + " " + currency;
                                    font-size: Typography.title;
                                    font-weight: Typography.bold;
                                    color: variance-status == "balanced" ? Colors.success :
                                           variance-status == "short" ? Colors.danger :
                                           Colors.warning;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Note input (shown when variance != 0)
                    if variance-status != "balanced": Rectangle {
                        height: 80px;
                        border-radius: Radius.md;
                        background: Colors.surface;
                        border-width: 1px;
                        border-color: Colors.border;

                        VerticalLayout {
                            padding: Spacing.md;
                            spacing: Spacing.sm;

                            Text {
                                text: Layout.rtl ? "ملاحظة (مطلوبة)" : "Note (required)";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                            }

                            Rectangle {
                                border-radius: Radius.sm;
                                background: Colors.background;
                                border-width: 1px;
                                border-color: Colors.border;
                                vertical-stretch: 1;

                                note-input := TextInput {
                                    placeholder: Layout.rtl ? "سبب الفرق..." : "Reason for variance...";
                                    text <=> variance-note;
                                }
                            }
                        }
                    }

                    // Keypad (when denomination selected)
                    if active-denomination-index >= 0: Rectangle {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: Spacing.md;

                            // Selected denomination indicator
                            Rectangle {
                                height: 40px;
                                border-radius: Radius.md;
                                background: Colors.primary-light;

                                HorizontalLayout {
                                    padding-left: Spacing.lg;
                                    padding-right: Spacing.lg;
                                    alignment: center;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: Layout.rtl ? "عدد فئة" : "Count for";
                                        font-size: Typography.caption;
                                        color: Colors.primary-dark;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: active-denomination-index >= 0 && active-denomination-index < denominations.length ?
                                              denominations[active-denomination-index].label + " " + currency : "";
                                        font-size: Typography.body;
                                        font-weight: Typography.bold;
                                        color: Colors.primary-dark;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Compact keypad
                            CompactKeypad {
                                value <=> keypad-value;

                                key-pressed(key) => {
                                    if (active-denomination-index >= 0) {
                                        // Update count for active denomination
                                        // Note: In Slint, we'd use callbacks to update the model in Rust
                                        root.denomination-changed(active-denomination-index, keypad-value.to-float());
                                    }
                                }

                                backspace => {
                                    if (active-denomination-index >= 0) {
                                        root.denomination-changed(active-denomination-index, keypad-value.to-float());
                                    }
                                }

                                clear => {
                                    if (active-denomination-index >= 0) {
                                        root.denomination-changed(active-denomination-index, 0);
                                    }
                                }
                            }
                        }
                    }

                    // Placeholder when no denomination selected
                    if active-denomination-index < 0: Rectangle {
                        vertical-stretch: 1;

                        VerticalLayout {
                            alignment: center;
                            spacing: Spacing.md;

                            Text {
                                text: "👆";
                                font-size: 48px;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: Layout.rtl ? "اختر فئة للعد" : "Select a denomination to count";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ====================================================================
        // BOTTOM ACTION BAR
        // ====================================================================
        Rectangle {
            height: 88px;
            background: Colors.surface;
            border-width: 1px;
            border-color: Colors.border;

            HorizontalLayout {
                padding-left: Spacing.xxl;
                padding-right: Spacing.xxl;
                padding-top: Spacing.lg;
                padding-bottom: Spacing.lg;
                spacing: Spacing.lg;
                alignment: center;

                // Save Draft button
                Button {
                    text: Layout.rtl ? "حفظ مسودة" : "Save Draft";
                    variant: "ghost";
                    width: 140px;
                    clicked => { root.save-draft(); }
                }

                // Spacer
                Rectangle { horizontal-stretch: 1; }

                // Close Shift button (primary action)
                Button {
                    text: Layout.rtl ? "إغلاق الوردية" : "Close Shift";
                    variant: variance-status == "balanced" ? "primary" : "warning";
                    width: 200px;
                    disabled: (variance-status != "balanced" && variance-note == "") || loading;
                    loading: loading;
                    clicked => {
                        root.loading = true;
                        root.close-shift(counted-cash, variance, variance-note);
                    }
                }
            }
        }

        // ====================================================================
        // STATUS BAR
        // ====================================================================
        StatusBar {
            terminal-code: AppState.terminal-code;
            version: AppState.version;
            is-online: AppState.is-online;
            pending-sync-count: AppState.pending-sync-count;
        }
    }

    // Save Draft Dialog overlay
    if show-save-draft-dialog: Rectangle {
        background: Colors.overlay;

        TouchArea {
            clicked => { show-save-draft-dialog = false; }
        }

        // Dialog card
        Rectangle {
            x: (parent.width - 400px) / 2;
            y: (parent.height - 200px) / 2;
            width: 400px;
            height: 200px;
            border-radius: Radius.lg;
            background: Colors.surface;

            TouchArea {} // Block clicks

            VerticalLayout {
                padding: Spacing.xl;
                spacing: Spacing.lg;

                Text {
                    text: Layout.rtl ? "حفظ عد النقدية" : "Save Cash Count";
                    font-size: Typography.heading;
                    font-weight: Typography.semi-bold;
                    color: Colors.text-primary;
                    horizontal-alignment: center;
                }

                Text {
                    text: Layout.rtl ?
                          "سيتم حفظ عد النقدية الحالي كمسودة يمكنك متابعتها لاحقاً." :
                          "Current cash count will be saved as a draft for later.";
                    font-size: Typography.body;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: Spacing.md;
                    alignment: center;

                    Button {
                        text: Layout.rtl ? "إلغاء" : "Cancel";
                        variant: "secondary";
                        width: 120px;
                        clicked => { show-save-draft-dialog = false; }
                    }

                    Button {
                        text: Layout.rtl ? "حفظ" : "Save";
                        variant: "primary";
                        width: 120px;
                        clicked => {
                            show-save-draft-dialog = false;
                            root.save-draft();
                        }
                    }
                }
            }
        }
    }

    // Internal state
    property <bool> show-save-draft-dialog: false;
}
