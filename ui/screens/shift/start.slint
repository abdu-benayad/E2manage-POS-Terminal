// ============================================================================
// E2Manage POS Terminal - Start Shift Screen (Screen 1.5)
// ============================================================================
// Opening float entry screen shown after successful PIN login
// Allows operator to enter or skip opening cash drawer amount
// RTL (Arabic) support with proper text alignment
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Animation, Locale, AppState, Layout, CartState } from "../../theme.slint";
import { StatusBar } from "../../components/status_bar.slint";
import { NumericKeypad } from "../../components/numeric_keypad.slint";
import { AmountDisplay } from "../../components/pin_display.slint";
import { Button } from "../../components/button.slint";

// ============================================================================
// START SHIFT SCREEN
// ============================================================================
// Usage:
//   StartShiftScreen {
//       operator-name: "Ahmed Mohamed";
//       terminal-id: "POS-001";
//       start-shift(amount) => { /* create shift with opening float */ }
//       skip-float => { /* create shift with zero float */ }
//       cancel => { /* navigate back to login */ }
//   }
// ============================================================================

export component StartShiftScreen inherits Rectangle {
    // Operator info (passed from PIN entry)
    in property <string> operator-name: Layout.rtl ? "أحمد محمد" : "Ahmed Mohamed";
    in property <string> terminal-id: AppState.terminal-code;
    in property <string> currency: CartState.currency;

    // Amount state
    in-out property <string> opening-float: "0.000";
    in-out property <bool> confirmed: false;
    in-out property <bool> loading: false;

    // Internal state - raw digits without decimal (e.g., "200" for 200.000)
    // Start empty so typing doesn't create leading zeros
    property <string> raw-digits: "";
    property <string> display-amount: format-amount(raw-digits);
    property <bool> amount-entered: raw-digits != "";

    // Format raw digits to amount with 3 decimal places (e.g., "200" -> "200.000")
    pure function format-amount(digits: string) -> string {
        if digits == "" {
            return "0.000";
        }
        return digits + ".000";
    }

    // Quick amount values
    property <[int]> quick-amounts: [100, 200, 500, 1000];

    // Callbacks
    callback start-shift(string); // Called with opening float amount
    callback skip-float;          // Called when skipping float entry
    callback cancel;              // Called when canceling

    background: Colors.background;

    VerticalLayout {
        spacing: 0px;

        // ====================================================================
        // HEADER
        // ====================================================================
        Rectangle {
            height: 80px;
            background: @linear-gradient(180deg, Colors.gradient-top 0%, Colors.gradient-bottom 100%);

            HorizontalLayout {
                padding-left: Spacing.xl;
                padding-right: Spacing.xl;
                alignment: space-between;

                // Left section - Screen title
                VerticalLayout {
                    alignment: center;

                    Text {
                        text: Layout.rtl ? "بدء الوردية" : "Start Shift";
                        font-size: Typography.heading;
                        font-weight: Typography.semi-bold;
                        color: Colors.text-on-primary;
                        vertical-alignment: center;
                    }
                }

                // Center section - Terminal info
                VerticalLayout {
                    alignment: center;

                    HorizontalLayout {
                        spacing: Spacing.md;

                        Text {
                            text: terminal-id;
                            font-size: Typography.body;
                            color: rgba(255, 255, 255, 0.9);
                            vertical-alignment: center;
                        }
                    }
                }

                // Right section - Time and status
                HorizontalLayout {
                    alignment: end;
                    spacing: Spacing.md;

                    VerticalLayout {
                        alignment: center;

                        HorizontalLayout {
                            spacing: Spacing.xs;

                            Text {
                                text: AppState.current-time;
                                font-size: Typography.body;
                                color: Colors.text-on-primary;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: Sizes.status-dot;
                                height: Sizes.status-dot;
                                border-radius: Sizes.status-dot / 2;
                                background: AppState.is-online ? Colors.success : Colors.warning;
                            }

                            Text {
                                text: AppState.is-online ? Locale.online : Locale.offline;
                                font-size: Typography.small;
                                color: rgba(255, 255, 255, 0.8);
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ====================================================================
        // MAIN CONTENT (Two-panel layout)
        // ====================================================================
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // ================================================================
            // LEFT PANEL - Info & Amount Display
            // ================================================================
            Rectangle {
                horizontal-stretch: 1;
                background: Colors.surface;

                VerticalLayout {
                    alignment: center;
                    spacing: Spacing.xl;
                    padding-left: Spacing.xxxl;
                    padding-right: Spacing.xxxl;
                    padding-top: Spacing.xxl;
                    padding-bottom: Spacing.xxl;

                    // Welcome message
                    VerticalLayout {
                        alignment: center;
                        spacing: Spacing.sm;

                        Text {
                            text: Layout.rtl ?
                                  "مرحباً، " + operator-name :
                                  "Welcome, " + operator-name;
                            font-size: Typography.title;
                            font-weight: Typography.semi-bold;
                            color: Colors.text-primary;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: Layout.rtl ?
                                  "أدخل مبلغ الافتتاح في درج النقود" :
                                  "Enter opening cash drawer amount";
                            font-size: Typography.body;
                            color: Colors.text-secondary;
                            horizontal-alignment: center;
                        }
                    }

                    // Amount display card
                    Rectangle {
                        width: 320px;
                        height: 120px;
                        border-radius: Radius.lg;
                        background: Colors.background;
                        border-width: 2px;
                        border-color: amount-entered ? Colors.primary : Colors.border;

                        animate border-color { duration: Animation.fast; }

                        VerticalLayout {
                            alignment: center;
                            spacing: Spacing.sm;
                            padding: Spacing.lg;

                            Text {
                                text: Layout.rtl ? "مبلغ الافتتاح" : "Opening Float";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-alignment: center;
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: Spacing.xs;

                                Text {
                                    text: display-amount;
                                    font-size: 36px;
                                    font-weight: Typography.bold;
                                    color: amount-entered ? Colors.primary : Colors.text-primary;
                                }

                                Text {
                                    text: currency;
                                    font-size: Typography.heading;
                                    font-weight: Typography.medium;
                                    color: Colors.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Quick amount buttons
                    VerticalLayout {
                        alignment: center;
                        spacing: Spacing.md;

                        Text {
                            text: Layout.rtl ? "مبالغ سريعة" : "Quick Amounts";
                            font-size: Typography.caption;
                            color: Colors.text-secondary;
                            horizontal-alignment: center;
                        }

                        HorizontalLayout {
                            spacing: Spacing.md;
                            alignment: center;

                            for amount in quick-amounts: Rectangle {
                                width: 100px;
                                height: 56px;
                                border-radius: Radius.md;
                                background: raw-digits == amount ?
                                            Colors.primary-light :
                                            Colors.background;
                                border-width: 1px;
                                border-color: raw-digits == amount ?
                                              Colors.primary :
                                              Colors.border;

                                animate background { duration: Animation.fast; }
                                animate border-color { duration: Animation.fast; }

                                quick-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        raw-digits = amount;
                                        opening-float = amount + ".000";
                                    }
                                }

                                Rectangle {
                                    background: quick-touch.has-hover && raw-digits != amount ?
                                                rgba(37, 99, 235, 0.05) : transparent;
                                    border-radius: Radius.md;
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Text {
                                        text: amount;
                                        font-size: Typography.heading;
                                        font-weight: Typography.semi-bold;
                                        color: raw-digits == amount ?
                                               Colors.primary : Colors.text-primary;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: currency;
                                        font-size: Typography.small;
                                        color: Colors.text-secondary;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Confirmation checkbox
                    Rectangle {
                        width: 360px;
                        height: 52px;
                        border-radius: Radius.md;
                        background: confirmed ? rgba(34, 197, 94, 0.1) : Colors.background;
                        border-width: 1px;
                        border-color: confirmed ? Colors.success : Colors.border;

                        animate background { duration: Animation.fast; }
                        animate border-color { duration: Animation.fast; }

                        confirm-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                confirmed = !confirmed;
                            }
                        }

                        HorizontalLayout {
                            padding-left: Spacing.lg;
                            padding-right: Spacing.lg;
                            spacing: Spacing.md;
                            alignment: space-between;

                            // Label (left side)
                            Text {
                                text: Layout.rtl ?
                                      "أؤكد أن الدرج يحتوي على المبلغ أعلاه" :
                                      "I confirm the drawer contains the amount above";
                                font-size: Typography.body;
                                color: confirmed ? Colors.success : Colors.text-secondary;
                                vertical-alignment: center;
                                horizontal-stretch: 1;

                                animate color { duration: Animation.fast; }
                            }

                            // Checkbox (right side)
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: Radius.sm;
                                background: confirmed ? Colors.success : Colors.surface;
                                border-width: confirmed ? 0px : 2px;
                                border-color: Colors.border;

                                animate background { duration: Animation.fast; }

                                if confirmed: Text {
                                    text: "\u{2713}"; // Checkmark
                                    font-size: Typography.body;
                                    font-weight: Typography.bold;
                                    color: Colors.text-on-primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // Divider
            Rectangle {
                width: 1px;
                background: Colors.border;
            }

            // ================================================================
            // RIGHT PANEL - Numeric Keypad
            // ================================================================
            Rectangle {
                horizontal-stretch: 1;
                background: Colors.background;

                VerticalLayout {
                    alignment: center;
                    spacing: Spacing.xl;
                    padding: Spacing.xxl;

                    Text {
                        text: Layout.rtl ? "أدخل مبلغ مخصص" : "Enter Custom Amount";
                        font-size: Typography.body;
                        color: Colors.text-secondary;
                        horizontal-alignment: center;
                    }

                    NumericKeypad {
                        mode: "amount";
                        value <=> raw-digits; // Two-way binding - keypad updates raw-digits directly
                        max-length: 7; // Max 9999999 (7 digits)
                        show-decimal: false;
                        confirm-label: Layout.rtl ? "تأكيد" : "OK";

                        key-pressed(key) => {
                            // NumericKeypad already updates raw-digits via two-way binding
                            // Just sync opening-float for the formatted display
                            if key != "backspace" {
                                opening-float = raw-digits + ".000";
                            }
                        }

                        confirmed(value) => {
                            opening-float = raw-digits + ".000";
                        }

                        backspace => {
                            // Clear all digits (Slint lacks substring for single-char removal)
                            raw-digits = "";
                            opening-float = "0.000";
                        }
                    }
                }
            }
        }

        // ====================================================================
        // BOTTOM ACTION BAR
        // ====================================================================
        Rectangle {
            height: 88px;
            background: Colors.surface;
            border-width: 1px;
            border-color: Colors.border;

            HorizontalLayout {
                padding-left: Spacing.xxl;
                padding-right: Spacing.xxl;
                padding-top: Spacing.lg;
                padding-bottom: Spacing.lg;
                spacing: Spacing.lg;
                alignment: center;

                // Cancel button (left)
                Button {
                    text: Layout.rtl ? "إلغاء" : "Cancel";
                    variant: "ghost";
                    width: 160px;
                    clicked => { root.cancel(); }
                }

                // Spacer
                Rectangle {
                    horizontal-stretch: 1;
                }

                // Skip button
                Button {
                    text: Layout.rtl ? "تخطي" : "Skip";
                    variant: "secondary";
                    width: 160px;
                    clicked => {
                        opening-float = "0.000";
                        root.skip-float();
                    }
                }

                // Start Shift button (primary action)
                Button {
                    text: Layout.rtl ? "بدء الوردية" : "Start Shift";
                    variant: "primary";
                    width: 200px;
                    disabled: !confirmed || loading;
                    loading: loading;
                    clicked => {
                        root.loading = true;
                        root.start-shift(opening-float);
                    }
                }
            }
        }

        // ====================================================================
        // STATUS BAR
        // ====================================================================
        StatusBar {
            terminal-code: AppState.terminal-code;
            version: AppState.version;
            is-online: AppState.is-online;
            pending-sync-count: AppState.pending-sync-count;
        }
    }
}
