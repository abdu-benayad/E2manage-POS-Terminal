// ============================================================================
// E2Manage POS Terminal - Z-Report Screen (End of Day)
// ============================================================================
// End-of-day clearing report aggregating all shifts for the day
// Resets counters and closes out the business day
// RTL (Arabic) support with proper text alignment
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Animation, Locale, AppState, Layout, CartState } from "../../theme.slint";
import { StatusBar, Button } from "../../components/mod.slint";

// ============================================================================
// Z-REPORT SCREEN
// ============================================================================
// Usage:
//   ZReportScreen {
//       report-date: "2024-01-15";
//       report-number: "Z-2024-015";
//       terminal-id: "POS-001";
//       total-shifts: 2;
//       net-sales: "7,750.000";
//       currency: CartState.currency;
//       print-report => { /* print */ }
//       close-day => { /* close day */ }
//       back-clicked => { /* navigate back */ }
//   }
// ============================================================================

export component ZReportScreen inherits Rectangle {
    // Report info
    in property <string> report-date: "2024-01-15";
    in property <string> report-number: "Z-2024-015";
    in property <string> terminal-id: "POS-001";
    in property <string> currency: CartState.currency;

    // Shift summaries
    in property <int> total-shifts: 2;
    in property <int> total-transactions: 120;

    // Day totals
    in property <string> gross-sales: "8,500.000";
    in property <string> discounts: "450.000";
    in property <string> returns: "300.000";
    in property <string> net-sales: "7,750.000";
    in property <string> tax-collected: "1,162.500";
    in property <string> tax-rate: AppState.tax-rate-label;

    // Payment totals
    in property <string> cash-total: "4,200.000";
    in property <string> card-total: "2,800.000";
    in property <string> wallet-total: "750.000";
    in property <string> credit-total: "0.000";
    in property <int> cash-count: 65;
    in property <int> card-count: 40;
    in property <int> wallet-count: 15;
    in property <int> credit-count: 0;

    // Cash accountability
    in property <string> opening-float: "500.000";
    in property <string> total-cash-in: "4,200.000";
    in property <string> total-cash-out: "200.000";
    in property <string> expected-cash: "4,500.000";
    in property <string> actual-cash: "4,500.000";
    in property <string> variance: "0.000";
    in property <string> variance-status: "balanced"; // balanced, short, over

    // Returns & Voids
    in property <int> return-count: 5;
    in property <string> return-total: "300.000";
    in property <int> void-count: 2;
    in property <string> void-total: "75.000";

    // State
    in property <bool> can-close: true;
    in property <string> status: "preview"; // preview, closing, closed
    in property <bool> is-printing: false;

    // Callbacks
    callback print-report;
    callback close-day;
    callback back-clicked;

    background: Colors.background;

    VerticalLayout {
        spacing: 0px;

        // ====================================================================
        // HEADER - Color changes based on status
        // ====================================================================
        Rectangle {
            height: 72px;
            background: status == "closed" ? Colors.success :
                       status == "closing" ? Colors.warning :
                       @linear-gradient(180deg, #dc2626 0%, #b91c1c 100%); // Red gradient for danger

            HorizontalLayout {
                padding-left: Spacing.xl;
                padding-right: Spacing.xl;
                alignment: space-between;

                // Left - Back button and title
                HorizontalLayout {
                    spacing: Spacing.lg;
                    alignment: start;

                    // Back button
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: Radius.md;
                        background: back-touch.has-hover ? rgba(255, 255, 255, 0.1) : transparent;

                        back-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.back-clicked(); }
                        }

                        Text {
                            text: Layout.rtl ? "→" : "←";
                            font-size: 24px;
                            font-weight: Typography.bold;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Title section
                    VerticalLayout {
                        alignment: center;

                        HorizontalLayout {
                            spacing: Spacing.sm;
                            alignment: start;

                            // Z badge
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: Radius.sm;
                                background: rgba(255, 255, 255, 0.2);

                                Text {
                                    text: "Z";
                                    font-size: Typography.heading;
                                    font-weight: Typography.bold;
                                    color: Colors.text-on-primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: Layout.rtl ? "تقرير Z - نهاية اليوم" : "Z-Report - End of Day";
                                font-size: Typography.heading;
                                font-weight: Typography.semi-bold;
                                color: Colors.text-on-primary;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: report-date + " • " + terminal-id;
                            font-size: Typography.small;
                            color: rgba(255, 255, 255, 0.8);
                        }
                    }
                }

                // Right - Time and Print button
                HorizontalLayout {
                    alignment: end;
                    spacing: Spacing.lg;

                    // Current time
                    VerticalLayout {
                        alignment: center;

                        HorizontalLayout {
                            spacing: Spacing.xs;

                            Text {
                                text: AppState.current-time;
                                font-size: Typography.body;
                                color: Colors.text-on-primary;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: Sizes.status-dot;
                                height: Sizes.status-dot;
                                border-radius: Sizes.status-dot / 2;
                                background: AppState.is-online ? Colors.success : Colors.warning;
                            }
                        }
                    }

                    // Print button (hidden when closing)
                    if status != "closing": Rectangle {
                        width: 120px;
                        height: 40px;
                        border-radius: Radius.md;
                        background: print-touch.has-hover ? rgba(255, 255, 255, 0.3) : rgba(255, 255, 255, 0.2);
                        opacity: is-printing ? 0.6 : 1.0;

                        print-touch := TouchArea {
                            mouse-cursor: is-printing ? default : pointer;
                            enabled: !is-printing;
                            clicked => { root.print-report(); }
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: Spacing.sm;

                            Text {
                                text: "🖨️";
                                font-size: Typography.body;
                                vertical-alignment: center;
                            }

                            Text {
                                text: is-printing ?
                                      (Layout.rtl ? "جارٍ الطباعة..." : "Printing...") :
                                      (Layout.rtl ? "طباعة" : "Print");
                                font-size: Typography.caption;
                                font-weight: Typography.medium;
                                color: Colors.text-on-primary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ====================================================================
        // SCROLLABLE CONTENT
        // ====================================================================
        Flickable {
            vertical-stretch: 1;
            viewport-height: report-content.preferred-height;

            report-content := VerticalLayout {
                padding: Spacing.xl;
                spacing: Spacing.lg;

                // ============================================================
                // DAY SUMMARY BANNER
                // ============================================================
                Rectangle {
                    height: 120px;
                    border-radius: Radius.lg;
                    background: status == "closed" ? Colors.success :
                               @linear-gradient(135deg, #dc2626 0%, #f97316 100%);

                    HorizontalLayout {
                        padding: Spacing.xl;
                        spacing: Spacing.xl;

                        // Left - Report info
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: report-number;
                                font-size: Typography.title;
                                font-weight: Typography.bold;
                                color: Colors.text-on-primary;
                            }

                            HorizontalLayout {
                                spacing: Spacing.sm;

                                // Shifts badge
                                Rectangle {
                                    width: 80px;
                                    height: 28px;
                                    border-radius: Radius.sm;
                                    background: rgba(255, 255, 255, 0.2);

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: Spacing.xs;

                                        Text {
                                            text: "📋";
                                            font-size: Typography.small;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: total-shifts + (Layout.rtl ? " ورديات" : " shifts");
                                            font-size: Typography.small;
                                            color: Colors.text-on-primary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Transactions badge
                                Rectangle {
                                    width: 100px;
                                    height: 28px;
                                    border-radius: Radius.sm;
                                    background: rgba(255, 255, 255, 0.2);

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: Spacing.xs;

                                        Text {
                                            text: "🧾";
                                            font-size: Typography.small;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: total-transactions + (Layout.rtl ? " معاملة" : " txns");
                                            font-size: Typography.small;
                                            color: Colors.text-on-primary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Right - Net sales (main figure)
                        VerticalLayout {
                            alignment: center;

                            Text {
                                text: Layout.rtl ? "صافي المبيعات" : "Net Sales";
                                font-size: Typography.caption;
                                color: rgba(255, 255, 255, 0.8);
                                horizontal-alignment: right;
                            }

                            Text {
                                text: net-sales + " " + currency;
                                font-size: 36px;
                                font-weight: Typography.bold;
                                color: Colors.text-on-primary;
                                horizontal-alignment: right;
                            }
                        }
                    }
                }

                // ============================================================
                // SALES BREAKDOWN CARD
                // ============================================================
                Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.lg;
                    border-width: 1px;
                    border-color: Colors.border;

                    VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        // Section header
                        HorizontalLayout {
                            spacing: Spacing.sm;

                            Text {
                                text: "📊";
                                font-size: Typography.body;
                                vertical-alignment: center;
                            }

                            Text {
                                text: Layout.rtl ? "تفصيل المبيعات" : "Sales Breakdown";
                                font-size: Typography.subheading;
                                font-weight: Typography.semi-bold;
                                color: Colors.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle { height: 1px; background: Colors.border; }

                        // Gross sales
                        HorizontalLayout {
                            Text {
                                text: Layout.rtl ? "إجمالي المبيعات" : "Gross Sales";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: gross-sales + " " + currency;
                                font-size: Typography.body;
                                font-weight: Typography.medium;
                                color: Colors.text-primary;
                            }
                        }

                        // Discounts
                        HorizontalLayout {
                            Text {
                                text: Layout.rtl ? "الخصومات" : "Discounts";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: "-" + discounts + " " + currency;
                                font-size: Typography.body;
                                font-weight: Typography.medium;
                                color: Colors.success;
                            }
                        }

                        // Returns
                        HorizontalLayout {
                            Text {
                                text: Layout.rtl ? "المرتجعات" : "Returns";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: "-" + returns + " " + currency;
                                font-size: Typography.body;
                                font-weight: Typography.medium;
                                color: Colors.warning;
                            }
                        }

                        Rectangle { height: 1px; background: Colors.border; }

                        // Net sales (highlighted)
                        HorizontalLayout {
                            Text {
                                text: Layout.rtl ? "صافي المبيعات" : "Net Sales";
                                font-size: Typography.subheading;
                                font-weight: Typography.bold;
                                color: Colors.text-primary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: net-sales + " " + currency;
                                font-size: Typography.subheading;
                                font-weight: Typography.bold;
                                color: Colors.primary;
                            }
                        }

                        // Tax collected
                        HorizontalLayout {
                            Text {
                                text: Layout.rtl ?
                                      "الضريبة المحصلة (" + tax-rate + ")" :
                                      "Tax Collected (" + tax-rate + ")";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: tax-collected + " " + currency;
                                font-size: Typography.body;
                                font-weight: Typography.medium;
                                color: Colors.text-primary;
                            }
                        }
                    }
                }

                // ============================================================
                // PAYMENT METHODS CARD
                // ============================================================
                Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.lg;
                    border-width: 1px;
                    border-color: Colors.border;

                    VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        // Section header
                        HorizontalLayout {
                            spacing: Spacing.sm;

                            Text {
                                text: "💳";
                                font-size: Typography.body;
                                vertical-alignment: center;
                            }

                            Text {
                                text: Layout.rtl ? "إجمالي طرق الدفع" : "Payment Method Totals";
                                font-size: Typography.subheading;
                                font-weight: Typography.semi-bold;
                                color: Colors.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle { height: 1px; background: Colors.border; }

                        // Cash
                        HorizontalLayout {
                            spacing: Spacing.md;

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: Radius.sm;
                                background: Colors.success;

                                Text {
                                    text: "💵";
                                    font-size: Typography.body;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: Layout.rtl ? "نقداً" : "Cash";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }

                            Text {
                                text: cash-count + "×";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                                vertical-alignment: center;
                            }

                            Text {
                                text: cash-total + " " + currency;
                                font-size: Typography.body;
                                font-weight: Typography.medium;
                                color: Colors.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        // Card
                        HorizontalLayout {
                            spacing: Spacing.md;

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: Radius.sm;
                                background: Colors.primary;

                                Text {
                                    text: "💳";
                                    font-size: Typography.body;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: Layout.rtl ? "بطاقة" : "Card";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }

                            Text {
                                text: card-count + "×";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                                vertical-alignment: center;
                            }

                            Text {
                                text: card-total + " " + currency;
                                font-size: Typography.body;
                                font-weight: Typography.medium;
                                color: Colors.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        // Wallet
                        HorizontalLayout {
                            spacing: Spacing.md;

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: Radius.sm;
                                background: Colors.info;

                                Text {
                                    text: "📱";
                                    font-size: Typography.body;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: Layout.rtl ? "محفظة" : "Wallet";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }

                            Text {
                                text: wallet-count + "×";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                                vertical-alignment: center;
                            }

                            Text {
                                text: wallet-total + " " + currency;
                                font-size: Typography.body;
                                font-weight: Typography.medium;
                                color: Colors.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        // Credit (if any)
                        if credit-count > 0: HorizontalLayout {
                            spacing: Spacing.md;

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: Radius.sm;
                                background: Colors.warning;

                                Text {
                                    text: "📋";
                                    font-size: Typography.body;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: Layout.rtl ? "آجل" : "Credit";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }

                            Text {
                                text: credit-count + "×";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                                vertical-alignment: center;
                            }

                            Text {
                                text: credit-total + " " + currency;
                                font-size: Typography.body;
                                font-weight: Typography.medium;
                                color: Colors.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // ============================================================
                // CASH ACCOUNTABILITY CARD
                // ============================================================
                Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.lg;
                    border-width: 1px;
                    border-color: Colors.border;

                    VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        // Section header
                        HorizontalLayout {
                            spacing: Spacing.sm;

                            Text {
                                text: "🗃️";
                                font-size: Typography.body;
                                vertical-alignment: center;
                            }

                            Text {
                                text: Layout.rtl ? "مسؤولية النقدية" : "Cash Accountability";
                                font-size: Typography.subheading;
                                font-weight: Typography.semi-bold;
                                color: Colors.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle { height: 1px; background: Colors.border; }

                        // Opening float
                        HorizontalLayout {
                            Text {
                                text: Layout.rtl ? "مبلغ الافتتاح" : "Opening Float";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: opening-float + " " + currency;
                                font-size: Typography.body;
                                font-weight: Typography.medium;
                                color: Colors.text-primary;
                            }
                        }

                        // Total cash in
                        HorizontalLayout {
                            Text {
                                text: Layout.rtl ? "إجمالي النقدية الواردة" : "Total Cash In";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: "+" + total-cash-in + " " + currency;
                                font-size: Typography.body;
                                font-weight: Typography.medium;
                                color: Colors.success;
                            }
                        }

                        // Total cash out
                        HorizontalLayout {
                            Text {
                                text: Layout.rtl ? "إجمالي النقدية الصادرة" : "Total Cash Out";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: "-" + total-cash-out + " " + currency;
                                font-size: Typography.body;
                                font-weight: Typography.medium;
                                color: Colors.danger;
                            }
                        }

                        Rectangle { height: 1px; background: Colors.border; }

                        // Expected cash
                        HorizontalLayout {
                            Text {
                                text: Layout.rtl ? "النقدية المتوقعة" : "Expected Cash";
                                font-size: Typography.body;
                                font-weight: Typography.semi-bold;
                                color: Colors.text-primary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: expected-cash + " " + currency;
                                font-size: Typography.body;
                                font-weight: Typography.semi-bold;
                                color: Colors.text-primary;
                            }
                        }

                        // Actual cash
                        HorizontalLayout {
                            Text {
                                text: Layout.rtl ? "النقدية الفعلية" : "Actual Cash";
                                font-size: Typography.body;
                                font-weight: Typography.semi-bold;
                                color: Colors.text-primary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: actual-cash + " " + currency;
                                font-size: Typography.body;
                                font-weight: Typography.semi-bold;
                                color: Colors.text-primary;
                            }
                        }

                        // Variance badge
                        Rectangle {
                            height: 52px;
                            border-radius: Radius.md;
                            background: variance-status == "balanced" ? Colors.success :
                                       variance-status == "short" ? Colors.danger : Colors.warning;

                            HorizontalLayout {
                                padding-left: Spacing.lg;
                                padding-right: Spacing.lg;

                                HorizontalLayout {
                                    spacing: Spacing.sm;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: variance-status == "balanced" ? "✓" :
                                              variance-status == "short" ? "⚠" : "ℹ";
                                        font-size: Typography.heading;
                                        color: Colors.text-on-primary;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: Layout.rtl ? "الفرق:" : "Variance:";
                                        font-size: Typography.body;
                                        color: Colors.text-on-primary;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: (variance-status == "short" ? "-" : variance-status == "over" ? "+" : "") +
                                          variance + " " + currency + " - " +
                                          (variance-status == "balanced" ?
                                           (Layout.rtl ? "متوازن" : "Balanced") :
                                           variance-status == "short" ?
                                           (Layout.rtl ? "عجز" : "Short") :
                                           (Layout.rtl ? "زيادة" : "Over"));
                                    font-size: Typography.body;
                                    font-weight: Typography.bold;
                                    color: Colors.text-on-primary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ============================================================
                // RETURNS & VOIDS CARD (if any)
                // ============================================================
                if return-count > 0 || void-count > 0: Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.lg;
                    border-width: 1px;
                    border-color: Colors.border;

                    VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        // Section header
                        HorizontalLayout {
                            spacing: Spacing.sm;

                            Text {
                                text: "↩️";
                                font-size: Typography.body;
                                vertical-alignment: center;
                            }

                            Text {
                                text: Layout.rtl ? "المرتجعات والإلغاءات" : "Returns & Voids";
                                font-size: Typography.subheading;
                                font-weight: Typography.semi-bold;
                                color: Colors.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle { height: 1px; background: Colors.border; }

                        // Returns
                        if return-count > 0: HorizontalLayout {
                            spacing: Spacing.md;

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: Radius.sm;
                                background: Colors.warning;

                                Text {
                                    text: "↩️";
                                    font-size: Typography.body;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: Layout.rtl ? "المرتجعات" : "Returns";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }

                            Text {
                                text: return-count + "×";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                                vertical-alignment: center;
                            }

                            Text {
                                text: return-total + " " + currency;
                                font-size: Typography.body;
                                font-weight: Typography.medium;
                                color: Colors.warning;
                                vertical-alignment: center;
                            }
                        }

                        // Voids
                        if void-count > 0: HorizontalLayout {
                            spacing: Spacing.md;

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: Radius.sm;
                                background: Colors.danger;

                                Text {
                                    text: "❌";
                                    font-size: Typography.body;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: Layout.rtl ? "الإلغاءات" : "Voids";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }

                            Text {
                                text: void-count + "×";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                                vertical-alignment: center;
                            }

                            Text {
                                text: void-total + " " + currency;
                                font-size: Typography.body;
                                font-weight: Typography.medium;
                                color: Colors.danger;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // ============================================================
                // WARNING NOTE (for clearing report)
                // ============================================================
                if status == "preview": Rectangle {
                    height: 72px;
                    border-radius: Radius.md;
                    background: rgba(239, 68, 68, 0.1);
                    border-width: 1px;
                    border-color: Colors.danger;

                    HorizontalLayout {
                        padding-left: Spacing.lg;
                        padding-right: Spacing.lg;
                        spacing: Spacing.md;

                        Text {
                            text: "⚠️";
                            font-size: Typography.heading;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: Layout.rtl ?
                                      "تحذير: تقرير Z هو تقرير إغلاق نهائي" :
                                      "Warning: Z-Report is a clearing report";
                                font-size: Typography.body;
                                font-weight: Typography.semi-bold;
                                color: Colors.danger;
                            }

                            Text {
                                text: Layout.rtl ?
                                      "سيتم تصفير جميع العدادات ولا يمكن التراجع عن هذا الإجراء" :
                                      "All counters will be reset and this action cannot be undone";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // Bottom spacing
                Rectangle { height: Spacing.xl; }
            }
        }

        // ====================================================================
        // CLOSE DAY BUTTON (Preview status)
        // ====================================================================
        if status == "preview": Rectangle {
            height: 80px;
            background: Colors.surface;
            border-width: 1px;
            border-color: Colors.border;

            HorizontalLayout {
                padding: Spacing.lg;
                alignment: center;
                spacing: Spacing.lg;

                Button {
                    text: Layout.rtl ? "إغلاق اليوم" : "Close Day";
                    variant: "danger";
                    width: 300px;
                    disabled: !can-close;
                    clicked => { root.close-day(); }
                }
            }
        }

        // ====================================================================
        // CLOSING INDICATOR
        // ====================================================================
        if status == "closing": Rectangle {
            height: 80px;
            background: Colors.warning;

            HorizontalLayout {
                alignment: center;
                spacing: Spacing.md;

                Text {
                    text: "⏳";
                    font-size: Typography.heading;
                    vertical-alignment: center;
                }

                Text {
                    text: Layout.rtl ? "جارٍ إغلاق اليوم..." : "Closing Day...";
                    font-size: Typography.subheading;
                    font-weight: Typography.semi-bold;
                    color: Colors.text-on-primary;
                    vertical-alignment: center;
                }
            }
        }

        // ====================================================================
        // SUCCESS BANNER (Closed status)
        // ====================================================================
        if status == "closed": Rectangle {
            height: 80px;
            background: Colors.success;

            HorizontalLayout {
                alignment: center;
                spacing: Spacing.md;

                Text {
                    text: "✓";
                    font-size: 28px;
                    font-weight: Typography.bold;
                    color: Colors.text-on-primary;
                    vertical-alignment: center;
                }

                Text {
                    text: Layout.rtl ? "تم إغلاق اليوم بنجاح" : "Day Closed Successfully";
                    font-size: Typography.subheading;
                    font-weight: Typography.semi-bold;
                    color: Colors.text-on-primary;
                    vertical-alignment: center;
                }
            }
        }

        // ====================================================================
        // STATUS BAR
        // ====================================================================
        StatusBar {
            terminal-code: AppState.terminal-code;
            version: AppState.version;
            is-online: AppState.is-online;
            pending-sync-count: AppState.pending-sync-count;
        }
    }
}
