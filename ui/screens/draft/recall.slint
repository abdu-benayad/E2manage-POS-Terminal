// ============================================================================
// E2Manage POS Terminal - Recall Draft Screen (Phase 29)
// ============================================================================
// Lists saved drafts/held orders for recall or deletion
// Supports Arabic RTL layout and localization
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Layout, Locale, CartState } from "../../theme.slint";
import { Button, SearchInput, CompactStatusBar } from "../../components/mod.slint";

// ============================================================================
// Draft Item Structure (for display)
// ============================================================================

export struct DraftItem {
    id: string,
    name: string,
    customer-name: string,
    item-count: int,
    total: string,
    created-at: string,
    time-ago: string,
    operator-name: string,
}

// ============================================================================
// Draft List Item Row Component
// ============================================================================

component DraftListItem inherits Rectangle {
    in property <DraftItem> draft;
    in property <string> currency: CartState.currency;
    in property <bool> selected: false;

    callback recall-clicked();
    callback delete-clicked();

    height: 96px;
    background: touch-area.has-hover ? Colors.surface-variant : Colors.surface;
    border-radius: Radius.md;

    touch-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.recall-clicked(); }
    }

    HorizontalLayout {
        padding: Spacing.md;
        spacing: Spacing.md;

        // Draft icon badge
        Rectangle {
            width: 56px;
            height: 56px;
            border-radius: Radius.md;
            background: Colors.primary-light;

            VerticalLayout {
                alignment: center;

                Text {
                    text: "\u{1F4CB}"; // Clipboard emoji
                    font-size: 24px;
                    horizontal-alignment: center;
                }
            }
        }

        // Draft info section
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Spacing.xs;
            alignment: center;

            // Top row: Name and customer badge
            HorizontalLayout {
                spacing: Spacing.sm;
                alignment: Layout.rtl ? end : start;

                Text {
                    text: draft.name != "" ? draft.name :
                          (Locale.current == "ar" ? "مسودة" : "Draft");
                    font-size: Typography.body;
                    font-weight: 600;
                    color: Colors.text-primary;
                    horizontal-alignment: Layout.rtl ? right : left;
                }

                // Customer badge
                if draft.customer-name != "": Rectangle {
                    background: Colors.customer-bar;
                    border-radius: Radius.sm;
                    height: 22px;

                    HorizontalLayout {
                        padding-left: Spacing.sm;
                        padding-right: Spacing.sm;
                        spacing: Spacing.xxs;

                        Text {
                            text: "\u{1F464}"; // Person emoji
                            font-size: Typography.small;
                            vertical-alignment: center;
                        }

                        Text {
                            text: draft.customer-name;
                            font-size: Typography.small;
                            color: Colors.orange-accent;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Middle row: Items count and total
            HorizontalLayout {
                spacing: Spacing.lg;
                alignment: Layout.rtl ? end : start;

                HorizontalLayout {
                    spacing: Spacing.xs;

                    Text {
                        text: "\u{1F6D2}"; // Shopping cart emoji
                        font-size: Typography.caption;
                        vertical-alignment: center;
                    }

                    Text {
                        text: draft.item-count + (Locale.current == "ar" ? " عنصر" : " items");
                        font-size: Typography.caption;
                        color: Colors.text-secondary;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: draft.total + " " + currency;
                    font-size: Typography.body;
                    font-weight: 700;
                    color: Colors.primary;
                    horizontal-alignment: Layout.rtl ? right : left;
                }
            }

            // Bottom row: Time ago and operator
            HorizontalLayout {
                spacing: Spacing.md;
                alignment: Layout.rtl ? end : start;

                Text {
                    text: draft.time-ago;
                    font-size: Typography.small;
                    color: Colors.text-secondary;
                }

                if draft.operator-name != "": HorizontalLayout {
                    spacing: Spacing.xxs;

                    Text {
                        text: "\u{1F9D1}\u{200D}\u{1F4BC}"; // Office worker emoji
                        font-size: Typography.small;
                    }

                    Text {
                        text: draft.operator-name;
                        font-size: Typography.small;
                        color: Colors.text-secondary;
                    }
                }
            }
        }

        // Action buttons
        VerticalLayout {
            alignment: center;
            spacing: Spacing.xs;

            // Recall button
            Rectangle {
                width: 100px;
                height: 36px;
                background: recall-touch.has-hover ? Colors.primary-dark : Colors.primary;
                border-radius: Radius.button;

                recall-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.recall-clicked(); }
                }

                Text {
                    text: Locale.current == "ar" ? "استرجاع" : "Recall";
                    font-size: Typography.caption;
                    font-weight: 600;
                    color: Colors.text-on-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Delete link
            Rectangle {
                width: 100px;
                height: 28px;
                background: delete-touch.has-hover ? rgba(239, 68, 68, 0.1) : transparent;
                border-radius: Radius.sm;

                delete-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.delete-clicked(); }
                }

                Text {
                    text: Locale.current == "ar" ? "حذف" : "Delete";
                    font-size: Typography.caption;
                    color: Colors.danger;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// ============================================================================
// Recall Draft Screen Component
// ============================================================================

export component RecallDraftScreen inherits Rectangle {
    // Input properties
    in property <[DraftItem]> drafts: [];
    in-out property <string> search-query: "";
    in property <string> currency: CartState.currency;
    in property <bool> loading: false;
    in property <string> operator-name: "";
    in property <string> shift-number: "";

    // Callbacks
    callback search-changed(string);
    callback recall-draft(string);
    callback delete-draft(string);
    callback back-clicked();

    background: Colors.background;

    VerticalLayout {
        spacing: 0px;

        // =====================================================
        // Header
        // =====================================================
        Rectangle {
            height: Sizes.header-height;
            background: Colors.primary;

            HorizontalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.lg;
                alignment: space-between;

                // Left section: Back button and title
                HorizontalLayout {
                    spacing: Spacing.md;
                    alignment: start;

                    // Back button
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: Radius.full;
                        background: back-touch.has-hover ? rgba(255, 255, 255, 0.1) : transparent;

                        back-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.back-clicked(); }
                        }

                        Text {
                            text: Layout.rtl ? "\u{2192}" : "\u{2190}"; // Arrow (direction aware)
                            font-size: 24px;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Title with icon
                    HorizontalLayout {
                        spacing: Spacing.sm;
                        alignment: start;

                        Text {
                            text: "\u{1F4CB}"; // Clipboard emoji
                            font-size: Typography.heading;
                            vertical-alignment: center;
                        }

                        Text {
                            text: Locale.current == "ar" ? "المسودات المحفوظة" : "Saved Drafts";
                            font-size: Typography.heading;
                            font-weight: 600;
                            color: Colors.text-on-primary;
                            vertical-alignment: center;
                            horizontal-alignment: Layout.rtl ? right : left;
                        }
                    }
                }

                // Right section: Draft count badge
                HorizontalLayout {
                    alignment: end;

                    Rectangle {
                        background: rgba(255, 255, 255, 0.2);
                        border-radius: Radius.full;
                        height: 32px;

                        HorizontalLayout {
                            padding-left: Spacing.md;
                            padding-right: Spacing.md;

                            Text {
                                text: drafts.length + (Locale.current == "ar" ? " مسودة" : " drafts");
                                font-size: Typography.caption;
                                font-weight: 500;
                                color: Colors.text-on-primary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // =====================================================
        // Search Bar
        // =====================================================
        Rectangle {
            height: 64px;
            background: Colors.surface;
            border-width: 0px;
            border-color: Colors.border;

            HorizontalLayout {
                padding: Spacing.md;

                SearchInput {
                    placeholder: Locale.current == "ar" ?
                                "بحث بالاسم أو العميل..." :
                                "Search by name or customer...";
                    text <=> root.search-query;

                    search(query) => { root.search-changed(query); }
                }
            }
        }

        // Divider line
        Rectangle {
            height: 1px;
            background: Colors.border;
        }

        // =====================================================
        // Drafts List Content
        // =====================================================
        Rectangle {
            vertical-stretch: 1;
            background: Colors.background;

            // Loading state
            if loading: VerticalLayout {
                alignment: center;
                spacing: Spacing.md;

                Text {
                    text: "\u{23F3}"; // Hourglass emoji
                    font-size: 48px;
                    horizontal-alignment: center;
                }

                Text {
                    text: Locale.current == "ar" ? "جارٍ التحميل..." : "Loading...";
                    font-size: Typography.body;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                }
            }

            // Empty state (no drafts)
            if !loading && drafts.length == 0: VerticalLayout {
                alignment: center;
                spacing: Spacing.lg;
                padding: Spacing.xxxl;

                // Empty state illustration
                Rectangle {
                    width: 120px;
                    height: 120px;
                    border-radius: Radius.full;
                    background: Colors.surface;

                    Text {
                        text: "\u{1F4CB}"; // Clipboard emoji
                        font-size: 64px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: Locale.current == "ar" ?
                          "لا توجد مسودات محفوظة" :
                          "No saved drafts";
                    font-size: Typography.heading;
                    font-weight: 600;
                    color: Colors.text-primary;
                    horizontal-alignment: center;
                }

                Text {
                    text: Locale.current == "ar" ?
                          "اضغط \"حفظ\" أو F3 في الكاشير لحفظ معاملة" :
                          "Press \"Hold\" or F3 in checkout to save a transaction";
                    font-size: Typography.body;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    max-width: 400px;
                }

                // Go back to checkout button
                Rectangle {
                    width: 200px;
                    height: Sizes.button-height;
                    background: back-to-checkout.has-hover ? Colors.primary-dark : Colors.primary;
                    border-radius: Radius.button;

                    back-to-checkout := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.back-clicked(); }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.sm;

                        Text {
                            text: Layout.rtl ? "\u{2192}" : "\u{2190}";
                            font-size: Typography.body;
                            color: Colors.text-on-primary;
                            vertical-alignment: center;
                        }

                        Text {
                            text: Locale.current == "ar" ? "العودة للكاشير" : "Back to Checkout";
                            font-size: Typography.body;
                            font-weight: 600;
                            color: Colors.text-on-primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Drafts list
            if !loading && drafts.length > 0: Flickable {
                viewport-width: self.width;
                viewport-height: drafts.length * 104px + Spacing.lg * 2;  // 96px item + 8px gap

                VerticalLayout {
                    padding: Spacing.md;
                    spacing: Spacing.sm;

                    for draft[index] in drafts: DraftListItem {
                        draft: draft;
                        currency: root.currency;

                        recall-clicked => { root.recall-draft(draft.id); }
                        delete-clicked => { root.delete-draft(draft.id); }
                    }

                    // Bottom padding
                    Rectangle {
                        height: Spacing.lg;
                    }
                }
            }
        }

        // =====================================================
        // Status Bar
        // =====================================================
        CompactStatusBar {
            is-online: true;
            pending-sync-count: 0;
        }
    }
}
