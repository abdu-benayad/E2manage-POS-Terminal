// ============================================================================
// E2Manage POS Terminal - Settings Router
// ============================================================================
// Handles routing between all settings sub-screens
// Reduces main.slint complexity by encapsulating settings navigation
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Layout, Locale, AppState, SettingsState } from "../../theme.slint";
import { Button } from "../../components/mod.slint";

// Import all settings screens
import { SettingsHomeScreen, SettingItem } from "home.slint";
import { PrinterSettingsScreen, PrinterDevice } from "printer.slint";
import { DisplaySettingsScreen } from "display.slint";
import { AboutSettingsScreen } from "about.slint";
import { SecuritySettingsScreen } from "security.slint";
import { SyncSettingsScreen } from "sync.slint";
import { PaymentSettingsScreen, PaymentMethodConfig } from "payment.slint";

// Import modals for About screen actions
import { LogsModal, LogEntryData } from "logs-modal.slint";
import { ExportStatusModal } from "export-status-modal.slint";
import { UpdateModal } from "update-modal.slint";
import { SupportModal } from "support-modal.slint";

// Re-export LogEntryData for use by Rust
export { LogEntryData }

// ============================================================================
// Settings Router Component
// ============================================================================

export component SettingsRouter inherits Rectangle {
    // Callbacks to parent (main.slint)
    callback exit-settings;  // Navigate back to checkout
    callback sync-now-requested;   // Trigger quick sync
    callback full-sync-requested;  // Trigger full sync

    // Printer devices (passed from main or could be fetched)
    in property <[PrinterDevice]> available-printers: [
        { id: "USB-001", name: "EPSON TM-T20II", connection: "usb", status: "connected" },
        { id: "NET-001", name: "Star TSP143IV", connection: "network", status: "disconnected" },
    ];

    // Payment methods config
    in property <[PaymentMethodConfig]> payment-methods: [
        { id: "cash", name: "Cash", name-ar: "نقدي", icon: "💵", enabled: true, is-default: true },
        { id: "card", name: "Card", name-ar: "بطاقة", icon: "💳", enabled: true, is-default: false },
        { id: "mobile", name: "Mobile", name-ar: "محفظة", icon: "📱", enabled: false, is-default: false },
    ];

    // ========================================================================
    // Logs Modal State
    // ========================================================================
    in-out property <bool> show-logs-modal: false;
    in-out property <[LogEntryData]> log-entries: [];
    in-out property <string> log-filter: "ALL";
    in-out property <bool> logs-loading: false;

    callback load-logs;
    callback filter-logs(string);

    // ========================================================================
    // Export Logs Modal State
    // ========================================================================
    in-out property <bool> show-export-modal: false;
    in-out property <bool> export-in-progress: false;
    in-out property <bool> export-success: false;
    in-out property <string> export-path: "";
    in-out property <string> export-error: "";

    callback export-logs;
    callback open-export-folder;

    // ========================================================================
    // Update Modal State
    // ========================================================================
    in-out property <bool> show-update-modal: false;
    in-out property <bool> update-checking: false;
    in-out property <bool> update-available: false;
    in-out property <bool> force-update: false;
    in-out property <string> current-version: "1.0.0";
    in-out property <string> latest-version: "1.0.0";
    in-out property <string> update-release-notes: "";
    in-out property <string> update-error: "";

    callback check-updates;
    callback download-update;

    // ========================================================================
    // Support Modal State
    // ========================================================================
    in-out property <bool> show-support-modal: false;
    in-out property <string> support-company: "E2Manage Support";
    in-out property <string> support-email: "support@e2manage.com";
    in-out property <string> support-phone: "+966-XXX-XXX-XXXX";
    in-out property <string> support-whatsapp: "+966XXXXXXXXX";
    in-out property <string> support-website: "https://e2manage.com/support";
    in-out property <string> support-hours: "Sun-Thu 9:00 AM - 6:00 PM (AST)";

    callback load-support-info;
    callback send-support-email;
    callback call-support-phone;
    callback open-support-whatsapp;
    callback open-support-website;

    background: Colors.background;

    // Settings Home
    if SettingsState.current-screen == "home": SettingsHomeScreen {
        terminal-id: AppState.terminal-code;
        app-version: AppState.version;
        last-sync: AppState.last-sync;
        pending-sync: AppState.pending-sync-count;
        is-online: AppState.is-online;

        navigate-to(setting-id) => {
            debug("Settings: Navigate to " + setting-id);
            SettingsState.current-screen = setting-id;
        }

        sync-now => {
            debug("Sync Now requested");
            SettingsState.sync-in-progress = true;
            // In production: Call SyncService
        }

        logout => {
            debug("Logout requested");
            root.exit-settings();
        }

        back-clicked => {
            debug("Exit settings");
            root.exit-settings();
        }
    }

    // Printer Settings
    if SettingsState.current-screen == "printer": PrinterSettingsScreen {
        available-printers: root.available-printers;
        selected-printer-id: SettingsState.selected-printer-id;
        printer-ip: SettingsState.printer-ip;
        paper-width: SettingsState.paper-width;
        auto-print: SettingsState.auto-print;
        print-logo: SettingsState.print-logo;
        open-drawer: SettingsState.open-drawer;
        is-online: AppState.is-online;

        printer-selected(id) => {
            SettingsState.selected-printer-id = id;
        }

        ip-changed(ip) => {
            SettingsState.printer-ip = ip;
        }

        paper-width-changed(width) => {
            SettingsState.paper-width = width;
        }

        toggle-auto-print(enabled) => {
            SettingsState.auto-print = enabled;
        }

        toggle-print-logo(enabled) => {
            SettingsState.print-logo = enabled;
        }

        toggle-open-drawer(enabled) => {
            SettingsState.open-drawer = enabled;
        }

        test-print => {
            debug("Test print requested");
        }

        save-settings => {
            debug("Save printer settings");
            SettingsState.current-screen = "home";
        }

        back-clicked => {
            SettingsState.current-screen = "home";
        }
    }

    // Display Settings
    if SettingsState.current-screen == "display": DisplaySettingsScreen {
        current-language: SettingsState.language;
        current-theme: SettingsState.theme;
        brightness: SettingsState.brightness;
        font-scale: SettingsState.font-scale;
        sound-enabled: SettingsState.sound-enabled;
        screen-timeout: SettingsState.screen-timeout;
        is-online: AppState.is-online;

        language-changed(lang) => {
            SettingsState.language = lang;
            Locale.current = lang;
            Layout.rtl = lang == "ar";
        }

        theme-changed(theme) => {
            SettingsState.theme = theme;
        }

        brightness-changed(value) => {
            SettingsState.brightness = value;
        }

        font-scale-changed(scale) => {
            SettingsState.font-scale = scale;
        }

        toggle-sound(enabled) => {
            SettingsState.sound-enabled = enabled;
        }

        timeout-changed(minutes) => {
            SettingsState.screen-timeout = minutes;
        }

        save-settings => {
            debug("Save display settings");
            SettingsState.current-screen = "home";
        }

        back-clicked => {
            SettingsState.current-screen = "home";
        }
    }

    // About Settings
    if SettingsState.current-screen == "about": AboutSettingsScreen {
        terminal-id: AppState.terminal-code;
        hardware-id: SettingsState.hardware-id;
        tenant-id: SettingsState.tenant-id;
        company-name: SettingsState.company-name;
        app-version: AppState.version;
        electron-version: SettingsState.electron-version;
        os-info: SettingsState.os-info;
        last-sync: AppState.last-sync;
        registered-at: SettingsState.registered-at;
        is-online: AppState.is-online;

        view-logs => {
            debug("View logs requested");
            root.show-logs-modal = true;
            root.logs-loading = true;
            root.load-logs();
        }

        export-logs => {
            debug("Export logs requested");
            root.show-export-modal = true;
            root.export-in-progress = true;
            root.export-success = false;
            root.export-error = "";
            root.export-logs();
        }

        check-updates => {
            debug("Check updates requested");
            root.show-update-modal = true;
            root.update-checking = true;
            root.update-error = "";
            root.check-updates();
        }

        contact-support => {
            debug("Contact support requested");
            root.load-support-info();
            root.show-support-modal = true;
        }

        back-clicked => {
            SettingsState.current-screen = "home";
        }
    }

    // Security Settings
    if SettingsState.current-screen == "security": SecuritySettingsScreen {
        pin-enabled: SettingsState.pin-enabled;
        auto-lock-enabled: SettingsState.auto-lock-enabled;
        auto-lock-timeout: SettingsState.auto-lock-timeout;
        require-pin-for-refund: SettingsState.require-pin-refund;
        require-pin-for-discount: SettingsState.require-pin-discount;
        require-pin-for-void: SettingsState.require-pin-void;
        require-pin-for-cash-drawer: SettingsState.require-pin-drawer;
        is-online: AppState.is-online;

        change-pin => {
            debug("Change PIN requested");
        }

        toggle-auto-lock(enabled) => {
            SettingsState.auto-lock-enabled = enabled;
        }

        set-auto-lock-timeout(minutes) => {
            SettingsState.auto-lock-timeout = minutes;
        }

        toggle-require-pin-refund(enabled) => {
            SettingsState.require-pin-refund = enabled;
        }

        toggle-require-pin-discount(enabled) => {
            SettingsState.require-pin-discount = enabled;
        }

        toggle-require-pin-void(enabled) => {
            SettingsState.require-pin-void = enabled;
        }

        toggle-require-pin-drawer(enabled) => {
            SettingsState.require-pin-drawer = enabled;
        }

        save-settings => {
            debug("Save security settings");
            SettingsState.current-screen = "home";
        }

        back-clicked => {
            SettingsState.current-screen = "home";
        }
    }

    // Sync Settings
    if SettingsState.current-screen == "sync": SyncSettingsScreen {
        is-online: AppState.is-online;
        auto-sync-enabled: SettingsState.auto-sync-enabled;
        sync-interval: SettingsState.sync-interval;
        last-sync: AppState.last-sync;
        last-full-sync: SettingsState.last-full-sync;
        pending-uploads: SettingsState.pending-uploads;
        pending-downloads: SettingsState.pending-downloads;
        sync-in-progress: SettingsState.sync-in-progress;
        sync-progress: SettingsState.sync-progress;
        sync-status: SettingsState.sync-status;
        wifi-only: SettingsState.wifi-only;
        sync-on-startup: SettingsState.sync-on-startup;

        sync-now => {
            debug("Sync now requested");
            root.sync-now-requested();
        }

        full-sync => {
            debug("Full sync requested");
            root.full-sync-requested();
        }

        toggle-auto-sync(enabled) => {
            SettingsState.auto-sync-enabled = enabled;
        }

        set-sync-interval(minutes) => {
            SettingsState.sync-interval = minutes;
        }

        toggle-wifi-only(enabled) => {
            SettingsState.wifi-only = enabled;
        }

        toggle-sync-on-startup(enabled) => {
            SettingsState.sync-on-startup = enabled;
        }

        clear-cache => {
            debug("Clear cache requested");
        }

        save-settings => {
            debug("Save sync settings");
            SettingsState.current-screen = "home";
        }

        back-clicked => {
            SettingsState.current-screen = "home";
        }
    }

    // Payment Settings
    if SettingsState.current-screen == "payment": PaymentSettingsScreen {
        payment-methods: root.payment-methods;
        default-method: SettingsState.default-payment-method;
        allow-split-payment: SettingsState.allow-split-payment;
        require-signature: SettingsState.require-signature;
        signature-threshold: SettingsState.signature-threshold;
        currency: SettingsState.currency;
        allow-multi-currency: SettingsState.allow-multi-currency;
        round-cash: SettingsState.round-cash;
        rounding-mode: SettingsState.rounding-mode;
        emv-enabled: SettingsState.emv-enabled;
        emv-terminal-id: SettingsState.emv-terminal-id;
        is-online: AppState.is-online;

        toggle-method(method-id, enabled) => {
            debug("Payment method toggled: " + method-id);
        }

        set-default-method(method-id) => {
            SettingsState.default-payment-method = method-id;
        }

        toggle-split-payment(enabled) => {
            SettingsState.allow-split-payment = enabled;
        }

        toggle-signature(enabled) => {
            SettingsState.require-signature = enabled;
        }

        set-signature-threshold(amount) => {
            SettingsState.signature-threshold = amount;
        }

        toggle-multi-currency(enabled) => {
            SettingsState.allow-multi-currency = enabled;
        }

        toggle-round-cash(enabled) => {
            SettingsState.round-cash = enabled;
        }

        set-rounding-mode(mode) => {
            SettingsState.rounding-mode = mode;
        }

        configure-emv => {
            debug("Configure EMV requested");
        }

        test-emv => {
            debug("Test EMV connection requested");
        }

        save-settings => {
            debug("Save payment settings");
            SettingsState.current-screen = "home";
        }

        back-clicked => {
            SettingsState.current-screen = "home";
        }
    }

    // ========================================================================
    // Modals (rendered on top of everything)
    // ========================================================================

    // Logs Modal
    if show-logs-modal: LogsModal {
        logs: root.log-entries;
        filter-level: root.log-filter;
        is-loading: root.logs-loading;

        close => {
            root.show-logs-modal = false;
        }
        filter-changed(level) => {
            root.log-filter = level;
            root.filter-logs(level);
        }
        refresh => {
            root.logs-loading = true;
            root.load-logs();
        }
    }

    // Export Status Modal
    if show-export-modal: ExportStatusModal {
        is-exporting: root.export-in-progress;
        export-success: root.export-success;
        export-path: root.export-path;
        error-message: root.export-error;

        close => {
            root.show-export-modal = false;
            root.export-success = false;
            root.export-error = "";
        }
        open-folder => {
            root.open-export-folder();
        }
    }

    // Update Modal
    if show-update-modal: UpdateModal {
        is-checking: root.update-checking;
        update-available: root.update-available;
        force-update: root.force-update;
        current-version: root.current-version;
        latest-version: root.latest-version;
        release-notes: root.update-release-notes;
        error-message: root.update-error;

        close => {
            root.show-update-modal = false;
        }
        download => {
            root.download-update();
        }
        retry => {
            root.update-checking = true;
            root.update-error = "";
            root.check-updates();
        }
    }

    // Support Modal
    if show-support-modal: SupportModal {
        company-name: root.support-company;
        email: root.support-email;
        phone: root.support-phone;
        whatsapp: root.support-whatsapp;
        website: root.support-website;
        support-hours: root.support-hours;

        close => {
            root.show-support-modal = false;
        }
        send-email => {
            root.send-support-email();
        }
        call-phone => {
            root.call-support-phone();
        }
        open-whatsapp => {
            root.open-support-whatsapp();
        }
        open-website => {
            root.open-support-website();
        }
    }
}
