// ============================================================================
// E2Manage POS Terminal - About Settings Screen
// ============================================================================
// Shows terminal information, version, hardware ID, and support details
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Layout, Locale } from "../../theme.slint";
import { Button, StatusBar } from "../../components/mod.slint";

// ============================================================================
// About Settings Screen
// ============================================================================

export component AboutSettingsScreen inherits Rectangle {
    // Input properties
    in property <string> terminal-id: "POS-001";
    in property <string> hardware-id: "a1b2c3d4e5f6";
    in property <string> tenant-id: "";
    in property <string> company-name: "Company Name";
    in property <string> app-version: "1.0.0";
    in property <string> electron-version: "";
    in property <string> os-info: "Linux";
    in property <string> last-sync: "2024-01-15 14:30";
    in property <string> registered-at: "2024-01-01 10:00";
    in property <bool> is-online: true;

    // Callbacks
    callback view-logs;
    callback export-logs;
    callback check-updates;
    callback contact-support;
    callback back-clicked;

    background: Colors.background;

    VerticalLayout {
        spacing: 0px;

        // Header
        Rectangle {
            height: Sizes.header-height;
            background: Colors.primary;

            HorizontalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.lg;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Spacing.lg;

                    // Back button
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: Radius.md;

                        back-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.back-clicked(); }
                        }

                        Rectangle {
                            background: back-touch.pressed ? rgba(255, 255, 255, 0.2) :
                                       back-touch.has-hover ? rgba(255, 255, 255, 0.1) : transparent;
                            border-radius: parent.border-radius;
                        }

                        Text {
                            text: Layout.rtl ? "→" : "←";
                            font-size: 24px;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Icon
                    Text {
                        text: "ℹ️";
                        font-size: 24px;
                        vertical-alignment: center;
                    }

                    // Title
                    Text {
                        text: Locale.current == "ar" ? "حول" : "About";
                        font-size: Typography.heading;
                        font-weight: 600;
                        color: Colors.text-on-primary;
                        vertical-alignment: center;
                    }
                }

                // Status indicator
                Rectangle {
                    width: 120px;
                    height: 36px;
                    border-radius: Radius.sm;
                    background: is-online ? rgba(76, 175, 80, 0.2) : rgba(244, 67, 54, 0.2);

                    HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.xs;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: is-online ? #4CAF50 : #F44336;
                        }

                        Text {
                            text: is-online ?
                                (Locale.current == "ar" ? "متصل" : "Online") :
                                (Locale.current == "ar" ? "غير متصل" : "Offline");
                            font-size: Typography.caption;
                            color: is-online ? #4CAF50 : #F44336;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Content
        Flickable {
            viewport-height: content-layout.preferred-height;

            content-layout := VerticalLayout {
                padding: Spacing.lg;
                spacing: Spacing.lg;

                // App Info Card
                Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.lg;
                    drop-shadow-blur: 4px;
                    drop-shadow-color: rgba(0, 0, 0, 0.1);
                    drop-shadow-offset-y: 2px;

                    VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        // App Logo and Name
                        HorizontalLayout {
                            alignment: center;
                            spacing: Spacing.md;

                            Rectangle {
                                width: 64px;
                                height: 64px;
                                border-radius: Radius.md;
                                background: Colors.primary;

                                Text {
                                    text: "E2";
                                    font-size: 28px;
                                    font-weight: 700;
                                    color: Colors.text-on-primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                spacing: Spacing.xs;

                                Text {
                                    text: "E2Manage POS";
                                    font-size: Typography.title;
                                    font-weight: 600;
                                    color: Colors.text-primary;
                                }

                                Text {
                                    text: Locale.current == "ar" ?
                                        "نقطة البيع" : "Point of Sale Terminal";
                                    font-size: Typography.body;
                                    color: Colors.text-secondary;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Colors.border; }

                        // Version Info
                        HorizontalLayout {
                            spacing: Spacing.lg;

                            VerticalLayout {
                                spacing: Spacing.xs;
                                horizontal-stretch: 1;

                                Text {
                                    text: Locale.current == "ar" ? "إصدار التطبيق" : "App Version";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }

                                Text {
                                    text: "v" + app-version;
                                    font-size: Typography.body;
                                    font-weight: 500;
                                    color: Colors.text-primary;
                                }
                            }

                            if electron-version != "": VerticalLayout {
                                spacing: Spacing.xs;
                                horizontal-stretch: 1;

                                Text {
                                    text: Locale.current == "ar" ? "إصدار Electron" : "Electron Version";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }

                                Text {
                                    text: electron-version;
                                    font-size: Typography.body;
                                    font-weight: 500;
                                    color: Colors.text-primary;
                                }
                            }

                            VerticalLayout {
                                spacing: Spacing.xs;
                                horizontal-stretch: 1;

                                Text {
                                    text: Locale.current == "ar" ? "نظام التشغيل" : "OS";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }

                                Text {
                                    text: os-info;
                                    font-size: Typography.body;
                                    font-weight: 500;
                                    color: Colors.text-primary;
                                }
                            }
                        }
                    }
                }

                // Terminal Info Card
                Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.lg;
                    drop-shadow-blur: 4px;
                    drop-shadow-color: rgba(0, 0, 0, 0.1);
                    drop-shadow-offset-y: 2px;

                    VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        Text {
                            text: Locale.current == "ar" ? "معلومات الجهاز" : "Terminal Information";
                            font-size: Typography.subheading;
                            font-weight: 600;
                            color: Colors.text-primary;
                        }

                        Rectangle { height: 1px; background: Colors.border; }

                        // Terminal ID
                        HorizontalLayout {
                            spacing: Spacing.md;

                            Text {
                                text: Locale.current == "ar" ? "معرف الجهاز:" : "Terminal ID:";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: terminal-id;
                                font-size: Typography.body;
                                font-weight: 500;
                                color: Colors.text-primary;
                            }
                        }

                        // Hardware ID
                        HorizontalLayout {
                            spacing: Spacing.md;

                            Text {
                                text: Locale.current == "ar" ? "معرف الجهاز المادي:" : "Hardware ID:";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: hardware-id;
                                font-size: Typography.body;
                                font-weight: 500;
                                color: Colors.primary;
                            }
                        }

                        // Company
                        HorizontalLayout {
                            spacing: Spacing.md;

                            Text {
                                text: Locale.current == "ar" ? "الشركة:" : "Company:";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: company-name;
                                font-size: Typography.body;
                                font-weight: 500;
                                color: Colors.text-primary;
                            }
                        }

                        // Registered At
                        HorizontalLayout {
                            spacing: Spacing.md;

                            Text {
                                text: Locale.current == "ar" ? "تاريخ التسجيل:" : "Registered:";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: registered-at;
                                font-size: Typography.body;
                                color: Colors.text-primary;
                            }
                        }

                        // Last Sync
                        HorizontalLayout {
                            spacing: Spacing.md;

                            Text {
                                text: Locale.current == "ar" ? "آخر مزامنة:" : "Last Sync:";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: last-sync;
                                font-size: Typography.body;
                                color: Colors.text-primary;
                            }
                        }
                    }
                }

                // Actions Card
                Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.lg;
                    drop-shadow-blur: 4px;
                    drop-shadow-color: rgba(0, 0, 0, 0.1);
                    drop-shadow-offset-y: 2px;

                    VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        Text {
                            text: Locale.current == "ar" ? "الإجراءات" : "Actions";
                            font-size: Typography.subheading;
                            font-weight: 600;
                            color: Colors.text-primary;
                        }

                        Rectangle { height: 1px; background: Colors.border; }

                        // View Logs
                        Rectangle {
                            height: 56px;
                            border-radius: Radius.md;
                            background: logs-touch.has-hover ? Colors.surface-variant : transparent;

                            logs-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.view-logs(); }
                            }

                            HorizontalLayout {
                                padding-left: Spacing.md;
                                padding-right: Spacing.md;
                                spacing: Spacing.md;

                                Text {
                                    text: "📋";
                                    font-size: 20px;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    spacing: Spacing.xs;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: Locale.current == "ar" ? "عرض السجلات" : "View Logs";
                                        font-size: Typography.body;
                                        font-weight: 500;
                                        color: Colors.text-primary;
                                    }

                                    Text {
                                        text: Locale.current == "ar" ?
                                            "عرض سجلات النظام والأخطاء" : "View system and error logs";
                                        font-size: Typography.caption;
                                        color: Colors.text-secondary;
                                    }
                                }

                                Text {
                                    text: Layout.rtl ? "←" : "→";
                                    font-size: 20px;
                                    color: Colors.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Export Logs
                        Rectangle {
                            height: 56px;
                            border-radius: Radius.md;
                            background: export-touch.has-hover ? Colors.surface-variant : transparent;

                            export-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.export-logs(); }
                            }

                            HorizontalLayout {
                                padding-left: Spacing.md;
                                padding-right: Spacing.md;
                                spacing: Spacing.md;

                                Text {
                                    text: "📤";
                                    font-size: 20px;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    spacing: Spacing.xs;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: Locale.current == "ar" ? "تصدير السجلات" : "Export Logs";
                                        font-size: Typography.body;
                                        font-weight: 500;
                                        color: Colors.text-primary;
                                    }

                                    Text {
                                        text: Locale.current == "ar" ?
                                            "تصدير السجلات للدعم الفني" : "Export logs for technical support";
                                        font-size: Typography.caption;
                                        color: Colors.text-secondary;
                                    }
                                }

                                Text {
                                    text: Layout.rtl ? "←" : "→";
                                    font-size: 20px;
                                    color: Colors.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Check Updates
                        Rectangle {
                            height: 56px;
                            border-radius: Radius.md;
                            background: updates-touch.has-hover ? Colors.surface-variant : transparent;

                            updates-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.check-updates(); }
                            }

                            HorizontalLayout {
                                padding-left: Spacing.md;
                                padding-right: Spacing.md;
                                spacing: Spacing.md;

                                Text {
                                    text: "🔄";
                                    font-size: 20px;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    spacing: Spacing.xs;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: Locale.current == "ar" ? "التحقق من التحديثات" : "Check for Updates";
                                        font-size: Typography.body;
                                        font-weight: 500;
                                        color: Colors.text-primary;
                                    }

                                    Text {
                                        text: Locale.current == "ar" ?
                                            "البحث عن إصدارات جديدة" : "Search for new versions";
                                        font-size: Typography.caption;
                                        color: Colors.text-secondary;
                                    }
                                }

                                Text {
                                    text: Layout.rtl ? "←" : "→";
                                    font-size: 20px;
                                    color: Colors.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Contact Support
                        Rectangle {
                            height: 56px;
                            border-radius: Radius.md;
                            background: support-touch.has-hover ? Colors.surface-variant : transparent;

                            support-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.contact-support(); }
                            }

                            HorizontalLayout {
                                padding-left: Spacing.md;
                                padding-right: Spacing.md;
                                spacing: Spacing.md;

                                Text {
                                    text: "🎧";
                                    font-size: 20px;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    spacing: Spacing.xs;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: Locale.current == "ar" ? "الدعم الفني" : "Contact Support";
                                        font-size: Typography.body;
                                        font-weight: 500;
                                        color: Colors.text-primary;
                                    }

                                    Text {
                                        text: Locale.current == "ar" ?
                                            "تواصل مع فريق الدعم" : "Get help from support team";
                                        font-size: Typography.caption;
                                        color: Colors.text-secondary;
                                    }
                                }

                                Text {
                                    text: Layout.rtl ? "←" : "→";
                                    font-size: 20px;
                                    color: Colors.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Footer
                Rectangle {
                    height: 60px;

                    Text {
                        text: "© 2024 E2Manage. All rights reserved.";
                        font-size: Typography.caption;
                        color: Colors.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
