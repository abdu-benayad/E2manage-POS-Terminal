// ============================================================================
// E2Manage POS Terminal - Export Status Modal
// ============================================================================
// Shows progress and result of log export operation
// ============================================================================

import { Colors, Typography, Spacing, Radius, Locale } from "../../theme.slint";
import { Button } from "../../components/mod.slint";

export component ExportStatusModal inherits Rectangle {
    in property <bool> is-exporting: false;
    in property <bool> export-success: false;
    in property <string> export-path: "";
    in property <string> error-message: "";

    callback close;
    callback open-folder;

    background: Colors.overlay;

    // Click outside to close (only if not exporting)
    TouchArea {
        clicked => {
            if !is-exporting {
                root.close();
            }
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 400px;
        height: 250px;
        background: Colors.surface;
        border-radius: Radius.lg;

        // Prevent closing when clicking inside modal
        TouchArea {}

        VerticalLayout {
            padding: Spacing.lg;
            spacing: Spacing.md;
            alignment: center;

            if is-exporting: VerticalLayout {
                spacing: Spacing.md;
                alignment: center;

                // Loading indicator
                Text {
                    text: "...";
                    font-size: 48px;
                    horizontal-alignment: center;
                    animate font-size { duration: 500ms; }
                }

                Text {
                    text: Locale.current == "ar" ?
                        "جاري تصدير السجلات..." :
                        "Exporting logs...";
                    font-size: Typography.body;
                    color: Colors.text-primary;
                    horizontal-alignment: center;
                }
            }

            if !is-exporting && export-success: VerticalLayout {
                spacing: Spacing.md;
                alignment: center;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 32px;
                    background: Colors.success;

                    Text {
                        text: "V";
                        font-size: 32px;
                        font-weight: 700;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: Locale.current == "ar" ?
                        "تم تصدير السجلات بنجاح" :
                        "Logs exported successfully";
                    font-size: Typography.body;
                    font-weight: 600;
                    color: Colors.success;
                    horizontal-alignment: center;
                }

                Text {
                    text: export-path;
                    font-size: Typography.caption;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: Spacing.md;
                    alignment: center;

                    Button {
                        text: Locale.current == "ar" ? "فتح المجلد" : "Open Folder";
                        variant: "outline";
                        clicked => { root.open-folder(); }
                    }

                    Button {
                        text: Locale.current == "ar" ? "إغلاق" : "Close";
                        variant: "primary";
                        clicked => { root.close(); }
                    }
                }
            }

            if !is-exporting && !export-success && error-message != "": VerticalLayout {
                spacing: Spacing.md;
                alignment: center;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 32px;
                    background: Colors.danger;

                    Text {
                        text: "X";
                        font-size: 32px;
                        font-weight: 700;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: Locale.current == "ar" ?
                        "فشل تصدير السجلات" :
                        "Export failed";
                    font-size: Typography.body;
                    font-weight: 600;
                    color: Colors.danger;
                    horizontal-alignment: center;
                }

                Text {
                    text: error-message;
                    font-size: Typography.caption;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                }

                Button {
                    text: Locale.current == "ar" ? "إغلاق" : "Close";
                    variant: "primary";
                    clicked => { root.close(); }
                }
            }
        }
    }
}
