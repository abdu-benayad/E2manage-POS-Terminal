// ============================================================================
// E2Manage POS Terminal - Update Modal
// ============================================================================
// Shows update check results and download options
// ============================================================================

import { Colors, Typography, Spacing, Radius, Locale } from "../../theme.slint";
import { Button } from "../../components/mod.slint";

export component UpdateModal inherits Rectangle {
    in property <bool> is-checking: false;
    in property <bool> update-available: false;
    in property <bool> force-update: false;
    in property <string> current-version: "1.0.0";
    in property <string> latest-version: "1.0.0";
    in property <string> release-notes: "";
    in property <string> error-message: "";

    callback close;
    callback download;
    callback retry;

    background: Colors.overlay;

    // Click outside to close (only if not checking and not force update)
    TouchArea {
        clicked => {
            if !is-checking && !force-update {
                root.close();
            }
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 450px;
        height: force-update ? 320px : update-available ? 350px : 280px;
        background: Colors.surface;
        border-radius: Radius.lg;

        // Prevent closing when clicking inside modal
        TouchArea {}

        VerticalLayout {
            padding: Spacing.lg;
            spacing: Spacing.md;
            alignment: center;

            // Checking state
            if is-checking: VerticalLayout {
                spacing: Spacing.md;
                alignment: center;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 32px;
                    background: Colors.primary;

                    Text {
                        text: "...";
                        font-size: 24px;
                        font-weight: 700;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: Locale.current == "ar" ?
                        "جاري البحث عن تحديثات..." :
                        "Checking for updates...";
                    font-size: Typography.body;
                    color: Colors.text-primary;
                    horizontal-alignment: center;
                }

                Text {
                    text: Locale.current == "ar" ?
                        "الإصدار الحالي: " + current-version :
                        "Current version: " + current-version;
                    font-size: Typography.caption;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                }
            }

            // Error state
            if !is-checking && error-message != "": VerticalLayout {
                spacing: Spacing.md;
                alignment: center;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 32px;
                    background: Colors.danger;

                    Text {
                        text: "!";
                        font-size: 32px;
                        font-weight: 700;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: Locale.current == "ar" ?
                        "فشل التحقق من التحديثات" :
                        "Update check failed";
                    font-size: Typography.body;
                    font-weight: 600;
                    color: Colors.danger;
                    horizontal-alignment: center;
                }

                Text {
                    text: error-message;
                    font-size: Typography.caption;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: Spacing.md;
                    alignment: center;

                    Button {
                        text: Locale.current == "ar" ? "إعادة المحاولة" : "Retry";
                        variant: "outline";
                        clicked => { root.retry(); }
                    }

                    Button {
                        text: Locale.current == "ar" ? "إغلاق" : "Close";
                        variant: "primary";
                        clicked => { root.close(); }
                    }
                }
            }

            // Update available
            if !is-checking && error-message == "" && update-available: VerticalLayout {
                spacing: Spacing.md;
                alignment: center;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 32px;
                    background: force-update ? Colors.warning : Colors.info;

                    Text {
                        text: "^";
                        font-size: 32px;
                        font-weight: 700;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: Locale.current == "ar" ?
                        (force-update ? "تحديث مطلوب" : "تحديث متوفر") :
                        (force-update ? "Update Required" : "Update Available");
                    font-size: Typography.heading;
                    font-weight: 600;
                    color: force-update ? Colors.warning : Colors.info;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: Spacing.md;

                    Text {
                        text: current-version;
                        font-size: Typography.body;
                        color: Colors.text-secondary;
                    }
                    Text {
                        text: "->";
                        font-size: Typography.body;
                        color: Colors.text-secondary;
                    }
                    Text {
                        text: latest-version;
                        font-size: Typography.body;
                        font-weight: 600;
                        color: Colors.success;
                    }
                }

                if release-notes != "": Rectangle {
                    background: Colors.surface-variant;
                    border-radius: Radius.sm;
                    height: 60px;

                    VerticalLayout {
                        padding: Spacing.sm;

                        Text {
                            text: release-notes;
                            font-size: Typography.caption;
                            color: Colors.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: Spacing.md;
                    alignment: center;

                    if !force-update: Button {
                        text: Locale.current == "ar" ? "لاحقاً" : "Later";
                        variant: "outline";
                        clicked => { root.close(); }
                    }

                    Button {
                        text: Locale.current == "ar" ? "تحميل" : "Download";
                        variant: "primary";
                        clicked => { root.download(); }
                    }
                }
            }

            // Up to date
            if !is-checking && error-message == "" && !update-available: VerticalLayout {
                spacing: Spacing.md;
                alignment: center;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 32px;
                    background: Colors.success;

                    Text {
                        text: "V";
                        font-size: 32px;
                        font-weight: 700;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: Locale.current == "ar" ?
                        "النظام محدث" :
                        "You're up to date";
                    font-size: Typography.heading;
                    font-weight: 600;
                    color: Colors.success;
                    horizontal-alignment: center;
                }

                Text {
                    text: Locale.current == "ar" ?
                        "الإصدار " + current-version :
                        "Version " + current-version;
                    font-size: Typography.body;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                }

                Button {
                    text: Locale.current == "ar" ? "إغلاق" : "Close";
                    variant: "outline";
                    clicked => { root.close(); }
                }
            }
        }
    }
}
