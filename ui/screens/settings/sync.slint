// ============================================================================
// E2Manage POS Terminal - Sync Settings Screen
// ============================================================================
// Data synchronization settings and status
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Layout, Locale } from "../../theme.slint";
import { Button, StatusBar } from "../../components/mod.slint";

// ============================================================================
// Sync Settings Screen
// ============================================================================

export component SyncSettingsScreen inherits Rectangle {
    // Input properties
    in property <bool> is-online: true;
    in property <bool> auto-sync-enabled: true;
    in property <int> sync-interval: 5; // minutes
    in property <string> last-sync: "2024-01-15 14:30";
    in property <string> last-full-sync: "2024-01-15 10:00";
    in property <int> pending-uploads: 0;
    in property <int> pending-downloads: 0;
    in property <bool> sync-in-progress: false;
    in property <int> sync-progress: 0; // 0-100
    in property <string> sync-status: ""; // Current sync operation
    in property <bool> wifi-only: false;
    in property <bool> sync-on-startup: true;

    // Callbacks
    callback sync-now;
    callback full-sync;
    callback toggle-auto-sync(bool);
    callback set-sync-interval(int);
    callback toggle-wifi-only(bool);
    callback toggle-sync-on-startup(bool);
    callback clear-cache;
    callback save-settings;
    callback back-clicked;

    background: Colors.background;

    // Interval options
    property <[int]> interval-options: [1, 2, 5, 10, 15, 30];

    VerticalLayout {
        spacing: 0px;

        // Header
        Rectangle {
            height: Sizes.header-height;
            background: Colors.primary;

            HorizontalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.lg;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Spacing.lg;

                    // Back button
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: Radius.md;

                        back-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.back-clicked(); }
                        }

                        Rectangle {
                            background: back-touch.pressed ? rgba(255, 255, 255, 0.2) :
                                       back-touch.has-hover ? rgba(255, 255, 255, 0.1) : transparent;
                            border-radius: parent.border-radius;
                        }

                        Text {
                            text: Layout.rtl ? "→" : "←";
                            font-size: 24px;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Icon
                    Text {
                        text: "🔄";
                        font-size: 24px;
                        vertical-alignment: center;
                    }

                    // Title
                    Text {
                        text: Locale.current == "ar" ? "المزامنة" : "Sync";
                        font-size: Typography.heading;
                        font-weight: 600;
                        color: Colors.text-on-primary;
                        vertical-alignment: center;
                    }
                }

                // Status indicator
                Rectangle {
                    width: 120px;
                    height: 36px;
                    border-radius: Radius.sm;
                    background: is-online ? rgba(76, 175, 80, 0.2) : rgba(244, 67, 54, 0.2);

                    HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.xs;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: is-online ? #4CAF50 : #F44336;
                        }

                        Text {
                            text: is-online ?
                                (Locale.current == "ar" ? "متصل" : "Online") :
                                (Locale.current == "ar" ? "غير متصل" : "Offline");
                            font-size: Typography.caption;
                            color: is-online ? #4CAF50 : #F44336;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Content
        Flickable {
            viewport-height: content-layout.preferred-height;

            content-layout := VerticalLayout {
                padding: Spacing.lg;
                spacing: Spacing.lg;

                // Sync Status Card
                Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.lg;
                    drop-shadow-blur: 4px;
                    drop-shadow-color: rgba(0, 0, 0, 0.1);
                    drop-shadow-offset-y: 2px;

                    VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        Text {
                            text: Locale.current == "ar" ? "حالة المزامنة" : "Sync Status";
                            font-size: Typography.subheading;
                            font-weight: 600;
                            color: Colors.text-primary;
                        }

                        Rectangle { height: 1px; background: Colors.border; }

                        // Last sync times
                        HorizontalLayout {
                            spacing: Spacing.lg;

                            VerticalLayout {
                                spacing: Spacing.xs;
                                horizontal-stretch: 1;

                                Text {
                                    text: Locale.current == "ar" ? "آخر مزامنة" : "Last Sync";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }

                                Text {
                                    text: last-sync;
                                    font-size: Typography.body;
                                    font-weight: 500;
                                    color: Colors.text-primary;
                                }
                            }

                            VerticalLayout {
                                spacing: Spacing.xs;
                                horizontal-stretch: 1;

                                Text {
                                    text: Locale.current == "ar" ? "آخر مزامنة كاملة" : "Last Full Sync";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }

                                Text {
                                    text: last-full-sync;
                                    font-size: Typography.body;
                                    font-weight: 500;
                                    color: Colors.text-primary;
                                }
                            }
                        }

                        // Pending items
                        HorizontalLayout {
                            spacing: Spacing.lg;

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 60px;
                                border-radius: Radius.md;
                                background: pending-uploads > 0 ? rgba(255, 152, 0, 0.1) : Colors.surface-variant;

                                HorizontalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: "⬆️";
                                        font-size: 20px;
                                        vertical-alignment: center;
                                    }

                                    VerticalLayout {
                                        spacing: Spacing.xs;

                                        Text {
                                            text: pending-uploads;
                                            font-size: Typography.title;
                                            font-weight: 600;
                                            color: pending-uploads > 0 ? #FF9800 : Colors.text-primary;
                                        }

                                        Text {
                                            text: Locale.current == "ar" ? "معلق للرفع" : "Pending Upload";
                                            font-size: Typography.caption;
                                            color: Colors.text-secondary;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 60px;
                                border-radius: Radius.md;
                                background: pending-downloads > 0 ? rgba(33, 150, 243, 0.1) : Colors.surface-variant;

                                HorizontalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: "⬇️";
                                        font-size: 20px;
                                        vertical-alignment: center;
                                    }

                                    VerticalLayout {
                                        spacing: Spacing.xs;

                                        Text {
                                            text: pending-downloads;
                                            font-size: Typography.title;
                                            font-weight: 600;
                                            color: pending-downloads > 0 ? #2196F3 : Colors.text-primary;
                                        }

                                        Text {
                                            text: Locale.current == "ar" ? "معلق للتنزيل" : "Pending Download";
                                            font-size: Typography.caption;
                                            color: Colors.text-secondary;
                                        }
                                    }
                                }
                            }
                        }

                        // Sync progress (when syncing)
                        if sync-in-progress: VerticalLayout {
                            spacing: Spacing.sm;

                            HorizontalLayout {
                                Text {
                                    text: sync-status;
                                    font-size: Typography.body;
                                    color: Colors.text-primary;
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: sync-progress + "%";
                                    font-size: Typography.body;
                                    font-weight: 500;
                                    color: Colors.primary;
                                }
                            }

                            Rectangle {
                                height: 8px;
                                border-radius: 4px;
                                background: Colors.surface-variant;

                                Rectangle {
                                    width: parent.width * (sync-progress / 100);
                                    height: parent.height;
                                    border-radius: parent.border-radius;
                                    background: Colors.primary;

                                    animate width { duration: 300ms; }
                                }
                            }
                        }

                        // Sync buttons
                        HorizontalLayout {
                            spacing: Spacing.md;

                            Button {
                                text: Locale.current == "ar" ? "مزامنة الآن" : "Sync Now";
                                variant: "primary";
                                horizontal-stretch: 1;
                                loading: sync-in-progress;
                                clicked => { root.sync-now(); }
                            }

                            Button {
                                text: Locale.current == "ar" ? "مزامنة كاملة" : "Full Sync";
                                variant: "outline";
                                horizontal-stretch: 1;
                                clicked => { root.full-sync(); }
                            }
                        }
                    }
                }

                // Sync Settings Card
                Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.lg;
                    drop-shadow-blur: 4px;
                    drop-shadow-color: rgba(0, 0, 0, 0.1);
                    drop-shadow-offset-y: 2px;

                    VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        Text {
                            text: Locale.current == "ar" ? "إعدادات المزامنة" : "Sync Settings";
                            font-size: Typography.subheading;
                            font-weight: 600;
                            color: Colors.text-primary;
                        }

                        Rectangle { height: 1px; background: Colors.border; }

                        // Auto-sync toggle
                        HorizontalLayout {
                            spacing: Spacing.md;
                            height: 48px;

                            VerticalLayout {
                                spacing: Spacing.xs;
                                horizontal-stretch: 1;

                                Text {
                                    text: Locale.current == "ar" ? "المزامنة التلقائية" : "Auto-Sync";
                                    font-size: Typography.body;
                                    color: Colors.text-primary;
                                }

                                Text {
                                    text: Locale.current == "ar" ?
                                        "مزامنة البيانات تلقائياً" : "Sync data automatically";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                            }

                            Rectangle {
                                width: 52px;
                                height: 28px;
                                border-radius: 14px;
                                background: auto-sync-enabled ? Colors.primary : Colors.border;

                                animate background { duration: 200ms; }

                                auto-sync-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle-auto-sync(!auto-sync-enabled); }
                                }

                                Rectangle {
                                    x: auto-sync-enabled ? parent.width - self.width - 2px : 2px;
                                    y: 2px;
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 12px;
                                    background: white;

                                    animate x { duration: 200ms; }
                                }
                            }
                        }

                        // Sync interval
                        if auto-sync-enabled: VerticalLayout {
                            spacing: Spacing.sm;

                            Text {
                                text: Locale.current == "ar" ? "فترة المزامنة" : "Sync Interval";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                            }

                            HorizontalLayout {
                                spacing: Spacing.sm;

                                for interval in interval-options: Rectangle {
                                    width: 60px;
                                    height: 40px;
                                    border-radius: Radius.sm;
                                    background: sync-interval == interval ? Colors.primary : Colors.surface-variant;
                                    border-width: 1px;
                                    border-color: sync-interval == interval ? Colors.primary : Colors.border;

                                    interval-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.set-sync-interval(interval); }
                                    }

                                    Text {
                                        text: interval + (Locale.current == "ar" ? " د" : " min");
                                        font-size: Typography.caption;
                                        font-weight: sync-interval == interval ? 600 : 400;
                                        color: sync-interval == interval ? Colors.text-on-primary : Colors.text-primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Colors.border; }

                        // WiFi only toggle
                        HorizontalLayout {
                            spacing: Spacing.md;
                            height: 48px;

                            VerticalLayout {
                                spacing: Spacing.xs;
                                horizontal-stretch: 1;

                                Text {
                                    text: Locale.current == "ar" ? "WiFi فقط" : "WiFi Only";
                                    font-size: Typography.body;
                                    color: Colors.text-primary;
                                }

                                Text {
                                    text: Locale.current == "ar" ?
                                        "المزامنة فقط عند الاتصال بـ WiFi" : "Only sync when connected to WiFi";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                            }

                            Rectangle {
                                width: 52px;
                                height: 28px;
                                border-radius: 14px;
                                background: wifi-only ? Colors.primary : Colors.border;

                                animate background { duration: 200ms; }

                                wifi-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle-wifi-only(!wifi-only); }
                                }

                                Rectangle {
                                    x: wifi-only ? parent.width - self.width - 2px : 2px;
                                    y: 2px;
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 12px;
                                    background: white;

                                    animate x { duration: 200ms; }
                                }
                            }
                        }

                        // Sync on startup toggle
                        HorizontalLayout {
                            spacing: Spacing.md;
                            height: 48px;

                            VerticalLayout {
                                spacing: Spacing.xs;
                                horizontal-stretch: 1;

                                Text {
                                    text: Locale.current == "ar" ? "المزامنة عند بدء التشغيل" : "Sync on Startup";
                                    font-size: Typography.body;
                                    color: Colors.text-primary;
                                }

                                Text {
                                    text: Locale.current == "ar" ?
                                        "مزامنة البيانات عند فتح التطبيق" : "Sync data when app starts";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                            }

                            Rectangle {
                                width: 52px;
                                height: 28px;
                                border-radius: 14px;
                                background: sync-on-startup ? Colors.primary : Colors.border;

                                animate background { duration: 200ms; }

                                startup-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle-sync-on-startup(!sync-on-startup); }
                                }

                                Rectangle {
                                    x: sync-on-startup ? parent.width - self.width - 2px : 2px;
                                    y: 2px;
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 12px;
                                    background: white;

                                    animate x { duration: 200ms; }
                                }
                            }
                        }
                    }
                }

                // Cache Management Card
                Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.lg;
                    drop-shadow-blur: 4px;
                    drop-shadow-color: rgba(0, 0, 0, 0.1);
                    drop-shadow-offset-y: 2px;

                    VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        Text {
                            text: Locale.current == "ar" ? "إدارة الذاكرة المؤقتة" : "Cache Management";
                            font-size: Typography.subheading;
                            font-weight: 600;
                            color: Colors.text-primary;
                        }

                        Rectangle { height: 1px; background: Colors.border; }

                        // Clear cache
                        Rectangle {
                            height: 56px;
                            border-radius: Radius.md;
                            background: cache-touch.has-hover ? rgba(244, 67, 54, 0.1) : transparent;

                            cache-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.clear-cache(); }
                            }

                            HorizontalLayout {
                                padding-left: Spacing.md;
                                padding-right: Spacing.md;
                                spacing: Spacing.md;

                                Text {
                                    text: "🗑️";
                                    font-size: 20px;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    spacing: Spacing.xs;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: Locale.current == "ar" ? "مسح الذاكرة المؤقتة" : "Clear Cache";
                                        font-size: Typography.body;
                                        font-weight: 500;
                                        color: #F44336;
                                    }

                                    Text {
                                        text: Locale.current == "ar" ?
                                            "حذف البيانات المؤقتة وإعادة المزامنة" : "Delete cached data and re-sync";
                                        font-size: Typography.caption;
                                        color: Colors.text-secondary;
                                    }
                                }

                                Text {
                                    text: Layout.rtl ? "←" : "→";
                                    font-size: 20px;
                                    color: Colors.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Spacer
                Rectangle { height: Spacing.lg; }
            }
        }
    }
}
