// ============================================================================
// E2Manage POS Terminal - Settings Home Screen
// ============================================================================
// Phase 36: Settings home screen with setting categories
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Layout, Locale } from "../../theme.slint";
import { Button, StatusBar } from "../../components/mod.slint";

// ============================================================================
// Setting Item Struct
// ============================================================================

export struct SettingItem {
    id: string,
    icon: string,
    title-en: string,
    title-ar: string,
    description-en: string,
    description-ar: string,
}

// ============================================================================
// Settings Home Screen
// ============================================================================

export component SettingsHomeScreen inherits Rectangle {
    // Input properties
    in property <string> terminal-id: "POS-001";
    in property <string> app-version: "1.0.0";
    in property <string> last-sync: "2024-01-15 14:30";
    in property <int> pending-sync: 0;
    in property <bool> is-online: true;

    // Callbacks
    callback navigate-to(string);
    callback sync-now;
    callback logout;
    callback shutdown;  // Opens shutdown dialog
    callback back-clicked;

    background: Colors.background;

    // Settings categories
    property <[SettingItem]> settings: [
        { id: "printer", icon: "🖨️", title-en: "Printer", title-ar: "الطابعة",
          description-en: "Configure receipt printer", description-ar: "إعداد طابعة الإيصالات" },
        { id: "display", icon: "🖥️", title-en: "Display", title-ar: "العرض",
          description-en: "Screen brightness, language", description-ar: "السطوع، اللغة" },
        { id: "payment", icon: "💳", title-en: "Payment", title-ar: "الدفع",
          description-en: "Payment methods, EMV", description-ar: "طرق الدفع، EMV" },
        { id: "security", icon: "🔒", title-en: "Security", title-ar: "الأمان",
          description-en: "PIN, auto-lock, permissions", description-ar: "رمز PIN، القفل التلقائي" },
        { id: "sync", icon: "🔄", title-en: "Sync", title-ar: "المزامنة",
          description-en: "Data sync settings", description-ar: "إعدادات مزامنة البيانات" },
        { id: "about", icon: "ℹ️", title-en: "About", title-ar: "حول",
          description-en: "Version, support, logs", description-ar: "الإصدار، الدعم، السجلات" },
    ];

    VerticalLayout {
        spacing: 0px;

        // Header
        Rectangle {
            height: Sizes.header-height;
            background: Colors.primary;

            HorizontalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.lg;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Spacing.lg;

                    // Back button
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: Radius.md;

                        back-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.back-clicked(); }
                        }

                        Rectangle {
                            background: back-touch.pressed ? rgba(255, 255, 255, 0.2) :
                                       back-touch.has-hover ? rgba(255, 255, 255, 0.1) : transparent;
                            border-radius: parent.border-radius;
                        }

                        Text {
                            text: Layout.rtl ? "→" : "←";
                            font-size: 24px;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Title
                    Text {
                        text: Locale.current == "ar" ? "الإعدادات" : "Settings";
                        font-size: Typography.heading;
                        font-weight: 600;
                        color: Colors.text-on-primary;
                        vertical-alignment: center;
                    }

                    // Settings gear icon
                    Text {
                        text: "⚙️";
                        font-size: 24px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Content
        Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: Spacing.lg;
                spacing: Spacing.lg;

                // Terminal status card
                Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.lg;
                    drop-shadow-blur: 4px;
                    drop-shadow-offset-y: 2px;
                    drop-shadow-color: rgba(0, 0, 0, 0.1);

                    VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        // Status indicator row
                        HorizontalLayout {
                            spacing: Spacing.md;
                            alignment: start;

                            // Status dot
                            Rectangle {
                                width: 12px;
                                height: 12px;
                                border-radius: 6px;
                                background: is-online ? Colors.success : Colors.danger;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: is-online ?
                                      (Locale.current == "ar" ? "متصل" : "Online") :
                                      (Locale.current == "ar" ? "غير متصل" : "Offline");
                                font-size: Typography.body;
                                color: is-online ? Colors.success : Colors.danger;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        // Info grid
                        HorizontalLayout {
                            spacing: Spacing.xl;

                            // Terminal ID
                            VerticalLayout {
                                spacing: Spacing.xs;

                                Text {
                                    text: Locale.current == "ar" ? "الجهاز" : "Terminal";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                                Text {
                                    text: terminal-id;
                                    font-size: Typography.body;
                                    font-weight: 600;
                                    color: Colors.text-primary;
                                }
                            }

                            // Last Sync
                            VerticalLayout {
                                spacing: Spacing.xs;

                                Text {
                                    text: Locale.current == "ar" ? "آخر مزامنة" : "Last Sync";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                                Text {
                                    text: last-sync;
                                    font-size: Typography.body;
                                    color: Colors.text-primary;
                                }
                            }

                            // Pending
                            VerticalLayout {
                                spacing: Spacing.xs;

                                Text {
                                    text: Locale.current == "ar" ? "في الانتظار" : "Pending";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                                Text {
                                    text: pending-sync;
                                    font-size: Typography.body;
                                    font-weight: 600;
                                    color: pending-sync > 0 ? Colors.warning : Colors.text-primary;
                                }
                            }
                        }

                        // Sync Now button (shown when pending or offline)
                        if pending-sync > 0 || !is-online: Button {
                            text: Locale.current == "ar" ? "مزامنة الآن" : "Sync Now";
                            variant: "primary";
                            clicked => { root.sync-now(); }
                        }
                    }
                }

                // Settings list
                VerticalLayout {
                    spacing: Spacing.sm;

                    for setting in settings: Rectangle {
                        height: 80px;
                        background: Colors.surface;
                        border-radius: Radius.md;
                        drop-shadow-blur: 2px;
                        drop-shadow-offset-y: 1px;
                        drop-shadow-color: rgba(0, 0, 0, 0.05);

                        setting-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.navigate-to(setting.id); }
                        }

                        Rectangle {
                            background: setting-touch.pressed ? rgba(0, 0, 0, 0.05) :
                                       setting-touch.has-hover ? rgba(0, 0, 0, 0.02) : transparent;
                            border-radius: parent.border-radius;
                        }

                        HorizontalLayout {
                            padding: Spacing.lg;
                            spacing: Spacing.lg;

                            // Icon circle
                            Rectangle {
                                width: 48px;
                                height: 48px;
                                border-radius: Radius.md;
                                background: Colors.primary-light;

                                Text {
                                    text: setting.icon;
                                    font-size: 24px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Text content
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: Spacing.xs;

                                Text {
                                    text: Locale.current == "ar" ? setting.title-ar : setting.title-en;
                                    font-size: Typography.body;
                                    font-weight: 600;
                                    color: Colors.text-primary;
                                }

                                Text {
                                    text: Locale.current == "ar" ? setting.description-ar : setting.description-en;
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                            }

                            // Arrow indicator (RTL-aware)
                            Text {
                                text: Layout.rtl ? "←" : "→";
                                font-size: 20px;
                                color: Colors.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Version info card
                Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.md;
                    height: 60px;

                    HorizontalLayout {
                        padding: Spacing.lg;
                        alignment: space-between;

                        Text {
                            text: Locale.current == "ar" ? "الإصدار" : "Version";
                            font-size: Typography.body;
                            color: Colors.text-secondary;
                            vertical-alignment: center;
                        }

                        Text {
                            text: app-version;
                            font-size: Typography.body;
                            color: Colors.text-primary;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                }

                // Logout button
                Button {
                    text: Locale.current == "ar" ? "تسجيل الخروج" : "Logout";
                    variant: "danger";
                    clicked => { root.logout(); }
                }

                // Bottom padding
                Rectangle {
                    height: Spacing.lg;
                }
            }
        }

        // Status bar
        StatusBar {
            is-online: root.is-online;
        }
    }
}
