// ============================================================================
// E2Manage POS Terminal - Payment Settings Screen
// ============================================================================
// Payment method configuration, EMV settings, and currency options
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Layout, Locale, CartState } from "../../theme.slint";
import { Button, StatusBar } from "../../components/mod.slint";

// ============================================================================
// Payment Method Struct
// ============================================================================

export struct PaymentMethodConfig {
    id: string,
    name: string,
    name-ar: string,
    icon: string,
    enabled: bool,
    is-default: bool,
}

// ============================================================================
// Payment Settings Screen
// ============================================================================

export component PaymentSettingsScreen inherits Rectangle {
    // Input properties
    in property <[PaymentMethodConfig]> payment-methods: [
        { id: "cash", name: "Cash", name-ar: "نقدي", icon: "💵", enabled: true, is-default: true },
        { id: "card", name: "Card", name-ar: "بطاقة", icon: "💳", enabled: true, is-default: false },
        { id: "mobile", name: "Mobile", name-ar: "محفظة", icon: "📱", enabled: false, is-default: false },
    ];
    in property <string> default-method: "cash";
    in property <bool> allow-split-payment: true;
    in property <bool> require-signature: false;
    in property <int> signature-threshold: 50; // Amount above which signature required
    in property <string> currency: CartState.currency;
    in property <bool> allow-multi-currency: false;
    in property <bool> round-cash: true;
    in property <string> rounding-mode: "nearest"; // nearest, up, down
    in property <bool> emv-enabled: true;
    in property <string> emv-terminal-id: "";
    in property <bool> is-online: true;

    // Callbacks
    callback toggle-method(string, bool);
    callback set-default-method(string);
    callback toggle-split-payment(bool);
    callback toggle-signature(bool);
    callback set-signature-threshold(int);
    callback toggle-multi-currency(bool);
    callback toggle-round-cash(bool);
    callback set-rounding-mode(string);
    callback configure-emv;
    callback test-emv;
    callback save-settings;
    callback back-clicked;

    background: Colors.background;

    // Signature threshold options
    property <[int]> threshold-options: [25, 50, 100, 200, 500];

    VerticalLayout {
        spacing: 0px;

        // Header
        Rectangle {
            height: Sizes.header-height;
            background: Colors.primary;

            HorizontalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.lg;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Spacing.lg;

                    // Back button
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: Radius.md;

                        back-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.back-clicked(); }
                        }

                        Rectangle {
                            background: back-touch.pressed ? rgba(255, 255, 255, 0.2) :
                                       back-touch.has-hover ? rgba(255, 255, 255, 0.1) : transparent;
                            border-radius: parent.border-radius;
                        }

                        Text {
                            text: Layout.rtl ? "→" : "←";
                            font-size: 24px;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Icon
                    Text {
                        text: "💳";
                        font-size: 24px;
                        vertical-alignment: center;
                    }

                    // Title
                    Text {
                        text: Locale.current == "ar" ? "الدفع" : "Payment";
                        font-size: Typography.heading;
                        font-weight: 600;
                        color: Colors.text-on-primary;
                        vertical-alignment: center;
                    }
                }

                // Save button
                Button {
                    text: Locale.current == "ar" ? "حفظ" : "Save";
                    variant: "secondary";
                    clicked => { root.save-settings(); }
                }
            }
        }

        // Content
        Flickable {
            viewport-height: content-layout.preferred-height;

            content-layout := VerticalLayout {
                padding: Spacing.lg;
                spacing: Spacing.lg;

                // Payment Methods Card
                Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.lg;
                    drop-shadow-blur: 4px;
                    drop-shadow-color: rgba(0, 0, 0, 0.1);
                    drop-shadow-offset-y: 2px;

                    VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        Text {
                            text: Locale.current == "ar" ? "طرق الدفع" : "Payment Methods";
                            font-size: Typography.subheading;
                            font-weight: 600;
                            color: Colors.text-primary;
                        }

                        Text {
                            text: Locale.current == "ar" ?
                                "اختر طرق الدفع المتاحة" : "Select available payment methods";
                            font-size: Typography.caption;
                            color: Colors.text-secondary;
                        }

                        Rectangle { height: 1px; background: Colors.border; }

                        for method in payment-methods: Rectangle {
                            height: 64px;
                            border-radius: Radius.md;
                            background: method.enabled ? Colors.surface-variant : transparent;
                            border-width: method.is-default ? 2px : 0px;
                            border-color: Colors.primary;

                            HorizontalLayout {
                                padding-left: Spacing.md;
                                padding-right: Spacing.md;
                                spacing: Spacing.md;

                                Text {
                                    text: method.icon;
                                    font-size: 24px;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    spacing: Spacing.xs;
                                    horizontal-stretch: 1;

                                    HorizontalLayout {
                                        spacing: Spacing.sm;

                                        Text {
                                            text: Locale.current == "ar" ? method.name-ar : method.name;
                                            font-size: Typography.body;
                                            font-weight: 500;
                                            color: Colors.text-primary;
                                        }

                                        if method.is-default: Rectangle {
                                            width: default-label.preferred-width + 12px;
                                            height: 20px;
                                            border-radius: 10px;
                                            background: Colors.primary;

                                            default-label := Text {
                                                text: Locale.current == "ar" ? "افتراضي" : "Default";
                                                font-size: Typography.caption;
                                                color: Colors.text-on-primary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if method.enabled && !method.is-default: TouchArea {
                                        height: 20px;
                                        mouse-cursor: pointer;
                                        clicked => { root.set-default-method(method.id); }

                                        Text {
                                            text: Locale.current == "ar" ? "تعيين كافتراضي" : "Set as default";
                                            font-size: Typography.caption;
                                            color: Colors.primary;
                                        }
                                    }
                                }

                                // Toggle switch
                                Rectangle {
                                    width: 52px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: method.enabled ? Colors.primary : Colors.border;

                                    animate background { duration: 200ms; }

                                    method-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.toggle-method(method.id, !method.enabled); }
                                    }

                                    Rectangle {
                                        x: method.enabled ? parent.width - self.width - 2px : 2px;
                                        y: 2px;
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: white;

                                        animate x { duration: 200ms; }
                                    }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Colors.border; }

                        // Split payment toggle
                        HorizontalLayout {
                            spacing: Spacing.md;
                            height: 48px;

                            VerticalLayout {
                                spacing: Spacing.xs;
                                horizontal-stretch: 1;

                                Text {
                                    text: Locale.current == "ar" ? "الدفع المقسم" : "Split Payment";
                                    font-size: Typography.body;
                                    color: Colors.text-primary;
                                }

                                Text {
                                    text: Locale.current == "ar" ?
                                        "السماح بالدفع بأكثر من طريقة" : "Allow payment with multiple methods";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                            }

                            Rectangle {
                                width: 52px;
                                height: 28px;
                                border-radius: 14px;
                                background: allow-split-payment ? Colors.primary : Colors.border;

                                animate background { duration: 200ms; }

                                split-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle-split-payment(!allow-split-payment); }
                                }

                                Rectangle {
                                    x: allow-split-payment ? parent.width - self.width - 2px : 2px;
                                    y: 2px;
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 12px;
                                    background: white;

                                    animate x { duration: 200ms; }
                                }
                            }
                        }
                    }
                }

                // Cash Settings Card
                Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.lg;
                    drop-shadow-blur: 4px;
                    drop-shadow-color: rgba(0, 0, 0, 0.1);
                    drop-shadow-offset-y: 2px;

                    VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        Text {
                            text: Locale.current == "ar" ? "إعدادات النقد" : "Cash Settings";
                            font-size: Typography.subheading;
                            font-weight: 600;
                            color: Colors.text-primary;
                        }

                        Rectangle { height: 1px; background: Colors.border; }

                        // Currency display
                        HorizontalLayout {
                            spacing: Spacing.md;
                            height: 48px;

                            Text {
                                text: Locale.current == "ar" ? "العملة:" : "Currency:";
                                font-size: Typography.body;
                                color: Colors.text-secondary;
                                vertical-alignment: center;
                            }

                            Text {
                                text: currency;
                                font-size: Typography.body;
                                font-weight: 600;
                                color: Colors.text-primary;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }

                        // Round cash toggle
                        HorizontalLayout {
                            spacing: Spacing.md;
                            height: 48px;

                            VerticalLayout {
                                spacing: Spacing.xs;
                                horizontal-stretch: 1;

                                Text {
                                    text: Locale.current == "ar" ? "تقريب المبالغ النقدية" : "Round Cash Amounts";
                                    font-size: Typography.body;
                                    color: Colors.text-primary;
                                }

                                Text {
                                    text: Locale.current == "ar" ?
                                        "تقريب مبالغ الباقي للعملات المتاحة" : "Round change to available denominations";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                            }

                            Rectangle {
                                width: 52px;
                                height: 28px;
                                border-radius: 14px;
                                background: round-cash ? Colors.primary : Colors.border;

                                animate background { duration: 200ms; }

                                round-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle-round-cash(!round-cash); }
                                }

                                Rectangle {
                                    x: round-cash ? parent.width - self.width - 2px : 2px;
                                    y: 2px;
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 12px;
                                    background: white;

                                    animate x { duration: 200ms; }
                                }
                            }
                        }

                        // Rounding mode
                        if round-cash: VerticalLayout {
                            spacing: Spacing.sm;

                            Text {
                                text: Locale.current == "ar" ? "طريقة التقريب" : "Rounding Mode";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                            }

                            HorizontalLayout {
                                spacing: Spacing.sm;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 40px;
                                    border-radius: Radius.sm;
                                    background: rounding-mode == "nearest" ? Colors.primary : Colors.surface-variant;
                                    border-width: 1px;
                                    border-color: rounding-mode == "nearest" ? Colors.primary : Colors.border;

                                    nearest-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.set-rounding-mode("nearest"); }
                                    }

                                    Text {
                                        text: Locale.current == "ar" ? "الأقرب" : "Nearest";
                                        font-size: Typography.caption;
                                        font-weight: rounding-mode == "nearest" ? 600 : 400;
                                        color: rounding-mode == "nearest" ? Colors.text-on-primary : Colors.text-primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 40px;
                                    border-radius: Radius.sm;
                                    background: rounding-mode == "up" ? Colors.primary : Colors.surface-variant;
                                    border-width: 1px;
                                    border-color: rounding-mode == "up" ? Colors.primary : Colors.border;

                                    up-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.set-rounding-mode("up"); }
                                    }

                                    Text {
                                        text: Locale.current == "ar" ? "لأعلى" : "Up";
                                        font-size: Typography.caption;
                                        font-weight: rounding-mode == "up" ? 600 : 400;
                                        color: rounding-mode == "up" ? Colors.text-on-primary : Colors.text-primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 40px;
                                    border-radius: Radius.sm;
                                    background: rounding-mode == "down" ? Colors.primary : Colors.surface-variant;
                                    border-width: 1px;
                                    border-color: rounding-mode == "down" ? Colors.primary : Colors.border;

                                    down-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.set-rounding-mode("down"); }
                                    }

                                    Text {
                                        text: Locale.current == "ar" ? "لأسفل" : "Down";
                                        font-size: Typography.caption;
                                        font-weight: rounding-mode == "down" ? 600 : 400;
                                        color: rounding-mode == "down" ? Colors.text-on-primary : Colors.text-primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // Card/EMV Settings Card
                Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.lg;
                    drop-shadow-blur: 4px;
                    drop-shadow-color: rgba(0, 0, 0, 0.1);
                    drop-shadow-offset-y: 2px;

                    VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        Text {
                            text: Locale.current == "ar" ? "إعدادات البطاقة / EMV" : "Card / EMV Settings";
                            font-size: Typography.subheading;
                            font-weight: 600;
                            color: Colors.text-primary;
                        }

                        Rectangle { height: 1px; background: Colors.border; }

                        // EMV status
                        HorizontalLayout {
                            spacing: Spacing.md;
                            height: 48px;

                            Text {
                                text: "🔌";
                                font-size: 20px;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                spacing: Spacing.xs;
                                horizontal-stretch: 1;

                                Text {
                                    text: Locale.current == "ar" ? "جهاز EMV" : "EMV Terminal";
                                    font-size: Typography.body;
                                    color: Colors.text-primary;
                                }

                                Text {
                                    text: emv-terminal-id != "" ? emv-terminal-id :
                                        (Locale.current == "ar" ? "غير متصل" : "Not connected");
                                    font-size: Typography.caption;
                                    color: emv-terminal-id != "" ? Colors.text-secondary : Colors.danger;
                                }
                            }

                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: emv-enabled && emv-terminal-id != "" ? #4CAF50 : #F44336;
                            }
                        }

                        // Configure EMV
                        Rectangle {
                            height: 56px;
                            border-radius: Radius.md;
                            background: emv-touch.has-hover ? Colors.surface-variant : transparent;

                            emv-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.configure-emv(); }
                            }

                            HorizontalLayout {
                                padding-left: Spacing.md;
                                padding-right: Spacing.md;
                                spacing: Spacing.md;

                                Text {
                                    text: "⚙️";
                                    font-size: 20px;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    spacing: Spacing.xs;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: Locale.current == "ar" ? "إعداد جهاز EMV" : "Configure EMV Device";
                                        font-size: Typography.body;
                                        font-weight: 500;
                                        color: Colors.text-primary;
                                    }

                                    Text {
                                        text: Locale.current == "ar" ?
                                            "إعداد الاتصال بجهاز الدفع" : "Setup payment device connection";
                                        font-size: Typography.caption;
                                        color: Colors.text-secondary;
                                    }
                                }

                                Text {
                                    text: Layout.rtl ? "←" : "→";
                                    font-size: 20px;
                                    color: Colors.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Test EMV
                        Rectangle {
                            height: 56px;
                            border-radius: Radius.md;
                            background: test-touch.has-hover ? Colors.surface-variant : transparent;

                            test-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.test-emv(); }
                            }

                            HorizontalLayout {
                                padding-left: Spacing.md;
                                padding-right: Spacing.md;
                                spacing: Spacing.md;

                                Text {
                                    text: "🧪";
                                    font-size: 20px;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    spacing: Spacing.xs;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: Locale.current == "ar" ? "اختبار الاتصال" : "Test Connection";
                                        font-size: Typography.body;
                                        font-weight: 500;
                                        color: Colors.text-primary;
                                    }

                                    Text {
                                        text: Locale.current == "ar" ?
                                            "اختبار الاتصال بجهاز EMV" : "Test EMV device connection";
                                        font-size: Typography.caption;
                                        color: Colors.text-secondary;
                                    }
                                }

                                Text {
                                    text: Layout.rtl ? "←" : "→";
                                    font-size: 20px;
                                    color: Colors.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Colors.border; }

                        // Signature requirement
                        HorizontalLayout {
                            spacing: Spacing.md;
                            height: 48px;

                            VerticalLayout {
                                spacing: Spacing.xs;
                                horizontal-stretch: 1;

                                Text {
                                    text: Locale.current == "ar" ? "طلب التوقيع" : "Require Signature";
                                    font-size: Typography.body;
                                    color: Colors.text-primary;
                                }

                                Text {
                                    text: Locale.current == "ar" ?
                                        "طلب توقيع العميل للمبالغ الكبيرة" : "Request customer signature for large amounts";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                            }

                            Rectangle {
                                width: 52px;
                                height: 28px;
                                border-radius: 14px;
                                background: require-signature ? Colors.primary : Colors.border;

                                animate background { duration: 200ms; }

                                sig-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle-signature(!require-signature); }
                                }

                                Rectangle {
                                    x: require-signature ? parent.width - self.width - 2px : 2px;
                                    y: 2px;
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 12px;
                                    background: white;

                                    animate x { duration: 200ms; }
                                }
                            }
                        }

                        // Signature threshold
                        if require-signature: VerticalLayout {
                            spacing: Spacing.sm;

                            Text {
                                text: Locale.current == "ar" ?
                                    "الحد الأدنى للتوقيع (" + currency + ")" :
                                    "Signature Threshold (" + currency + ")";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                            }

                            HorizontalLayout {
                                spacing: Spacing.sm;

                                for threshold in threshold-options: Rectangle {
                                    horizontal-stretch: 1;
                                    height: 40px;
                                    border-radius: Radius.sm;
                                    background: signature-threshold == threshold ? Colors.primary : Colors.surface-variant;
                                    border-width: 1px;
                                    border-color: signature-threshold == threshold ? Colors.primary : Colors.border;

                                    threshold-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.set-signature-threshold(threshold); }
                                    }

                                    Text {
                                        text: threshold;
                                        font-size: Typography.caption;
                                        font-weight: signature-threshold == threshold ? 600 : 400;
                                        color: signature-threshold == threshold ? Colors.text-on-primary : Colors.text-primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // Spacer
                Rectangle { height: Spacing.lg; }
            }
        }
    }
}
