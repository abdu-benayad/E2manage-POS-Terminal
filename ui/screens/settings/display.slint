// ============================================================================
// E2Manage POS Terminal - Display & Language Settings Screen
// ============================================================================
// Phase 38: Language and display configuration screen
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Layout, Locale, Animation, CartState } from "../../theme.slint";
import { Button, StatusBar } from "../../components/mod.slint";

// ============================================================================
// Language Option Struct
// ============================================================================

export struct LanguageOption {
    code: string,
    name: string,
    flag: string,
}

// ============================================================================
// Theme Option Struct
// ============================================================================

export struct ThemeOption {
    id: string,
    icon: string,
    name-en: string,
    name-ar: string,
}

// ============================================================================
// Font Scale Option Struct
// ============================================================================

export struct FontScaleOption {
    value: int,
    label-en: string,
    label-ar: string,
}

// ============================================================================
// Display Settings Screen
// ============================================================================

export component DisplaySettingsScreen inherits Rectangle {
    // Input properties
    in property <string> current-language: "ar";
    in property <string> current-theme: "light"; // light, dark, auto
    in property <int> brightness: 100;
    in property <int> font-scale: 100; // 80, 100, 120
    in property <bool> sound-enabled: true;
    in property <int> screen-timeout: 5; // minutes, 0 = never
    in property <bool> is-online: true;

    // Callbacks
    callback language-changed(string);
    callback theme-changed(string);
    callback brightness-changed(int);
    callback font-scale-changed(int);
    callback toggle-sound(bool);
    callback timeout-changed(int);
    callback save-settings;
    callback back-clicked;

    background: Colors.background;

    // Language options
    property <[LanguageOption]> languages: [
        { code: "ar", name: "العربية", flag: "🇱🇾" },
        { code: "en", name: "English", flag: "🇬🇧" },
    ];

    // Theme options
    property <[ThemeOption]> themes: [
        { id: "light", icon: "☀️", name-en: "Light", name-ar: "فاتح" },
        { id: "dark", icon: "🌙", name-en: "Dark", name-ar: "داكن" },
        { id: "auto", icon: "🔄", name-en: "Auto", name-ar: "تلقائي" },
    ];

    // Font scale options
    property <[FontScaleOption]> font-scales: [
        { value: 80, label-en: "Small", label-ar: "صغير" },
        { value: 100, label-en: "Normal", label-ar: "عادي" },
        { value: 120, label-en: "Large", label-ar: "كبير" },
    ];

    // Screen timeout options (in minutes, 0 = never)
    property <[int]> timeout-options: [1, 5, 10, 30, 0];

    VerticalLayout {
        spacing: 0px;

        // Header
        Rectangle {
            height: Sizes.header-height;
            background: Colors.primary;

            HorizontalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.lg;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Spacing.lg;

                    // Back button
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: Radius.md;

                        back-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.back-clicked(); }
                        }

                        Rectangle {
                            background: back-touch.pressed ? rgba(255, 255, 255, 0.2) :
                                       back-touch.has-hover ? rgba(255, 255, 255, 0.1) : transparent;
                            border-radius: parent.border-radius;
                        }

                        Text {
                            text: Layout.rtl ? "→" : "←";
                            font-size: 24px;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Display icon
                    Text {
                        text: "🖥️";
                        font-size: 24px;
                        vertical-alignment: center;
                    }

                    // Title
                    Text {
                        text: Locale.current == "ar" ? "العرض واللغة" : "Display & Language";
                        font-size: Typography.heading;
                        font-weight: 600;
                        color: Colors.text-on-primary;
                        vertical-alignment: center;
                    }
                }

                // Save button
                Button {
                    text: Locale.current == "ar" ? "حفظ" : "Save";
                    variant: "secondary";
                    clicked => { root.save-settings(); }
                }
            }
        }

        // Content
        Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: Spacing.lg;
                spacing: Spacing.lg;

                // ================================================================
                // Language Selection Section
                // ================================================================
                Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.lg;
                    drop-shadow-blur: 4px;
                    drop-shadow-offset-y: 2px;
                    drop-shadow-color: rgba(0, 0, 0, 0.1);

                    VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        // Section header
                        HorizontalLayout {
                            spacing: Spacing.sm;

                            Text {
                                text: "🌐";
                                font-size: 20px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: Locale.current == "ar" ? "اللغة" : "Language";
                                font-size: Typography.subheading;
                                font-weight: 600;
                                color: Colors.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        // Language tiles
                        HorizontalLayout {
                            spacing: Spacing.md;

                            for lang in languages: Rectangle {
                                horizontal-stretch: 1;
                                height: 72px;
                                border-radius: Radius.md;
                                background: current-language == lang.code ?
                                           Colors.primary : Colors.background;
                                border-width: 2px;
                                border-color: current-language == lang.code ?
                                             Colors.primary : Colors.border;

                                lang-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.language-changed(lang.code); }
                                }

                                Rectangle {
                                    background: lang-touch.pressed ? rgba(0, 0, 0, 0.1) :
                                               lang-touch.has-hover && current-language != lang.code ?
                                               rgba(0, 0, 0, 0.02) : transparent;
                                    border-radius: parent.border-radius;
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: Spacing.md;

                                    Text {
                                        text: lang.flag;
                                        font-size: 28px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: lang.name;
                                        font-size: Typography.body;
                                        font-weight: 600;
                                        color: current-language == lang.code ?
                                               Colors.text-on-primary : Colors.text-primary;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Info text
                        Text {
                            text: Locale.current == "ar" ?
                                  "سيتم تطبيق التغيير فوراً" :
                                  "Change will be applied immediately";
                            font-size: Typography.caption;
                            color: Colors.text-secondary;
                        }
                    }
                }

                // ================================================================
                // Theme Selection Section
                // ================================================================
                Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.lg;
                    drop-shadow-blur: 4px;
                    drop-shadow-offset-y: 2px;
                    drop-shadow-color: rgba(0, 0, 0, 0.1);

                    VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        // Section header
                        HorizontalLayout {
                            spacing: Spacing.sm;

                            Text {
                                text: "🎨";
                                font-size: 20px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: Locale.current == "ar" ? "المظهر" : "Theme";
                                font-size: Typography.subheading;
                                font-weight: 600;
                                color: Colors.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        // Theme tiles
                        HorizontalLayout {
                            spacing: Spacing.md;

                            for theme in themes: Rectangle {
                                horizontal-stretch: 1;
                                height: 88px;
                                border-radius: Radius.md;
                                background: current-theme == theme.id ?
                                           Colors.primary-light : Colors.background;
                                border-width: 2px;
                                border-color: current-theme == theme.id ?
                                             Colors.primary : Colors.border;

                                theme-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.theme-changed(theme.id); }
                                }

                                Rectangle {
                                    background: theme-touch.pressed ? rgba(0, 0, 0, 0.1) :
                                               theme-touch.has-hover && current-theme != theme.id ?
                                               rgba(0, 0, 0, 0.02) : transparent;
                                    border-radius: parent.border-radius;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: theme.icon;
                                        font-size: 28px;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: Locale.current == "ar" ? theme.name-ar : theme.name-en;
                                        font-size: Typography.body;
                                        font-weight: 500;
                                        color: current-theme == theme.id ?
                                               Colors.primary : Colors.text-primary;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // ================================================================
                // Font Size Section
                // ================================================================
                Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.lg;
                    drop-shadow-blur: 4px;
                    drop-shadow-offset-y: 2px;
                    drop-shadow-color: rgba(0, 0, 0, 0.1);

                    VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        // Section header
                        HorizontalLayout {
                            spacing: Spacing.sm;

                            Text {
                                text: "🔤";
                                font-size: 20px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: Locale.current == "ar" ? "حجم الخط" : "Font Size";
                                font-size: Typography.subheading;
                                font-weight: 600;
                                color: Colors.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        // Font scale tiles
                        HorizontalLayout {
                            spacing: Spacing.md;

                            for scale in font-scales: Rectangle {
                                horizontal-stretch: 1;
                                height: 56px;
                                border-radius: Radius.md;
                                background: font-scale == scale.value ?
                                           Colors.primary : Colors.background;
                                border-width: 1px;
                                border-color: font-scale == scale.value ?
                                             Colors.primary : Colors.border;

                                scale-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.font-scale-changed(scale.value); }
                                }

                                Rectangle {
                                    background: scale-touch.pressed ? rgba(0, 0, 0, 0.1) :
                                               scale-touch.has-hover && font-scale != scale.value ?
                                               rgba(0, 0, 0, 0.02) : transparent;
                                    border-radius: parent.border-radius;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: Spacing.xs;

                                    Text {
                                        text: Locale.current == "ar" ? scale.label-ar : scale.label-en;
                                        font-size: scale.value == 80 ? 12px :
                                                  scale.value == 100 ? 14px : 16px;
                                        font-weight: 600;
                                        color: font-scale == scale.value ?
                                               Colors.text-on-primary : Colors.text-primary;
                                        horizontal-alignment: center;
                                    }

                                    // Preview text size indicator
                                    Text {
                                        text: scale.value == 80 ? "Aa" :
                                              scale.value == 100 ? "Aa" : "Aa";
                                        font-size: scale.value == 80 ? 10px :
                                                  scale.value == 100 ? 14px : 18px;
                                        color: font-scale == scale.value ?
                                               rgba(255, 255, 255, 0.7) : Colors.text-secondary;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // ================================================================
                // Sound Toggle Section
                // ================================================================
                Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.lg;
                    height: 72px;
                    drop-shadow-blur: 4px;
                    drop-shadow-offset-y: 2px;
                    drop-shadow-color: rgba(0, 0, 0, 0.1);

                    HorizontalLayout {
                        padding: Spacing.lg;

                        // Icon and text
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            spacing: Spacing.md;

                            Text {
                                text: sound-enabled ? "🔊" : "🔇";
                                font-size: 24px;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: Spacing.xs;

                                Text {
                                    text: Locale.current == "ar" ? "أصوات التطبيق" : "App Sounds";
                                    font-size: Typography.body;
                                    font-weight: 500;
                                    color: Colors.text-primary;
                                }

                                Text {
                                    text: Locale.current == "ar" ?
                                          "تأكيد الصوت والتنبيهات" :
                                          "Confirmation beeps and alerts";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                }
                            }
                        }

                        // Toggle switch
                        Rectangle {
                            width: 56px;
                            height: 32px;
                            border-radius: 16px;
                            background: sound-enabled ? Colors.primary : Colors.border;

                            sound-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-sound(!sound-enabled); }
                            }

                            // Toggle knob
                            Rectangle {
                                x: sound-enabled ? 28px : 4px;
                                y: 4px;
                                width: 24px;
                                height: 24px;
                                border-radius: 12px;
                                background: white;
                                drop-shadow-blur: 2px;
                                drop-shadow-offset-y: 1px;
                                drop-shadow-color: rgba(0, 0, 0, 0.2);

                                animate x { duration: Animation.fast; }
                            }
                        }
                    }
                }

                // ================================================================
                // Screen Timeout Section
                // ================================================================
                Rectangle {
                    background: Colors.surface;
                    border-radius: Radius.lg;
                    drop-shadow-blur: 4px;
                    drop-shadow-offset-y: 2px;
                    drop-shadow-color: rgba(0, 0, 0, 0.1);

                    VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        // Section header
                        HorizontalLayout {
                            spacing: Spacing.sm;

                            Text {
                                text: "⏰";
                                font-size: 20px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: Locale.current == "ar" ? "مهلة الشاشة" : "Screen Timeout";
                                font-size: Typography.subheading;
                                font-weight: 600;
                                color: Colors.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        // Description
                        Text {
                            text: Locale.current == "ar" ?
                                  "إعادة القفل بعد فترة عدم النشاط" :
                                  "Lock screen after inactivity period";
                            font-size: Typography.caption;
                            color: Colors.text-secondary;
                        }

                        // Timeout buttons
                        HorizontalLayout {
                            spacing: Spacing.sm;

                            for timeout in timeout-options: Rectangle {
                                horizontal-stretch: 1;
                                height: 48px;
                                border-radius: Radius.sm;
                                background: screen-timeout == timeout ?
                                           Colors.primary : Colors.background;
                                border-width: 1px;
                                border-color: screen-timeout == timeout ?
                                             Colors.primary : Colors.border;

                                timeout-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.timeout-changed(timeout); }
                                }

                                Rectangle {
                                    background: timeout-touch.pressed ? rgba(0, 0, 0, 0.1) :
                                               timeout-touch.has-hover && screen-timeout != timeout ?
                                               rgba(0, 0, 0, 0.02) : transparent;
                                    border-radius: parent.border-radius;
                                }

                                Text {
                                    text: timeout == 0 ?
                                          (Locale.current == "ar" ? "أبداً" : "Never") :
                                          timeout + (Locale.current == "ar" ? " د" : "m");
                                    font-size: Typography.caption;
                                    font-weight: 600;
                                    color: screen-timeout == timeout ?
                                           Colors.text-on-primary : Colors.text-primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ================================================================
                // Preview Section
                // ================================================================
                Rectangle {
                    background: Colors.surface-variant;
                    border-radius: Radius.lg;
                    border-width: 1px;
                    border-color: Colors.border;

                    VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        // Section header
                        HorizontalLayout {
                            spacing: Spacing.sm;

                            Text {
                                text: "👁️";
                                font-size: 20px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: Locale.current == "ar" ? "معاينة" : "Preview";
                                font-size: Typography.subheading;
                                font-weight: 600;
                                color: Colors.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        // Preview card
                        Rectangle {
                            height: 80px;
                            background: Colors.surface;
                            border-radius: Radius.md;
                            border-width: 1px;
                            border-color: Colors.border;

                            HorizontalLayout {
                                padding: Spacing.lg;
                                spacing: Spacing.md;

                                // Sample product tile
                                Rectangle {
                                    width: 60px;
                                    height: 60px;
                                    border-radius: Radius.md;
                                    background: Colors.primary-light;

                                    Text {
                                        text: "📦";
                                        font-size: font-scale == 80 ? 20px :
                                                  font-scale == 100 ? 24px : 28px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Sample text
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: Spacing.xs;

                                    Text {
                                        text: current-language == "ar" ? "منتج تجريبي" : "Sample Product";
                                        font-size: font-scale == 80 ? 12px :
                                                  font-scale == 100 ? 14px : 16px;
                                        font-weight: 600;
                                        color: Colors.text-primary;
                                        horizontal-alignment: Layout.rtl ? right : left;
                                    }

                                    Text {
                                        text: current-language == "ar" ? "وصف المنتج" : "Product description";
                                        font-size: font-scale == 80 ? 10px :
                                                  font-scale == 100 ? 12px : 14px;
                                        color: Colors.text-secondary;
                                        horizontal-alignment: Layout.rtl ? right : left;
                                    }
                                }

                                // Sample price
                                Text {
                                    text: "5.500 " + CartState.currency;
                                    font-size: font-scale == 80 ? 14px :
                                              font-scale == 100 ? 16px : 18px;
                                    font-weight: 600;
                                    color: Colors.primary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Bottom padding
                Rectangle {
                    height: Spacing.xl;
                }
            }
        }

        // Status bar
        StatusBar {
            is-online: root.is-online;
        }
    }
}
