// ============================================================================
// E2Manage POS Terminal - Support Modal
// ============================================================================
// Shows support contact information and quick actions
// ============================================================================

import { Colors, Typography, Spacing, Radius, Locale } from "../../theme.slint";
import { Button } from "../../components/mod.slint";

export component SupportModal inherits Rectangle {
    in property <string> company-name: "E2Manage Support";
    in property <string> email: "support@e2manage.com";
    in property <string> phone: "+966-XXX-XXX-XXXX";
    in property <string> whatsapp: "+966XXXXXXXXX";
    in property <string> website: "https://e2manage.com/support";
    in property <string> support-hours: "Sun-Thu 9:00 AM - 6:00 PM (AST)";

    callback close;
    callback send-email;
    callback call-phone;
    callback open-whatsapp;
    callback open-website;

    background: Colors.overlay;

    // Click outside to close
    TouchArea {
        clicked => { root.close(); }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width * 0.9, 450px);
        height: 520px;
        background: Colors.surface;
        border-radius: Radius.lg;

        // Prevent closing when clicking inside modal
        TouchArea {}

        VerticalLayout {
            padding: Spacing.lg;
            spacing: Spacing.md;

            // Header
            HorizontalLayout {
                spacing: Spacing.md;

                Text {
                    text: Locale.current == "ar" ? "الدعم الفني" : "Contact Support";
                    font-size: Typography.heading;
                    font-weight: 600;
                    color: Colors.text-primary;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: Radius.sm;
                    background: close-touch.has-hover ? Colors.surface-variant : transparent;

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close(); }
                    }

                    Text {
                        text: "X";
                        font-size: 18px;
                        font-weight: 600;
                        color: Colors.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Support icon
            Rectangle {
                height: 80px;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 32px;
                    background: Colors.primary;

                    Text {
                        text: "?";
                        font-size: 32px;
                        font-weight: 700;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Company name
            Text {
                text: company-name;
                font-size: Typography.subheading;
                font-weight: 600;
                color: Colors.text-primary;
                horizontal-alignment: center;
            }

            // Support hours
            Rectangle {
                background: Colors.surface-variant;
                border-radius: Radius.sm;
                height: 40px;

                Text {
                    text: Locale.current == "ar" ?
                        "ساعات العمل: " + support-hours :
                        "Hours: " + support-hours;
                    font-size: Typography.caption;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Contact options
            VerticalLayout {
                spacing: Spacing.sm;
                padding-top: Spacing.md;

                // Email
                Rectangle {
                    height: 56px;
                    background: email-touch.has-hover ? Colors.surface-variant : transparent;
                    border-radius: Radius.md;

                    email-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.send-email(); }
                    }

                    HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        spacing: Spacing.md;

                        Rectangle {
                            width: 40px;
                            height: 40px;
                            border-radius: 20px;
                            background: Colors.primary;

                            Text {
                                text: "@";
                                font-size: 20px;
                                font-weight: 600;
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: Locale.current == "ar" ? "البريد الإلكتروني" : "Email";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                            }
                            Text {
                                text: email;
                                font-size: Typography.body;
                                color: Colors.primary;
                            }
                        }

                        Text {
                            text: ">";
                            font-size: 18px;
                            color: Colors.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Phone
                Rectangle {
                    height: 56px;
                    background: phone-touch.has-hover ? Colors.surface-variant : transparent;
                    border-radius: Radius.md;

                    phone-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.call-phone(); }
                    }

                    HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        spacing: Spacing.md;

                        Rectangle {
                            width: 40px;
                            height: 40px;
                            border-radius: 20px;
                            background: Colors.success;

                            Text {
                                text: "#";
                                font-size: 20px;
                                font-weight: 600;
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: Locale.current == "ar" ? "الهاتف" : "Phone";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                            }
                            Text {
                                text: phone;
                                font-size: Typography.body;
                                color: Colors.primary;
                            }
                        }

                        Text {
                            text: ">";
                            font-size: 18px;
                            color: Colors.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }

                // WhatsApp
                Rectangle {
                    height: 56px;
                    background: wa-touch.has-hover ? Colors.surface-variant : transparent;
                    border-radius: Radius.md;

                    wa-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-whatsapp(); }
                    }

                    HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        spacing: Spacing.md;

                        Rectangle {
                            width: 40px;
                            height: 40px;
                            border-radius: 20px;
                            background: #25D366;

                            Text {
                                text: "W";
                                font-size: 20px;
                                font-weight: 600;
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: "WhatsApp";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                            }
                            Text {
                                text: whatsapp;
                                font-size: Typography.body;
                                color: #25D366;
                            }
                        }

                        Text {
                            text: ">";
                            font-size: 18px;
                            color: Colors.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Website
                Rectangle {
                    height: 56px;
                    background: web-touch.has-hover ? Colors.surface-variant : transparent;
                    border-radius: Radius.md;

                    web-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-website(); }
                    }

                    HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        spacing: Spacing.md;

                        Rectangle {
                            width: 40px;
                            height: 40px;
                            border-radius: 20px;
                            background: Colors.info;

                            Text {
                                text: "W";
                                font-size: 20px;
                                font-weight: 600;
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: Locale.current == "ar" ? "الموقع الإلكتروني" : "Website";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                            }
                            Text {
                                text: website;
                                font-size: Typography.body;
                                color: Colors.primary;
                                overflow: elide;
                            }
                        }

                        Text {
                            text: ">";
                            font-size: 18px;
                            color: Colors.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
