// ============================================================================
// E2Manage POS Terminal - Payment Methods Screen (Phase 20)
// ============================================================================
// Payment method selection screen with 6 payment tiles in 2x3 grid
// Supports: Cash, Card, Split, Mobile Wallet, Credit (On Account), Other
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Animation, Layout, Locale, CartState } from "../../theme.slint";
import { Button } from "../../components/mod.slint";

// ============================================================================
// PAYMENT TILE COMPONENT
// ============================================================================

component PaymentTile inherits Rectangle {
    in property <string> title;
    in property <string> title-ar;
    in property <string> icon-text: "";
    in property <color> icon-bg: Colors.primary-light;
    in property <bool> disabled: false;

    callback clicked;

    width: Sizes.payment-tile-width;
    height: Sizes.payment-tile-height;
    border-radius: Radius.lg;
    background: disabled ? Colors.surface-variant : Colors.surface;
    border-width: 1px;
    border-color: Colors.border;

    states [
        pressed when touch.pressed && !disabled: {
            background: Colors.surface-variant;
        }
        hovered when touch.has-hover && !disabled && !touch.pressed: {
            background: Colors.background;
            border-color: Colors.primary;
        }
    ]

    animate background { duration: Animation.fast; }
    animate border-color { duration: Animation.fast; }

    VerticalLayout {
        alignment: center;
        spacing: Spacing.md;
        padding: Spacing.lg;

        // Icon circle
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: 28px;
                background: disabled ? Colors.border : icon-bg;

                Text {
                    text: icon-text;
                    font-size: 24px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Title (locale-aware)
        Text {
            text: Locale.current == "ar" && title-ar != "" ? title-ar : title;
            font-size: Typography.body;
            font-weight: Typography.medium;
            color: disabled ? Colors.text-secondary : Colors.text-primary;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: !disabled;
        mouse-cursor: disabled ? default : pointer;
        clicked => { root.clicked(); }
    }
}

// ============================================================================
// PAYMENT METHODS SCREEN
// ============================================================================

export component PaymentMethodsScreen inherits Rectangle {
    in property <string> total: "0.000";
    in property <string> currency: CartState.currency;
    in property <int> item-count: 0;

    // Disable options based on business rules
    in property <bool> card-enabled: true;
    in property <bool> mobile-enabled: true;
    in property <bool> credit-enabled: true;  // Depends on customer selection

    callback select-cash;
    callback select-card;
    callback select-split;
    callback select-mobile;
    callback select-credit;
    callback select-other;
    callback back-clicked;

    background: Colors.background;

    VerticalLayout {
        spacing: 0px;

        // Header
        Rectangle {
            height: Sizes.header-height;
            background: Colors.primary;

            HorizontalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.lg;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Spacing.lg;
                    alignment: start;

                    // Back button (RTL-aware)
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: Radius.md;
                        background: touch-back.has-hover ? rgba(255, 255, 255, 0.1) : transparent;

                        touch-back := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.back-clicked(); }
                        }

                        Text {
                            text: Layout.rtl ? "\u{2192}" : "\u{2190}"; // Arrow based on direction
                            font-size: 24px;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Title
                    Text {
                        text: Locale.current == "ar" ? "طريقة الدفع" : "Payment Method";
                        font-size: Typography.heading;
                        font-weight: Typography.semi-bold;
                        color: Colors.text-on-primary;
                        vertical-alignment: center;
                    }
                }

                // Total display
                Rectangle {
                    width: 220px;
                    height: 48px;
                    border-radius: Radius.md;
                    background: rgba(255, 255, 255, 0.15);

                    HorizontalLayout {
                        padding-left: Spacing.lg;
                        padding-right: Spacing.lg;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;

                            Text {
                                text: Locale.current == "ar" ? "المجموع:" : "Total:";
                                font-size: Typography.small;
                                color: rgba(255, 255, 255, 0.7);
                            }

                            Text {
                                text: Locale.current == "ar"
                                    ? (item-count == 1 ? "صنف واحد" : item-count + " أصناف")
                                    : (item-count == 1 ? "1 item" : item-count + " items");
                                font-size: Typography.tiny;
                                color: rgba(255, 255, 255, 0.5);
                            }
                        }

                        Text {
                            text: total + " " + currency;
                            font-size: Typography.subheading;
                            font-weight: Typography.bold;
                            color: Colors.text-on-primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Payment tiles grid
        Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: center;
                spacing: Spacing.xl;

                // Instruction text
                Text {
                    text: Locale.current == "ar" ? "اختر طريقة الدفع" : "Select Payment Method";
                    font-size: Typography.subheading;
                    font-weight: Typography.medium;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                }

                // Row 1: Cash, Card, Split
                HorizontalLayout {
                    alignment: center;
                    spacing: Spacing.xl;

                    PaymentTile {
                        title: "Cash";
                        title-ar: "نقداً";
                        icon-text: "\u{1F4B5}"; // Money bag emoji
                        icon-bg: #22C55E;  // Green
                        clicked => { root.select-cash(); }
                    }

                    PaymentTile {
                        title: "Card";
                        title-ar: "بطاقة";
                        icon-text: "\u{1F4B3}"; // Credit card emoji
                        icon-bg: Colors.primary;
                        disabled: !card-enabled;
                        clicked => { root.select-card(); }
                    }

                    PaymentTile {
                        title: "Split";
                        title-ar: "تقسيم";
                        icon-text: "\u{2702}"; // Scissors emoji (for splitting)
                        icon-bg: #8B5CF6;  // Purple
                        clicked => { root.select-split(); }
                    }
                }

                // Row 2: Mobile Wallet, Credit (On Account), Other
                HorizontalLayout {
                    alignment: center;
                    spacing: Spacing.xl;

                    PaymentTile {
                        title: "Mobile";
                        title-ar: "محفظة";
                        icon-text: "\u{1F4F1}"; // Mobile phone emoji
                        icon-bg: #0EA5E9;  // Sky blue
                        disabled: !mobile-enabled;
                        clicked => { root.select-mobile(); }
                    }

                    PaymentTile {
                        title: "Credit";
                        title-ar: "آجل";
                        icon-text: "\u{1F4CB}"; // Clipboard emoji
                        icon-bg: #F59E0B;  // Amber
                        disabled: !credit-enabled;
                        clicked => { root.select-credit(); }
                    }

                    PaymentTile {
                        title: "Other";
                        title-ar: "أخرى";
                        icon-text: "\u{2026}"; // Ellipsis
                        icon-bg: Colors.text-secondary;
                        clicked => { root.select-other(); }
                    }
                }
            }
        }

        // Bottom action bar
        Rectangle {
            height: 80px;
            background: Colors.surface;
            border-width: 1px;
            border-color: Colors.border;

            HorizontalLayout {
                alignment: center;
                padding: Spacing.lg;

                Button {
                    text: Locale.current == "ar" ? "إلغاء" : "Cancel";
                    variant: "secondary";
                    width: 200px;
                    clicked => { root.back-clicked(); }
                }
            }
        }
    }
}
