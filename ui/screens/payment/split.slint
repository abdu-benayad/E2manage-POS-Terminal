// ============================================================================
// E2Manage POS Terminal - Split Payment Screen (Phase 23)
// ============================================================================
// Split payment screen allowing multiple payment methods for a single transaction
// Screen 3.4: Split Payment
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Animation, Layout, Locale, CartState } from "../../theme.slint";
import { Button, CompactKeypad } from "../../components/mod.slint";

// ============================================================================
// PAYMENT ENTRY STRUCT
// ============================================================================

export struct SplitPaymentEntry {
    id: string,
    method: string,           // cash, card, wallet
    method_label: string,     // Display label (localized)
    amount: string,           // Payment amount
    status: string,           // pending, processing, completed, failed
}

// ============================================================================
// METHOD BUTTON (internal)
// ============================================================================

component MethodButton inherits Rectangle {
    in property <string> method-id: "";
    in property <string> icon: "";
    in property <string> label: "";
    in property <bool> selected: false;
    in property <bool> disabled: false;

    callback clicked;

    horizontal-stretch: 1;
    height: 64px;
    border-radius: Radius.md;
    background: disabled ? Colors.surface-variant :
                selected ? Colors.primary :
                touch.pressed ? Colors.surface-variant :
                touch.has-hover ? Colors.background :
                Colors.surface;
    border-width: selected ? 0px : 1px;
    border-color: disabled ? Colors.border :
                  touch.has-hover ? Colors.primary :
                  Colors.border;

    animate background { duration: Animation.fast; }
    animate border-color { duration: Animation.fast; }

    touch := TouchArea {
        enabled: !disabled;
        mouse-cursor: disabled ? default : pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        spacing: Spacing.sm;

        Text {
            text: icon;
            font-size: 24px;
            vertical-alignment: center;
        }

        Text {
            text: label;
            font-size: Typography.body;
            font-weight: Typography.semi-bold;
            color: disabled ? Colors.disabled :
                   selected ? Colors.text-on-primary :
                   Colors.text-primary;
            vertical-alignment: center;
        }
    }
}

// ============================================================================
// PAYMENT ITEM ROW (internal)
// ============================================================================

component PaymentItemRow inherits Rectangle {
    in property <SplitPaymentEntry> payment;
    in property <string> currency: CartState.currency;

    callback remove-clicked;

    height: 72px;
    background: Colors.surface;
    border-radius: Radius.md;

    HorizontalLayout {
        padding-left: Spacing.md;
        padding-right: Spacing.md;
        spacing: Spacing.md;

        // Method icon circle
        Rectangle {
            width: 48px;
            height: 48px;
            border-radius: 24px;
            background: payment.status == "completed" ? Colors.success :
                        payment.status == "failed" ? Colors.danger :
                        payment.status == "processing" ? Colors.warning :
                        Colors.primary-light;

            Text {
                text: payment.method == "cash" ? "\u{1F4B5}" :
                      payment.method == "card" ? "\u{1F4B3}" :
                      payment.method == "wallet" ? "\u{1F4F1}" :
                      "\u{1F4B0}";
                font-size: 22px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Payment info
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Spacing.xxs;

            Text {
                text: payment.method_label;
                font-size: Typography.body;
                font-weight: Typography.semi-bold;
                color: Colors.text-primary;
            }

            Text {
                text: payment.status == "completed" ?
                      (Locale.current == "ar" ? "مكتمل" : "Completed") :
                      payment.status == "processing" ?
                      (Locale.current == "ar" ? "قيد المعالجة..." : "Processing...") :
                      payment.status == "failed" ?
                      (Locale.current == "ar" ? "فشل" : "Failed") :
                      (Locale.current == "ar" ? "معلق" : "Pending");
                font-size: Typography.small;
                color: payment.status == "completed" ? Colors.success :
                       payment.status == "processing" ? Colors.warning :
                       payment.status == "failed" ? Colors.danger :
                       Colors.text-secondary;
            }
        }

        // Amount
        Text {
            text: payment.amount + " " + currency;
            font-size: Typography.subheading;
            font-weight: Typography.bold;
            color: Colors.text-primary;
            vertical-alignment: center;
        }

        // Remove button (only if pending or failed)
        if payment.status == "pending" || payment.status == "failed": Rectangle {
            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: remove-touch.has-hover ? rgba(239, 68, 68, 0.1) : transparent;

            remove-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.remove-clicked(); }
            }

            Text {
                text: "\u{2715}"; // X mark
                font-size: 18px;
                color: Colors.danger;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Checkmark for completed
        if payment.status == "completed": Rectangle {
            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: Colors.success;

            Text {
                text: "\u{2713}";
                font-size: 16px;
                color: Colors.text-on-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// ============================================================================
// SPLIT PAYMENT SCREEN
// ============================================================================

export component SplitPaymentScreen inherits Rectangle {
    // Input properties
    in property <string> grand-total: "0.000";
    in property <string> paid-amount: "0.000";
    in property <string> remaining-amount: "0.000";
    in property <string> currency: CartState.currency;
    in property <int> item-count: 0;

    // Current payment entry
    in-out property <string> current-amount: "0";
    in property <string> selected-method: "cash";

    // Payments list
    in property <[SplitPaymentEntry]> payments: [];

    // State
    in property <bool> can-complete: false;       // true when remaining = 0
    in property <bool> has-pending-payments: false;

    // Callbacks
    callback back-clicked;
    callback method-selected(string);
    callback amount-changed(string);
    callback add-payment;
    callback remove-payment(string);
    callback process-card-payment(string);  // For card payments
    callback complete-transaction;
    callback keypad-key(string);
    callback keypad-clear;
    callback keypad-backspace;

    background: Colors.background;

    VerticalLayout {
        spacing: 0px;

        // ====================================================================
        // HEADER
        // ====================================================================
        Rectangle {
            height: Sizes.header-height;
            background: Colors.primary;

            HorizontalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.lg;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Spacing.lg;
                    alignment: start;

                    // Back button (RTL-aware arrow)
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: Radius.md;
                        background: touch-back.has-hover ? rgba(255, 255, 255, 0.1) : transparent;

                        touch-back := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.back-clicked(); }
                        }

                        Text {
                            text: Layout.rtl ? "\u{2192}" : "\u{2190}";
                            font-size: 24px;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Title with split emoji
                    HorizontalLayout {
                        spacing: Spacing.sm;
                        alignment: center;

                        Text {
                            text: "\u{2702}"; // Scissors (split) emoji
                            font-size: 24px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: Locale.current == "ar" ? "الدفع المقسم" : "Split Payment";
                            font-size: Typography.heading;
                            font-weight: Typography.semi-bold;
                            color: Colors.text-on-primary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Total display badge
                Rectangle {
                    width: 220px;
                    height: 48px;
                    border-radius: Radius.md;
                    background: rgba(255, 255, 255, 0.15);

                    HorizontalLayout {
                        padding-left: Spacing.lg;
                        padding-right: Spacing.lg;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;

                            Text {
                                text: Locale.current == "ar" ? "المجموع:" : "Total:";
                                font-size: Typography.small;
                                color: rgba(255, 255, 255, 0.7);
                            }

                            Text {
                                text: Locale.current == "ar"
                                    ? (item-count == 1 ? "صنف واحد" : item-count + " أصناف")
                                    : (item-count == 1 ? "1 item" : item-count + " items");
                                font-size: Typography.tiny;
                                color: rgba(255, 255, 255, 0.5);
                            }
                        }

                        Text {
                            text: grand-total + " " + currency;
                            font-size: Typography.subheading;
                            font-weight: Typography.bold;
                            color: Colors.text-on-primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ====================================================================
        // MAIN CONTENT - Two Panel Layout
        // ====================================================================
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // ----------------------------------------------------------------
            // LEFT PANEL - Payment Entry
            // ----------------------------------------------------------------
            Rectangle {
                horizontal-stretch: 50;
                background: Colors.surface;

                VerticalLayout {
                    padding: Spacing.xl;
                    spacing: Spacing.lg;

                    // Totals Summary Card
                    Rectangle {
                        background: Colors.background;
                        border-radius: Radius.lg;
                        height: 110px;

                        HorizontalLayout {
                            padding: Spacing.lg;
                            spacing: Spacing.lg;

                            // Grand Total
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: Spacing.xs;
                                alignment: center;

                                Text {
                                    text: Locale.current == "ar" ? "الإجمالي" : "Total";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: grand-total;
                                    font-size: Typography.title;
                                    font-weight: Typography.bold;
                                    color: Colors.text-primary;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: currency;
                                    font-size: Typography.small;
                                    color: Colors.text-secondary;
                                    horizontal-alignment: center;
                                }
                            }

                            // Divider
                            Rectangle {
                                width: 1px;
                                background: Colors.border;
                            }

                            // Paid Amount
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: Spacing.xs;
                                alignment: center;

                                Text {
                                    text: Locale.current == "ar" ? "المدفوع" : "Paid";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: paid-amount;
                                    font-size: Typography.title;
                                    font-weight: Typography.bold;
                                    color: Colors.success;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: currency;
                                    font-size: Typography.small;
                                    color: Colors.success;
                                    horizontal-alignment: center;
                                }
                            }

                            // Divider
                            Rectangle {
                                width: 1px;
                                background: Colors.border;
                            }

                            // Remaining
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: Spacing.xs;
                                alignment: center;

                                Text {
                                    text: Locale.current == "ar" ? "المتبقي" : "Remaining";
                                    font-size: Typography.caption;
                                    color: Colors.text-secondary;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: remaining-amount;
                                    font-size: Typography.title;
                                    font-weight: Typography.bold;
                                    color: remaining-amount == "0.000" || remaining-amount == "0" ? Colors.success : Colors.danger;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: currency;
                                    font-size: Typography.small;
                                    color: remaining-amount == "0.000" || remaining-amount == "0" ? Colors.success : Colors.danger;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }

                    // Payment Method Selection
                    VerticalLayout {
                        spacing: Spacing.sm;

                        Text {
                            text: Locale.current == "ar" ? "طريقة الدفع" : "Payment Method";
                            font-size: Typography.caption;
                            font-weight: Typography.medium;
                            color: Colors.text-secondary;
                        }

                        HorizontalLayout {
                            spacing: Spacing.sm;

                            MethodButton {
                                method-id: "cash";
                                icon: "\u{1F4B5}";
                                label: Locale.current == "ar" ? "نقداً" : "Cash";
                                selected: selected-method == "cash";
                                clicked => { root.method-selected("cash"); }
                            }

                            MethodButton {
                                method-id: "card";
                                icon: "\u{1F4B3}";
                                label: Locale.current == "ar" ? "بطاقة" : "Card";
                                selected: selected-method == "card";
                                clicked => { root.method-selected("card"); }
                            }

                            MethodButton {
                                method-id: "wallet";
                                icon: "\u{1F4F1}";
                                label: Locale.current == "ar" ? "محفظة" : "Wallet";
                                selected: selected-method == "wallet";
                                clicked => { root.method-selected("wallet"); }
                            }
                        }
                    }

                    // Amount Entry Section
                    VerticalLayout {
                        spacing: Spacing.sm;

                        Text {
                            text: Locale.current == "ar" ? "المبلغ" : "Amount";
                            font-size: Typography.caption;
                            font-weight: Typography.medium;
                            color: Colors.text-secondary;
                        }

                        // Amount display box
                        Rectangle {
                            height: 64px;
                            background: Colors.background;
                            border-radius: Radius.md;
                            border-width: 2px;
                            border-color: Colors.primary;

                            HorizontalLayout {
                                padding-left: Spacing.lg;
                                padding-right: Spacing.lg;
                                alignment: end;

                                Text {
                                    text: current-amount == "" || current-amount == "0" ? "0" : current-amount;
                                    font-size: Typography.title;
                                    font-weight: Typography.bold;
                                    color: Colors.primary;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: " " + currency;
                                    font-size: Typography.subheading;
                                    font-weight: Typography.medium;
                                    color: Colors.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Quick amount: "Remaining" button
                        Rectangle {
                            height: 40px;
                            border-radius: Radius.sm;
                            background: remaining-touch.pressed ? Colors.surface-variant :
                                        remaining-touch.has-hover ? Colors.background :
                                        Colors.surface;
                            border-width: 1px;
                            border-color: remaining-touch.has-hover ? Colors.primary : Colors.border;

                            animate background { duration: Animation.fast; }

                            remaining-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.amount-changed(remaining-amount); }
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: Spacing.sm;

                                Text {
                                    text: "\u{21B5}"; // Enter/return arrow
                                    font-size: 14px;
                                    color: Colors.text-secondary;
                                }

                                Text {
                                    text: Locale.current == "ar" ?
                                          "استخدام المتبقي (" + remaining-amount + " " + currency + ")" :
                                          "Use Remaining (" + remaining-amount + " " + currency + ")";
                                    font-size: Typography.small;
                                    color: Colors.text-secondary;
                                }
                            }
                        }
                    }

                    // Compact Keypad
                    CompactKeypad {
                        key-pressed(key) => { root.keypad-key(key); }
                        backspace => { root.keypad-backspace(); }
                        clear => { root.keypad-clear(); }
                    }

                    // Add Payment Button
                    Rectangle {
                        height: 52px;
                        border-radius: Radius.md;
                        background: add-touch.pressed ? #1D4ED8 :
                                    add-touch.has-hover ? #2563EB :
                                    Colors.primary;

                        animate background { duration: Animation.fast; }

                        add-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.add-payment(); }
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: Spacing.sm;

                            Text {
                                text: "\u{2795}"; // Plus sign
                                font-size: 18px;
                                color: Colors.text-on-primary;
                            }

                            Text {
                                text: Locale.current == "ar" ? "إضافة الدفعة" : "Add Payment";
                                font-size: Typography.body;
                                font-weight: Typography.semi-bold;
                                color: Colors.text-on-primary;
                            }
                        }
                    }
                }
            }

            // ----------------------------------------------------------------
            // DIVIDER
            // ----------------------------------------------------------------
            Rectangle {
                width: 1px;
                background: Colors.border;
            }

            // ----------------------------------------------------------------
            // RIGHT PANEL - Payments List
            // ----------------------------------------------------------------
            Rectangle {
                horizontal-stretch: 50;
                background: Colors.background;

                VerticalLayout {
                    padding: Spacing.xl;
                    spacing: Spacing.lg;

                    // Header
                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: Locale.current == "ar" ? "المدفوعات" : "Payments";
                            font-size: Typography.subheading;
                            font-weight: Typography.semi-bold;
                            color: Colors.text-primary;
                        }

                        // Payment count badge
                        if payments.length > 0: Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: Colors.primary;

                            Text {
                                text: payments.length;
                                font-size: Typography.small;
                                font-weight: Typography.bold;
                                color: Colors.text-on-primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Payments List
                    Flickable {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: Spacing.sm;

                            // Empty state
                            if payments.length == 0: Rectangle {
                                height: 200px;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: Spacing.md;

                                    Text {
                                        text: "\u{1F4B8}"; // Money with wings
                                        font-size: 48px;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: Locale.current == "ar" ?
                                              "لم يتم إضافة مدفوعات بعد" :
                                              "No payments added yet";
                                        font-size: Typography.body;
                                        color: Colors.text-secondary;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: Locale.current == "ar" ?
                                              "اختر طريقة الدفع وأدخل المبلغ" :
                                              "Select a payment method and enter an amount";
                                        font-size: Typography.small;
                                        color: Colors.text-secondary;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            // Payment entries
                            for payment in payments: PaymentItemRow {
                                payment: payment;
                                currency: root.currency;
                                remove-clicked => { root.remove-payment(payment.id); }
                            }
                        }
                    }

                    // Instructions / Status
                    if payments.length > 0 && !can-complete: Rectangle {
                        height: 48px;
                        border-radius: Radius.md;
                        background: rgba(245, 158, 11, 0.1);

                        HorizontalLayout {
                            padding-left: Spacing.md;
                            padding-right: Spacing.md;
                            alignment: center;
                            spacing: Spacing.sm;

                            Text {
                                text: "\u{26A0}"; // Warning icon
                                font-size: 18px;
                                color: Colors.warning;
                            }

                            Text {
                                text: Locale.current == "ar" ?
                                      "أضف المزيد من المدفوعات لتغطية المبلغ المتبقي" :
                                      "Add more payments to cover the remaining amount";
                                font-size: Typography.small;
                                color: Colors.warning;
                            }
                        }
                    }

                    // Success indicator when fully paid
                    if can-complete: Rectangle {
                        height: 48px;
                        border-radius: Radius.md;
                        background: rgba(34, 197, 94, 0.1);

                        HorizontalLayout {
                            padding-left: Spacing.md;
                            padding-right: Spacing.md;
                            alignment: center;
                            spacing: Spacing.sm;

                            Text {
                                text: "\u{2713}"; // Checkmark
                                font-size: 18px;
                                color: Colors.success;
                            }

                            Text {
                                text: Locale.current == "ar" ?
                                      "تم تغطية المبلغ بالكامل - جاهز للإتمام" :
                                      "Full amount covered - Ready to complete";
                                font-size: Typography.small;
                                color: Colors.success;
                            }
                        }
                    }
                }
            }
        }

        // ====================================================================
        // BOTTOM ACTION BAR
        // ====================================================================
        Rectangle {
            height: 88px;
            background: Colors.surface;
            border-width: 1px;
            border-color: Colors.border;

            HorizontalLayout {
                padding: Spacing.lg;
                spacing: Spacing.xl;
                alignment: center;

                // Cancel button
                Button {
                    text: Locale.current == "ar" ? "إلغاء" : "Cancel";
                    variant: "secondary";
                    width: 180px;
                    clicked => { root.back-clicked(); }
                }

                // Complete transaction button
                Rectangle {
                    width: 280px;
                    height: 56px;
                    border-radius: Radius.lg;
                    background: can-complete
                        ? (complete-touch.pressed ? #16A34A : complete-touch.has-hover ? #22C55E : Colors.success)
                        : Colors.disabled;

                    animate background { duration: Animation.fast; }

                    complete-touch := TouchArea {
                        enabled: can-complete;
                        mouse-cursor: can-complete ? pointer : default;
                        clicked => { root.complete-transaction(); }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.md;

                        Text {
                            text: "\u{2713}"; // Checkmark
                            font-size: 24px;
                            color: can-complete ? Colors.text-on-primary : Colors.text-secondary;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: Spacing.xxs;

                            Text {
                                text: Locale.current == "ar" ? "إتمام المعاملة" : "Complete Transaction";
                                font-size: Typography.body;
                                font-weight: Typography.bold;
                                color: can-complete ? Colors.text-on-primary : Colors.text-secondary;
                            }

                            if can-complete: Text {
                                text: Locale.current == "ar"
                                    ? payments.length + " طرق دفع"
                                    : payments.length + " payments";
                                font-size: Typography.small;
                                color: rgba(255, 255, 255, 0.8);
                            }
                        }
                    }
                }
            }
        }
    }
}
