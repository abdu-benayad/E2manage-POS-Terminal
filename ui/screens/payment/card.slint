// ============================================================================
// E2Manage POS Terminal - Card Payment (EMV) Screen (Phase 22)
// ============================================================================
// Card payment screen with EMV terminal integration
// Screen 3.3: Card Payment
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Animation, Layout, Locale, CartState } from "../../theme.slint";
import { Button } from "../../components/mod.slint";

// ============================================================================
// CARD PAYMENT SCREEN
// ============================================================================

export component CardPaymentScreen inherits Rectangle {
    // Input properties
    in property <string> total-amount: "0.000";
    in property <string> currency: CartState.currency;
    in property <int> item-count: 0;

    // Payment status: waiting, card_inserted, processing, pin_required, approved, declined, error, cancelled
    in property <string> status: "waiting";

    // Card information (populated after successful read)
    in property <string> card-type: "";       // visa, mastercard, amex, etc.
    in property <string> last-four: "";       // Last 4 digits of card
    in property <string> auth-code: "";       // Authorization code
    in property <string> transaction-id: "";  // EMV transaction reference

    // Error handling
    in property <string> error-message: "";

    // Callbacks
    callback back-clicked;
    callback cancel-payment;
    callback retry-payment;
    callback payment-completed;

    background: Colors.background;

    VerticalLayout {
        spacing: 0px;

        // ====================================================================
        // HEADER
        // ====================================================================
        Rectangle {
            height: Sizes.header-height;
            background: Colors.primary;

            HorizontalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.lg;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Spacing.lg;
                    alignment: start;

                    // Back button (RTL-aware arrow)
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: Radius.md;
                        background: touch-back.has-hover ? rgba(255, 255, 255, 0.1) : transparent;

                        touch-back := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.back-clicked(); }
                        }

                        Text {
                            text: Layout.rtl ? "\u{2192}" : "\u{2190}";
                            font-size: 24px;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Title with card emoji
                    HorizontalLayout {
                        spacing: Spacing.sm;
                        alignment: center;

                        Text {
                            text: "\u{1F4B3}"; // Credit card emoji
                            font-size: 24px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: Locale.current == "ar" ? "الدفع بالبطاقة" : "Card Payment";
                            font-size: Typography.heading;
                            font-weight: Typography.semi-bold;
                            color: Colors.text-on-primary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Total display badge
                Rectangle {
                    width: 220px;
                    height: 48px;
                    border-radius: Radius.md;
                    background: rgba(255, 255, 255, 0.15);

                    HorizontalLayout {
                        padding-left: Spacing.lg;
                        padding-right: Spacing.lg;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;

                            Text {
                                text: Locale.current == "ar" ? "المجموع:" : "Total:";
                                font-size: Typography.small;
                                color: rgba(255, 255, 255, 0.7);
                            }

                            Text {
                                text: Locale.current == "ar"
                                    ? (item-count == 1 ? "صنف واحد" : item-count + " أصناف")
                                    : (item-count == 1 ? "1 item" : item-count + " items");
                                font-size: Typography.tiny;
                                color: rgba(255, 255, 255, 0.5);
                            }
                        }

                        Text {
                            text: total-amount + " " + currency;
                            font-size: Typography.subheading;
                            font-weight: Typography.bold;
                            color: Colors.text-on-primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ====================================================================
        // MAIN CONTENT - Status Display
        // ====================================================================
        Rectangle {
            vertical-stretch: 1;
            background: Colors.surface;

            VerticalLayout {
                alignment: center;
                spacing: Spacing.xxl;
                padding: Spacing.xxl;

                // Amount Due Section
                VerticalLayout {
                    spacing: Spacing.xs;
                    alignment: center;

                    Text {
                        text: Locale.current == "ar" ? "المبلغ المطلوب" : "Amount Due";
                        font-size: Typography.caption;
                        color: Colors.text-secondary;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.sm;

                        Text {
                            text: total-amount;
                            font-size: Typography.display;
                            font-weight: Typography.bold;
                            color: Colors.text-primary;
                        }

                        Text {
                            text: currency;
                            font-size: Typography.heading;
                            font-weight: Typography.medium;
                            color: Colors.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Status Circle with Icon
                Rectangle {
                    width: 200px;
                    height: 200px;
                    border-radius: 100px;
                    background: status == "waiting" ? Colors.primary-light :
                               status == "card_inserted" ? Colors.info :
                               status == "processing" ? Colors.warning :
                               status == "pin_required" ? Colors.info :
                               status == "approved" ? Colors.success :
                               status == "declined" ? Colors.danger :
                               status == "error" ? Colors.danger :
                               Colors.surface-variant;

                    animate background { duration: Animation.normal; }

                    VerticalLayout {
                        alignment: center;
                        spacing: Spacing.md;

                        // Status Icon
                        Text {
                            text: status == "waiting" ? "\u{1F4B3}" :       // Card
                                  status == "card_inserted" ? "\u{2705}" :   // Check in box
                                  status == "processing" ? "\u{231B}" :      // Hourglass
                                  status == "pin_required" ? "\u{1F511}" :   // Key
                                  status == "approved" ? "\u{2713}" :        // Checkmark
                                  status == "declined" ? "\u{2717}" :        // X mark
                                  status == "error" ? "\u{26A0}" :           // Warning
                                  "\u{1F4B3}";                               // Default: Card
                            font-size: 64px;
                            horizontal-alignment: center;
                        }

                        // Status Text
                        Text {
                            text: status == "waiting" ?
                                  (Locale.current == "ar" ? "أدخل البطاقة" : "Insert Card") :
                                  status == "card_inserted" ?
                                  (Locale.current == "ar" ? "تم قراءة البطاقة" : "Card Detected") :
                                  status == "processing" ?
                                  (Locale.current == "ar" ? "جاري المعالجة..." : "Processing...") :
                                  status == "pin_required" ?
                                  (Locale.current == "ar" ? "أدخل الرقم السري" : "Enter PIN") :
                                  status == "approved" ?
                                  (Locale.current == "ar" ? "تمت الموافقة" : "Approved") :
                                  status == "declined" ?
                                  (Locale.current == "ar" ? "مرفوض" : "Declined") :
                                  status == "error" ?
                                  (Locale.current == "ar" ? "خطأ" : "Error") :
                                  (Locale.current == "ar" ? "ملغي" : "Cancelled");
                            font-size: Typography.subheading;
                            font-weight: Typography.semi-bold;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Instructions or Status Details
                if status == "waiting": VerticalLayout {
                    spacing: Spacing.sm;
                    alignment: center;

                    Text {
                        text: Locale.current == "ar"
                            ? "أدخل البطاقة أو اضغط للدفع بدون تلامس"
                            : "Insert card or tap for contactless";
                        font-size: Typography.body;
                        color: Colors.text-secondary;
                        horizontal-alignment: center;
                    }

                    // Contactless icon hint
                    HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.md;

                        Rectangle {
                            width: 60px;
                            height: 40px;
                            border-radius: Radius.sm;
                            background: Colors.background;
                            border-width: 1px;
                            border-color: Colors.border;

                            Text {
                                text: "\u{1F4F6}"; // Antenna/signal emoji for contactless
                                font-size: 20px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: Locale.current == "ar" ? "NFC / EMV" : "NFC / EMV";
                            font-size: Typography.caption;
                            color: Colors.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Processing animation hint
                if status == "processing": Text {
                    text: Locale.current == "ar"
                        ? "يرجى الانتظار، جاري التحقق من البطاقة..."
                        : "Please wait, verifying card...";
                    font-size: Typography.body;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                }

                // PIN required hint
                if status == "pin_required": Text {
                    text: Locale.current == "ar"
                        ? "يرجى إدخال الرقم السري على الجهاز"
                        : "Please enter your PIN on the terminal";
                    font-size: Typography.body;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                }

                // Card info (when approved)
                if status == "approved" && card-type != "": VerticalLayout {
                    spacing: Spacing.md;
                    alignment: center;

                    // Card type and number
                    Rectangle {
                        width: 280px;
                        height: 72px;
                        border-radius: Radius.lg;
                        background: Colors.background;
                        border-width: 1px;
                        border-color: Colors.success;

                        HorizontalLayout {
                            padding-left: Spacing.lg;
                            padding-right: Spacing.lg;
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: Spacing.md;
                                alignment: center;

                                // Card brand icon
                                Rectangle {
                                    width: 48px;
                                    height: 32px;
                                    border-radius: Radius.sm;
                                    background: card-type == "visa" ? #1A1F71 :
                                                card-type == "mastercard" ? #EB001B :
                                                card-type == "amex" ? #006FCF :
                                                Colors.surface-variant;

                                    Text {
                                        text: card-type == "visa" ? "VISA" :
                                              card-type == "mastercard" ? "MC" :
                                              card-type == "amex" ? "AMEX" :
                                              "\u{1F4B3}";
                                        font-size: card-type == "visa" || card-type == "mastercard" || card-type == "amex"
                                                 ? Typography.tiny : 16px;
                                        font-weight: Typography.bold;
                                        color: Colors.text-on-primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: Spacing.xxs;

                                    Text {
                                        text: card-type == "visa" ? "Visa" :
                                              card-type == "mastercard" ? "Mastercard" :
                                              card-type == "amex" ? "American Express" :
                                              card-type;
                                        font-size: Typography.body;
                                        font-weight: Typography.semi-bold;
                                        color: Colors.text-primary;
                                    }

                                    Text {
                                        text: "**** **** **** " + last-four;
                                        font-size: Typography.small;
                                        color: Colors.text-secondary;
                                    }
                                }
                            }

                            // Checkmark
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 16px;
                                background: Colors.success;

                                Text {
                                    text: "\u{2713}";
                                    font-size: 16px;
                                    color: Colors.text-on-primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Auth code and transaction ID
                    if auth-code != "": HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.xl;

                        HorizontalLayout {
                            spacing: Spacing.xs;

                            Text {
                                text: Locale.current == "ar" ? "رمز التفويض:" : "Auth Code:";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                            }

                            Text {
                                text: auth-code;
                                font-size: Typography.caption;
                                font-weight: Typography.semi-bold;
                                color: Colors.text-secondary;
                            }
                        }

                        if transaction-id != "": HorizontalLayout {
                            spacing: Spacing.xs;

                            Text {
                                text: Locale.current == "ar" ? "رقم العملية:" : "Ref:";
                                font-size: Typography.caption;
                                color: Colors.text-secondary;
                            }

                            Text {
                                text: transaction-id;
                                font-size: Typography.caption;
                                font-weight: Typography.semi-bold;
                                color: Colors.text-secondary;
                            }
                        }
                    }
                }

                // Error message display
                if (status == "error" || status == "declined") && error-message != "": Rectangle {
                    width: 400px;
                    height: 56px;
                    border-radius: Radius.md;
                    background: rgba(239, 68, 68, 0.1); // Light red

                    HorizontalLayout {
                        padding-left: Spacing.lg;
                        padding-right: Spacing.lg;
                        alignment: center;
                        spacing: Spacing.md;

                        Text {
                            text: "\u{26A0}"; // Warning icon
                            font-size: 20px;
                            color: Colors.danger;
                        }

                        Text {
                            text: error-message;
                            font-size: Typography.body;
                            color: Colors.danger;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }

        // ====================================================================
        // BOTTOM ACTION BAR
        // ====================================================================
        Rectangle {
            height: 88px;
            background: Colors.surface;
            border-width: 1px;
            border-color: Colors.border;

            HorizontalLayout {
                padding: Spacing.lg;
                spacing: Spacing.xl;
                alignment: center;

                // Cancel button (always visible except when approved)
                if status != "approved": Button {
                    text: Locale.current == "ar" ? "إلغاء" : "Cancel";
                    variant: "secondary";
                    width: 180px;
                    clicked => { root.cancel-payment(); }
                }

                // Retry button (only on error or declined)
                if status == "error" || status == "declined": Button {
                    text: Locale.current == "ar" ? "إعادة المحاولة" : "Retry";
                    variant: "primary";
                    width: 180px;
                    clicked => { root.retry-payment(); }
                }

                // Complete button (only on approved)
                if status == "approved": Rectangle {
                    width: 280px;
                    height: 56px;
                    border-radius: Radius.lg;
                    background: complete-touch.pressed ? #16A34A : complete-touch.has-hover ? #22C55E : Colors.success;

                    animate background { duration: Animation.fast; }

                    complete-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.payment-completed(); }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.md;

                        Text {
                            text: "\u{2713}"; // Checkmark
                            font-size: 24px;
                            color: Colors.text-on-primary;
                            vertical-alignment: center;
                        }

                        Text {
                            text: Locale.current == "ar" ? "إتمام العملية" : "Complete";
                            font-size: Typography.body;
                            font-weight: Typography.bold;
                            color: Colors.text-on-primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
