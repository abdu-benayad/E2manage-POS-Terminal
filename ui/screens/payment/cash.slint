// ============================================================================
// E2Manage POS Terminal - Cash Payment Screen (Phase 21)
// ============================================================================
// Cash payment screen with amount entry, quick amounts, and change calculation
// Screen 3.2: Cash Payment
// ============================================================================

import { Colors, Typography, Spacing, Sizes, Radius, Animation, Layout, Locale, CartState } from "../../theme.slint";
import { Button, NumericKeypad, CompactKeypad } from "../../components/mod.slint";
import { AmountDisplay, ChangeDisplay } from "../../components/mod.slint";

// ============================================================================
// QUICK AMOUNT BUTTON (internal)
// ============================================================================

component QuickAmountBtn inherits Rectangle {
    in property <string> amount: "";
    in property <string> currency: CartState.currency;
    in property <bool> disabled: false;
    in property <bool> is-exact: false;

    callback clicked;

    width: 90px;
    height: 52px;
    border-radius: Radius.md;
    background: disabled ? Colors.surface-variant :
                is-exact ? Colors.primary :
                touch.pressed ? Colors.surface-variant :
                touch.has-hover ? Colors.background :
                Colors.surface;
    border-width: is-exact ? 0px : 1px;
    border-color: disabled ? Colors.border :
                  touch.has-hover ? Colors.primary :
                  Colors.border;

    animate background { duration: Animation.fast; }
    animate border-color { duration: Animation.fast; }

    VerticalLayout {
        alignment: center;
        spacing: Spacing.xxs;

        if !is-exact: Text {
            text: amount;
            font-size: Typography.body;
            font-weight: Typography.bold;
            color: disabled ? Colors.disabled : Colors.text-primary;
            horizontal-alignment: center;
        }

        if !is-exact: Text {
            text: currency;
            font-size: Typography.tiny;
            color: disabled ? Colors.disabled : Colors.text-secondary;
            horizontal-alignment: center;
        }

        if is-exact: Text {
            text: Locale.current == "ar" ? "بالضبط" : "Exact";
            font-size: Typography.small;
            font-weight: Typography.semi-bold;
            color: Colors.text-on-primary;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: !disabled;
        mouse-cursor: disabled ? default : pointer;
        clicked => { root.clicked(); }
    }
}

// ============================================================================
// CASH PAYMENT SCREEN
// ============================================================================

export component CashPaymentScreen inherits Rectangle {
    // Input properties
    in property <string> total-due: "0.000";
    in property <string> currency: CartState.currency;
    in property <int> item-count: 0;

    // Amount entry state
    in-out property <string> amount-tendered: "0";
    in property <string> change-due: "0.000";
    in property <bool> is-sufficient: false;  // true when tendered >= total

    // Quick amount suggestions (calculated based on total)
    in property <[string]> quick-amounts: ["20", "50", "100", "200"];

    // Callbacks
    callback back-clicked;
    callback amount-changed(string);
    callback quick-amount-selected(string);
    callback exact-amount-selected;
    callback complete-payment;
    callback keypad-key(string);
    callback keypad-clear;
    callback keypad-backspace;

    background: Colors.background;

    VerticalLayout {
        spacing: 0px;

        // ====================================================================
        // HEADER
        // ====================================================================
        Rectangle {
            height: Sizes.header-height;
            background: Colors.primary;

            HorizontalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.lg;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Spacing.lg;
                    alignment: start;

                    // Back button (RTL-aware arrow)
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: Radius.md;
                        background: touch-back.has-hover ? rgba(255, 255, 255, 0.1) : transparent;

                        touch-back := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.back-clicked(); }
                        }

                        Text {
                            text: Layout.rtl ? "\u{2192}" : "\u{2190}";
                            font-size: 24px;
                            color: Colors.text-on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Title with cash emoji
                    HorizontalLayout {
                        spacing: Spacing.sm;
                        alignment: center;

                        Text {
                            text: "\u{1F4B5}"; // Money bag emoji
                            font-size: 24px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: Locale.current == "ar" ? "الدفع نقداً" : "Cash Payment";
                            font-size: Typography.heading;
                            font-weight: Typography.semi-bold;
                            color: Colors.text-on-primary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Total display badge
                Rectangle {
                    width: 220px;
                    height: 48px;
                    border-radius: Radius.md;
                    background: rgba(255, 255, 255, 0.15);

                    HorizontalLayout {
                        padding-left: Spacing.lg;
                        padding-right: Spacing.lg;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;

                            Text {
                                text: Locale.current == "ar" ? "المجموع:" : "Total:";
                                font-size: Typography.small;
                                color: rgba(255, 255, 255, 0.7);
                            }

                            Text {
                                text: Locale.current == "ar"
                                    ? (item-count == 1 ? "صنف واحد" : item-count + " أصناف")
                                    : (item-count == 1 ? "1 item" : item-count + " items");
                                font-size: Typography.tiny;
                                color: rgba(255, 255, 255, 0.5);
                            }
                        }

                        Text {
                            text: total-due + " " + currency;
                            font-size: Typography.subheading;
                            font-weight: Typography.bold;
                            color: Colors.text-on-primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ====================================================================
        // MAIN CONTENT - Two Panel Layout
        // ====================================================================
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // ----------------------------------------------------------------
            // LEFT PANEL - Amount displays and quick buttons
            // ----------------------------------------------------------------
            Rectangle {
                horizontal-stretch: 50;
                background: Colors.surface;

                VerticalLayout {
                    alignment: center;
                    spacing: Spacing.xl;
                    padding: Spacing.xxl;

                    // Total Due Section
                    VerticalLayout {
                        spacing: Spacing.xs;
                        alignment: center;

                        Text {
                            text: Locale.current == "ar" ? "المبلغ المطلوب" : "Total Due";
                            font-size: Typography.caption;
                            color: Colors.text-secondary;
                            horizontal-alignment: center;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: Spacing.sm;

                            Text {
                                text: total-due;
                                font-size: Typography.display;
                                font-weight: Typography.bold;
                                color: Colors.text-primary;
                            }

                            Text {
                                text: currency;
                                font-size: Typography.heading;
                                font-weight: Typography.medium;
                                color: Colors.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Divider
                    Rectangle {
                        height: 1px;
                        background: Colors.border;
                        horizontal-stretch: 1;
                    }

                    // Amount Tendered Section
                    VerticalLayout {
                        spacing: Spacing.sm;
                        alignment: center;

                        Text {
                            text: Locale.current == "ar" ? "المبلغ المستلم" : "Amount Tendered";
                            font-size: Typography.caption;
                            color: Colors.text-secondary;
                            horizontal-alignment: center;
                        }

                        // Highlighted amount display box
                        Rectangle {
                            width: 280px;
                            height: 72px;
                            border-radius: Radius.lg;
                            background: Colors.background;
                            border-width: 2px;
                            border-color: Colors.primary;

                            HorizontalLayout {
                                padding-left: Spacing.lg;
                                padding-right: Spacing.lg;
                                alignment: end;

                                Text {
                                    text: amount-tendered == "" || amount-tendered == "0" ? "0" : amount-tendered;
                                    font-size: Typography.display;
                                    font-weight: Typography.bold;
                                    color: Colors.primary;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: " " + currency;
                                    font-size: Typography.heading;
                                    font-weight: Typography.medium;
                                    color: Colors.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Divider
                    Rectangle {
                        height: 1px;
                        background: Colors.border;
                        horizontal-stretch: 1;
                    }

                    // Change Section
                    VerticalLayout {
                        spacing: Spacing.xs;
                        alignment: center;

                        Text {
                            text: is-sufficient
                                ? (Locale.current == "ar" ? "الباقي" : "Change")
                                : (Locale.current == "ar" ? "المبلغ المطلوب" : "Amount Needed");
                            font-size: Typography.caption;
                            color: Colors.text-secondary;
                            horizontal-alignment: center;
                        }

                        // Change display with color coding
                        Rectangle {
                            width: 200px;
                            height: 56px;
                            border-radius: Radius.md;
                            background: is-sufficient
                                ? rgba(34, 197, 94, 0.15)   // Green tint
                                : rgba(245, 158, 11, 0.15); // Warning tint

                            HorizontalLayout {
                                alignment: center;
                                spacing: Spacing.xs;

                                Text {
                                    text: change-due;
                                    font-size: Typography.title;
                                    font-weight: Typography.bold;
                                    color: is-sufficient ? Colors.success : Colors.warning;
                                }

                                Text {
                                    text: currency;
                                    font-size: Typography.body;
                                    font-weight: Typography.medium;
                                    color: is-sufficient ? Colors.success : Colors.warning;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Divider
                    Rectangle {
                        height: 1px;
                        background: Colors.border;
                        horizontal-stretch: 1;
                    }

                    // Quick Amount Section
                    VerticalLayout {
                        spacing: Spacing.md;
                        alignment: center;

                        Text {
                            text: Locale.current == "ar" ? "اختيار سريع" : "Quick Select";
                            font-size: Typography.caption;
                            color: Colors.text-secondary;
                            horizontal-alignment: center;
                        }

                        HorizontalLayout {
                            spacing: Spacing.md;
                            alignment: center;

                            // Quick amount buttons from property
                            for amt in quick-amounts: QuickAmountBtn {
                                amount: amt;
                                currency: root.currency;
                                clicked => { root.quick-amount-selected(amt); }
                            }

                            // Exact amount button
                            QuickAmountBtn {
                                is-exact: true;
                                clicked => { root.exact-amount-selected(); }
                            }
                        }
                    }
                }
            }

            // ----------------------------------------------------------------
            // DIVIDER
            // ----------------------------------------------------------------
            Rectangle {
                width: 1px;
                background: Colors.border;
            }

            // ----------------------------------------------------------------
            // RIGHT PANEL - Numeric Keypad
            // ----------------------------------------------------------------
            Rectangle {
                horizontal-stretch: 50;
                background: Colors.background;

                VerticalLayout {
                    alignment: center;
                    spacing: Spacing.xl;
                    padding: Spacing.xxl;

                    // Keypad instruction
                    Text {
                        text: Locale.current == "ar" ? "أدخل المبلغ المستلم" : "Enter Amount Received";
                        font-size: Typography.body;
                        font-weight: Typography.medium;
                        color: Colors.text-secondary;
                        horizontal-alignment: center;
                    }

                    // Numeric Keypad
                    CompactKeypad {
                        max-length: 10;

                        key-pressed(key) => {
                            root.keypad-key(key);
                        }

                        backspace => {
                            root.keypad-backspace();
                        }

                        clear => {
                            root.keypad-clear();
                        }
                    }

                    // Decimal point button (separate for amount entry)
                    HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            width: 100px;
                            height: 48px;
                            border-radius: Radius.md;
                            background: decimal-touch.pressed ? Colors.surface-variant :
                                        decimal-touch.has-hover ? Colors.background :
                                        Colors.surface;
                            border-width: 1px;
                            border-color: Colors.border;

                            animate background { duration: Animation.fast; }

                            decimal-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.keypad-key("."); }
                            }

                            Text {
                                text: ".";
                                font-size: Typography.title;
                                font-weight: Typography.bold;
                                color: Colors.text-primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ====================================================================
        // BOTTOM ACTION BAR
        // ====================================================================
        Rectangle {
            height: 88px;
            background: Colors.surface;
            border-width: 1px;
            border-color: Colors.border;

            HorizontalLayout {
                padding: Spacing.lg;
                spacing: Spacing.xl;
                alignment: center;

                // Cancel button
                Button {
                    text: Locale.current == "ar" ? "إلغاء" : "Cancel";
                    variant: "secondary";
                    width: 180px;
                    clicked => { root.back-clicked(); }
                }

                // Complete payment button
                Rectangle {
                    width: 280px;
                    height: 56px;
                    border-radius: Radius.lg;
                    background: is-sufficient
                        ? (complete-touch.pressed ? #16A34A : complete-touch.has-hover ? #22C55E : Colors.success)
                        : Colors.disabled;

                    animate background { duration: Animation.fast; }

                    complete-touch := TouchArea {
                        enabled: is-sufficient;
                        mouse-cursor: is-sufficient ? pointer : default;
                        clicked => { root.complete-payment(); }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.md;

                        Text {
                            text: "\u{2713}"; // Checkmark
                            font-size: 24px;
                            color: is-sufficient ? Colors.text-on-primary : Colors.text-secondary;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: Spacing.xxs;

                            Text {
                                text: Locale.current == "ar" ? "إتمام الدفع" : "Complete Payment";
                                font-size: Typography.body;
                                font-weight: Typography.bold;
                                color: is-sufficient ? Colors.text-on-primary : Colors.text-secondary;
                            }

                            if is-sufficient: Text {
                                text: Locale.current == "ar"
                                    ? "الباقي: " + change-due + " " + currency
                                    : "Change: " + change-due + " " + currency;
                                font-size: Typography.small;
                                color: rgba(255, 255, 255, 0.8);
                            }
                        }
                    }
                }
            }
        }
    }
}
