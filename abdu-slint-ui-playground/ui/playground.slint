// abdu-slint-ui Playground — interactive catalog window.
//
// Layout:
//   ┌──────────┬─────────────────────────────────────────────┐
//   │          │ Toolbar (global tokens)                      │
//   │ Sidebar  ├─────────────────────────────────────────────┤
//   │          │ Section preview (live + property panel)     │
//   └──────────┴─────────────────────────────────────────────┘
//
// The playground's chrome (sidebar/toolbar) uses std-widgets so a bug in
// abdu-slint-ui can be debugged without breaking the harness. Each section
// renders abdu-slint-ui components directly in its own preview pane.

import { Theme, Locale, IconFont, IconFamily, CurrencyFormat, Animation } from "@abdu-slint-ui";
import { ComboBox, CheckBox, HorizontalBox, VerticalBox, ListView, StandardListView, StandardButton, ScrollView, Slider } from "std-widgets.slint";
import { ButtonSection } from "sections/button.slint";
import { IconButtonSection } from "sections/icon-button.slint";
import { ToggleSection } from "sections/toggle.slint";
import { CardSection } from "sections/card.slint";

export component PlaygroundWindow inherits Window {
    title: "abdu-slint-ui Playground";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1024px;
    min-height: 640px;
    background: Theme.background;

    // Currently-selected component section.
    in-out property <string> selected-section: "button";

    // Toolbar ComboBoxes write directly to globals via `selected()` and read
    // back via `current-index`. The previous intermediate-property pattern
    // hit a stale-value race: when the user picks a value equal to the
    // intermediate's current value, `changed` does not fire and the global
    // is never updated.

    function button-shape-index() -> int {
        return Theme.button-shape == "rounded" ? 0
             : Theme.button-shape == "square"  ? 2
             : 1; // "pill"
    }
    function icon-button-shape-index() -> int {
        return Theme.icon-button-shape == "rounded" ? 0
             : Theme.icon-button-shape == "pill"    ? 1
             : Theme.icon-button-shape == "square"  ? 3
             : 2; // "circle"
    }
    function card-shape-index() -> int {
        return Theme.card-shape == "square" ? 1 : 0; // "rounded"
    }
    function density-index() -> int {
        return Theme.density == "compact"     ? 0
             : Theme.density == "comfortable" ? 2
             : 1; // "default"
    }
    function icon-family-index() -> int {
        return IconFont.family == IconFamily.lucide ? 1 : 0; // phosphor
    }

    HorizontalLayout {
        // --- Sidebar ---------------------------------------------------
        Rectangle {
            width: 240px;
            horizontal-stretch: 0;
            background: #f8fafc;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: #e2e8f0;
            }

            VerticalBox {
                padding: 16px;
                spacing: 4px;
                alignment: start;

                Text {
                    text: "abdu-slint-ui";
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: "Playground";
                    font-size: 12px;
                    color: #64748b;
                }
                Rectangle { height: 12px; }
                Text {
                    text: "COMPONENTS";
                    font-size: 11px;
                    font-weight: 600;
                    color: #94a3b8;
                }

                button-tile := Rectangle {
                    height: 36px;
                    background: root.selected-section == "button" ? #e2e8f0 : transparent;
                    border-radius: 6px;
                    Text {
                        x: 12px;
                        text: "Button";
                        font-size: 13px;
                        vertical-alignment: center;
                        color: #0f172a;
                    }
                    TouchArea {
                        clicked => { root.selected-section = "button"; }
                        mouse-cursor: pointer;
                    }
                }

                icon-button-tile := Rectangle {
                    height: 36px;
                    background: root.selected-section == "icon-button" ? #e2e8f0 : transparent;
                    border-radius: 6px;
                    Text {
                        x: 12px;
                        text: "IconButton";
                        font-size: 13px;
                        vertical-alignment: center;
                        color: #0f172a;
                    }
                    TouchArea {
                        clicked => { root.selected-section = "icon-button"; }
                        mouse-cursor: pointer;
                    }
                }

                toggle-tile := Rectangle {
                    height: 36px;
                    background: root.selected-section == "toggle" ? #e2e8f0 : transparent;
                    border-radius: 6px;
                    Text {
                        x: 12px;
                        text: "Toggle";
                        font-size: 13px;
                        vertical-alignment: center;
                        color: #0f172a;
                    }
                    TouchArea {
                        clicked => { root.selected-section = "toggle"; }
                        mouse-cursor: pointer;
                    }
                }

                card-tile := Rectangle {
                    height: 36px;
                    background: root.selected-section == "card" ? #e2e8f0 : transparent;
                    border-radius: 6px;
                    Text {
                        x: 12px;
                        text: "Card";
                        font-size: 13px;
                        vertical-alignment: center;
                        color: #0f172a;
                    }
                    TouchArea {
                        clicked => { root.selected-section = "card"; }
                        mouse-cursor: pointer;
                    }
                }

                Text {
                    text: "(KeyValueRow appears here as its section lands)";
                    font-size: 11px;
                    color: #94a3b8;
                    wrap: word-wrap;
                }
            }
        }

        // --- Right column: toolbar over section ----
        VerticalLayout {
            // Toolbar
            Rectangle {
                height: 56px;
                background: Theme.surface;
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }

                // ScrollView wrapper so the toolbar stays accessible
                // when the playground window is narrower than the
                // toolbar's natural content width. Vertical scrollbar
                // disabled — toolbar is single-row.
                toolbar-scroll := ScrollView {
                    width:  parent.width;
                    height: parent.height;
                    vertical-scrollbar-policy: always-off;
                    horizontal-scrollbar-policy: as-needed;

                HorizontalBox {
                    spacing: 12px;
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: start;

                    HorizontalBox {
                        spacing: 6px;
                        Text { text: "Button shape:"; vertical-alignment: center; font-size: 12px; }
                        ComboBox {
                            model: ["rounded", "pill", "square"];
                            current-index: root.button-shape-index();
                            selected(v) => { Theme.button-shape = v; }
                        }
                    }
                    HorizontalBox {
                        spacing: 6px;
                        Text { text: "Icon-btn:"; vertical-alignment: center; font-size: 12px; }
                        ComboBox {
                            model: ["rounded", "pill", "circle", "square"];
                            current-index: root.icon-button-shape-index();
                            selected(v) => { Theme.icon-button-shape = v; }
                        }
                    }
                    HorizontalBox {
                        spacing: 6px;
                        Text { text: "Card:"; vertical-alignment: center; font-size: 12px; }
                        ComboBox {
                            model: ["rounded", "square"];
                            current-index: root.card-shape-index();
                            selected(v) => { Theme.card-shape = v; }
                        }
                    }
                    HorizontalBox {
                        spacing: 6px;
                        Text { text: "Density:"; vertical-alignment: center; font-size: 12px; }
                        ComboBox {
                            model: ["compact", "default", "comfortable"];
                            current-index: root.density-index();
                            selected(v) => { Theme.density = v; }
                        }
                    }
                    HorizontalBox {
                        spacing: 6px;
                        Text { text: "Currency:"; vertical-alignment: center; font-size: 12px; }
                        ComboBox {
                            model: ["USD", "EUR", "SAR", "MAD"];
                            current-index: CurrencyFormat.currency == "EUR" ? 1
                                         : CurrencyFormat.currency == "SAR" ? 2
                                         : CurrencyFormat.currency == "MAD" ? 3 : 0;
                            selected(v) => { CurrencyFormat.currency = v; }
                        }
                    }
                    HorizontalBox {
                        spacing: 6px;
                        Text { text: "Icons:"; vertical-alignment: center; font-size: 12px; }
                        ComboBox {
                            model: ["phosphor", "lucide"];
                            current-index: root.icon-family-index();
                            selected(v) => {
                                IconFont.family = v == "lucide" ? IconFamily.lucide : IconFamily.phosphor;
                            }
                        }
                    }
                    HorizontalBox {
                        spacing: 6px;
                        CheckBox {
                            text: "RTL";
                            checked: Locale.rtl;
                            toggled => { Locale.rtl = self.checked; }
                        }
                    }
                    HorizontalBox {
                        spacing: 6px;
                        Text {
                            text: "Spinner:";
                            vertical-alignment: center;
                            font-size: 12px;
                        }
                        Slider {
                            width: 100px;
                            minimum: 400;
                            maximum: 3000;
                            value: Animation.spinner-period / 1ms;
                            changed(val) => { Animation.spinner-period = val * 1ms; }
                        }
                        Text {
                            text: floor(Animation.spinner-period / 1ms) + "ms";
                            vertical-alignment: center;
                            font-size: 11px;
                            color: Theme.muted-foreground;
                            min-width: 48px;
                        }
                    }
                }
                }   // close toolbar-scroll ScrollView
            }

            // Section pane
            if root.selected-section == "button":      ButtonSection { }
            if root.selected-section == "icon-button": IconButtonSection { }
            if root.selected-section == "toggle":      ToggleSection { }
            if root.selected-section == "card":        CardSection { }
            if root.selected-section != "button" && root.selected-section != "icon-button" && root.selected-section != "toggle" && root.selected-section != "card": Rectangle {
                background: Theme.surface-muted;
                Text {
                    x: 32px;
                    y: 32px;
                    text: "Section '" + root.selected-section + "' not yet implemented. Select Button, IconButton, Toggle, or Card from the sidebar.";
                    color: Theme.muted-foreground;
                }
            }
        }
    }
}
