// abdu-slint-ui Playground — interactive catalog window.
//
// Layout:
//   ┌──────────┬─────────────────────────────────────────────┐
//   │          │ Toolbar (global tokens)                      │
//   │ Sidebar  ├─────────────────────────────┬────────────────┤
//   │          │ Preview pane                │ Property panel │
//   │ component│ (live abdu-slint-ui render) │ + code snippet │
//   │   list   │                             │                │
//   └──────────┴─────────────────────────────┴────────────────┘
//
// The playground's chrome (sidebar/toolbar/property-panel) uses std-widgets
// so a bug in abdu-slint-ui can be debugged without breaking the harness.
// The preview pane renders abdu-slint-ui components directly.

import { Theme, Locale, IconFont, IconFamily } from "@abdu-slint-ui";
import { ComboBox, CheckBox, HorizontalBox, VerticalBox, ListView, StandardListView, StandardButton, ScrollView } from "std-widgets.slint";

export component PlaygroundWindow inherits Window {
    title: "abdu-slint-ui Playground";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 640px;
    background: Theme.background;

    // Currently-selected component section. Empty string = no section.
    in-out property <string> selected-section: "";

    // --- Global token state, mirrored to abdu-slint-ui globals. ---
    in-out property <string> tok-button-shape: "pill";
    in-out property <string> tok-icon-button-shape: "circle";
    in-out property <string> tok-card-shape: "rounded";
    in-out property <string> tok-density: "default";
    in-out property <string> tok-currency: "USD";
    in-out property <bool>   tok-rtl: false;
    in-out property <string> tok-icon-family: "phosphor";

    // Propagate token changes to the abdu-slint-ui globals.
    changed tok-button-shape       => { Theme.button-shape       = self.tok-button-shape; }
    changed tok-icon-button-shape  => { Theme.icon-button-shape  = self.tok-icon-button-shape; }
    changed tok-card-shape         => { Theme.card-shape         = self.tok-card-shape; }
    changed tok-density            => { Theme.density            = self.tok-density; }
    changed tok-rtl                => { Locale.rtl               = self.tok-rtl; }
    changed tok-icon-family => {
        IconFont.family = self.tok-icon-family == "lucide" ? IconFamily.lucide : IconFamily.phosphor;
    }

    HorizontalLayout {
        // --- Sidebar ---------------------------------------------------
        Rectangle {
            width: 240px;
            background: #f8fafc;
            border-color: #e2e8f0;
            border-width: 0px;
            // Right border only.
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: #e2e8f0;
            }

            VerticalBox {
                Text {
                    text: "Components";
                    font-size: 12px;
                    font-weight: 600;
                    color: #64748b;
                }
                Text {
                    text: "(none yet — sections appear here as components land)";
                    font-size: 13px;
                    color: #94a3b8;
                    wrap: word-wrap;
                }
            }
        }

        // --- Right column: toolbar over (preview | property panel) ----
        VerticalLayout {
            // Toolbar
            Rectangle {
                height: 56px;
                background: Theme.surface;
                border-color: Theme.border;
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }

                HorizontalBox {
                    spacing: 12px;
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: start;

                    HorizontalBox {
                        spacing: 6px;
                        alignment: start;
                        Text { text: "Button shape:"; vertical-alignment: center; font-size: 12px; }
                        ComboBox {
                            model: ["rounded", "pill", "square"];
                            current-value: root.tok-button-shape;
                            selected(v) => { root.tok-button-shape = v; }
                        }
                    }
                    HorizontalBox {
                        spacing: 6px;
                        Text { text: "Icon-btn:"; vertical-alignment: center; font-size: 12px; }
                        ComboBox {
                            model: ["rounded", "pill", "circle", "square"];
                            current-value: root.tok-icon-button-shape;
                            selected(v) => { root.tok-icon-button-shape = v; }
                        }
                    }
                    HorizontalBox {
                        spacing: 6px;
                        Text { text: "Card:"; vertical-alignment: center; font-size: 12px; }
                        ComboBox {
                            model: ["rounded", "square"];
                            current-value: root.tok-card-shape;
                            selected(v) => { root.tok-card-shape = v; }
                        }
                    }
                    HorizontalBox {
                        spacing: 6px;
                        Text { text: "Density:"; vertical-alignment: center; font-size: 12px; }
                        ComboBox {
                            model: ["compact", "default", "comfortable"];
                            current-value: root.tok-density;
                            selected(v) => { root.tok-density = v; }
                        }
                    }
                    HorizontalBox {
                        spacing: 6px;
                        Text { text: "Currency:"; vertical-alignment: center; font-size: 12px; }
                        ComboBox {
                            model: ["USD", "EUR", "SAR", "MAD"];
                            current-value: root.tok-currency;
                            selected(v) => { root.tok-currency = v; }
                        }
                    }
                    HorizontalBox {
                        spacing: 6px;
                        Text { text: "Icons:"; vertical-alignment: center; font-size: 12px; }
                        ComboBox {
                            model: ["phosphor", "lucide"];
                            current-value: root.tok-icon-family;
                            selected(v) => { root.tok-icon-family = v; }
                        }
                    }
                    HorizontalBox {
                        spacing: 6px;
                        CheckBox {
                            text: "RTL";
                            checked: root.tok-rtl;
                            toggled => { root.tok-rtl = self.checked; }
                        }
                    }
                }
            }

            // Preview pane | Property panel
            HorizontalLayout {
                // Preview pane
                Rectangle {
                    background: Theme.surface-muted;
                    ScrollView {
                        VerticalBox {
                            padding: 24px;
                            spacing: 16px;
                            Text {
                                text: root.selected-section == ""
                                    ? "← Select a component from the sidebar."
                                    : "Section: " + root.selected-section;
                                font-size: 14px;
                                color: Theme.muted-foreground;
                            }
                            Text {
                                text: "Once Button, IconButton, Toggle, Card, and KeyValueRow land in §1.6 of the plan, their sections will populate the sidebar and render here.";
                                wrap: word-wrap;
                                color: Theme.muted-foreground;
                                font-size: 13px;
                            }
                        }
                    }
                }

                // Property panel
                Rectangle {
                    width: 320px;
                    background: Theme.surface;
                    Rectangle {
                        x: 0;
                        width: 1px;
                        background: Theme.border;
                    }
                    VerticalBox {
                        padding: 16px;
                        spacing: 8px;
                        Text { text: "Properties"; font-weight: 600; font-size: 14px; }
                        Text {
                            text: "Per-section controls will appear here.";
                            color: Theme.muted-foreground;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
