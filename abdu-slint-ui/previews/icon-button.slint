// IconButton preview — variant × size × shape × tone × state × depth in one window.
// Run: `slint-viewer abdu-slint-ui/previews/icon-button.slint`

import { IconButton } from "../components/icon-button.slint";
import { ButtonVariant, IconButtonSize, Shape, Tone, Elevation } from "../enums.slint";
import { Theme } from "../globals/theme.slint";
import { Locale } from "../globals/locale.slint";
import { Spacing } from "../globals/spacing.slint";
import { Typography } from "../globals/typography.slint";

import "../assets/phosphor.ttf";
import "../assets/lucide.ttf";

component Section inherits VerticalLayout {
    in property <string> title;
    spacing: Spacing.sm;
    Text {
        text: root.title;
        font-size: Typography.text-sm;
        font-weight: Typography.weight-semibold;
        color: Theme.muted-foreground;
    }
}

export component IconButtonPreview inherits Window {
    title: "IconButton — preview";
    preferred-width: 1100px;
    preferred-height: 980px;
    background: Theme.background;

    in-out property <bool> rtl-toggle: false;
    changed rtl-toggle => { Locale.rtl = self.rtl-toggle; }

    VerticalLayout {
        padding: Spacing.xl;
        spacing: Spacing.xl;

        Text {
            text: "IconButton";
            font-size: Typography.text-xxl;
            font-weight: Typography.weight-bold;
            color: Theme.foreground;
        }
        Text {
            text: "Square icon-only primitive. Sibling of Button. Default variant is ghost. Shape resolves against Theme.icon-button-shape (default circle).";
            font-size: Typography.text-sm;
            color: Theme.muted-foreground;
            wrap: word-wrap;
        }

        // --- Variants ----------------------------------------------------
        Section {
            title: "Variants — all six (link is unusual on a square but supported)";
            HorizontalLayout {
                spacing: Spacing.md;
                alignment: start;
                IconButton { icon: "plus";    aria-label: "Add";       variant: ButtonVariant.default; }
                IconButton { icon: "trash";   aria-label: "Delete";    variant: ButtonVariant.destructive; }
                IconButton { icon: "pencil";  aria-label: "Edit";      variant: ButtonVariant.outline; }
                IconButton { icon: "gear";    aria-label: "Settings";  variant: ButtonVariant.secondary; }
                IconButton { icon: "x";       aria-label: "Close";     variant: ButtonVariant.ghost; }
                IconButton { icon: "info";    aria-label: "Info";      variant: ButtonVariant.link; }
            }
        }

        // --- Sizes -------------------------------------------------------
        Section {
            title: "Sizes — xs (32) to xxl (72)";
            HorizontalLayout {
                spacing: Spacing.md;
                alignment: start;
                IconButton { icon: "check"; aria-label: "xs";  size: IconButtonSize.xs;  variant: ButtonVariant.default; }
                IconButton { icon: "check"; aria-label: "sm";  size: IconButtonSize.sm;  variant: ButtonVariant.default; }
                IconButton { icon: "check"; aria-label: "md";  size: IconButtonSize.md;  variant: ButtonVariant.default; }
                IconButton { icon: "check"; aria-label: "lg";  size: IconButtonSize.lg;  variant: ButtonVariant.default; }
                IconButton { icon: "check"; aria-label: "xl";  size: IconButtonSize.xl;  variant: ButtonVariant.default; }
                IconButton { icon: "check"; aria-label: "xxl"; size: IconButtonSize.xxl; variant: ButtonVariant.default; }
            }
        }

        // --- Shapes ------------------------------------------------------
        Section {
            title: "Shapes — circle and pill collapse to the same radius on a square button";
            HorizontalLayout {
                spacing: Spacing.md;
                IconButton { icon: "heart"; aria-label: "Favorite (default)"; shape: Shape.default; variant: ButtonVariant.outline; }
                IconButton { icon: "heart"; aria-label: "Favorite (rounded)"; shape: Shape.rounded; variant: ButtonVariant.outline; }
                IconButton { icon: "heart"; aria-label: "Favorite (pill)";    shape: Shape.pill;    variant: ButtonVariant.outline; }
                IconButton { icon: "heart"; aria-label: "Favorite (circle)";  shape: Shape.circle;  variant: ButtonVariant.outline; }
                IconButton { icon: "heart"; aria-label: "Favorite (square)";  shape: Shape.square;  variant: ButtonVariant.outline; }
            }
        }

        // --- Tones -------------------------------------------------------
        Section {
            title: "Tones — outline variant + tone override";
            HorizontalLayout {
                spacing: Spacing.md;
                IconButton { icon: "check";  aria-label: "Confirm";  variant: ButtonVariant.outline; tone: Tone.success; }
                IconButton { icon: "warning"; aria-label: "Warning"; variant: ButtonVariant.outline; tone: Tone.warning; }
                IconButton { icon: "trash";  aria-label: "Delete";   variant: ButtonVariant.outline; tone: Tone.destructive; }
                IconButton { icon: "info";   aria-label: "Info";     variant: ButtonVariant.outline; tone: Tone.info; }
                IconButton { icon: "lock";   aria-label: "Muted";    variant: ButtonVariant.outline; tone: Tone.muted; }
            }
        }

        // --- States ------------------------------------------------------
        Section {
            title: "States — rest, disabled, loading, checked";
            HorizontalLayout {
                spacing: Spacing.md;
                IconButton { icon: "play"; aria-label: "Play"; variant: ButtonVariant.default; }
                IconButton { icon: "play"; aria-label: "Disabled play"; variant: ButtonVariant.default; disabled: true; }
                IconButton { icon: "play"; aria-label: "Loading"; variant: ButtonVariant.default; loading: true; }
                IconButton { icon: "star"; aria-label: "Favorited"; variant: ButtonVariant.outline; checkable: true; checked: true; tone: Tone.warning; }
                IconButton { icon: "star"; aria-label: "Not favorited"; variant: ButtonVariant.outline; checkable: true; }
            }
        }

        // --- Depth — elevations ------------------------------------------
        Section {
            title: "Depth — shadow-elevation from none to xl";
            HorizontalLayout {
                spacing: Spacing.md;
                IconButton { icon: "plus"; aria-label: "Elevation none"; shadow-elevation: Elevation.none; }
                IconButton { icon: "plus"; aria-label: "Elevation sm";   shadow-elevation: Elevation.sm; }
                IconButton { icon: "plus"; aria-label: "Elevation md";   shadow-elevation: Elevation.md; }
                IconButton { icon: "plus"; aria-label: "Elevation lg";   shadow-elevation: Elevation.lg; }
                IconButton { icon: "plus"; aria-label: "Elevation xl";   shadow-elevation: Elevation.xl; }
            }
        }

        // --- Depth — thickness ------------------------------------------
        Section {
            title: "Depth — thickness extrusion, hover or click to see the press slide";
            HorizontalLayout {
                spacing: Spacing.md;
                IconButton { icon: "house"; aria-label: "Flat";          variant: ButtonVariant.default; thickness: 0px; }
                IconButton { icon: "house"; aria-label: "Thickness 2px"; variant: ButtonVariant.default; thickness: 2px; }
                IconButton { icon: "house"; aria-label: "Thickness 4px"; variant: ButtonVariant.default; thickness: 4px; }
                IconButton { icon: "house"; aria-label: "Thickness 6px"; variant: ButtonVariant.default; thickness: 6px; }
                IconButton { icon: "house"; aria-label: "Thickness 8px"; variant: ButtonVariant.default; thickness: 8px; }
            }
        }

        // --- Tooltip -----------------------------------------------------
        Section {
            title: "Tooltip — hover an icon button to discover its purpose";
            HorizontalLayout {
                spacing: Spacing.md;
                IconButton { icon: "trash";   aria-label: "Delete";   tooltip: "Delete this item"; variant: ButtonVariant.ghost; }
                IconButton { icon: "pencil";  aria-label: "Edit";     tooltip: "Edit details";      variant: ButtonVariant.ghost; }
                IconButton { icon: "gear";    aria-label: "Settings"; tooltip: "Open settings";     variant: ButtonVariant.ghost; }
                IconButton { icon: "x";       aria-label: "Close";    tooltip: "Close window";      variant: ButtonVariant.ghost; }
            }
        }

        // --- RTL toggle --------------------------------------------------
        Section {
            title: "RTL toggle — IconButton renders identically; tooltip text would flip in a real RTL string";
            HorizontalLayout {
                spacing: Spacing.md;
                alignment: start;
                IconButton { icon: "check"; aria-label: rtl-toggle ? "تأكيد" : "Confirm"; tooltip: rtl-toggle ? "تأكيد العملية" : "Confirm action"; variant: ButtonVariant.default; }
                IconButton { icon: "house"; aria-label: rtl-toggle ? "أوقف RTL" : "Toggle RTL"; variant: ButtonVariant.outline;
                    clicked => { rtl-toggle = !rtl-toggle; }
                }
            }
        }
    }
}
