// KeyValueRow — labelled-value display row.
//
// Two primary content slots (`label` and `value`) rendered as separate
// cells per the single-script segmentation principle. Optional
// supporting elements (label-icon, description-under-label, value-icon,
// value-unit, leading status indicator, trailing disclosure indicator)
// each render as their own cell. The row computes shared typography
// and color values at the row level and references them from two
// per-locale cell sequences inside an outer HorizontalLayout.
//
// Composed on the segment-as-cell pattern's foundation primitives —
// Segment, SegmentColumn, Badge — all private to the library
// (`components/_*.slint`). No new private helpers needed for this row.
//
// Public API: 18 properties. See architecture/key-value-row.md for the
// design rationale, the unit-position XNOR semantic, the locked-height
// rule, and the status-dot-not-pill decision. See
// architecture/segment-pattern.md for the seven invariants and the
// show:bool convention that the foundation primitives enforce.
//
// Display-only in v1.0 — no `interactive` / `clicked()`. Consumers
// needing clickable rows wrap KeyValueRow inside an interactive Card.

import { Emphasis, Tone, Density, UnitPosition, DisclosureIndicator } from "../enums.slint";
import { Theme } from "../globals/theme.slint";
import { Typography } from "../globals/typography.slint";
import { Sizes } from "../globals/sizes.slint";
import { Radius } from "../globals/radius.slint";
import { Spacing } from "../globals/spacing.slint";
import { Animation } from "../globals/animation.slint";
import { Locale } from "../globals/locale.slint";
import { IconFont } from "../globals/icon-font.slint";

import { Segment } from "./_segment.slint";
import { SegmentColumn } from "./_segment-column.slint";
import { Badge } from "./_badge.slint";

export component KeyValueRow inherits Rectangle {
    // ===== Public API — 18 properties ====================================
    //
    // Property groupings mirror the design doc:
    //   Content (6), Typography & tone (3), Affordances (3),
    //   Layout & behaviour (5), Debug (1).

    // ----- Content (6) ---------------------------------------------------

    /// Leading-side primary text. Single-script content — do not concatenate
    /// bidi-mixed text into this string (Slint issue #7267).
    in property <string> label: "";

    /// Optional icon name (resolved through IconFont.resolve). Rendered
    /// adjacent to `label`. Position flips with Locale.rtl — LTR places
    /// the icon BEFORE the label, RTL places it AFTER.
    in property <string> label-icon: "";

    /// Optional secondary text rendered below `label`. When non-empty the
    /// label cell becomes a two-line SegmentColumn (label primary +
    /// description secondary). When empty the cell collapses to single-line
    /// via Segment's empty-state self-zeroing. Smaller font, muted color.
    in property <string> description: "";

    /// Trailing-side primary text. Single-script content.
    in property <string> value: "";

    /// Optional unit/suffix rendered adjacent to `value` (e.g. "kg", "%",
    /// "SAR"). Reading position relative to `value` is controlled by
    /// `unit-position`.
    in property <string> value-unit: "";

    /// Optional icon rendered in the value cluster (trend arrows, status
    /// glyphs). Resolved through IconFont.resolve.
    in property <string> value-icon: "";

    // ----- Typography & tone (3) -----------------------------------------

    /// Typography preset — `subtle` / `normal` / `strong` / `total`. Drives
    /// font-size and weight of label and value (and value-unit). See the
    /// emphasis-resolution table in architecture/key-value-row.md.
    in property <Emphasis> emphasis: Emphasis.normal;

    /// Tone of the value cluster (value text + unit + icon share the tone).
    /// Label is NEVER toned — always Theme.muted-foreground regardless of
    /// this property's value.
    in property <Tone> value-tone: Tone.default;

    /// When true, the value cell renders in Typography.font-family-monospace
    /// for tabular-figures alignment. Unit and icon cells unaffected.
    in property <bool> value-monospace: false;

    // ----- Affordances (3) -----------------------------------------------

    /// When true, renders a small colored dot (`●` at Sizes.icon-xs = 12px)
    /// at the row's leading edge. Useful for sync state, queue state,
    /// unread indicators. Dot, not pill — see architecture/key-value-row.md
    /// → "Status indicator: dot, not pill".
    in property <bool> show-status: false;

    /// Tone of the status dot. Resolves via the same mapping as `value-tone`.
    /// Only meaningful when `show-status: true`. `Tone.muted` falls back to
    /// Theme.muted-foreground (low contrast — see "Known risks" in
    /// architecture/key-value-row-impl.md).
    in property <Tone> status-tone: Tone.muted;

    /// Trailing-edge disclosure indicator. `none` / `chevron` / `external`.
    /// Glyph auto-flips with locale — `chevron` is `›` LTR / `‹` RTL;
    /// `external` is `↗` LTR / `↖` RTL.
    in property <DisclosureIndicator> disclosure: DisclosureIndicator.none;

    // ----- Layout & behaviour (5) ----------------------------------------

    /// Density preset — `compact` (padding-y: 8px) / `default` (12px) /
    /// `comfortable` (16px). Horizontal padding is always 0 — KeyValueRow
    /// expects to live inside a padded surface (Card / SectionCard).
    in property <Density> density: Density.default;

    /// Reading position of `value-unit` relative to `value`. `trailing`
    /// (default) reads value→unit; `leading` reads unit→value
    /// (currency-prefix style). The cluster's internal physical order is
    /// determined by the XNOR of this property and Locale.rtl.
    in property <UnitPosition> unit-position: UnitPosition.trailing;

    /// When false, content is single-line and elides on overflow. When true
    /// both label and value wrap; the row grows vertically and the locked
    /// height becomes a floor.
    in property <bool> wrap: false;

    /// Renders a 1px Theme.border bottom edge. Consumers showing a column
    /// of rows typically set this on every row except the last.
    in property <bool> show-divider: false;

    /// Hover text. A non-empty value installs a row-spanning TouchArea that
    /// blocks click propagation to a wrapping interactive Card — choose
    /// tooltip OR clickable-row-via-Card, not both.
    in property <string> tooltip: "";

    // ----- Debug (1) -----------------------------------------------------

    /// Renders a 2px magenta border around the row root for layout
    /// diagnosis. v1.0 is row-only — per-cell outlines are deferred. For
    /// cell-level debugging during composition work, use
    /// previews/_segment.slint's Bound helper.
    in property <bool> debug-bounds: false;

    // ===== Row-level derived state =======================================
    //
    // Every property below is computed once at the row level and referenced
    // by both LTR and RTL cell call sites. Lifting everything liftable
    // keeps each per-branch cell declaration short and trivial — see the
    // pattern doc's row-composition contract.

    // ----- Font & icon-font selection -----------------------------------
    //
    // Both clusters use the same font family, chosen by locale. Arabic
    // uses Noto Sans Arabic by default; Latin uses Inter. Icons use the
    // IconFont's registered family name (Phosphor or Lucide).

    property <string> row-font:
        Locale.current == "ar" ? Typography.font-family-ar : Typography.font-family;

    // ----- Density → vertical padding -----------------------------------
    //
    // Tighter than Card's mapping (Card: md/lg/xl) — KeyValueRow is
    // content, not container. Per CLAUDE.md's "Density is
    // per-component-tuned" convention.

    property <length> padding-y:
          root.density == Density.compact     ? Spacing.sm
        : root.density == Density.comfortable ? Spacing.lg
        :                                       Spacing.md;

    // ----- Emphasis → typography sizes & weights ------------------------
    //
    // The label font-size stays text-sm across all emphasis levels — the
    // value carries the typographic weight; the label provides context.
    // At `total`, the label weight bumps to medium so the bolded
    // grand-total value has a label that holds its own.

    property <length> label-font-size: Typography.text-sm;

    property <int> label-font-weight:
          root.emphasis == Emphasis.total ? Typography.weight-medium
        :                                   Typography.weight-regular;

    property <length> description-font-size: Typography.text-xs;

    property <length> value-font-size:
          root.emphasis == Emphasis.subtle ? Typography.text-sm
        : root.emphasis == Emphasis.total  ? Typography.text-lg
        :                                    Typography.text-base;

    property <length> value-unit-font-size:
          root.emphasis == Emphasis.subtle ? Typography.text-xs
        : root.emphasis == Emphasis.total  ? Typography.text-base
        :                                    Typography.text-sm;

    property <int> value-font-weight:
          root.emphasis == Emphasis.strong ? Typography.weight-semibold
        : root.emphasis == Emphasis.total  ? Typography.weight-bold
        :                                    Typography.weight-regular;

    property <length> icon-size:
          root.emphasis == Emphasis.total ? Sizes.icon-md
        :                                   Sizes.icon-sm;

    // ----- Color resolution ---------------------------------------------
    //
    // The label is never toned — stays muted-foreground in every emphasis
    // and value-tone combination. The value default color depends on
    // emphasis (subtle uses muted-foreground; everything else uses
    // foreground); the value-tone override fires when value-tone is
    // anything other than default.

    property <color> label-color: Theme.muted-foreground;

    property <color> value-default-color:
          root.emphasis == Emphasis.subtle ? Theme.muted-foreground
        :                                    Theme.foreground;

    property <color> value-color:
          root.value-tone == Tone.primary     ? Theme.primary
        : root.value-tone == Tone.success     ? Theme.success
        : root.value-tone == Tone.warning     ? Theme.warning
        : root.value-tone == Tone.destructive ? Theme.destructive
        : root.value-tone == Tone.info        ? Theme.info
        : root.value-tone == Tone.muted       ? Theme.muted-foreground
        :                                       root.value-default-color;

    // ----- Status indicator state ---------------------------------------
    //
    // A Segment with the glyph `●`, not a Badge. The Segment self-zeros
    // when its text is "" (which happens when show-status is false), so
    // the show:bool decorator-coordination convention is not needed for
    // this cell. The dot's color resolves via the same tone mapping as
    // value-tone, applied to the Segment's text-color. No background,
    // no padding around the dot — a colored glyph, not a pill.

    property <string> status-glyph: root.show-status ? "●" : "";

    property <color> status-color:
          root.status-tone == Tone.primary     ? Theme.primary
        : root.status-tone == Tone.success     ? Theme.success
        : root.status-tone == Tone.warning     ? Theme.warning
        : root.status-tone == Tone.destructive ? Theme.destructive
        : root.status-tone == Tone.info        ? Theme.info
        :                                        Theme.muted-foreground;

    property <length> status-size: Sizes.icon-xs;

    // ----- Disclosure glyph (locale-aware) ------------------------------
    //
    // The enum value picks the indicator family (chevron / external);
    // Locale.rtl picks the physical-direction glyph. Empty string when
    // disclosure is `none` — the Segment self-zeros.

    property <string> disclosure-glyph:
          root.disclosure == DisclosureIndicator.chevron  && !Locale.rtl ? "›"
        : root.disclosure == DisclosureIndicator.chevron  &&  Locale.rtl ? "‹"
        : root.disclosure == DisclosureIndicator.external && !Locale.rtl ? "↗"
        : root.disclosure == DisclosureIndicator.external &&  Locale.rtl ? "↖"
        :                                                                  "";

    // ----- Label-icon glyph ---------------------------------------------
    //
    // Resolves the icon-name string through the active IconFont. Empty
    // when label-icon is "" — the Segment self-zeros.

    property <string> label-icon-glyph:
        root.label-icon != "" ? IconFont.resolve(root.label-icon) : "";

    // ----- Value-cluster slot resolution --------------------------------
    //
    // The XNOR rule from segment-pattern.md → Appendix B. The cluster
    // always renders three Segments in source order — value-side-A,
    // value, value-side-B — and this block decides which slot holds the
    // value-icon vs the value-unit.
    //
    //   icon-leads-value-cluster := Locale.rtl == leading-flip
    //
    // i.e. either (LTR + unit-position=trailing — default case →
    // [icon, value, unit]) or (RTL + unit-position=leading —
    // [icon, value, unit] again, because both locale and intent flip).
    //
    // Each slot has three derived properties (text, font, size) because
    // a slot can hold either an icon (icon-font, icon-size) or a unit
    // (row-font, value-unit-font-size). The cell at the call site picks
    // its content via these three properties; the cell template stays
    // identical across slots.

    property <bool> leading-flip: root.unit-position == UnitPosition.leading;
    property <bool> icon-leads-value-cluster: Locale.rtl == leading-flip;

    property <string> value-side-a-text:
        icon-leads-value-cluster
            ? (root.value-icon != "" ? IconFont.resolve(root.value-icon) : "")
            : root.value-unit;
    property <string> value-side-a-font:
        icon-leads-value-cluster ? IconFont.font-family-name() : row-font;
    property <length> value-side-a-size:
        icon-leads-value-cluster ? icon-size : value-unit-font-size;

    property <string> value-side-b-text:
        icon-leads-value-cluster
            ? root.value-unit
            : (root.value-icon != "" ? IconFont.resolve(root.value-icon) : "");
    property <string> value-side-b-font:
        icon-leads-value-cluster ? row-font : IconFont.font-family-name();
    property <length> value-side-b-size:
        icon-leads-value-cluster ? value-unit-font-size : icon-size;

    // ----- Row sizing ---------------------------------------------------
    //
    // Locked height for locale stability — the row's height does not track
    // Text natural line-height (which differs per font: Noto Sans Arabic
    // has a taller line-height than Inter). Lock to value-font-size × 1.6
    // so toggling Locale.current between "en" and "ar" does not resize
    // the row. The lock relaxes when `wrap: true` OR `description != ""`
    // (see Phase 5 sizing bindings).

    property <length> row-content-height: root.value-font-size * 1.6;
    property <length> row-total-height:   2 * root.padding-y + root.row-content-height;

    // ===== Root sizing & background ======================================
    //
    // Phase 5 binds the locked-height sizing rules and the show-divider
    // Rectangle. Phase 6 adds tooltip + debug-bounds.

    background: transparent;

    // ===== Outer layout — two per-locale cell sequences ==================
    //
    // One outer `if Locale.rtl` branch per the segment-pattern's Invariant
    // 4. Each cell is declared TWICE — once in the LTR branch, once in
    // the RTL branch — with content bound from row-level derived
    // properties at the call site (Invariant 6). The only stretching
    // child of this HorizontalLayout is the bare slack Rectangle between
    // the label-side and value-side cells (Invariant 7).
    //
    // Cell sequence in source order (= physical left-to-right, since
    // Slint 1.14's HorizontalLayout is not locale-aware):
    //
    //   LTR: [status, label-icon, label-column, slack,
    //         value-side-A, value, value-side-B, disclosure]
    //   RTL: [disclosure, value-side-A, value, value-side-B, slack,
    //         label-column, label-icon, status]
    //
    // Per-branch differences are concentrated in `align-h`:
    //   - locale-dependent text (label, description, value) matches the
    //     branch (left in LTR, right in RTL — elide trailing reading edge);
    //   - locale-independent content (label-icon, value-side-A/B) stays
    //     left in both branches;
    //   - geometric-anchor cells (status, disclosure) push their glyph
    //     against the row's outer edge per branch.

    layout := HorizontalLayout {
        spacing: 0;
        padding-top:    root.padding-y;
        padding-bottom: root.padding-y;

        // ----- LTR branch — label leads, value-cluster trails ----------
        if !Locale.rtl: Segment {
            text:        root.status-glyph;
            font-family: root.row-font;
            font-size:   root.status-size;
            text-color:  root.status-color;
            align-h:     center;
            padding-h:   Spacing.xs;
        }
        if !Locale.rtl: Segment {
            text:        root.label-icon-glyph;
            font-family: IconFont.font-family-name();
            font-size:   root.icon-size;
            text-color:  root.label-color;
            align-h:     left;
            padding-h:   Spacing.xs;
        }
        if !Locale.rtl: SegmentColumn {
            Segment {
                text:        root.label;
                font-family: root.row-font;
                font-size:   root.label-font-size;
                font-weight: root.label-font-weight;
                text-color:  root.label-color;
                align-h:     left;
                padding-h:   Spacing.xs;
                wrap:        root.wrap;
            }
            Segment {
                text:        root.description;
                font-family: root.row-font;
                font-size:   root.description-font-size;
                font-weight: Typography.weight-regular;
                text-color:  Theme.muted-foreground;
                align-h:     left;
                padding-h:   Spacing.xs;
                wrap:        root.wrap;
            }
        }
        if !Locale.rtl: Rectangle { horizontal-stretch: 1; }
        if !Locale.rtl: Segment {
            text:        root.value-side-a-text;
            font-family: root.value-side-a-font;
            font-size:   root.value-side-a-size;
            text-color:  root.value-color;
            align-h:     left;
            padding-h:   Spacing.xs;
        }
        if !Locale.rtl: Segment {
            text:        root.value;
            font-family: root.value-monospace ? Typography.font-family-monospace : root.row-font;
            font-size:   root.value-font-size;
            font-weight: root.value-font-weight;
            text-color:  root.value-color;
            align-h:     left;
            padding-h:   Spacing.xs;
            wrap:        root.wrap;
        }
        if !Locale.rtl: Segment {
            text:        root.value-side-b-text;
            font-family: root.value-side-b-font;
            font-size:   root.value-side-b-size;
            text-color:  root.value-color;
            align-h:     left;
            padding-h:   Spacing.xs;
        }
        if !Locale.rtl: Segment {
            text:        root.disclosure-glyph;
            font-family: root.row-font;
            font-size:   root.icon-size;
            text-color:  Theme.muted-foreground;
            align-h:     right;
            padding-h:   Spacing.xs;
        }

        // ----- RTL branch — mirror sequence ----------------------------
        if Locale.rtl: Segment {
            text:        root.disclosure-glyph;
            font-family: root.row-font;
            font-size:   root.icon-size;
            text-color:  Theme.muted-foreground;
            align-h:     left;
            padding-h:   Spacing.xs;
        }
        if Locale.rtl: Segment {
            text:        root.value-side-a-text;
            font-family: root.value-side-a-font;
            font-size:   root.value-side-a-size;
            text-color:  root.value-color;
            align-h:     left;
            padding-h:   Spacing.xs;
        }
        if Locale.rtl: Segment {
            text:        root.value;
            font-family: root.value-monospace ? Typography.font-family-monospace : root.row-font;
            font-size:   root.value-font-size;
            font-weight: root.value-font-weight;
            text-color:  root.value-color;
            align-h:     right;
            padding-h:   Spacing.xs;
            wrap:        root.wrap;
        }
        if Locale.rtl: Segment {
            text:        root.value-side-b-text;
            font-family: root.value-side-b-font;
            font-size:   root.value-side-b-size;
            text-color:  root.value-color;
            align-h:     left;
            padding-h:   Spacing.xs;
        }
        if Locale.rtl: Rectangle { horizontal-stretch: 1; }
        if Locale.rtl: SegmentColumn {
            Segment {
                text:        root.label;
                font-family: root.row-font;
                font-size:   root.label-font-size;
                font-weight: root.label-font-weight;
                text-color:  root.label-color;
                align-h:     right;
                padding-h:   Spacing.xs;
                wrap:        root.wrap;
            }
            Segment {
                text:        root.description;
                font-family: root.row-font;
                font-size:   root.description-font-size;
                font-weight: Typography.weight-regular;
                text-color:  Theme.muted-foreground;
                align-h:     right;
                padding-h:   Spacing.xs;
                wrap:        root.wrap;
            }
        }
        if Locale.rtl: Segment {
            text:        root.label-icon-glyph;
            font-family: IconFont.font-family-name();
            font-size:   root.icon-size;
            text-color:  root.label-color;
            align-h:     left;
            padding-h:   Spacing.xs;
        }
        if Locale.rtl: Segment {
            text:        root.status-glyph;
            font-family: root.row-font;
            font-size:   root.status-size;
            text-color:  root.status-color;
            align-h:     center;
            padding-h:   Spacing.xs;
        }
    }
}
