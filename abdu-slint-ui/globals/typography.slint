// Typography — font families, sizes, and weights.
//
// Consumers may override `font-family` and `font-family-ar` at startup
// to match the host application's bundled fonts. The scale and weights
// are fixed tokens shared across components.

export global Typography {
    // --- Font families (consumer-configurable) ---
    //
    // Slint's `font-family` property takes a single font name, NOT a
    // CSS-style fallback list. The string must match a font installed
    // on the consumer system or one bundled via `import "*.ttf"` in
    // lib.slint. Comma-separated fallback chains do not work — they
    // resolve to a literal lookup that fails silently and Slint falls
    // back to its default font (which usually has no Arabic glyphs,
    // so RTL text renders as boxes).
    //
    // Defaults below are picked for broad availability on Linux/macOS;
    // consumers shipping their own brand font override these at startup
    // (e.g. `Typography.font-family = "SF Pro Text";`).
    //
    // For guaranteed cross-system availability the library should bundle
    // an Arabic font (Cairo/Tajawal OFL) under `assets/` and import it
    // in `lib.slint` — tracked as a v1.1 candidate.
    in-out property <string> font-family: "Inter";
    in-out property <string> font-family-ar: "Noto Sans Arabic";

    // --- Size scale ---
    out property <length> text-xs: 12px;
    out property <length> text-sm: 14px;
    out property <length> text-base: 16px;
    out property <length> text-lg: 18px;
    out property <length> text-xl: 20px;
    out property <length> text-xxl: 24px;       // doc-table "text-2xl"
    out property <length> text-xxxl: 32px;      // doc-table "text-3xl"
    out property <length> text-display: 48px;

    // --- Weights ---
    out property <int> weight-regular: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;
    out property <int> weight-bold: 700;
}
