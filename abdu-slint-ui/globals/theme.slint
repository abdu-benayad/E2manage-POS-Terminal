// Theme — semantic colors, shape tokens, density, and shadow primitives.
//
// Consumers may override `in-out` properties at app startup to switch
// between light/dark, swap accent colors, or change the shape language.
// `out` properties are intended to be read-only from consumer code.

export global Theme {
    // --- Surfaces & foregrounds ---
    out property <color> background: #ffffff;
    out property <color> foreground: #020817;
    out property <color> surface: #ffffff;
    out property <color> surface-muted: #f1f5f9;

    // --- Primary palette ---
    out property <color> primary: #0f172a;
    out property <color> primary-hover: #1e293b;
    out property <color> primary-foreground: #f8fafc;

    // --- Destructive palette ---
    out property <color> destructive: #ef4444;
    out property <color> destructive-hover: #dc2626;
    out property <color> destructive-foreground: #f8fafc;

    // --- Secondary palette ---
    out property <color> secondary: #f1f5f9;
    out property <color> secondary-hover: #e2e8f0;
    out property <color> secondary-foreground: #0f172a;

    // --- Accent (hover background for ghost/outline) ---
    out property <color> accent: #f1f5f9;
    out property <color> accent-foreground: #0f172a;

    // --- Semantic palettes ---
    out property <color> success: #10b981;
    out property <color> success-foreground: #f0fdf4;
    out property <color> warning: #f59e0b;
    out property <color> warning-foreground: #fffbeb;
    out property <color> info: #3b82f6;
    out property <color> info-foreground: #eff6ff;

    // --- Structural ---
    out property <color> border: #e2e8f0;
    out property <color> ring: #94a3b8;
    out property <color> muted-foreground: #64748b;

    // --- Shape tokens (consumer-configurable) ---
    // Values: "rounded" | "pill" | "square"
    in-out property <string> button-shape: "pill";
    // Values: "rounded" | "square"
    in-out property <string> card-shape: "rounded";
    // Values: "rounded" | "pill" | "circle" | "square"
    in-out property <string> icon-button-shape: "circle";

    // --- Density (consumer-configurable) ---
    // Values: "compact" | "default" | "comfortable"
    in-out property <string> density: "default";

    // --- Shadow primitives ---
    out property <length> shadow-sm-blur: 2px;
    out property <length> shadow-sm-y: 1px;
    out property <color>  shadow-sm-color: #0000000d;     // rgba(0,0,0,0.05)

    out property <length> shadow-md-blur: 6px;
    out property <length> shadow-md-y: 2px;
    out property <color>  shadow-md-color: #00000014;     // rgba(0,0,0,0.08)

    out property <length> shadow-lg-blur: 16px;
    out property <length> shadow-lg-y: 6px;
    out property <color>  shadow-lg-color: #0000001f;     // rgba(0,0,0,0.12)
}
