// Animation — duration tokens.
//
// Easings are Slint built-ins (`ease-out`, `ease-in`, `ease-in-out`,
// `ease`). Components use `ease-out` for discrete state changes and
// `ease-in-out` for continuous animations (pulses, transitions).

export global Animation {
    out property <duration> instant: 0ms;
    out property <duration> fast: 120ms;
    out property <duration> normal: 200ms;
    out property <duration> slow: 300ms;
    out property <duration> slower: 500ms;

    // Duration of one full revolution for indeterminate loading spinners.
    // Components reading this: Button, IconButton. Tune once at startup
    // to slow or quicken every spinner in the app at once.
    in-out property <duration> spinner-period: 1200ms;

    // Suggested duration for theme-mode transitions (light <-> dark).
    // Currently unused — component-level `animate background` blocks
    // run at `fast` (120ms), which makes mode flips feel snappy but
    // slightly rushed for a deliberate visual mode change. This token
    // is the v1.1 knob: components wanting a more deliberate fade on
    // mode-driven color changes can substitute this duration. Tuned
    // once here rather than per-component.
    out property <duration> theme-transition: 300ms;
}
