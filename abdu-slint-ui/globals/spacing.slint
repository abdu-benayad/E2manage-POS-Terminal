// Spacing — consistent gap / padding scale.
//
// Names follow t-shirt sizing. `zero` replaces the doc-table `0` row
// (Slint identifiers cannot start with a digit). `xxl`/`xxxl`/`xxxxl`
// replace the `2xl`/`3xl`/`4xl` rows for the same reason.

export global Spacing {
    out property <length> zero: 0px;
    out property <length> xs: 4px;
    out property <length> sm: 8px;
    out property <length> md: 12px;
    out property <length> lg: 16px;
    out property <length> xl: 24px;
    out property <length> xxl: 32px;
    out property <length> xxxl: 48px;
    out property <length> xxxxl: 64px;
}
