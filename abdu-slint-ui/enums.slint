// Public enum definitions shared across components.
// Variants follow CLAUDE.md naming: kebab-case or lowercase.

export enum ButtonVariant {
    default,        // primary action — solid near-black
    destructive,    // red, for destructive actions
    outline,        // bordered, transparent background
    secondary,      // muted background, dark foreground
    ghost,          // transparent until hover
    link,           // text-only, underline on hover
}

export enum ButtonSize {
    xs,    // 32px
    sm,    // 38px
    md,    // 44px (default — Apple HIG minimum tap target)
    lg,    // 52px
    xl,    // 60px
    xxl,   // 72px — large primary actions on tablet POS
    hero,  // 88px — PAY-class buttons
    icon,  // square, icon-only (matches icon-button-square)
}

export enum Shape {
    default,   // sentinel — follows theme token
    rounded,   // Radius.md
    pill,      // height/2 — capsule
    square,    // 0 radius
    circle,    // 1:1 + pill — for icon variants only
}

export enum Tone {
    default,
    primary,
    success,
    warning,
    destructive,
    info,
    muted,
}

export enum Elevation {
    none,
    sm,    // subtle, e.g. cards at rest
    md,    // hovered cards, sticky surfaces
    lg,    // dialogs, popovers
    xl,    // toasts, top-level overlays
}

export enum Density {
    compact,        // tighter padding/heights
    default,        // standard
    comfortable,    // looser padding/heights
}

export enum Emphasis {
    subtle,
    normal,
    strong,
    total,    // for grand totals / final values
}

export enum ToggleSize {
    sm,
    md,
    lg,
}

// IconButton's size enum. Separate from ButtonSize so the compiler
// rejects passing `hero` or `icon` to an IconButton (both are
// meaningless here — `icon` is redundant on an icon-only button,
// `hero` at 88px feels excessive for icon-only).
export enum IconButtonSize {
    xs,    // 32px
    sm,    // 38px
    md,    // 44px (default — Apple HIG minimum tap target)
    lg,    // 52px
    xl,    // 60px
    xxl,   // 72px — tablet hero icon actions (back/close on checkout)
}

export enum TonalSurface {
    on-surface,
    on-primary,
    on-dark,
    on-light,
}

export enum IconFamily {
    phosphor,
    lucide,
}

// Color-palette mode. Theme.mode selects between the parallel light-*
// and dark-* sub-palettes; every public Theme color token is derived
// from the active mode. Consumers populate Theme.mode at startup
// (typically from an OS-preference detection in the Rust host).
export enum ThemeMode {
    light,
    dark,
}

// KeyValueRow's unit-position knob. `trailing` (default) places the
// unit on the reading-trailing edge of the value cluster — physical
// RIGHT in LTR, physical LEFT in RTL — so the reader reads
// value→unit in both locales (the "standard" iOS/Apple-derived
// convention adapted for bi-directional layouts). `leading` flips
// the cluster: unit on the reading-leading edge so the reader
// reads unit→value (currency-prefix style — useful for accounting
// formats where the currency symbol precedes the magnitude). The
// flip is symmetric across locales: setting `leading` swaps physical
// positions in both LTR and RTL, preserving consistent reading order.
export enum UnitPosition {
    trailing,    // unit reads AFTER value (default)
    leading,     // unit reads BEFORE value (currency-prefix style)
}

// KeyValueRow's trailing-edge disclosure indicator. `none` (default)
// renders nothing. `chevron` and `external` render a single locale-aware
// glyph as the row's last cell — `chevron` is the standard
// settings-row affordance (`›` LTR / `‹` RTL); `external` signals an
// off-screen / off-app target (`↗` LTR / `↖` RTL). Glyph selection is
// derived at the row level from the enum value and Locale.rtl, then
// bound to a Segment's `text`.
export enum DisclosureIndicator {
    none,        // no indicator
    chevron,     // `›` LTR, `‹` RTL
    external,    // `↗` LTR, `↖` RTL
}
