# ============================================================================
# Vendored Sources (for offline builds)
# ============================================================================

[source.crates-io]
replace-with = "vendored-sources"

[source.vendored-sources]
directory = "vendor"

# ============================================================================
# Cargo Configuration for Faster Builds
# ============================================================================

[build]
# Use mold linker (fastest available)
rustflags = ["-C", "link-arg=-fuse-ld=mold"]

# Limit parallel jobs to avoid OOM on low-memory systems
jobs = 1

[target.x86_64-unknown-linux-gnu]
linker = "clang"
rustflags = ["-C", "link-arg=-fuse-ld=mold"]

# ============================================================================
# Incremental Build Settings
# ============================================================================

[env]
# Reduce memory usage during compilation
CARGO_INCREMENTAL = "1"

# ============================================================================
# Profile Overrides for Dependencies
# ============================================================================

# Build dependencies with some optimization even in dev mode
# This makes the final link faster and reduces memory pressure
[profile.dev.package."*"]
opt-level = 1
debug = false

# Keep our code unoptimized for fast rebuilds
[profile.dev.package.e2manage-pos-terminal]
opt-level = 0
debug = true

# Slint compiler runs during build - optimize it
[profile.dev.build-override]
opt-level = 2
